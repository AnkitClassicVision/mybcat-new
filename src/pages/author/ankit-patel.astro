---
/**
 * Author Page: Ankit Patel
 * Dedicated author page for E-A-T signals
 * URL: /author/ankit-patel/
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import { company } from '@data/company';
import { getCollection } from 'astro:content';
import { serializeSchema } from '@utils/schema';

// Get all published blog posts by Ankit (exclude future-dated posts)
const now = new Date();
const allPosts = await getCollection('blog', ({ data }) =>
  data.status === 'published' && data.author === 'Ankit Patel' && data.publishDate <= now
);
const recentPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);

// Person schema for author page - critical for E-A-T
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${company.site.url}/author/ankit-patel/#person`,
  name: 'Ankit Patel',
  givenName: 'Ankit',
  familyName: 'Patel',
  jobTitle: 'Founder & CEO',
  description: 'Healthcare operations expert with background at Dell and Cleveland Clinic. Lean Six Sigma certified. Co-founder of Classic Vision Care and founder of My Business Care Team.',
  image: `${company.site.url}/images/ankit_headshot_full.webp`,
  url: `${company.site.url}/author/ankit-patel/`,
  sameAs: [
    'https://www.linkedin.com/in/ankitpatelcvc/',
    company.social.linkedin,
    company.social.facebook
  ],
  worksFor: {
    '@type': 'Organization',
    '@id': `${company.site.url}/#organization`,
    name: company.name
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Case Western Reserve University',
      department: 'Weatherhead School of Management'
    }
  ],
  knowsAbout: [
    'Healthcare Operations',
    'Medical Practice Management',
    'Lean Six Sigma',
    'Patient Acquisition',
    'Optometry Practice Management',
    'Healthcare Call Centers',
    'Virtual Assistants',
    'Organizational Development'
  ],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: 'Master of Positive Organizational Development (MPOD)'
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'certificate',
      name: 'Lean Six Sigma Certification'
    }
  ]
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: company.site.url
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Ankit Patel',
      item: `${company.site.url}/author/ankit-patel/`
    }
  ]
};

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { ...personSchema, '@context': undefined },
    { ...breadcrumbSchema, '@context': undefined }
  ]
};
---

<PageLayout
  title="Ankit Patel | Healthcare Operations Expert | MyBCAT"
  description="Ankit Patel, founder of My Business Care Team & Classic Vision Care. Dell & Cleveland Clinic alum. Lean Six Sigma healthcare operations expert."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Authors' },
    { name: 'Ankit Patel' }
  ]}
>
  <script type="application/ld+json" set:html={serializeSchema(combinedSchema)} slot="head" />

  <div class="author-page">
    <!-- Hero Section -->
    <section class="author-hero">
      <div class="container">
        <div class="author-hero-grid">
          <div class="author-hero-image">
            <img
              src="/images/ankit_headshot_full.webp"
              alt="Ankit Patel - Founder of My Business Care Team"
              width="400"
              height="500"
              loading="eager"
            />
          </div>
          <div class="author-hero-content">
            <div class="eyebrow">Author & Founder</div>
            <h1>Ankit Patel</h1>
            <p class="author-title">Founder & CEO, My Business Care Team</p>
            <p class="author-bio">
              Healthcare operations expert with a background spanning Dell, Cleveland Clinic, and founding his own optometry practice. Ankit brings Lean Six Sigma methodology and organizational development expertise to help healthcare practices capture every patient opportunity.
            </p>

            <div class="author-credentials">
              <span class="credential">Lean Six Sigma Certified</span>
              <span class="credential">Case Western MPOD</span>
              <span class="credential">EO Atlanta Member</span>
            </div>

            <div class="author-social">
              <a href="https://www.linkedin.com/in/ankitpatelcvc/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile" class="social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                <span>Connect on LinkedIn</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Expertise Section -->
    <section class="expertise-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">Areas of Expertise</div>
          <h2>What I Write About</h2>
        </div>

        <div class="expertise-grid">
          <div class="expertise-item">
            <div class="expertise-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <h3>Patient Acquisition</h3>
            <p>Strategies for capturing every patient opportunity through better call handling and scheduling.</p>
          </div>
          <div class="expertise-item">
            <div class="expertise-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3>Healthcare Operations</h3>
            <p>Lean Six Sigma principles applied to medical practice workflows and team efficiency.</p>
          </div>
          <div class="expertise-item">
            <div class="expertise-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <h3>Practice Management</h3>
            <p>Building systems that reduce no-shows, improve recall rates, and maximize revenue per patient.</p>
          </div>
          <div class="expertise-item">
            <div class="expertise-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </div>
            <h3>Scaling Multi-Location Practices</h3>
            <p>Operational blueprints for growing from single to multi-location healthcare groups.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Background Section -->
    <section class="background-section">
      <div class="container">
        <div class="background-content">
          <div class="section-header">
            <div class="eyebrow">Background</div>
            <h2>From Corporate to Practice Owner</h2>
          </div>

          <div class="background-text">
            <p>
              My journey to healthcare operations started in unexpected places. At <strong>Dell</strong>, I learned how world-class companies optimize at scale. At <strong>Cleveland Clinic</strong>, I saw firsthand how complex healthcare systems actually operate.
            </p>
            <p>
              I earned my <strong>Lean Six Sigma certification</strong> and completed my <strong>Master of Positive Organizational Development (MPOD)</strong> at Case Western Reserve's Weatherhead School of Management. These frameworks became the foundation for everything I build today.
            </p>
            <p>
              When my wife Dr. Mital Patel and I opened <strong>Classic Vision Care</strong> in Atlanta, I quickly discovered that even the best clinical care fails without solid operations. Missed calls meant lost patients. Staffing chaos meant inconsistent service. That frustration led me to build the systems that became <strong>My Business Care Team</strong>.
            </p>
            <p>
              Today, I split my time between running operations at Classic Vision Care (our real-world testing lab) and helping {company.stats.trustedPractices} healthcare practices implement the same systems that transformed our practice.
            </p>
          </div>

          <div class="background-cta">
            <Button href="/about/">Learn More About MyBCAT</Button>
            <Button href="/contact/" variant="secondary">Let's Talk</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Articles Section -->
    <section class="articles-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">Recent Writing</div>
          <h2>Articles by Ankit</h2>
          <p class="section-description">Practical insights on healthcare operations, patient acquisition, and practice management.</p>
        </div>

        <div class="articles-grid">
          {recentPosts.map((post) => {
            return (
              <a href={`/blog/${post.slug}/`} class="article-card">
                {post.data.featuredImage && (
                  <div class="article-image">
                    <img src={post.data.featuredImage} alt={post.data.title} loading="lazy" />
                  </div>
                )}
                <div class="article-content">
                  <span class="article-category">{post.data.category}</span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
              </a>
            );
          })}
        </div>

        <div class="articles-cta">
          <Button href="/blog/" variant="secondary">View All Articles</Button>
        </div>
      </div>
    </section>

    <!-- Resources Section -->
    <section class="resources-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">More from Ankit</div>
          <h2>Books & Podcast</h2>
        </div>

        <div class="resources-grid">
          <a href="/resources/podcast/" class="resource-card">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>Optometrists Building Empires</h3>
              <p>Weekly podcast on scaling your practice</p>
            </div>
          </a>

          <a href="/resources/book/" class="resource-card">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>The Eye Care Entrepreneur</h3>
              <p>The complete guide to practice management</p>
            </div>
          </a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .author-page {
    padding-bottom: 60px;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 48px;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-description {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  /* Hero Section */
  .author-hero {
    padding: 60px 0 80px;
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
  }

  .author-hero-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
    align-items: center;
  }

  .author-hero-image img {
    width: 100%;
    max-width: 350px;
    height: auto;
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
  }

  .author-hero h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .author-title {
    font-size: 1.25rem;
    color: var(--oceanic-teal);
    font-weight: 600;
    margin-bottom: 20px;
  }

  .author-bio {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .author-credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .credential {
    display: inline-block;
    background: var(--glass-teal);
    color: var(--oceanic-teal);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }

  .author-social {
    display: flex;
    gap: 12px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--glass-navy);
    color: var(--navy-800);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: all 0.2s;
  }

  .social-link:hover {
    background: var(--oceanic-teal);
    color: white;
  }

  /* Expertise Section */
  .expertise-section {
    padding: 80px 0;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .expertise-item {
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 28px;
    text-align: center;
    transition: all 0.2s;
  }

  .expertise-item:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .expertise-icon {
    width: 56px;
    height: 56px;
    background: var(--glass-teal);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    color: var(--oceanic-teal);
  }

  .expertise-item h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .expertise-item p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Background Section */
  .background-section {
    padding: 80px 0;
    background: var(--spatial-glass);
  }

  .background-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .background-text {
    margin-bottom: 32px;
  }

  .background-text p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .background-text strong {
    color: var(--navy-900);
    font-weight: 600;
  }

  .background-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  /* Articles Section */
  .articles-section {
    padding: 80px 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .article-card {
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
  }

  .article-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .article-image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .article-card:hover .article-image img {
    transform: scale(1.05);
  }

  .article-content {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .article-category {
    display: inline-block;
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
    width: fit-content;
  }

  .article-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.4;
    margin-bottom: 8px;
  }

  .article-content p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-content time {
    font-size: 13px;
    color: var(--text-muted);
  }

  .articles-cta {
    text-align: center;
  }

  /* Resources Section */
  .resources-section {
    padding: 80px 0;
    background: var(--spatial-glass);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 700px;
    margin: 0 auto;
  }

  .resource-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .resource-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .resource-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--oceanic-teal);
    flex-shrink: 0;
  }

  .resource-details h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .resource-details p {
    font-size: 14px;
    color: var(--text-secondary);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .author-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .author-hero-image {
      order: -1;
    }

    .author-hero-image img {
      max-width: 250px;
      margin: 0 auto;
    }

    .author-credentials {
      justify-content: center;
    }

    .author-social {
      justify-content: center;
    }

    .expertise-grid {
      grid-template-columns: 1fr;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .resources-grid {
      grid-template-columns: 1fr;
    }

    .background-cta {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
