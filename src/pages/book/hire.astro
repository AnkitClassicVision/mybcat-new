---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${HIRE_BOOKER}`} />
    <title>Book a hiring interview | MyBCAT</title>
    <link rel="canonical" href="https://mybcat.com/book/hire/" />
    <script is:inline define:vars={{ HIRE_BOOKER }}>
      window.location.replace(HIRE_BOOKER);
    </script>
