---
/**
 * Homepage - Lean landing page linking to separate pages
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Hero from '@/components/sections/Hero.astro';
import Industries from '@/components/sections/Industries.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Stats from '@/components/sections/Stats.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import LogoMarquee from '@/components/sections/LogoMarquee.astro';
// Schema imports removed - BaseLayout handles Organization/WebSite schemas for homepage
import { testimonials } from '@data/testimonials';
import { getFAQsByCategory } from '@data/faq';

// Process steps
const processSteps = [
  {
    step: 1,
    title: 'Discovery Call',
    description: 'We learn your workflows, EHR, and pain points.'
  },
  {
    step: 2,
    title: 'Integration',
    description: 'Connect phone systems and PM/EHR access.'
  },
  {
    step: 3,
    title: 'Go Live',
    description: 'Full team integration in 1-4 weeks.'
  }
];

// Stats - Patient value varies by specialty (optometry ~$2,400, dental ~$3,000+, ENT surgical ~$8,500+)
const stats = [
  { value: '$1,500-$8,500+', label: 'Patient Value Lost Per Missed Call*' },
  { value: '87%', label: 'Callers Hang Up on Voicemail' },
  { value: '40+', label: 'Appointments Recovered Monthly' }
];

// Get general FAQs
const homepageFaqs = getFAQsByCategory('general').slice(0, 5);

// Logo marquee
const clientLogos = [
  { src: '/images/authority/classic-logo.webp', alt: 'Classic Vision Care' },
  { src: '/images/authority/golden-triangle-logo.webp', alt: 'Golden Triangle' },
  { src: '/images/authority/fec_logo.webp', alt: 'FEC' },
  { src: '/images/authority/idoc.webp', alt: 'iDoc' },
  { src: '/images/authority/rlk.webp', alt: 'RLK Vision' },
  { src: '/images/authority/ODonFinance-Logo.webp', alt: 'ODon Finance' },
  { src: '/images/authority/Emerald.webp', alt: 'Emerald Eye Care' },
  { src: '/images/authority/505-logo.webp', alt: '505 Vision' },
  { src: '/images/authority/shelby-logo.webp', alt: 'Shelby Eye Care' },
  { src: '/images/authority/winchester-logo.webp', alt: 'Winchester Eye Care' }
];
---

<BaseLayout
  title="Healthcare Patient Operations | My Business Care Team"
  description="Complete patient operations for healthcare practices. 24/7 answering, scheduling, recall campaigns, and administrative support. HIPAA compliant."
  lcpImage="/videos/final-optimized-landscape.webp"
>
  <!-- Organization + WebSite schemas are added by BaseLayout for homepage -->

  <main id="main-content" class="homepage">
    <!-- Hero Section with Video -->
    <Hero
      title="Centralized Patient Access for Multi-Location Healthcare Groups"
      tagline="One team handles calls, scheduling, and intake across all your locations-patients never know the difference."
      description="From 3 locations to 300, we centralize your patient operations. Direct scheduling into Eyefinity, Dentrix, ModMed, and 50+ systems. Unified reporting. Consistent patient experience. No staffing headaches."
      ctaText="Talk to Enterprise Team"
      ctaHref="/contact/"
      secondaryText="See How It Works"
      secondaryHref="/enterprise/"
      showBrand={true}
      benefits={[
        { icon: 'check', text: 'Pilot 1-2 locations first' },
        { icon: 'chart', text: 'Unified reporting by location' },
        { icon: 'growth', text: 'Rollouts for acquisitions' }
      ]}
      trustItems={[
        { icon: 'shield', text: 'HIPAA Compliant' },
        { icon: 'clock', text: '24/7 Coverage' }
      ]}
      video={{
        poster: '/videos/final-optimized-landscape.webp',
        youtubeId: 'bp_Rx2tENsI',
        author: 'Client Testimonial',
        title: 'See How MyBCAT Transforms Healthcare Practices',
        avatar: '/videos/dittman-headshot-optimized.webp'
      }}
    />

    <!-- Stats Section -->
    <Stats
      stats={stats}
      variant="multi"
      headline="87%"
      headlineColor="gold"
    />

    <!-- Enterprise Callout - Moved above Solutions for enterprise-first positioning -->
    <section class="enterprise-callout">
      <div class="enterprise-content">
        <div class="enterprise-badge">For 3+ Locations</div>
        <h2>Enterprise Patient Access Operations</h2>
        <p>Centralize patient operations across all your locations. One team, consistent experience, unified reporting by location.</p>
        <div class="enterprise-features">
          <div class="enterprise-feature">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Pilot 1-2 Locations First</span>
          </div>
          <div class="enterprise-feature">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>50+ EHR Integrations</span>
          </div>
          <div class="enterprise-feature">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Rollouts for Acquisitions</span>
          </div>
        </div>
        <div class="enterprise-ctas">
          <Button href="/contact/" variant="primary">Talk to Enterprise Team</Button>
          <Button href="/enterprise/" variant="secondary">See How It Works</Button>
        </div>
      </div>
      <div class="enterprise-verticals">
        <a href="/enterprise/dso/" class="vertical-link">DSOs & Dental Groups</a>
        <a href="/enterprise/optometry-groups/" class="vertical-link">Optometry Groups</a>
        <a href="/enterprise/veterinary-groups/" class="vertical-link">Veterinary Groups</a>
        <a href="/enterprise/urgent-care-chains/" class="vertical-link">Urgent Care Chains</a>
      </div>
    </section>

    <!-- Key Links for Enterprise Buyers -->
    <section class="enterprise-links">
      <div class="links-row">
        <a href="/enterprise/" class="key-link">Enterprise Solutions</a>
        <a href="/hipaa-compliance/" class="key-link">HIPAA Compliance</a>
        <a href="/solutions/integrations/" class="key-link">EHR Integrations</a>
        <a href="/case-studies/dittman-eye-care/" class="key-link">Case Study: 5-Location Group</a>
      </div>
    </section>

    <!-- Solutions Overview -->
    <section class="solutions-overview">
      <div class="section-intro">
        <div class="eyebrow">What We Do</div>
        <h2>Complete Patient Operations</h2>
        <p class="subtitle">From answering calls to managing your schedule, we handle it all.</p>
      </div>
      <div class="solutions-grid">
        <a href="/solutions/medical-answering-service/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3>Medical Answering Service</h3>
          <p>Every call answered in 3 rings. Direct scheduling into your EHR, 24/7.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/patient-recall/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          </div>
          <h3>Patient Recall</h3>
          <p>Bring patients back before they lapse with proactive outreach campaigns.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/no-show-recovery/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <h3>No-Show Recovery</h3>
          <p>Fill cancelled slots fast with waitlist management and same-day outreach.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/front-desk-outsourcing/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3>Front Desk Outsourcing</h3>
          <p>Complete front desk operations without the hiring headaches.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/virtual-medical-scribe/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          </div>
          <h3>Virtual Medical Scribe</h3>
          <p>Real-time documentation so providers can focus on patients, not notes.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/medical-virtual-assistant/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <h3>Medical Virtual Assistant</h3>
          <p>Dedicated remote staff for insurance, billing, and admin tasks.</p>
          <span class="solution-link">Learn more →</span>
        </a>
      </div>
      <div class="solutions-cta">
        <Button href="/solutions/" variant="secondary">View All Solutions</Button>
      </div>
    </section>

    <!-- Industries -->
    <Industries
      title="Built for Healthcare Specialists"
      eyebrow="Industries We Serve"
      subtitle="We understand your EHR, your insurance workflows, and your patients."
    />

    <!-- How It Works -->
    <ProcessSteps
      steps={processSteps}
      title="Live in Days, Not Months"
      eyebrow="Simple Setup"
    />

    <!-- Social Proof -->
    <Testimonials
      items={testimonials.slice(0, 5)}
      title="Trusted by 70+ Healthcare Professionals"
      eyebrow="Optometry · Dental · Veterinary"
    />
    <div class="testimonials-cta">
      <Button href="/case-studies/" variant="secondary">View Case Studies</Button>
      <div class="case-study-links">
        <a href="/case-studies/classic-vision-care/" class="case-study-link">Classic Vision Care</a>
        <span class="link-separator">|</span>
        <a href="/case-studies/dittman-eye-care/" class="case-study-link">Dittman Eye Care</a>
      </div>
    </div>

    <!-- Logo Marquee -->
    <LogoMarquee
      logos={clientLogos}
      title="Trusted by Leading Healthcare Practices"
    />

    <!-- Why We're Different Section -->
    <section class="different-section">
      <div class="section-intro">
        <div class="eyebrow">Been Burned Before?</div>
        <h2>Why This Is Different From What You've Tried</h2>
        <p class="subtitle">We get it. You've tried outsourcing and it didn't work. Here's why we're not like the others.</p>
      </div>
      <div class="different-grid">
        <div class="different-card problem">
          <div class="card-header">
            <span class="card-icon">✗</span>
            <h3>Cheap Answering Services</h3>
          </div>
          <ul>
            <li>Read scripts, take messages</li>
            <li>No EHR access-patients wait for callbacks</li>
            <li>Generic operators who don't know healthcare</li>
            <li>Patients feel like a number</li>
          </ul>
        </div>
        <div class="different-card problem">
          <div class="card-header">
            <span class="card-icon">✗</span>
            <h3>$10/hr Virtual Assistants</h3>
          </div>
          <ul>
            <li>You train, manage, and replace them</li>
            <li>One person = no backup when they're sick</li>
            <li>You provide all the systems and processes</li>
            <li>High turnover, constant retraining</li>
          </ul>
        </div>
        <div class="different-card solution">
          <div class="card-header">
            <span class="card-icon">✓</span>
            <h3>My Business Care Team</h3>
          </div>
          <ul>
            <li><strong>Book directly into your EHR</strong>-no callbacks needed</li>
            <li><strong>Managed team with backup</strong>-coverage never gaps</li>
            <li><strong>Healthcare-trained</strong>-we know Dentrix, Eyefinity, Cornerstone</li>
            <li><strong>Patients can't tell</strong>-we answer as your practice</li>
          </ul>
          <p class="solution-note">Like hiring a full-time receptionist for less-without the headaches.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <FAQ
      items={homepageFaqs}
      title="Frequently Asked Questions"
      eyebrow="Questions?"
    />
    <div class="faq-cta">
      <Button href="/faq/" variant="secondary">View All FAQs</Button>
    </div>

    <!-- Quick Links Section -->
    <section class="quick-links-section">
      <div class="section-intro">
        <div class="eyebrow">Learn More</div>
        <h2>Explore MyBCAT</h2>
        <p class="subtitle">Everything you need to make an informed decision about your patient operations.</p>
      </div>
      <div class="quick-links-grid">
        <a href="/about/" class="quick-link-card">
          <div class="quick-link-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3>About Us</h3>
          <p>Meet the team behind MyBCAT and learn our story.</p>
          <span class="quick-link-arrow">Learn more</span>
        </a>
        <a href="/pricing/" class="quick-link-card">
          <div class="quick-link-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h3>Pricing</h3>
          <p>Transparent pricing plans for practices of all sizes.</p>
          <span class="quick-link-arrow">View pricing</span>
        </a>
        <a href="/compare/" class="quick-link-card">
          <div class="quick-link-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="9"></rect><path d="M3 16h7v5H3z"></path><path d="M14 16h7v5h-7z"></path></svg>
          </div>
          <h3>Compare Solutions</h3>
          <p>See how we stack up against alternatives.</p>
          <span class="quick-link-arrow">Compare now</span>
        </a>
        <a href="/solutions/integrations/" class="quick-link-card">
          <div class="quick-link-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </div>
          <h3>EHR Integrations</h3>
          <p>50+ EHR and PM system integrations available.</p>
          <span class="quick-link-arrow">View integrations</span>
        </a>
      </div>
    </section>

    <!-- Final CTA -->
    <CTA
      title="Give Your Front Desk the Backup They Deserve"
      description="Stop choosing between the patient in front of you and the one on the phone. Book a discovery call to see how we can capture every call and fill every slot."
      buttonText="Book Your Discovery Call"
      buttonHref="/contact/"
    />
  </main>
</BaseLayout>

<style>
  .homepage {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px 0;
  }

  .section-intro {
    text-align: center;
    padding: 60px 0 20px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-intro h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-intro .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Solutions Overview */
  .solutions-overview {
    padding: 40px 0;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 20px 0;
  }

  .solution-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 32px;
    text-decoration: none;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
  }

  .solution-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .solution-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--oceanic-teal);
  }

  .solution-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .solution-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 16px;
  }

  .solution-link {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .solutions-cta {
    text-align: center;
    padding-top: 20px;
  }

  @media (max-width: 900px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Enterprise Links */
  .enterprise-links {
    padding: 24px 0;
    margin-bottom: 20px;
  }

  .links-row {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .key-link {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--navy-900);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .key-link:hover {
    border-color: var(--oceanic-teal);
    background: var(--glass-teal);
    color: var(--oceanic-teal);
  }

  /* Enterprise Callout */
  .enterprise-callout {
    background: var(--glass-navy);
    border-radius: 24px;
    padding: 48px;
    margin: 40px 0 60px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
  }

  .enterprise-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .enterprise-badge {
    display: inline-block;
    background: var(--oceanic-teal);
    color: white;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .enterprise-content h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .enterprise-content p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
    max-width: 500px;
  }

  .enterprise-features {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .enterprise-feature {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--navy-900);
  }

  .enterprise-feature svg {
    color: var(--oceanic-teal);
  }

  .enterprise-verticals {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vertical-link {
    display: block;
    padding: 12px 20px;
    background: white;
    border-radius: 12px;
    color: var(--navy-900);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s;
    border: 1px solid var(--glass-border);
  }

  .vertical-link:hover {
    border-color: var(--oceanic-teal);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .enterprise-callout {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }

    .enterprise-verticals {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .vertical-link {
      flex: 1 1 calc(50% - 4px);
      min-width: 140px;
    }
  }

  /* Why We're Different Section */
