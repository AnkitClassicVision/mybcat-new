---
/**
 * Homepage - Lean landing page linking to separate pages
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Hero from '@/components/sections/Hero.astro';
import Industries from '@/components/sections/Industries.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Stats from '@/components/sections/Stats.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import LogoMarquee from '@/components/sections/LogoMarquee.astro';
import { generateOrganizationSchema, generateWebSiteSchema, serializeSchema } from '@utils/schema';
import { testimonials } from '@data/testimonials';
import { getFAQsByCategory } from '@data/faq';

// Process steps
const processSteps = [
  {
    step: 1,
    title: 'Discovery Call',
    description: 'We learn your workflows, EHR, and pain points.'
  },
  {
    step: 2,
    title: 'Integration',
    description: 'Connect phone systems and PM/EHR access.'
  },
  {
    step: 3,
    title: 'Go Live',
    description: 'AI-assisted intake in 5 days, full team in 30-60.'
  }
];

// Stats
const stats = [
  { value: '$100K+', label: 'Recoverable Revenue Per Location' },
  { value: '87%', label: 'Callers Abandon Voicemail' },
  { value: '40+', label: 'Appointments Recovered Monthly' }
];

// Get general FAQs
const homepageFaqs = getFAQsByCategory('general').slice(0, 5);

// Logo marquee
const clientLogos = [
  { src: '/images/authority/classic-logo.webp', alt: 'Classic Vision Care' },
  { src: '/images/authority/golden-triangle-logo.webp', alt: 'Golden Triangle' },
  { src: '/images/authority/fec_logo.webp', alt: 'FEC' },
  { src: '/images/authority/idoc.webp', alt: 'iDoc' },
  { src: '/images/authority/rlk.webp', alt: 'RLK Vision' },
  { src: '/images/authority/ODonFinance-Logo.webp', alt: 'ODon Finance' },
  { src: '/images/authority/Emerald.webp', alt: 'Emerald Eye Care' },
  { src: '/images/authority/505-logo.webp', alt: '505 Vision' },
  { src: '/images/authority/shelby-logo.webp', alt: 'Shelby Eye Care' },
  { src: '/images/authority/winchester-logo.webp', alt: 'Winchester Eye Care' }
];
---

<BaseLayout
  title="Healthcare Patient Operations | My Business Care Team"
  description="Complete patient operations for healthcare practices. 24/7 answering, scheduling, recall campaigns, and administrative support. HIPAA compliant."
>
  <script type="application/ld+json" set:html={serializeSchema(generateOrganizationSchema())} slot="head" />
  <script type="application/ld+json" set:html={serializeSchema(generateWebSiteSchema())} slot="head" />

  <main class="homepage">
    <!-- Hero Section with Video -->
    <Hero
      title="Every empty appointment slot costs you $2,400. Let's get your calendar filled."
      tagline="Your Complete Patient Operations Team"
      description="Stop relying on luck to fill your schedule. With 87% of new patients hanging up the moment they reach voicemail, your practice is losing revenue. Our patient operations team captures every call, fills cancelled slots, and brings patients back—increasing your bookings by up to 40% in just 90 days."
      ctaText="Get My Schedule Filled"
      ctaHref="/contact/"
      secondaryText="See how it works"
      secondaryHref="/how-it-works/"
      showBrand={true}
      benefits={[
        { icon: 'workflow', text: 'Fewer missed calls' },
        { icon: 'calendar', text: 'Cleaner schedule' },
        { icon: 'users', text: 'Happier providers' }
      ]}
      trustItems={[
        { icon: 'shield', text: 'HIPAA Compliant' },
        { icon: 'users', text: 'US-Based Coordinators' },
        { icon: 'clock', text: '24/7 Coverage' }
      ]}
      video={{
        poster: '/videos/final-optimized-landscape.webp',
        src: '/videos/dittman-optimized.mp4',
        author: 'Dr. Michael Dittman',
        title: 'Owner, Dittman Eye Care (Multi-Location Optometry)',
        avatar: '/videos/dittman-headshot-optimized.webp'
      }}
    />

    <!-- Stats Section -->
    <Stats
      stats={stats}
      variant="multi"
      headline="87%"
      headlineColor="gold"
    />

    <!-- Solutions Overview -->
    <section class="solutions-overview">
      <div class="section-intro">
        <div class="eyebrow">What We Do</div>
        <h2>Complete Patient Operations</h2>
        <p class="subtitle">From answering calls to managing your schedule, we handle it all.</p>
      </div>
      <div class="solutions-grid">
        <a href="/solutions/medical-answering-service/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3>Medical Answering Service</h3>
          <p>Every call answered in 3 rings. Direct scheduling into your EHR, 24/7.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/patient-recall/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          </div>
          <h3>Patient Recall</h3>
          <p>Bring patients back before they lapse with proactive outreach campaigns.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/no-show-recovery/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <h3>No-Show Recovery</h3>
          <p>Fill cancelled slots fast with waitlist management and same-day outreach.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/front-desk-outsourcing/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h3>Front Desk Outsourcing</h3>
          <p>Complete front desk operations without the hiring headaches.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/virtual-medical-scribe/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          </div>
          <h3>Virtual Medical Scribe</h3>
          <p>Real-time documentation so providers can focus on patients, not notes.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/medical-virtual-assistant/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <h3>Medical Virtual Assistant</h3>
          <p>Dedicated remote staff for insurance, billing, and admin tasks.</p>
          <span class="solution-link">Learn more →</span>
        </a>
      </div>
      <div class="solutions-cta">
        <Button href="/solutions/" variant="secondary">View All Solutions</Button>
      </div>
    </section>

    <!-- Industries -->
    <Industries
      title="Built for Healthcare Specialists"
      eyebrow="Industries We Serve"
      subtitle="We understand your EHR, your insurance workflows, and your patients."
    />

    <!-- Enterprise Callout -->
    <section class="enterprise-callout">
      <div class="enterprise-content">
        <div class="enterprise-badge">Multi-Location</div>
        <h2>Scaling to Multiple Locations?</h2>
        <p>Centralize patient operations across 5, 50, or 500 locations. One team, consistent experience, unified reporting.</p>
        <div class="enterprise-features">
          <div class="enterprise-feature">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Multi-System Integration</span>
          </div>
          <div class="enterprise-feature">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Centralized Reporting</span>
          </div>
          <div class="enterprise-feature">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Scalable Infrastructure</span>
          </div>
        </div>
        <Button href="/enterprise/" variant="primary">Explore Enterprise Solutions</Button>
      </div>
      <div class="enterprise-verticals">
        <a href="/enterprise/dso/" class="vertical-link">DSOs & Dental Groups</a>
        <a href="/enterprise/optometry-groups/" class="vertical-link">Optometry Groups</a>
        <a href="/enterprise/veterinary-groups/" class="vertical-link">Veterinary Groups</a>
        <a href="/enterprise/urgent-care-chains/" class="vertical-link">Urgent Care Chains</a>
      </div>
    </section>

    <!-- How It Works -->
    <ProcessSteps
      steps={processSteps}
      title="Live in Days, Not Months"
      eyebrow="Simple Setup"
    />

    <!-- Social Proof -->
    <Testimonials
      items={testimonials.slice(0, 3)}
      title="Trusted by 70+ Healthcare Professionals"
      eyebrow="Real Results"
    />

    <!-- Logo Marquee -->
    <LogoMarquee
      logos={clientLogos}
      title="Trusted by Leading Healthcare Practices"
    />

    <!-- FAQ -->
    <FAQ
      items={homepageFaqs}
      title="Frequently Asked Questions"
      eyebrow="Questions?"
    />

    <!-- Final CTA -->
    <CTA
      title="Ready to Fill Every Appointment Slot?"
      description="Book a discovery call to see how My Business Care Team can capture the revenue you're leaving on the table."
      buttonText="Book Your Discovery Call"
      buttonHref="/contact/"
    />
  </main>
</BaseLayout>

<style>
  .homepage {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px 0;
  }

  .section-intro {
    text-align: center;
    padding: 60px 0 20px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-intro h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-intro .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Solutions Overview */
  .solutions-overview {
    padding: 40px 0;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 20px 0;
  }

  .solution-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 32px;
    text-decoration: none;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
  }

  .solution-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .solution-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--oceanic-teal);
  }

  .solution-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .solution-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 16px;
  }

  .solution-link {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .solutions-cta {
    text-align: center;
    padding-top: 20px;
  }

  @media (max-width: 900px) {
    .solutions-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Enterprise Callout */
  .enterprise-callout {
    background: var(--glass-navy);
    border-radius: 24px;
    padding: 48px;
    margin: 60px 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
  }

  .enterprise-badge {
    display: inline-block;
    background: var(--oceanic-teal);
    color: white;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .enterprise-content h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .enterprise-content p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
    max-width: 500px;
  }

  .enterprise-features {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }

  .enterprise-feature {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--navy-900);
  }

  .enterprise-feature svg {
    color: var(--oceanic-teal);
  }

  .enterprise-verticals {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vertical-link {
    display: block;
    padding: 12px 20px;
    background: white;
    border-radius: 12px;
    color: var(--navy-900);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s;
    border: 1px solid var(--glass-border);
  }

  .vertical-link:hover {
    border-color: var(--oceanic-teal);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .enterprise-callout {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }

    .enterprise-verticals {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .vertical-link {
      flex: 1 1 calc(50% - 4px);
      min-width: 140px;
    }
  }
</style>
