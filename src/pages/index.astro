---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Filling Optometry, Ophthalmology, Dental, Veterinary Appointment Books | MyBCAT"
  description="My Business Care Team is a done-for-you service that helps fill your appointment books by taking care of all things front desk and proactive outreach to patients."
>
  <main class="bento-container">
    <div class="bento-grid">
      <!-- Placeholder for hero section -->
      <section id="hero" class="spatial-card" style="grid-column: span 6; min-height: 400px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
        <h1 style="text-align: center;">A Full Schedule. Every Hour. Every Day.</h1>
        <p style="text-align: center; max-width: 600px; margin-top: 16px;">
          Site migration in progress. Full content coming soon.
        </p>
        <p style="text-align: center; margin-top: 32px; color: var(--oceanic-teal); font-weight: 600;">
          Phase 1: Project Setup Complete
        </p>
      </section>
    </div>
  </main>
</Base>
