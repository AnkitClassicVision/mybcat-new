---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import HubSpotMeeting from '@/components/HubSpotMeeting.astro';
---

<Base
  title="Filling Optometry, Ophthalmology, Dental, Veterinary Appointment Books | MyBCAT"
  description="My Business Care Team is a done-for-you service that helps fill your appointment books by taking care of all things front desk and proactive outreach to patients."
>
  <main id="main-content" class="bento-container">
    <div class="bento-grid">

      <!-- Hero Section -->
      <section id="hero" class="spatial-hero">
        <div class="spatial-hero-inner">
          <div class="hero-content">
            <!-- Logo and Brand Name -->
            <div class="hero-brand">
              <img src="/images/logo-optimized.webp" alt="MyBCAT Logo" width="54" height="50" loading="eager" fetchpriority="high">
              <div class="hero-brand-text">My Business Care Team</div>
            </div>
            <h1 class="hero-title">A Full Schedule. Every Hour. Every Day.</h1>
            <p class="hero-tagline">
              Every empty appointment slot costs you $2,400. Let's get your calendar filled.
            </p>
            <p class="hero-description">
              Stop relying on luck to fill your schedule. With 87% of new patients hanging up the moment they reach voicemail, your practice is losing revenue to capacity issues, not staff failure. MyBCAT plugs that leak immediately. As your dedicated medical operations partner, we capture every call, text, and referral to increase your bookings by up to 40% in just 90 days.
            </p>
            <div class="hero-benefit-bar">
              <div class="benefit-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="4" height="4" rx="1"></rect>
                  <rect x="10" y="10" width="4" height="4" rx="1"></rect>
                  <rect x="17" y="4" width="4" height="4" rx="1"></rect>
                  <path d="M7 6h3"></path>
                  <path d="M14 12h3"></path>
                  <path d="M7 6l4 4 6-4"></path>
                </svg>
                <span>Fewer missed calls</span>
              </div>
              <div class="benefit-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Cleaner schedule</span>
              </div>
              <div class="benefit-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>Happier providers</span>
              </div>
            </div>
            <div class="hero-cta-group">
              <Button href="#final-cta">Get My Schedule Filled</Button>
              <a href="#differentiation" class="text-link">See how we compare</a>
            </div>
            <!-- Trust Bar -->
            <div class="hero-trust-bar">
              <div class="trust-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--copper-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>HIPAA Compliant</span>
              </div>
              <div class="trust-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--copper-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>US-Based Coordinators</span>
              </div>
              <div class="trust-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--copper-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>24/7 Coverage</span>
              </div>
            </div>
          </div>
          <!-- Hero Video Testimonial -->
          <div class="hero-visual">
            <div class="hero-video-container">
              <!-- Real Results Badge -->
              <div class="real-results-badge">REAL RESULTS</div>

              <!-- Video Player -->
              <video
                id="heroVideo"
                class="hero-video"
                poster="/videos/final-optimized.webp"
                playsinline
                preload="none"
                muted
              >
                <source data-src="/videos/dittman-optimized.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>

              <!-- Video Overlay Gradient -->
              <div class="video-overlay-gradient"></div>

              <!-- Premium Floating Play Button -->
              <div id="videoPlayOverlay" class="video-play-overlay">
                <div class="play-button-container">
                  <div class="play-button-glow"></div>
                  <div class="play-button-ring"></div>
                  <div class="play-button-ring-2"></div>
                  <div id="playButton" class="premium-play-btn">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" style="margin-left: 4px;">
                      <defs>
                        <linearGradient id="playGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" style="stop-color:#006064"/>
                          <stop offset="100%" style="stop-color:#00ACC1"/>
                        </linearGradient>
                      </defs>
                      <path d="M8 5v14l11-7z" fill="url(#playGradient)"/>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Testimonial Info Bar -->
              <div id="videoInfoBar" class="video-info-bar">
                <div class="video-info-content">
                  <img src="/videos/dittman-headshot-optimized.webp" alt="Dr. Michael Dittman" width="44" height="44" class="testimonial-avatar">
                  <div>
                    <div class="testimonial-name">Dr. Michael Dittman</div>
                    <div class="testimonial-title">Owner, Dittman Eye Care (Multi-Location Optometry)</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Who We're For Section -->
      <section id="who-were-for" class="section-intro">
        <div class="section-intro-eyebrow">Is this for you?</div>
        <h2 class="section-intro-title">Built for busy single locations and scaling multi-site groups.</h2>
      </section>

      <!-- Quick Qualifier Cards -->
      <Card variant="testimonial" class="who-card">
        <div class="who-card-content">
          <span class="section-tag">1-3 Locations</span>
          <h3>Do you choose between answering the phone or greeting a patient?</h3>
          <p>Your staff isn't failing-your system is. Let your front desk smile at the patient while we handle the calls in the background.</p>
        </div>
      </Card>

      <Card variant="testimonial" class="who-card">
        <div class="who-card-content">
          <span class="section-tag">3-20 Locations</span>
          <h3>Stuck in the "messy middle" of growth?</h3>
          <p>Scaling past 3 locations without operational chaos is the hardest phase. We provide the operating system that lets you step out of firefighting and into the CEO role.</p>
        </div>
      </Card>

      <!-- The Problem Section -->
      <section id="the-problem" class="section-intro">
        <div class="section-intro-eyebrow">The Uncomfortable Truth</div>
        <h2 class="section-intro-title">87% of New Patients Who Reach Voicemail Will Never Call Back</h2>
        <p class="section-intro-subtitle">It's not your team's fault. It's a capacity problem-and at every location, the cost compounds.</p>
      </section>

      <!-- Problem Cards -->
      <Card variant="feature" class="problem-card">
        <div class="feature-icon teal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--oceanic-teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h3 class="feature-title teal">It's a Capacity Problem, Not a People Problem</h3>
        <p>Your team is forced to choose: answer the phone or greet the patient in front of them. Both suffer. <strong>29% of calls go to voicemail</strong> during busy times.</p>
      </Card>

      <Card variant="feature" class="problem-card">
        <div class="feature-icon teal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--oceanic-teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
          </svg>
        </div>
        <h3 class="feature-title teal">The Hidden Cost</h3>
        <p>At one location: 12 missed calls/day x $2,400 patient lifetime value = <strong>$200,000/year</strong> in unrealized revenue. Running 5 locations? That's <strong>$1 million</strong> walking out the door.</p>
      </Card>

      <Card variant="feature" class="problem-card">
        <div class="feature-icon teal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--oceanic-teal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="20" x2="12" y2="10"/>
            <line x1="18" y1="20" x2="18" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="16"/>
          </svg>
        </div>
        <h3 class="feature-title teal">You Can't Fix What You Can't See</h3>
        <p>Multiple locations without centralized visibility is <strong>chaos by default</strong>. No dashboard shows missed calls. No report tracks conversion by location.</p>
      </Card>

      <!-- Testimonial Quote -->
      <section class="spatial-card quote-card full-width">
        <blockquote>
          "I pulled my call reports and was SHOCKED. We were missing 29% of our calls on one given day. They were just going to voicemail."
        </blockquote>
        <cite>- Beverly Wilburn, Practice Office Manager</cite>
      </section>

      <!-- Before/After Section -->
      <section class="spatial-card before-after-section full-width">
        <h3 class="section-title">Stop This &rarr; Start This</h3>
        <div class="before-after-grid">
          <div class="before-column">
            <h4>Before MyBCAT</h4>
            <ul>
              <li><span class="x-mark">&#10007;</span> Staff forced to choose: phone or patient</li>
              <li><span class="x-mark">&#10007;</span> Voicemail during lunch, busy times, after hours</li>
              <li><span class="x-mark">&#10007;</span> No centralized view of calls across locations</li>
              <li><span class="x-mark">&#10007;</span> 40+ lost appointments per month per location</li>
            </ul>
          </div>
          <div class="after-column">
            <h4>After MyBCAT</h4>
            <ul>
              <li><span class="check-mark">&#10003;</span> Staff focuses 100% on in-office patients</li>
              <li><span class="check-mark">&#10003;</span> Every call answered professionally-24/7</li>
              <li><span class="check-mark">&#10003;</span> Single dashboard tracks every opportunity</li>
              <li><span class="check-mark">&#10003;</span> Capture 40+ appointments previously lost</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- $100K Impact Statement -->
      <section class="spatial-card stat-card full-width">
        <div class="stat-number gold">$100,000+</div>
        <div class="stat-label gold">Annual Revenue Opportunity Per Location</div>
        <p class="stat-description">The average practice has over $100,000 per year in recoverable revenue from unanswered calls. Multi-location groups? Multiply accordingly.</p>
      </section>

      <!-- Differentiation Section -->
      <section id="differentiation" class="section-intro">
        <div class="section-intro-eyebrow">Why Current Solutions Fail</div>
        <h2 class="section-intro-title">Not All "Solutions" Are Created Equal</h2>
      </section>

      <section class="spatial-card comparison-section full-width">
        <div class="comparison-grid">
          <div class="comparison-column">
            <h4>Generic VAs ($8/hr)</h4>
            <ul class="comparison-list negative">
              <li>You train, manage, and replace them</li>
              <li>No healthcare workflow knowledge</li>
              <li>Work solo-no backup</li>
            </ul>
          </div>
          <div class="comparison-column">
            <h4>AI-Only Bots</h4>
            <ul class="comparison-list negative">
              <li>Can't handle complex scheduling</li>
              <li>Frustrate anxious patients</li>
              <li>No insurance verification</li>
            </ul>
          </div>
          <div class="comparison-column highlight">
            <h4>MyBCAT</h4>
            <ul class="comparison-list positive">
              <li>Arrives trained on your workflows</li>
              <li>Managed team with backups</li>
              <li>Full intake + insurance + recalls</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Services Section -->
      <section id="services" class="section-intro">
        <div class="section-intro-eyebrow">What We Actually Do</div>
        <h2 class="section-intro-title">Your Complete Patient Intake OS</h2>
      </section>

      <Card variant="feature" class="service-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <h3 class="card-title">Phone Answering</h3>
        <p class="card-description">Every call answered in 3 rings. New patient inquiries, appointment requests, insurance questions-all handled professionally.</p>
      </Card>

      <Card variant="feature" class="service-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <h3 class="card-title">Appointment Scheduling</h3>
        <p class="card-description">Direct booking into your EHR/PM system. We know your providers' preferences and optimize for utilization.</p>
      </Card>

      <Card variant="feature" class="service-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="card-title">Insurance Verification</h3>
        <p class="card-description">VSP, EyeMed, medical vision-we verify eligibility before appointments so there are no surprises.</p>
      </Card>

      <Card variant="feature" class="service-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </div>
        <h3 class="card-title">Recall Outreach</h3>
        <p class="card-description">Proactive patient reactivation. We work your recall list to bring patients back before they become lapsed.</p>
      </Card>

      <!-- How It Works Section -->
      <section id="how-it-works" class="section-intro">
        <div class="section-intro-eyebrow">Simple Setup</div>
        <h2 class="section-intro-title">Live in Days, Not Months</h2>
      </section>

      <div class="process-steps full-width">
        <div class="process-step">
          <div class="step-number">1</div>
          <h4>Discovery Call</h4>
          <p>We learn your workflows, EHR, and pain points.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h4>Integration</h4>
          <p>Connect phone systems and PM/EHR access.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h4>Go Live</h4>
          <p>AI-assisted intake in 5 days, full team in 30-60.</p>
        </div>
      </div>

      <!-- Proof Section -->
      <section id="proof" class="section-intro">
        <div class="section-intro-eyebrow">Results That Matter</div>
        <h2 class="section-intro-title">Trusted by 70+ Healthcare Professionals</h2>
      </section>

      <Card variant="testimonial">
        <blockquote class="quote">"Honestly it was a godsend. You have taken a process that we struggled with, and once we got the kinks figured out, you just run with it."</blockquote>
        <div class="author">
          <div class="author-avatar">MD</div>
          <div>
            <cite class="author-name">Dr. Michael Dittman</cite>
            <span class="author-title">Owner, Dittman Eye Care (5 locations)</span>
          </div>
        </div>
      </Card>

      <Card variant="testimonial">
        <blockquote class="quote">"The biggest thing I like is your manager. I talk directly to your managing team-they manage the remote staff. That takes it off my plate."</blockquote>
        <div class="author">
          <div class="author-avatar">DB</div>
          <div>
            <cite class="author-name">Dr. Derek Black</cite>
            <span class="author-title">Owner, Multi-Location Practice</span>
          </div>
        </div>
      </Card>

      <Card variant="testimonial">
        <blockquote class="quote">"Patient scheduling improved by 40% and we've never missed a call. 24/7 operations transformed how we operate."</blockquote>
        <div class="author">
          <div class="author-avatar">DP</div>
          <div>
            <cite class="author-name">Dr. Patel</cite>
            <span class="author-title">Owner, Classic Vision Care</span>
          </div>
        </div>
      </Card>

      <!-- Authority Logos -->
      <section class="authority-section full-width">
        <div class="authority-label">Trusted by Leading Healthcare Practices</div>
        <div class="authority-track">
          <!-- First set -->
          <img src="/images/authority/classic-logo.webp" alt="Classic Vision Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/golden-triangle-logo.webp" alt="Golden Triangle" class="authority-logo" loading="lazy">
          <img src="/images/authority/fec_logo.webp" alt="FEC" class="authority-logo" loading="lazy">
          <img src="/images/authority/idoc.webp" alt="iDoc" class="authority-logo" loading="lazy">
          <img src="/images/authority/rlk.webp" alt="RLK Vision" class="authority-logo" loading="lazy">
          <img src="/images/authority/ODonFinance-Logo.webp" alt="ODon Finance" class="authority-logo" loading="lazy">
          <img src="/images/authority/Emerald.webp" alt="Emerald Eye Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/505-logo.webp" alt="505 Vision" class="authority-logo" loading="lazy">
          <img src="/images/authority/shelby-logo.webp" alt="Shelby Eye Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/winchester-logo.webp" alt="Winchester Eye Care" class="authority-logo" loading="lazy">
          <!-- Second set (duplicate for infinite scroll) -->
          <img src="/images/authority/classic-logo.webp" alt="Classic Vision Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/golden-triangle-logo.webp" alt="Golden Triangle" class="authority-logo" loading="lazy">
          <img src="/images/authority/fec_logo.webp" alt="FEC" class="authority-logo" loading="lazy">
          <img src="/images/authority/idoc.webp" alt="iDoc" class="authority-logo" loading="lazy">
          <img src="/images/authority/rlk.webp" alt="RLK Vision" class="authority-logo" loading="lazy">
          <img src="/images/authority/ODonFinance-Logo.webp" alt="ODon Finance" class="authority-logo" loading="lazy">
          <img src="/images/authority/Emerald.webp" alt="Emerald Eye Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/505-logo.webp" alt="505 Vision" class="authority-logo" loading="lazy">
          <img src="/images/authority/shelby-logo.webp" alt="Shelby Eye Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/winchester-logo.webp" alt="Winchester Eye Care" class="authority-logo" loading="lazy">
          <!-- Third set (duplicate for infinite scroll) -->
          <img src="/images/authority/classic-logo.webp" alt="Classic Vision Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/golden-triangle-logo.webp" alt="Golden Triangle" class="authority-logo" loading="lazy">
          <img src="/images/authority/fec_logo.webp" alt="FEC" class="authority-logo" loading="lazy">
          <img src="/images/authority/idoc.webp" alt="iDoc" class="authority-logo" loading="lazy">
          <img src="/images/authority/rlk.webp" alt="RLK Vision" class="authority-logo" loading="lazy">
          <img src="/images/authority/ODonFinance-Logo.webp" alt="ODon Finance" class="authority-logo" loading="lazy">
          <img src="/images/authority/Emerald.webp" alt="Emerald Eye Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/505-logo.webp" alt="505 Vision" class="authority-logo" loading="lazy">
          <img src="/images/authority/shelby-logo.webp" alt="Shelby Eye Care" class="authority-logo" loading="lazy">
          <img src="/images/authority/winchester-logo.webp" alt="Winchester Eye Care" class="authority-logo" loading="lazy">
        </div>
      </section>

      <!-- Pricing Section -->
      <section id="pricing" class="section-intro" style="scroll-margin-top: 100px;">
        <div class="section-intro-eyebrow">Transparent Pricing</div>
        <h2 class="section-intro-title">Plans That Scale With You</h2>
      </section>

      <Card variant="pricing" class="pricing-card">
        <div class="pricing-header">
          <h3>Starter</h3>
          <div class="price">$1,995<span class="price-period">/mo</span></div>
        </div>
        <p class="pricing-description">Perfect for single locations ready to capture every call.</p>
        <ul class="pricing-features">
          <li>All calls answered in 3 rings</li>
          <li>Appointment scheduling</li>
          <li>Insurance verification</li>
          <li>8am-6pm coverage</li>
        </ul>
        <Button href="#final-cta" variant="secondary" size="sm">Get Started</Button>
      </Card>

      <Card variant="pricing" class="pricing-card popular">
        <div class="popular-badge">Most Popular</div>
        <div class="pricing-header">
          <h3>Growth</h3>
          <div class="price">$3,495<span class="price-period">/mo</span></div>
        </div>
        <p class="pricing-description">For practices ready to scale without operational chaos.</p>
        <ul class="pricing-features">
          <li>Everything in Starter</li>
          <li>Extended hours (7am-9pm)</li>
          <li>Recall outreach campaigns</li>
