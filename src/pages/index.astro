---
/**
 * Homepage - Lean landing page linking to separate pages
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import Hero from '@/components/sections/Hero.astro';
import Industries from '@/components/sections/Industries.astro';
import Features from '@/components/sections/Features.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Stats from '@/components/sections/Stats.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import LogoMarquee from '@/components/sections/LogoMarquee.astro';
import { generateOrganizationSchema, generateWebSiteSchema, serializeSchema } from '@utils/schema';
import { testimonials } from '@data/testimonials';
import { getFAQsByCategory } from '@data/faq';

// Homepage services data
const services = [
  {
    icon: 'phone',
    title: 'Phone Answering',
    description: 'Every call answered in 3 rings. New patient inquiries, appointment requests, insurance questions—all handled professionally.'
  },
  {
    icon: 'calendar',
    title: 'Appointment Scheduling',
    description: 'Direct booking into your EHR/PM system. We know your providers\' preferences and optimize for utilization.'
  },
  {
    icon: 'shield',
    title: 'Insurance Verification',
    description: 'VSP, EyeMed, medical vision—we verify eligibility before appointments so there are no surprises.'
  },
  {
    icon: 'refresh',
    title: 'Recall Outreach',
    description: 'Proactive patient reactivation. We work your recall list to bring patients back before they become lapsed.'
  }
];

// Process steps
const processSteps = [
  {
    step: 1,
    title: 'Discovery Call',
    description: 'We learn your workflows, EHR, and pain points.'
  },
  {
    step: 2,
    title: 'Integration',
    description: 'Connect phone systems and PM/EHR access.'
  },
  {
    step: 3,
    title: 'Go Live',
    description: 'AI-assisted intake in 5 days, full team in 30-60.'
  }
];

// Stats
const stats = [
  { value: '$100K+', label: 'Recoverable Revenue Per Location' },
  { value: '87%', label: 'Callers Abandon Voicemail' },
  { value: '40+', label: 'Appointments Recovered Monthly' }
];

// Get general FAQs
const homepageFaqs = getFAQsByCategory('general').slice(0, 5);

// Logo marquee
const clientLogos = [
  { src: '/images/authority/classic-logo.webp', alt: 'Classic Vision Care' },
  { src: '/images/authority/golden-triangle-logo.webp', alt: 'Golden Triangle' },
  { src: '/images/authority/fec_logo.webp', alt: 'FEC' },
  { src: '/images/authority/idoc.webp', alt: 'iDoc' },
  { src: '/images/authority/rlk.webp', alt: 'RLK Vision' },
  { src: '/images/authority/ODonFinance-Logo.webp', alt: 'ODon Finance' },
  { src: '/images/authority/Emerald.webp', alt: 'Emerald Eye Care' },
  { src: '/images/authority/505-logo.webp', alt: '505 Vision' },
  { src: '/images/authority/shelby-logo.webp', alt: 'Shelby Eye Care' },
  { src: '/images/authority/winchester-logo.webp', alt: 'Winchester Eye Care' }
];
---

<BaseLayout
  title="Medical Answering Service & Patient Acquisition Platform | MyBCAT"
  description="24/7 medical answering service that fills your appointment books. HIPAA compliant healthcare coordinators handle calls, scheduling, and patient outreach."
>
  <script type="application/ld+json" set:html={serializeSchema(generateOrganizationSchema())} slot="head" />
  <script type="application/ld+json" set:html={serializeSchema(generateWebSiteSchema())} slot="head" />

  <main class="homepage">
    <!-- Hero Section with Video -->
    <Hero
      title="Medical Answering Service That Fills Your Schedule"
      tagline="Every empty appointment slot costs you $2,400. Let's get your calendar filled."
      description="Stop relying on luck to fill your schedule. With 87% of new patients hanging up the moment they reach voicemail, your practice is losing revenue. Our 24/7 medical answering service captures every call, text, and referral to increase your bookings by up to 40% in just 90 days."
      ctaText="Get My Schedule Filled"
      ctaHref="/contact/"
      secondaryText="See how it works"
      secondaryHref="/solutions/"
      showBrand={true}
      benefits={[
        { icon: 'workflow', text: 'Fewer missed calls' },
        { icon: 'calendar', text: 'Cleaner schedule' },
        { icon: 'users', text: 'Happier providers' }
      ]}
      trustItems={[
        { icon: 'shield', text: 'HIPAA Compliant' },
        { icon: 'users', text: 'US-Based Coordinators' },
        { icon: 'clock', text: '24/7 Coverage' }
      ]}
      video={{
        poster: '/videos/final-optimized-landscape.webp',
        src: '/videos/dittman-optimized.mp4',
        author: 'Dr. Michael Dittman',
        title: 'Owner, Dittman Eye Care (Multi-Location Optometry)',
        avatar: '/videos/dittman-headshot-optimized.webp'
      }}
    />

    <!-- Stats Section -->
    <Stats
      stats={stats}
      variant="multi"
      headline="87%"
      headlineColor="gold"
    />

    <!-- Services/Features -->
    <Features
      features={services}
      title="Your Complete Patient Intake OS"
      eyebrow="What We Do"
      columns={2}
    />

    <!-- Quick Solutions Overview -->
    <section class="solutions-overview">
      <div class="section-intro">
        <div class="eyebrow">Our Solutions</div>
        <h2>Three Ways We Fill Your Schedule</h2>
      </div>
      <div class="solutions-grid">
        <a href="/solutions/medical-answering-service/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3>Medical Answering Service</h3>
          <p>Never miss a call. Every inquiry answered professionally, 24/7.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/patient-recall/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          </div>
          <h3>Patient Recall</h3>
          <p>Bring patients back before they lapse with proactive outreach.</p>
          <span class="solution-link">Learn more →</span>
        </a>
        <a href="/solutions/no-show-recovery/" class="solution-card">
          <div class="solution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <h3>No-Show Recovery</h3>
          <p>Fill cancelled slots fast with waitlist management.</p>
          <span class="solution-link">Learn more →</span>
        </a>
      </div>
      <div class="solutions-cta">
        <Button href="/solutions/" variant="secondary">View All Solutions</Button>
      </div>
    </section>

    <!-- Industries -->
    <Industries
      title="Built for Healthcare Specialists"
      eyebrow="Industries We Serve"
      subtitle="We understand your EHR, your insurance workflows, and your patients."
    />

    <!-- How It Works -->
    <ProcessSteps
      steps={processSteps}
      title="Live in Days, Not Months"
      eyebrow="Simple Setup"
    />

    <!-- Social Proof -->
    <Testimonials
      items={testimonials.slice(0, 3)}
      title="Trusted by 70+ Healthcare Professionals"
      eyebrow="Real Results"
    />

    <!-- Logo Marquee -->
    <LogoMarquee
      logos={clientLogos}
      title="Trusted by Leading Healthcare Practices"
    />

    <!-- Pricing Preview -->
    <section class="pricing-preview">
      <div class="section-intro">
        <div class="eyebrow">Transparent Pricing</div>
        <h2>Plans That Scale With You</h2>
        <p class="subtitle">From single locations to multi-site groups, we have a plan that fits.</p>
      </div>
      <div class="pricing-grid">
        <Card variant="pricing" class="pricing-card">
          <div class="pricing-header">
            <h3>Starter</h3>
            <div class="price">$1,995<span class="price-period">/mo</span></div>
          </div>
          <p class="pricing-description">Perfect for single locations ready to capture every call.</p>
          <ul class="pricing-features">
            <li>All calls answered in 3 rings</li>
            <li>Appointment scheduling</li>
            <li>8am-6pm coverage</li>
          </ul>
        </Card>
        <Card variant="pricing" class="pricing-card popular">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-header">
            <h3>Growth</h3>
            <div class="price">$3,495<span class="price-period">/mo</span></div>
          </div>
          <p class="pricing-description">For practices ready to scale without chaos.</p>
          <ul class="pricing-features">
            <li>Everything in Starter</li>
            <li>Extended hours (7am-9pm)</li>
            <li>Recall outreach campaigns</li>
          </ul>
        </Card>
        <Card variant="pricing" class="pricing-card">
          <div class="pricing-header">
            <h3>Enterprise</h3>
            <div class="price">Custom</div>
          </div>
          <p class="pricing-description">Multi-location groups with complex needs.</p>
          <ul class="pricing-features">
            <li>Everything in Growth</li>
            <li>24/7 coverage</li>
            <li>Centralized dashboard</li>
          </ul>
        </Card>
      </div>
      <div class="pricing-cta">
        <Button href="/pricing/" variant="secondary">See Full Pricing Details</Button>
      </div>
    </section>

    <!-- FAQ -->
    <FAQ
      items={homepageFaqs}
      title="Frequently Asked Questions"
      eyebrow="Questions?"
    />

    <!-- Final CTA -->
    <CTA
      title="Ready to Fill Every Appointment Slot?"
      description="Book a discovery call to see how MyBCAT can capture the revenue you're leaving on the table."
      buttonText="Book Your Discovery Call"
      buttonHref="/contact/"
    />
  </main>
</BaseLayout>

<style>
  .homepage {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px 0;
  }

  .section-intro {
    text-align: center;
    padding: 60px 0 20px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-intro h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-intro .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Solutions Overview */
  .solutions-overview {
    padding: 40px 0;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 20px 0;
  }

  .solution-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 32px;
    text-decoration: none;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
  }

  .solution-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .solution-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: var(--oceanic-teal);
  }

  .solution-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .solution-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: 16px;
  }

  .solution-link {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .solutions-cta {
    text-align: center;
    padding-top: 20px;
  }

  /* Pricing Preview */
  .pricing-preview {
    padding: 40px 0;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 20px 0;
  }

  :global(.pricing-card) {
    text-align: center;
    position: relative;
  }

  :global(.pricing-card.popular) {
    border-color: var(--oceanic-teal);
    box-shadow: 0 8px 32px rgba(0, 96, 100, 0.15);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--oceanic-teal);
    color: white;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .pricing-header h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .price {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--navy-900);
  }

  .price-period {
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .pricing-description {
    font-size: 15px;
    color: var(--text-secondary);
    margin: 16px 0;
  }

  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .pricing-features li {
    padding: 10px 0;
    font-size: 15px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
  }

  .pricing-features li::before {
    content: "✓ ";
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  .pricing-cta {
    text-align: center;
    padding-top: 24px;
  }

  @media (max-width: 900px) {
    .solutions-grid,
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
