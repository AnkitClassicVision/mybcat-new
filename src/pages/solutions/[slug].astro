---
/**
 * Solution Landing Page (Dynamic)
 * Generates pages for each solution we offer
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/Button.astro';
import Features from '@/components/sections/Features.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import { solutions, type Solution } from '@data/solutions';
import { getCaseStudiesBySolution } from '@data/case-studies';
import { faqs } from '@data/faq';
import { testimonials } from '@data/testimonials';
import { generateFAQSchema, serializeSchema } from '@utils/schema';

export function getStaticPaths() {
  return solutions.map(solution => ({
    params: { slug: solution.slug },
    props: { solution }
  }));
}

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;

const metaTitle = `${solution.name} for Healthcare Practices`;

// Get relevant FAQs - prefer solution-specific FAQs if available
const solutionFaqs = solution.extendedContent?.faqs || [];
const generalFaqs = faqs.filter(f => f.category === 'general' || f.category === 'onboarding').slice(0, 4);
const relevantFaqs = solutionFaqs.length > 0 ? solutionFaqs : generalFaqs;

// Generate FAQ schema for service-specific FAQs
const faqSchema = solutionFaqs.length > 0 ? generateFAQSchema(solutionFaqs) : null;

// Icon SVGs for solutions
const icons: Record<string, string> = {
  'medical-answering-service': '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  'patient-recall': '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>',
  'no-show-recovery': '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>',
  'front-desk-outsourcing': '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>',
  'integrations': '<svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>'
};

// Prepare features for Features component
const featuresData = solution.features.map(f => ({
  icon: f.icon,
  title: f.title,
  description: f.description
}));

// Get case studies that use this solution
const relatedCaseStudies = getCaseStudiesBySolution(solution.slug);
---

<LandingLayout
  title={`${metaTitle} | MyBCAT`}
  description={solution.metaDescription}
  serviceName={solution.name}
  serviceDescription={solution.description}
  serviceType={solution.serviceType}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Solutions', url: '/solutions/' },
    { name: solution.name }
  ]}
>
  {/* FAQ Schema for service-specific FAQs */}
  {faqSchema && (
    <script slot="head" type="application/ld+json" set:html={serializeSchema(faqSchema)} />
  )}

  <div class="solution-page">
    <!-- Hero Section -->
    <section class="solution-hero">
      <div class="hero-content">
        <div class="hero-icon">
          <Fragment set:html={icons[solution.slug] || icons['medical-answering-service']} />
        </div>
        <span class="hero-tagline">{solution.tagline}</span>
        <h1>{solution.headline}</h1>
        <p class="tldr"><strong>TL;DR:</strong> {solution.tldr}</p>
        <p class="hero-description">{solution.description}</p>
        <div class="hero-cta">
          <Button href="/contact/">Talk to Enterprise Team</Button>
          <a href="#how-it-works" class="text-link">See how it works</a>
        </div>
      </div>
    </section>

    <!-- Multi-Location Callout -->
    <section class="multi-location-callout">
      <div class="callout-content">
        <div class="callout-badge">For Multi-Location Groups</div>
        <h2>Need This Across Multiple Locations?</h2>
        <p>Centralize {solution.name.toLowerCase()} across all your locations with unified reporting, consistent protocols, and one team that knows your systems.</p>
        <div class="callout-links">
          <a href="/enterprise/" class="callout-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            Enterprise Solutions
          </a>
          <a href="/hipaa-compliance/" class="callout-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            Security & Compliance
          </a>
          <a href="/solutions/integrations/" class="callout-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            50+ EHR Integrations
          </a>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
      <div class="stats-grid">
        {solution.stats.map(stat => (
          <div class="stat-card">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Problem Section -->
    {solution.problem && (
      <section class="problem-section">
        <div class="problem-header">
          <h2>{solution.problem.question}</h2>
        </div>

        <div class="problem-stats">
          {solution.problem.stats.map(stat => (
            <div class="problem-stat">
              <span class="problem-stat-value">{stat.value}</span>
              <span class="problem-stat-label">{stat.label}</span>
            </div>
          ))}
        </div>

        <div class="pain-points">
          <h3>Common Pain Points</h3>
          <ul class="pain-points-list">
            {solution.problem.painPoints.map(point => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Features Section -->
    <section class="features-section">
      <Features
        features={featuresData}
        title="What's Included"
        eyebrow="Features"
        columns={2}
      />
    </section>

    <!-- Benefits Section -->
    <section class="benefits-section">
      <div class="section-header">
        <h2>Why Practices Choose This</h2>
      </div>

      <div class="benefits-grid">
        {solution.benefits.map((benefit, index) => (
          <div class="benefit-item">
            <span class="benefit-number">{index + 1}</span>
            <span>{benefit}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
      <Testimonials
        items={testimonials.slice(0, 4)}
        title="What Practices Are Saying"
        eyebrow="Optometry, Dental & Veterinary"
      />
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="process-section">
      <ProcessSteps
        title="How It Works"
        eyebrow="Simple Process"
        steps={solution.process}
      />
    </section>

    <!-- Extended Content Section (SEO Depth) -->
    {solution.extendedContent && (
      <section class="extended-content">
        <div class="extended-header">
          <span class="eyebrow">Learn More</span>
          <h2>Everything You Need to Know About {solution.name}</h2>
        </div>

        {solution.extendedContent.whatIs && (
          <details class="content-accordion" open>
            <summary>
              <h3>{solution.extendedContent.whatIs.title}</h3>
              <span class="accordion-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="accordion-content" set:html={solution.extendedContent.whatIs.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          </details>
        )}

        {solution.extendedContent.howItWorks && (
          <details class="content-accordion">
            <summary>
              <h3>{solution.extendedContent.howItWorks.title}</h3>
              <span class="accordion-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="accordion-content" set:html={solution.extendedContent.howItWorks.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          </details>
        )}

        {solution.extendedContent.whoItsFor && (
          <details class="content-accordion">
            <summary>
              <h3>{solution.extendedContent.whoItsFor.title}</h3>
              <span class="accordion-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="accordion-content" set:html={solution.extendedContent.whoItsFor.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          </details>
        )}

        {solution.extendedContent.comparison && (
          <details class="content-accordion">
            <summary>
              <h3>{solution.extendedContent.comparison.title}</h3>
              <span class="accordion-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="accordion-content" set:html={solution.extendedContent.comparison.content.split('\n\n').map(p => `<p>${p}</p>`).join('')} />
          </details>
        )}
      </section>
    )}

    <!-- FAQs Section -->
    <section class="faq-section">
      <FAQ
        items={relevantFaqs}
        title={`${solution.name} FAQ`}
        eyebrow="Common Questions"
      
        includeSchema={false}/>
    </section>

    <!-- Case Studies Section -->
    {relatedCaseStudies.length > 0 && (
      <section class="case-studies-section">
        <div class="section-header">
          <span class="eyebrow">Success Stories</span>
          <h2>See It in Action</h2>
          <p>Real practices achieving real results with {solution.name}.</p>
        </div>
        <div class="case-studies-grid">
          {relatedCaseStudies.map(caseStudy => (
            <a href={`/case-studies/${caseStudy.slug}/`} class="case-study-card">
              <span class="case-study-industry">{caseStudy.industry}</span>
              <h3 class="case-study-client">{caseStudy.client}</h3>
              <p class="case-study-title">{caseStudy.title}</p>
              <div class="case-study-metrics">
                {caseStudy.metrics.slice(0, 2).map(metric => (
                  <div class="case-study-metric">
                    <span class="metric-value">{metric.value}</span>
                    <span class="metric-label">{metric.label}</span>
                  </div>
                ))}
              </div>
              <span class="case-study-link">Read case study</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA Section -->
    <section class="cta-section">
      <CTA
        title={`Ready for ${solution.name}?`}
        description="Book a discovery call to learn how we can help your practice."
        buttonText="Schedule a Call"
      />
    </section>

    <!-- Other Solutions -->
    <section class="other-solutions">
      <h3>Other Solutions</h3>
      <div class="solutions-links">
        {solutions.filter(s => s.slug !== solution.slug).map(s => (
          <a href={`/solutions/${s.slug}/`} class="solution-link">
            <span class="link-name">{s.name}</span>
            <span class="link-tagline">{s.tagline}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</LandingLayout>

<style>
  .solution-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Hero */
  .solution-hero {
    text-align: center;
    padding: 60px 0 40px;
  }

  .hero-icon {
    width: 112px;
    height: 112px;
    background: var(--glass-teal);
    border-radius: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    color: var(--oceanic-teal);
  }

  .hero-tagline {
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .solution-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.2;
    margin-bottom: 16px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .tldr {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 650px;
    margin: 0 auto 20px;
    padding: 16px 24px;
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.05) 0%, rgba(0, 96, 100, 0.02) 100%);
    border-left: 3px solid var(--oceanic-teal);
    border-radius: 0 12px 12px 0;
    text-align: left;
  }

  .tldr strong {
    color: var(--oceanic-teal);
    font-weight: 700;
  }

  .hero-description {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .hero-cta {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: center;
  }

  .text-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .text-link:hover {
    color: var(--oceanic-teal);
  }

  /* Multi-Location Callout */
  .multi-location-callout {
    margin-bottom: 60px;
    padding: 32px 40px;
    background: linear-gradient(135deg, var(--navy-900) 0%, #1a3a3d 100%);
    border-radius: 20px;
  }

  .callout-content {
    text-align: center;
  }

  .callout-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    color: var(--oceanic-teal);
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
  }

  .callout-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 12px;
  }

  .callout-content p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 600px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }

  .callout-links {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .callout-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--oceanic-teal);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 10px 20px;
    background: rgba(27, 153, 139, 0.15);
    border: 1px solid rgba(27, 153, 139, 0.3);
    border-radius: 8px;
    transition: all 0.2s;
  }

  .callout-link:hover {
    background: rgba(27, 153, 139, 0.25);
    border-color: var(--oceanic-teal);
  }

  /* Stats */
  .stats-section {
    margin-bottom: 60px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .stat-card {
    text-align: center;
    padding: 32px;
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
  }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Problem Section */
  .problem-section {
    margin-bottom: 60px;
    padding: 48px;
    background: linear-gradient(135deg, rgba(184, 115, 51, 0.05) 0%, rgba(184, 115, 51, 0.02) 100%);
    border: 1px solid var(--glass-copper);
    border-radius: 20px;
  }

  .problem-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .problem-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  .problem-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }

  .problem-stat {
    text-align: center;
    padding: 20px;
    background: white;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
  }

  .problem-stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--copper-600);
    margin-bottom: 4px;
  }

  .problem-stat-label {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .pain-points {
    max-width: 600px;
    margin: 0 auto;
  }

  .pain-points h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 16px;
    text-align: center;
  }

  .pain-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pain-points-list li {
    position: relative;
    padding: 12px 0 12px 28px;
    font-size: 15px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
  }

  .pain-points-list li:last-child {
    border-bottom: none;
  }

  .pain-points-list li::before {
    content: "×";
    position: absolute;
    left: 0;
    color: var(--copper-500);
    font-weight: 700;
    font-size: 1.1rem;
  }

  /* Sections */
  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .section-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  /* Features */
  .features-section {
    margin-bottom: 60px;
  }

  /* Benefits */
  .benefits-section {
    margin-bottom: 60px;
  }

  /* Testimonials */
  .testimonials-section {
    margin-bottom: 60px;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
  }

  .benefit-item {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 20px 24px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .benefit-number {
    width: 32px;
    height: 32px;
    background: var(--oceanic-teal);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
  }

  /* Process */
  .process-section {
    margin-bottom: 60px;
  }

  /* Extended Content / Accordions */
  .extended-content {
    margin-bottom: 60px;
  }

  .extended-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .extended-header .eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 8px;
  }

  .extended-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  .content-accordion {
    margin-bottom: 12px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    overflow: hidden;
    background: white;
  }

  .content-accordion summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.02) 0%, transparent 100%);
    transition: background 0.2s;
  }

  .content-accordion summary::-webkit-details-marker {
    display: none;
  }

  .content-accordion summary:hover {
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.05) 0%, transparent 100%);
  }

  .content-accordion summary h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--navy-900);
    margin: 0;
  }

  .accordion-icon {
    color: var(--oceanic-teal);
    transition: transform 0.3s;
    flex-shrink: 0;
  }

  .content-accordion[open] .accordion-icon {
    transform: rotate(180deg);
  }

  .accordion-content {
    padding: 0 24px 24px;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .accordion-content :global(p) {
    margin-bottom: 1rem;
  }

  .accordion-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .accordion-content :global(strong) {
    color: var(--navy-900);
    font-weight: 600;
  }

