---
/**
 * HIPAA Compliance Page
 * HIPAA compliant answering service information, BAA, and security practices
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import { getFAQsByCategory } from '@data/faq';
---

<PageLayout
  title="HIPAA Compliant Medical Answering Service | MyBCAT"
  description="HIPAA compliant medical answering service with signed BAA, encrypted communications, and US-based leadership. Your patient data security is non-negotiable."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'HIPAA Compliance' }
  ]}
  heroEyebrow="HIPAA Compliant Answering Service"
  heroTitle="HIPAA Compliant Medical Answering Service"
  heroSubtitle="Your patient data security is non-negotiable. We operate under the same strict protocols as US-based healthcare staff with signed BAA agreements."
>
  <div class="security-page">
    <!-- Trust Badges -->
    <section class="trust-badges">
      <div class="badge-grid">
        <div class="trust-badge">
          <div class="badge-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <h3>HIPAA Compliant</h3>
          <p>Full compliance with all HIPAA Privacy and Security Rules</p>
        </div>

        <div class="trust-badge">
          <div class="badge-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <path d="M9 15l2 2 4-4"/>
            </svg>
          </div>
          <h3>BAA Agreement</h3>
          <p>Signed Business Associate Agreement with every client</p>
        </div>

	        <div class="trust-badge">
	          <div class="badge-icon">
	            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
	              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
	            </svg>
	          </div>
	          <h3>Secure Access</h3>
	          <p>Encrypted connections and access controls for patient systems</p>
	        </div>

        <div class="trust-badge">
          <div class="badge-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3>US-Based Leadership</h3>
          <p>US-based leadership + HIPAA-trained global delivery team with healthcare expertise</p>
        </div>
      </div>
    </section>

    <!-- Detailed Security Practices -->
    <section class="practices-section">
      <div class="section-header">
        <h2>How We Protect Your Data</h2>
        <p>Comprehensive security measures at every level</p>
      </div>

      <div class="practices-grid">
        <Card variant="feature" class="practice-card">
          <h3>Access Controls</h3>
          <ul>
            <li>Role-based access matching your in-house protocols</li>
            <li>Individual user accounts with unique credentials</li>
            <li>Multi-factor authentication required</li>
            <li>Access logging and audit trails</li>
            <li>Immediate access revocation when needed</li>
          </ul>
        </Card>

		        <Card variant="feature" class="practice-card">
		          <h3>Data Handling</h3>
		          <ul>
		            <li>Data handling defined in your BAA and implementation plan</li>
		            <li>Encrypted connections to your EMR/PM</li>
		            <li>Secure VPN access when required</li>
		            <li>Regular security assessments</li>
		          </ul>
		        </Card>

        <Card variant="feature" class="practice-card">
          <h3>Team Training</h3>
          <ul>
            <li>HIPAA training for all team members</li>
            <li>Annual compliance recertification</li>
            <li>PHI handling best practices</li>
            <li>Incident response procedures</li>
            <li>Confidentiality agreements signed</li>
          </ul>
        </Card>

        <Card variant="feature" class="practice-card">
          <h3>Communication Security</h3>
          <ul>
            <li>Encrypted phone lines and VoIP</li>
            <li>Secure messaging platforms</li>
            <li>No patient info via unsecured email</li>
            <li>Call recording with secure storage</li>
            <li>Compliant fax and document handling</li>
          </ul>
        </Card>
      </div>
    </section>

    <!-- BAA Information -->
    <section class="baa-section">
      <Card variant="pricing" class="baa-card">
        <div class="baa-content">
          <h2>Business Associate Agreement</h2>
          <p>We sign a comprehensive BAA with every client before any patient information is accessed. This agreement:</p>
          <ul class="baa-list">
            <li>
              <span class="check">&#10003;</span>
              <span>Establishes our obligations as a HIPAA Business Associate</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>Defines permitted uses and disclosures of PHI</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>Requires us to implement appropriate safeguards</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>Mandates breach notification procedures</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>Ensures PHI is returned or destroyed upon termination</span>
            </li>
          </ul>
          <p class="baa-note">The BAA is provided during onboarding and must be executed before service begins.</p>
        </div>
      </Card>
    </section>

    <!-- Enterprise Compliance Section -->
    <section class="enterprise-compliance">
      <div class="section-header">
        <span class="eyebrow">Enterprise Security</span>
        <h2>Enterprise-Grade Compliance Controls</h2>
        <p>Additional security measures for multi-location healthcare groups</p>
      </div>

      <div class="compliance-grid">
        <!-- Access Control Model -->
        <div class="compliance-card" id="access-control">
          <div class="compliance-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h3>Access Control Model</h3>
          <p class="compliance-intro">Role-based access that mirrors your internal security requirements.</p>
          <ul class="compliance-list">
            <li><strong>Location-Level Access:</strong> Agents only access systems for assigned locations</li>
            <li><strong>Role Segregation:</strong> Schedulers, call handlers, and supervisors have different permission levels</li>
            <li><strong>Principle of Least Privilege:</strong> Access limited to minimum required for job function</li>
            <li><strong>Just-In-Time Access:</strong> Temporary elevated access for specific tasks when needed</li>
            <li><strong>Automatic Deprovisioning:</strong> Access revoked within 24 hours of role change or termination</li>
          </ul>
        </div>

        <!-- Audit Logs -->
        <div class="compliance-card" id="audit-logs">
          <div class="compliance-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <h3>Audit Logs</h3>
          <p class="compliance-intro">Complete audit trail for compliance reporting and investigations.</p>
          <ul class="compliance-list">
            <li><strong>User Activity Logging:</strong> All system access, searches, and actions logged with timestamps</li>
            <li><strong>PHI Access Tracking:</strong> Every patient record access logged by user, date, and purpose</li>
            <li><strong>Login/Logout Records:</strong> Authentication events tracked across all systems</li>
            <li><strong>Change Logs:</strong> Modifications to patient data, schedules, and configurations recorded</li>
            <li><strong>Retention:</strong> Audit logs retained for minimum 6 years per HIPAA requirements</li>
          </ul>
        </div>

        <!-- MFA Requirements -->
        <div class="compliance-card" id="mfa">
          <div class="compliance-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              <circle cx="12" cy="16" r="1"/>
            </svg>
          </div>
          <h3>MFA Requirements</h3>
          <p class="compliance-intro">Multi-factor authentication required for all PHI access.</p>
          <ul class="compliance-list">
            <li><strong>Universal MFA:</strong> All team members must authenticate with 2+ factors</li>
            <li><strong>Supported Methods:</strong> Authenticator apps, hardware tokens, SMS backup</li>
            <li><strong>Session Management:</strong> Automatic timeout after 15 minutes of inactivity</li>
            <li><strong>Failed Login Lockout:</strong> Account locked after 5 failed attempts</li>
            <li><strong>Biometric Option:</strong> Fingerprint/facial recognition for workstation access</li>
          </ul>
        </div>

        <!-- Device Policies -->
        <div class="compliance-card" id="device-policies">
          <div class="compliance-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3>Device Policies</h3>
          <p class="compliance-intro">Strict controls on devices that access patient information.</p>
          <ul class="compliance-list">
            <li><strong>Managed Devices Only:</strong> No personal devices access PHI-company-controlled equipment only</li>
            <li><strong>Endpoint Encryption:</strong> Full disk encryption on all workstations</li>
            <li><strong>USB Restrictions:</strong> Removable media blocked on all systems</li>
            <li><strong>Screen Lock:</strong> Automatic screen lock after 2 minutes of inactivity</li>
            <li><strong>Remote Wipe:</strong> Lost or stolen devices can be remotely wiped within hours</li>
          </ul>
        </div>

        <!-- Incident Response -->
        <div class="compliance-card full-width" id="incident-response">
          <div class="compliance-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <h3>Incident Response Procedures</h3>
          <p class="compliance-intro">Documented procedures for identifying, containing, and reporting security incidents.</p>
          <div class="incident-timeline">
            <div class="incident-step">
              <div class="step-number">1</div>
              <div class="step-content">
                <h4>Detection & Identification</h4>
                <p>Automated monitoring alerts + human review to identify potential incidents within minutes</p>
              </div>
            </div>
            <div class="incident-step">
              <div class="step-number">2</div>
              <div class="step-content">
                <h4>Containment</h4>
                <p>Immediate isolation of affected systems, access revocation, and scope assessment</p>
              </div>
            </div>
            <div class="incident-step">
              <div class="step-number">3</div>
              <div class="step-content">
                <h4>Client Notification</h4>
                <p>Affected clients notified within 24 hours of confirmed incident per BAA requirements</p>
              </div>
            </div>
            <div class="incident-step">
              <div class="step-number">4</div>
              <div class="step-content">
                <h4>Remediation & Reporting</h4>
                <p>Root cause analysis, corrective actions, and full incident report provided</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Security FAQs -->
    <section class="faq-section">
      <FAQ
        items={getFAQsByCategory('security')}
        title="Security Questions"
        eyebrow="Common Questions"
      />
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <CTA
        title="Questions About Security?"
        description="We're happy to discuss our security practices in detail and address any concerns."
        buttonText="Talk to Our Team"
      />
    </section>
  </div>
</PageLayout>

<style>
  .security-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .trust-badges {
    margin-bottom: 60px;
  }

  .badge-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .trust-badge {
    text-align: center;
    padding: 32px 20px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
  }

  .badge-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    color: var(--oceanic-teal);
  }

  .trust-badge h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .trust-badge p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .section-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .practices-section {
    margin-bottom: 60px;
  }

  .practices-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  :global(.practice-card) {
    padding: 32px;
  }

  :global(.practice-card) h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--glass-teal);
  }

  :global(.practice-card) ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.practice-card) li {
    padding: 8px 0;
    font-size: 15px;
    color: var(--text-secondary);
    padding-left: 24px;
    position: relative;
  }

  :global(.practice-card) li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  .baa-section {
    margin-bottom: 60px;
  }

  :global(.baa-card) {
    padding: 48px;
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
  }

  .baa-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .baa-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
    text-align: center;
  }

  .baa-content > p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
    text-align: center;
  }

  .baa-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }

  .baa-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 0;
    font-size: 1rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
  }

  .baa-list li:last-child {
    border-bottom: none;
  }

  .baa-list .check {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .baa-note {
    font-size: 14px;
    color: var(--text-muted);
    text-align: center;
    font-style: italic;
  }

  /* Enterprise Compliance Section */
  .enterprise-compliance {
    margin-bottom: 60px;
  }

  .enterprise-compliance .eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .compliance-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .compliance-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 28px;
  }

  .compliance-card.full-width {
    grid-column: 1 / -1;
  }

  .compliance-icon {
    width: 56px;
    height: 56px;
    background: var(--glass-teal);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--oceanic-teal);
  }

  .compliance-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .compliance-intro {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
    line-height: 1.5;
  }

  .compliance-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .compliance-list li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 8px 0;
    border-bottom: 1px solid var(--glass-border);
    line-height: 1.5;
  }

  .compliance-list li:last-child {
    border-bottom: none;
  }

  .compliance-list strong {
    color: var(--navy-900);
  }

  /* Incident Timeline */
  .incident-timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .incident-step {
    text-align: center;
  }

  .step-number {
    width: 36px;
    height: 36px;
    background: var(--oceanic-teal);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 auto 12px;
  }

  .step-content h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 6px;
  }

  .step-content p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .faq-section {
    margin-bottom: 60px;
  }

  .cta-section {
    margin-bottom: 40px;
  }

  @media (max-width: 900px) {
    .compliance-grid {
      grid-template-columns: 1fr;
    }

    .incident-timeline {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .incident-timeline {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .badge-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .practices-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .badge-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
