---
/**
 * Public landing page for the October 2026 multi-practice growth research.
 * Group research only. No named practices. Others stay as P-codes or omitted.
 * No internal scorecard / Sheet 2 / "Ankit only" material.
 * Practice-specific worked-example slides are withheld.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import OptometryAnalysisForm from '@/components/landing/OptometryAnalysisForm.astro';
import OptometryAnalysisDeck from '@/components/landing/OptometryAnalysisDeck.astro';

const title = 'What Drives Growth Across Optometry Practices | MyBCAT';
const description = 'Multi-practice research on what separates growing independent optometry practices. Get a growth plan built for your market.';

const slides = [
  {
    src: '/images/optometry-analysis/slide-01.webp',
    srcMobile: '/images/optometry-analysis/slide-01-800.webp',
    alt: 'Sample: 27 practices profiled as P01 to P27; 21 answered the poll; 19 private independents used for correlations. Self-reported mix: 14 Up, 4 mixed or neutral, 3 Down, 6 comment only.',
  },
  {
    src: '/images/optometry-analysis/slide-02.webp',
    srcMobile: '/images/optometry-analysis/slide-02-800.webp',
    alt: 'Named Spearman correlations: private-only insurance share minus 0.68, median catchment age plus 0.63, web domain rating plus 0.57, myopia-control page plus 0.51, reviews versus peers plus 0.51.',
  },
  {
    src: '/images/optometry-analysis/slide-03.webp',
    srcMobile: '/images/optometry-analysis/slide-03-800.webp',
    alt: 'Partial correlations with the market held: domain rating and myopia care still track growth; Medicare, age 65 plus, and CPI fade.',
  },
  {
    src: '/images/optometry-analysis/slide-04.webp',
    srcMobile: '/images/optometry-analysis/slide-04-800.webp',
    alt: 'Hours, online booking, site speed, dry-eye care, and the Google Book button are noise at n equals 19.',
  },
];

const noiseRows = [
  { factor: 'Evening / Saturday hours', rho: '+0.38 / −0.12', n: '19', p: '.11 / .63', verdict: 'Noise; evenings is closest to a lean. Do not claim hours drive growth.' },
  { factor: 'Online booking', rho: '+0.26', n: '19', p: '.28', verdict: 'Noise; not a growth driver in this data.' },
  { factor: 'Dry-eye service line', rho: '+0.21', n: '19', p: '.39', verdict: 'Noise; do not claim dry eye drives growth.' },
  { factor: 'Google Business Profile Book button', rho: '+0.18', n: '15', p: '.51', verdict: 'Noise; not a growth driver in this data.' },
  { factor: 'Site speed (Lighthouse mobile)', rho: '−0.12', n: '18', p: '.63', verdict: 'Noise.' },
];
---

<LandingLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Optometry Analysis' }
  ]}
>
  <div class="oa-page">
    <section class="oa-hero" aria-labelledby="oa-hero-title">
      <div class="oa-shell oa-hero__grid">
        <div class="oa-hero__copy">
          <p class="oa-eyebrow">Multi-practice growth research · October 2026</p>
          <h1 id="oa-hero-title">What drives growth across a group of optometry practices</h1>
          <p class="oa-lede">
            A public-data study of 19 private independents. Growth follows the market more than the practice. The slides report the group findings, not a single-practice case study.
          </p>
        </div>
        <div id="request-analysis" class="oa-hero__form">
          <OptometryAnalysisForm idPrefix="oa-top" />
        </div>
        <ul class="oa-hero__points">
          <li>Growers sit in older markets with less private-only insurance.</li>
          <li>Reviews and web authority track growth. Hours, online booking, and site speed do not.</li>
          <li>Every finding is a lead, not proof. None of the 64 tests survives correction.</li>
        </ul>
        <p class="oa-source oa-hero__source">Source: ODs on Finance revenue poll (Oct 2026), MyBCAT analysis; directional, n=19 (13 Up / 6 not-Up).</p>
      </div>
    </section>

    <nav class="oa-toc" aria-label="On this page">
      <div class="oa-shell oa-toc__row">
        <a href="#example-deck">The research</a>
        <a href="#covers">What it covers</a>
        <a href="#sample">Sample</a>
        <a href="#findings">Findings</a>
        <a href="#market">Market</a>
        <a href="#custom">Your plan</a>
        <a href="#caveats">How to read it</a>
      </div>
    </nav>

    <OptometryAnalysisDeck slides={slides} />

    <section class="oa-section" id="covers" aria-labelledby="oa-covers-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">What the research covers</p>
        <h2 id="oa-covers-title">A public-data runbook, then 64 fields against a self-reported revenue answer</h2>
        <p class="oa-section__lede">
          For each practice in the group we ran a public-data runbook, then correlated 64 fields with the self-reported answer (Spearman ρ). That group study is what the slides report. We can apply the same market read to your location as a growth plan.
        </p>
        <ul class="oa-cover-grid">
          <li><strong>Google profile and reviews</strong> Volume, velocity, and reviews versus a frozen set of local competitors.</li>
          <li><strong>Website</strong> Service pages, online booking, and Lighthouse mobile speed.</li>
          <li><strong>Web authority</strong> Domain rating from Ahrefs.</li>
          <li><strong>Market</strong> Census ACS age and insurance mix, CDC PLACES, NPPES.</li>
        </ul>
        <p class="oa-note">Answers that said Up: 14 of 21. Action from the findings: read each practice’s market before promising growth, start with a review engine, and run each change as a 90-day pilot with a metric and a kill rule.</p>
      </div>
    </section>

    <section class="oa-section oa-section--alt" id="sample" aria-labelledby="oa-sample-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">The comparison set</p>
        <h2 id="oa-sample-title">We profiled 27 practices from one poll; 19 private independents form the comparison set</h2>
        <p class="oa-section__lede">21 answered the poll; 6 only commented. P14 (low match) and P21 (corporate/retail) are excluded from the correlation set.</p>
        <div class="oa-stat-row" role="list">
          <div class="oa-stat" role="listitem"><strong>27</strong><span>Practices profiled, coded P01–P27</span></div>
          <div class="oa-stat" role="listitem"><strong>21</strong><span>Answered the poll</span></div>
          <div class="oa-stat" role="listitem"><strong>19</strong><span>Private independents used for correlations</span></div>
          <div class="oa-stat" role="listitem"><strong>13 / 6</strong><span>Up / not-Up in the correlation set</span></div>
        </div>
        <p class="oa-source">Source: ODs on Finance revenue poll (Oct 2026), MyBCAT analysis; n=27 profiled, n=19 private independents for correlations; directional.</p>
      </div>
    </section>

    <section class="oa-section" id="findings" aria-labelledby="oa-findings-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">Findings</p>
        <h2 id="oa-findings-title">Growers share an older, less privately insured market first; web authority, myopia care, and reviews come next</h2>
        <p class="oa-section__lede">Spearman ρ with the self-reported revenue answer, private independents (n=19 unless shown). At n=19, |ρ| must reach about 0.46 for p&lt;.05. The named correlations from the deck are private-only insurance share (−0.68), median catchment age (+0.63), web domain rating (+0.57), a myopia-control page (+0.51), reviews vs local peers (+0.51), and local CPI (−0.48).</p>

        <div class="oa-split">
          <article>
            <h3>Once the market is held fixed</h3>
            <p>Partial Spearman ρ, private independents n=19. F1 = older/Medicare market. F2 = privately insured, college-educated.</p>
            <ul class="oa-plain">
              <li><strong>Practice skill holds up.</strong> Domain rating rises to +0.63 and myopia care to +0.56 with both market factors held. Reviews stay +0.47 with both market factors held, and weaken to +0.26 when only age is held.</li>
              <li><strong>Market proxies fade.</strong> Medicare and 65+ fall to +0.18 and +0.13 with age held. CPI falls from −0.48 to −0.10 with private-only share held. Bachelor’s falls to −0.04 with F2 held.</li>
              <li>Competitiveness (PCS) is +0.52 with the market held and +0.29 with age held.</li>
            </ul>
          </article>
          <article>
            <h3>What this means</h3>
            <ul class="oa-plain">
              <li><strong>Market first:</strong> private-only share (−0.68) and median age (+0.63) hold in every leave-one-out and sensitivity check.</li>
              <li><strong>Practice second:</strong> web domain rating, a myopia-control page, and reviews vs peers.</li>
              <li><strong>Leads, not proof:</strong> only 6 private practices are not-Up, so one practice can move a correlation by about 0.1.</li>
            </ul>
          </article>
        </div>
        <p class="oa-source">Source: ODs on Finance revenue poll (Oct 2026), MyBCAT analysis and multivariate analysis (Oct 22, 2026); 64 fields tested, none survive Bonferroni; directional, n=19.</p>
      </div>
    </section>

    <section class="oa-section oa-section--alt" aria-labelledby="oa-noise-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">What does not separate growers</p>
        <h2 id="oa-noise-title">Hours, online booking, site speed, and dry-eye care are noise at n=19</h2>
        <div class="oa-table-wrap">
          <table>
            <caption class="sr-only">Factors that do not separate growers in this sample</caption>
            <thead>
              <tr>
                <th scope="col">Factor</th>
                <th scope="col">ρ with answer</th>
                <th scope="col">n</th>
                <th scope="col">p</th>
                <th scope="col">Verdict</th>
              </tr>
            </thead>
            <tbody>
              {noiseRows.map((row) => (
                <tr>
                  <th scope="row">{row.factor}</th>
                  <td>{row.rho}</td>
                  <td>{row.n}</td>
                  <td>{row.p}</td>
                  <td>{row.verdict}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="oa-note">What this means: noise at n=19. Test these as measured pilots with a kill rule, not as growth promises.</p>
      </div>
    </section>

    <section class="oa-section" id="market" aria-labelledby="oa-market-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">Market cells</p>
        <h2 id="oa-market-title">Only 1 of 7 practices in younger, privately insured markets said Up, against 12 of 12 everywhere else</h2>
        <p class="oa-section__lede">Cells split at median age 37.3 and private-only coverage 61.5%. Dots in the original deck are placed approximately; the cells are what matter.</p>
        <div class="oa-matrix" role="img" aria-label="Four market cells. Younger and privately insured: 1 of 7 Up. Older and privately insured: 2 of 2 Up. Younger and less private-only: 3 of 3 Up. Older and less private-only: 7 of 7 Up.">
          <div class="oa-matrix__axis oa-matrix__axis--y-top">Private-only &gt; 61.5%</div>
          <div class="oa-matrix__axis oa-matrix__axis--y-bottom">Private-only ≤ 61.5%</div>
          <div class="oa-matrix__axis oa-matrix__axis--x-left">Younger market: median age ≤ 37.3</div>
          <div class="oa-matrix__axis oa-matrix__axis--x-right">Older market: median age &gt; 37.3</div>
          <div class="oa-matrix__grid">
            <article class="oa-cell oa-cell--hard">
              <p class="oa-cell__kicker">Younger, privately insured</p>
              <p class="oa-cell__score">1 of 7 Up</p>
              <p>All 6 not-Up practices sit here: growth has to be earned.</p>
            </article>
            <article class="oa-cell oa-cell--tailwind">
              <p class="oa-cell__kicker">Older, privately insured</p>
              <p class="oa-cell__score">2 of 2 Up</p>
              <p>Older market with more private-only coverage.</p>
            </article>
            <article class="oa-cell oa-cell--tailwind">
              <p class="oa-cell__kicker">Younger, less private-only</p>
              <p class="oa-cell__score">3 of 3 Up</p>
              <p>Younger market, but less private-only coverage.</p>
            </article>
            <article class="oa-cell oa-cell--tailwind">
              <p class="oa-cell__kicker">Older, less private-only</p>
              <p class="oa-cell__score">7 of 7 Up</p>
              <p>Largest group: older markets, less private-only coverage.</p>
            </article>
          </div>
        </div>
        <p class="oa-source">Source: ODs on Finance revenue poll (Oct 2026), MyBCAT analysis; cells split at age 37.3 and private-only 61.5%; directional, n=19.</p>
      </div>
    </section>

    <section class="oa-section" id="custom" aria-labelledby="oa-custom-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">A plan for your market</p>
        <h2 id="oa-custom-title">Same research method. Your market. A 90-day pilot, not a growth promise.</h2>
        <ol class="oa-steps">
          <li>
            <b>1</b>
            <h3>Send the practice and website</h3>
            <p>We need a practice name and a public site. Phone and email help us follow up. Do not send patient information.</p>
          </li>
          <li>
            <b>2</b>
            <h3>We run the public-data runbook</h3>
            <p>Google profile and reviews, a frozen local competitor set, website, Ahrefs, NPPES, Census ACS, CDC PLACES, and Lighthouse.</p>
          </li>
          <li>
            <b>3</b>
            <h3>We place the location in the market cells</h3>
            <p>Median age and private-only coverage first. Then reviews, domain rating, and the service lines that still track after the market is held fixed.</p>
          </li>
          <li>
            <b>4</b>
            <h3>Walk it on a discovery call</h3>
            <p>One evidence-backed first play where the data supports it. Judgment pilots elsewhere, each with a metric and a kill rule. Nothing here is a guarantee.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="oa-section oa-section--alt" id="caveats" aria-labelledby="oa-caveats-title">
      <div class="oa-shell">
        <p class="oa-eyebrow">How to read every number</p>
        <h2 id="oa-caveats-title">Directional: a small, self-reported sample in which no single test survives correction</h2>
        <div class="oa-stat-row" role="list">
          <div class="oa-stat" role="listitem"><strong>0 of 64</strong><span>Tests that survive correction</span></div>
          <div class="oa-stat" role="listitem"><strong>14 of 21</strong><span>Answers that said Up</span></div>
          <div class="oa-stat" role="listitem"><strong>11</strong><span>Practices with organic traffic trend data</span></div>
          <div class="oa-stat" role="listitem"><strong>16</strong><span>Practices with reviews vs local peers</span></div>
          <div class="oa-stat" role="listitem"><strong>18</strong><span>Practices with web domain rating</span></div>
          <div class="oa-stat" role="listitem"><strong>19</strong><span>Market and most fields</span></div>
        </div>
        <ol class="oa-caveats">
          <li>Self-reported in a public Facebook thread, so Up is likely over-represented; only 6 private practices are not-Up.</li>
          <li>Leads, not proof: one practice can move ρ by about 0.1. Do not use any number for pricing or guarantees.</li>
          <li>Peer median: ophthalmology groups count as local peers, which inflates it for an OD practice.</li>
        </ol>
        <p class="oa-source">Source: ODs on Finance revenue poll (Oct 2026), MyBCAT analysis; directional, n=19.</p>
      </div>
    </section>

    <section class="oa-final" aria-labelledby="oa-final-title">
      <div class="oa-shell oa-final__grid">
        <div>
          <p class="oa-eyebrow">Next step</p>
          <h2 id="oa-final-title">Get a plan built for your market</h2>
          <p>We will not promise growth from a form. We will place your location in the market cells from this research, name the evidence-backed gap, and set a 90-day pilot.</p>
        </div>
        <OptometryAnalysisForm idPrefix="oa-bottom" />
      </div>
    </section>
  </div>
</LandingLayout>

<script>
  window.MYBCAT_FORM_TOKEN =
    import.meta.env.PUBLIC_CUTOVER_FORMS_TOKEN || import.meta.env.PUBLIC_FORM_INTAKE_TOKEN || window.MYBCAT_FORM_TOKEN || '';
</script>
<script is:inline>
(function () {
  const INTAKE_ENDPOINT = 'https://estate-form-bridge.mybcat-estate.workers.dev';
  const BOOKING_PATH = '/book/discovery/';
  const SOURCE = 'optometry-analysis';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  let started = false;

  function token() {
    return window.MYBCAT_FORM_TOKEN || '';
  }

  function capture(eventName, props) {
    if (window.posthog && typeof window.posthog.capture === 'function') {
      window.posthog.capture(eventName, props);
    }
  }

  function pushDataLayer(eventName, props) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({ event: eventName }, props));
  }

  function normalizeWebsite(raw) {
    let value = String(raw || '').trim();
    if (!value) return '';
    if (!/^https?:\/\//i.test(value)) value = 'https://' + value;
    try {
      const url = new URL(value);
      if (url.protocol !== 'http:' && url.protocol !== 'https:') return '';
      if (!url.hostname || url.hostname.indexOf('.') === -1) return '';
      return url.toString();
    } catch {
      return '';
    }
  }

  function setError(form, name, message) {
    const field = form.elements.namedItem(name);
    const error = form.querySelector('[data-error-for="' + name + '"]');
    if (field && field.setAttribute) field.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (!error) return;
    if (message) {
      error.textContent = message;
      error.hidden = false;
    } else {
      error.textContent = '';
      error.hidden = true;
    }
  }

  function setStatus(form, message, isError) {
    const status = form.querySelector('[data-form-status]');
    if (!status) return;
    if (!message) {
      status.hidden = true;
      status.textContent = '';
      status.classList.remove('is-error');
      return;
    }
    status.hidden = false;
    status.textContent = message;
    status.classList.toggle('is-error', !!isError);
  }

  function validate(form) {
    let ok = true;
    const practiceName = String(form.elements.namedItem('practice_name').value || '').trim();
    const websiteRaw = String(form.elements.namedItem('website').value || '').trim();
    const website = normalizeWebsite(websiteRaw);
    const phone = String(form.elements.namedItem('mobilephone').value || '').trim();
    const email = String(form.elements.namedItem('email').value || '').trim();

    setError(form, 'practice_name', '');
    setError(form, 'website', '');
    setError(form, 'mobilephone', '');
    setError(form, 'email', '');

    if (!practiceName) {
      setError(form, 'practice_name', 'Practice name is required.');
      ok = false;
    }
    if (!websiteRaw) {
      setError(form, 'website', 'Practice website is required.');
      ok = false;
    } else if (!website) {
      setError(form, 'website', 'Enter a valid website URL, such as https://yourpractice.com.');
      ok = false;
    }
    if (phone && phone.replace(/\D/g, '').length < 10) {
      setError(form, 'mobilephone', 'Enter a phone number with at least 10 digits, or leave it blank.');
      ok = false;
    }
    if (email && !EMAIL_RE.test(email)) {
      setError(form, 'email', 'Enter a valid email, or leave it blank.');
      ok = false;
    }

    return {
      ok: ok,
      practiceName: practiceName,
      website: website,
      phone: phone,
      email: email
    };
  }

  function bookingUrl(values) {
    const params = new URLSearchParams();
    if (values.practiceName) params.set('firstName', values.practiceName);
    if (values.email) params.set('email', values.email);
    const qs = params.toString();
    return qs ? BOOKING_PATH + '?' + qs : BOOKING_PATH;
  }

  function setBusy(form, busy) {
    const button = form.querySelector('[type="submit"]');
    form.setAttribute('aria-busy', busy ? 'true' : 'false');
    if (button) {
      button.disabled = busy;
      if (!button.dataset.defaultLabel) button.dataset.defaultLabel = button.textContent || '';
      button.textContent = busy ? 'Sending…' : button.dataset.defaultLabel;
    }
  }

  function submitIntake(values) {
    const fields = [
      { name: 'company', value: values.practiceName },
      { name: 'firstname', value: values.practiceName },
      { name: 'website', value: values.website },
      { name: 'utm_source', value: SOURCE },
      { name: 'requested_meeting', value: 'Discovery' },
      { name: 'message', value: 'Custom optometry analysis request' }
    ];
    if (values.email) fields.push({ name: 'email', value: values.email });
    if (values.phone) fields.push({ name: 'mobilephone', value: values.phone });

    const payload = {
      fields: fields,
      context: {
        pageUri: window.location.href,
        pageName: document.title,
        source: SOURCE
      }
    };

    return fetch(INTAKE_ENDPOINT, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Forms-Token': token()
      },
      body: JSON.stringify(payload)
    }).then(function (res) {
      if (!res.ok) throw new Error('intake_failed');
    });
  }

  function attach(form) {
    form.addEventListener('focusin', function () {
      if (started) return;
      started = true;
      capture('contact_form_started', { source: SOURCE });
      pushDataLayer('form_start', { formName: SOURCE, source: SOURCE });
    });

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      event.stopImmediatePropagation();
      setStatus(form, '');
      const values = validate(form);
      if (!values.ok) {
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      if (!token()) {
        setStatus(form, 'Intake is not available on this preview. Email help@mybcat.com or book a discovery call.', true);
        return;
      }

      setBusy(form, true);
      capture('contact_form_submitted', { source: SOURCE });
      pushDataLayer('form_submit', { formName: SOURCE, source: SOURCE });

      submitIntake(values).then(function () {
        capture('discovery_call_scheduled', { source: SOURCE });
        window.location.assign(bookingUrl(values));
      }).catch(function () {
        setBusy(form, false);
        setStatus(form, 'We could not send your details. Please email help@mybcat.com or try again.', true);
      });
    });
  }

  document.querySelectorAll('[data-optometry-analysis-form]').forEach(attach);
})();
</script>

<style>
  .oa-page {
    color: var(--navy-800);
    background: var(--spatial-bg);
  }

  .oa-shell {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .oa-eyebrow {
    margin: 0 0 10px;
    color: var(--oceanic-teal);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .oa-hero {
    padding: 36px 0 56px;
  }

  .oa-hero__grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 48px 48px;
    align-items: start;
  }

  .oa-hero__points,
  .oa-hero__source {
    grid-column: 1;
  }

  @media (min-width: 901px) {
    .oa-hero__form {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }

  .oa-hero h1 {
    max-width: 22ch;
    margin: 0 0 18px;
    color: var(--navy-900);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .oa-lede,
  .oa-section__lede {
    max-width: 62ch;
    margin: 0 0 20px;
    color: var(--navy-800);
    font-size: 1.1rem;
    line-height: 1.65;
  }

  .oa-hero__points {
    display: grid;
    gap: 10px;
    margin: 0 0 22px;
    padding-left: 20px;
  }

  .oa-source,
  .oa-note {
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .oa-toc {
    position: sticky;
    top: 76px;
    z-index: 5;
    padding: 10px 0;
    background: rgba(244, 246, 248, 0.92);
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    backdrop-filter: blur(10px);
  }

