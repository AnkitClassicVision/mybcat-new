---
/**
 * Public landing page for the October 2026 multi-practice growth research.
 * Group research only. No named practices and no practice codes.
 * Layout matches the iDoc / ODs on Finance lead-gen landings.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/Card.astro';
import OptometryAnalysisForm from '@/components/landing/OptometryAnalysisForm.astro';
import OptometryAnalysisDeck from '@/components/landing/OptometryAnalysisDeck.astro';
import { company } from '@data/company';
import { serializeSchema } from '@utils/schema';

// Primary keyword: "optometry practice growth". Secondary: "how to grow an optometry practice",
// "independent optometry practice", "optometry benchmarks" (Ahrefs US, Oct 2026).
const title = 'What Drives Optometry Practice Growth? 2026 Study | MyBCAT';
const description = 'How to grow an optometry practice: a 2026 study of 19 independents and 64 public data points shows what tracks growth. Get a plan for your market.';
const headline = 'What drives optometry practice growth';
const publishDate = new Date('2026-10-24T00:00:00-04:00');
const modifiedDate = new Date('2026-10-25T00:00:00-04:00');
const ogImage = '/images/optometry-analysis/og-optometry-analysis.jpg';

const slides = [
  {
    src: '/images/optometry-analysis/slide-01-v2.webp',
    srcMobile: '/images/optometry-analysis/slide-01-v2-800.webp',
    alt: 'Sample: 27 practices profiled from one poll; 21 answered (14 Up, 4 mixed or neutral, 3 Down) and 6 only commented. 19 independents form the comparison set: 13 Up, 6 not-Up.',
    textId: 'oa-slide-text-1',
  },
  {
    src: '/images/optometry-analysis/slide-02-v2.webp',
    srcMobile: '/images/optometry-analysis/slide-02-v2-800.webp',
    alt: 'Growers sit in older markets with more Medicare and Medicaid patients. Spearman correlations: employer or individual-plan-only share minus 0.68, median catchment age plus 0.63, Medicare share plus 0.60, web domain rating plus 0.57, myopia-control page plus 0.51, reviews versus peers plus 0.51.',
    textId: 'oa-slide-text-2',
  },
  {
    src: '/images/optometry-analysis/slide-03-v2.webp',
    srcMobile: '/images/optometry-analysis/slide-03-v2-800.webp',
    alt: 'Partial correlations with the market held: domain rating and myopia care still track growth; Medicare, age 65 plus, and CPI fade.',
    textId: 'oa-slide-text-3',
  },
  {
    src: '/images/optometry-analysis/slide-04.webp',
    srcMobile: '/images/optometry-analysis/slide-04-800.webp',
    alt: 'Hours, online booking, site speed, dry-eye care, and the Google Book button are noise at n equals 19.',
    textId: 'oa-slide-text-4',
  },
];

// Crawlable text version of each slide. Short, factual, no practice names.
const slideText = [
  {
    heading: '27 practices profiled; 19 form the comparison set',
    body: '27 practices profiled from one poll. 21 answered: 14 Up, 4 mixed or neutral, 3 Down; 6 only commented. 19 independents are used for correlations (13 Up / 6 not-Up). One low-match and one corporate/retail practice are excluded.',
  },
  {
    heading: 'Growers sit in older markets with more Medicare and Medicaid patients.',
    body: 'Market first: median catchment age (+0.63) and insurance mix (employer or individual-plan share, −0.68). Practice second: web domain rating (+0.57), a myopia-control page (+0.51), and reviews vs local peers (+0.51). Leads, not proof.',
  },
  {
    heading: 'With the market held fixed, web authority and myopia care still track growth',
    body: 'Domain rating rises to +0.63 and myopia care to +0.56 with both market factors held. Medicare and age 65+ fall to +0.18 and +0.13; competitive pressure (CPI) falls from −0.48 to −0.10.',
  },
  {
    heading: 'Hours, online booking, site speed, and dry-eye care are noise at n=19',
    body: 'Evening / Saturday hours +0.38 / −0.12, online booking +0.26, dry-eye care +0.21, Google Book button +0.18, site speed −0.12. Test these as measured pilots, not growth promises.',
  },
];

const pageUrl = `${company.site.url}/optometry-analysis/`;
const orgId = `${company.site.url}/#organization`;
const slideImages = slides.map((slide) => `${company.site.url}${slide.src}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${company.site.url}/#website` },
      about: { '@type': 'Thing', name: 'Optometry practice growth' },
      primaryImageOfPage: { '@id': `${pageUrl}#slide-1` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: { '@id': `${pageUrl}#report` },
      datePublished: publishDate.toISOString(),
      dateModified: modifiedDate.toISOString(),
    },
    {
      '@type': ['Article', 'Report'],
      '@id': `${pageUrl}#report`,
      headline,
      description,
      url: pageUrl,
      inLanguage: 'en-US',
      datePublished: publishDate.toISOString(),
      dateModified: modifiedDate.toISOString(),
      author: { '@id': orgId },
      publisher: { '@id': orgId },
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
      image: slides.map((slide, index) => ({
        '@type': 'ImageObject',
        '@id': `${pageUrl}#slide-${index + 1}`,
        url: slideImages[index],
        contentUrl: slideImages[index],
        width: 1600,
        height: 901,
        caption: slide.alt,
      })),
      keywords: 'optometry practice growth, how to grow an optometry practice, independent optometry practice, optometry benchmarks',
      citation: 'Source: ODs on Finance revenue poll (Oct 2026) plus public data, MyBCAT analysis; directional, n=19 (13 Up / 6 not-Up).',
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'MyBCAT',
      alternateName: company.name,
      url: company.site.url,
      logo: `${company.site.url}/images/logo.webp`,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: company.site.url },
        { '@type': 'ListItem', position: 2, name: 'Optometry', item: `${company.site.url}/industries/optometry/` },
        { '@type': 'ListItem', position: 3, name: 'Optometry practice growth study', item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  publishDate={publishDate}
  modifiedDate={modifiedDate}
  noindex={false}
  disableTracking={false}
  navMode="hidden"
>
  <Fragment slot="head">
    {/* Responsive LCP preload: phones fetch the 800px slide, not both sizes. */}
    <link rel="preload" as="image" type="image/webp" href={slides[0].srcMobile} media="(max-width: 700px)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" href={slides[0].src} media="(min-width: 701px)" fetchpriority="high" />
    <meta property="og:image:alt" content="Optometry practice growth study: growers sit in older markets with more Medicare and Medicaid patients." />
    <meta name="twitter:image:alt" content="Optometry practice growth study: growers sit in older markets with more Medicare and Medicaid patients." />
    <script type="application/ld+json" set:html={serializeSchema(jsonLd)} />
  </Fragment>
  <main id="main-content" class="oa-page">
    <section class="hero" aria-labelledby="oa-hero-title">
      <div class="shell brand-row">
        <a class="brand" href="/" aria-label="MyBCAT home">
          <img src="/images/logo-optimized.webp" alt="" width="48" height="45" />
          <span><strong>MyBCAT</strong><small>My Business Care Team</small></span>
        </a>
        <div class="partner-badge">
          <span>October 2026 research</span>
          <strong>n=19</strong>
        </div>
      </div>

      <div class="shell hero-intro">
        <p class="eyebrow">Multi-practice growth research</p>
        <h1 id="oa-hero-title">What drives optometry practice growth</h1>
        <p class="lead">A study of 19 independent practices and 64 public data points. Growth follows the market more than the practice.</p>
      </div>

      <div class="deck-shell">
        <OptometryAnalysisDeck slides={slides} />
        <p class="oa-plan-jump">
          <a href="#book" data-oa-plan-cta>Get my plan ↓</a>
        </p>
      </div>

      <div class="shell hero-notes">
        <ul class="hero-bullets">
          <li>Growers sit in older markets with more Medicare and Medicaid patients.</li>
          <li>Reviews and web authority track growth. Hours, booking, and site speed do not.</li>
          <li>Every finding is a lead, not proof.</li>
        </ul>
        <p class="source">Source: ODs on Finance revenue poll (Oct 2026) plus public data, MyBCAT analysis; directional, n=19 (13 Up / 6 not-Up).</p>
        <p class="oa-links">
          For members: <a href="/ods-on-finance/">ODs on Finance</a> · <a href="/idoc/">iDoc</a> · <a href="/industries/optometry/">MyBCAT for optometry</a> · <a href="/">MyBCAT home</a>
        </p>
      </div>

      <section class="shell oa-transcript" aria-labelledby="oa-transcript-title">
        <details>
          <summary><h2 id="oa-transcript-title">Read the slide text</h2></summary>
          <ol>
            {slideText.map((item, index) => (
              <li id={`oa-slide-text-${index + 1}`}>
                <h3>Slide {index + 1}: {item.heading}</h3>
                <p>{item.body}</p>
              </li>
            ))}
          </ol>
        </details>
      </section>

      <div id="book" class="shell hero-form">
        <Card variant="pricing" class="form-card">
          <OptometryAnalysisForm idPrefix="oa-top" variant="plain" />
        </Card>
      </div>
    </section>

    <section class="final-cta">
      <div class="shell">
        <h2>Ready to apply this to your market?</h2>
        <a class="cta-button" href="#book">Get a plan built for your market</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  window.MYBCAT_FORM_TOKEN =
    import.meta.env.PUBLIC_CUTOVER_FORMS_TOKEN || import.meta.env.PUBLIC_FORM_INTAKE_TOKEN || window.MYBCAT_FORM_TOKEN || '';
</script>
<script is:inline>
(function () {
  const INTAKE_ENDPOINT = 'https://estate-form-bridge.mybcat-estate.workers.dev';
  const BOOKING_PATH = '/book/discovery/';
  const SOURCE = 'optometry-analysis';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];
  const UTM_STORAGE_KEY = 'mybcat_oa_utm';
  const UTM_UNSAFE = /[^A-Za-z0-9._-]/g;
  let started = false;

  function token() {
    return window.MYBCAT_FORM_TOKEN || '';
  }

  function sanitizeUtm(value) {
    return String(value || '').replace(UTM_UNSAFE, '').slice(0, 100);
  }

  function pickUtms(source) {
    const out = {};
    UTM_KEYS.forEach(function (key) {
      const clean = sanitizeUtm(source && source[key]);
      if (clean) out[key] = clean;
    });
    return out;
  }

  function readUrlUtms() {
    const sp = new URLSearchParams(window.location.search);
    const fromUrl = {};
    UTM_KEYS.forEach(function (key) {
      const clean = sanitizeUtm(sp.get(key));
      if (clean) fromUrl[key] = clean;
    });
    return fromUrl;
  }

  function readStoredUtms() {
    try {
      const parsed = JSON.parse(sessionStorage.getItem(UTM_STORAGE_KEY) || 'null');
      return pickUtms(parsed);
    } catch {
      return {};
    }
  }

  function writeStoredUtms(utms) {
    try {
      sessionStorage.setItem(UTM_STORAGE_KEY, JSON.stringify(utms));
    } catch {
      // sessionStorage can be unavailable; submit still uses in-memory UTMs.
    }
  }

  function resolveUtms() {
    const fromUrl = readUrlUtms();
    if (Object.keys(fromUrl).length) {
      writeStoredUtms(fromUrl);
      if (!fromUrl.utm_source) fromUrl.utm_source = SOURCE;
      return fromUrl;
    }
    const stored = readStoredUtms();
    if (!stored.utm_source) stored.utm_source = SOURCE;
    return stored;
  }

  function applyUtmsToForms(utms) {
    document.querySelectorAll('[data-optometry-analysis-form]').forEach(function (form) {
      UTM_KEYS.forEach(function (key) {
        const input = form.elements.namedItem(key);
        if (input) input.value = utms[key] || '';
      });
    });
  }

  function capture(eventName, props) {
    if (window.posthog && typeof window.posthog.capture === 'function') {
      window.posthog.capture(eventName, props);
    }
  }

  function identify(email) {
    if (email && window.posthog && typeof window.posthog.identify === 'function') {
      window.posthog.identify(email);
    }
  }

  function pushDataLayer(eventName, props) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({ event: eventName }, props));
  }

  function normalizeWebsite(raw) {
    let value = String(raw || '').trim();
    if (!value) return '';
    if (!/^https?:\/\//i.test(value)) value = 'https://' + value;
    try {
      const url = new URL(value);
      if (url.protocol !== 'http:' && url.protocol !== 'https:') return '';
      if (!url.hostname || url.hostname.indexOf('.') === -1) return '';
      return url.toString();
    } catch {
      return '';
    }
  }

  function setError(form, name, message) {
    const field = form.elements.namedItem(name);
    const error = form.querySelector('[data-error-for="' + name + '"]');
    if (field && field.setAttribute) field.setAttribute('aria-invalid', message ? 'true' : 'false');
    if (!error) return;
    if (message) {
      error.textContent = message;
      error.hidden = false;
    } else {
      error.textContent = '';
      error.hidden = true;
    }
  }

  function setStatus(form, message, isError) {
    const status = form.querySelector('[data-form-status]');
    if (!status) return;
    if (!message) {
      status.hidden = true;
      status.textContent = '';
      status.classList.remove('is-error');
      return;
    }
    status.hidden = false;
    status.textContent = message;
    status.classList.toggle('is-error', !!isError);
  }

  function validate(form) {
    let ok = true;
    const practiceName = String(form.elements.namedItem('practice_name').value || '').trim();
    const websiteRaw = String(form.elements.namedItem('website').value || '').trim();
    const website = normalizeWebsite(websiteRaw);
    const phone = String(form.elements.namedItem('mobilephone').value || '').trim();
    const email = String(form.elements.namedItem('email').value || '').trim();

    setError(form, 'practice_name', '');
    setError(form, 'website', '');
    setError(form, 'mobilephone', '');
    setError(form, 'email', '');

    if (!practiceName) {
      setError(form, 'practice_name', 'Practice name is required.');
      ok = false;
    }
    if (!websiteRaw) {
      setError(form, 'website', 'Practice website is required.');
      ok = false;
    } else if (!website) {
      setError(form, 'website', 'Enter a valid website URL, such as https://yourpractice.com.');
      ok = false;
    }
    if (phone && phone.replace(/\D/g, '').length < 10) {
      setError(form, 'mobilephone', 'Enter a phone number with at least 10 digits, or leave it blank.');
      ok = false;
    }
    if (email && !EMAIL_RE.test(email)) {
      setError(form, 'email', 'Enter a valid email, or leave it blank.');
      ok = false;
    }

    return {
      ok: ok,
      practiceName: practiceName,
      website: website,
      phone: phone,
      email: email
    };
  }

  function bookingUrl(values) {
    const params = new URLSearchParams();
    if (values.practiceName) params.set('firstName', values.practiceName);
    if (values.email) params.set('email', values.email);
    const qs = params.toString();
    return qs ? BOOKING_PATH + '?' + qs : BOOKING_PATH;
  }

  function setBusy(form, busy) {
    const button = form.querySelector('[type="submit"]');
    form.setAttribute('aria-busy', busy ? 'true' : 'false');
    if (button) {
      button.disabled = busy;
      if (!button.dataset.defaultLabel) button.dataset.defaultLabel = button.textContent || '';
      button.textContent = busy ? 'Sending…' : button.dataset.defaultLabel;
    }
  }

  function submitIntake(values) {
    const utms = resolveUtms();
    const fields = [
      { name: 'company', value: values.practiceName },
      { name: 'firstname', value: values.practiceName },
      { name: 'website', value: values.website },
      { name: 'requested_meeting', value: 'Discovery' },
      { name: 'message', value: 'Growth plan request: wants a growth plan for their local market (optometry analysis page)' }
    ];
    UTM_KEYS.forEach(function (key) {
      if (utms[key]) fields.push({ name: key, value: utms[key] });
    });
    if (values.email) fields.push({ name: 'email', value: values.email });
    if (values.phone) fields.push({ name: 'mobilephone', value: values.phone });

    const payload = {
      fields: fields,
      context: {
        pageUri: window.location.href,
        pageName: document.title,
        source: SOURCE,
        utm: utms
      }
    };

    return fetch(INTAKE_ENDPOINT, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Forms-Token': token()
      },
      body: JSON.stringify(payload)
    }).then(function (res) {
      if (!res.ok) throw new Error('intake_failed');
    });
  }

  function attach(form) {
    form.addEventListener('focusin', function () {
      if (started) return;
      started = true;
      capture('contact_form_started', { source: SOURCE });
      pushDataLayer('form_start', { formName: SOURCE, source: SOURCE });
    });

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      event.stopImmediatePropagation();
      setStatus(form, '');
      const values = validate(form);
      if (!values.ok) {
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      if (!token()) {
        setStatus(form, 'Intake is not available on this preview. Email help@mybcat.com or book a discovery call.', true);
        return;
      }

      setBusy(form, true);
      capture('contact_form_submitted', { source: SOURCE });
      pushDataLayer('form_submit', { formName: SOURCE, source: SOURCE });

      submitIntake(values).then(function () {
        identify(values.email);
        capture('growth_plan_requested', Object.assign({ source: SOURCE }, resolveUtms()));
        window.location.assign(bookingUrl(values));
      }).catch(function () {
        setBusy(form, false);
        setStatus(form, 'We could not send your details. Please email help@mybcat.com or try again.', true);
      });
    });
  }

  applyUtmsToForms(resolveUtms());
  document.querySelectorAll('[data-optometry-analysis-form]').forEach(attach);
})();
</script>

<style>
  .oa-page {
    color: var(--navy-800);
    background: var(--spatial-bg);
  }

  .shell {
    width: min(1160px, calc(100% - 40px));
    margin-inline: auto;
  }

  .deck-shell {
    width: min(1280px, calc(100% - 40px));
    margin: 0 auto 28px;
  }

  .hero {
    padding: 34px 0 76px;
    color: var(--navy-900);
    background: var(--spatial-bg);
  }

  .brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--navy-900);
    text-decoration: none;
  }

  .brand img {
    width: 48px;
    height: auto;
  }

  .brand span {
    display: grid;
    line-height: 1.15;
  }

  .brand strong {
    font-size: 20px;
  }

  .brand small {
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .partner-badge {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    background: #fff;
    color: var(--navy-800);
    font-size: 12px;
    font-weight: 700;
    box-shadow: var(--shadow);
  }

  .partner-badge strong {
    color: var(--oceanic-teal);
    font-size: 16px;
  }

  .hero-intro {
    margin-bottom: 22px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--oceanic-teal);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0 0 16px;
    color: var(--navy-900);
    font-size: clamp(2.45rem, 5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .lead {
    max-width: 650px;
    margin: 0;
    color: var(--navy-800);
    font-size: 19px;
    line-height: 1.5;
  }

  .oa-plan-jump {
    margin: 10px 0 0;
    text-align: center;
  }

  .oa-plan-jump a {
    color: var(--oceanic-teal);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
  }

  .oa-plan-jump a:hover,
  .oa-plan-jump a:focus-visible {
    text-decoration: underline;
  }

  .hero-notes {
    margin-bottom: 28px;
  }

  .hero-bullets {
    display: grid;
    gap: 8px;
    margin: 0 0 12px;
    padding-left: 20px;
    color: var(--navy-800);
    font-size: 15px;
  }

  .oa-links {
    margin: 8px 0 0;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .oa-links a {
    color: var(--oceanic-teal);
    font-weight: 700;
  }

  .oa-transcript {
    margin-bottom: 28px;
  }

  .oa-transcript summary {
    cursor: pointer;
    color: var(--oceanic-teal);
    font-weight: 800;
  }

  .oa-transcript summary h2 {
    display: inline;
    font-size: 15px;
  }

  .oa-transcript ol {
    display: grid;
    gap: 12px;
    margin: 12px 0 0;
    padding-left: 20px;
    color: var(--navy-800);
    font-size: 14px;
    line-height: 1.5;
  }

  .oa-transcript h3 {
    margin: 0 0 4px;
    font-size: 15px;
  }

  .hero-form {
    width: min(560px, calc(100% - 40px));
    margin-inline: auto;
    scroll-margin-top: 28px;
  }

  .source {
    margin: 0;
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.5;
  }

  :global(.form-card) {
    overflow: hidden;
    color: var(--navy-900);
    text-align: left;
    cursor: default;
    box-shadow: var(--shadow-lg);
  }

  :global(.form-card:hover) {
    transform: none;
    border-color: var(--glass-border);
    box-shadow: var(--shadow-lg);
  }

  .final-cta {
    padding: 72px 0;
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.94), rgba(33, 150, 154, 0.82));
    text-align: center;
  }

  .final-cta h2 {
    margin: 0 0 24px;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.03em;
  }

  .cta-button {
    display: inline-flex;
    justify-content: center;
    padding: 14px 22px;
    border: 0;
    border-radius: 9px;
    background: #fff;
    color: var(--oceanic-teal);
    font: inherit;
    font-weight: 800;
