---
/**
 * Pricing Page
 * Detailed pricing tiers and comparison
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Pricing from '@/components/sections/Pricing.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import Card from '@/components/Card.astro';
import { pricingTiers, allFeatures } from '@data/pricing';
import { getFAQsByCategory } from '@data/faq';
---

<PageLayout
  title="Enterprise Healthcare Pricing | Multi-Location Patient Access | MyBCAT"
  description="Enterprise healthcare pricing for multi-location groups. From $2,500/week base for centralized patient access across all your locations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Pricing' }
  ]}
  heroEyebrow="Enterprise Healthcare Pricing"
  heroTitle="One Investment. Every Location Covered."
  heroSubtitle="Centralized patient access pricing for healthcare groups. No per-location surprises, no per-call charges-just one team handling all your locations."
>
  <div class="pricing-page">
    <!-- Enterprise Callout -->
    <section class="enterprise-callout">
      <div class="enterprise-box">
        <div class="enterprise-badge">Most Groups Start Here</div>
        <h2>Multi-Location Healthcare Groups</h2>
        <p class="enterprise-desc">3+ locations? We centralize your patient access operations across all sites with unified reporting, single-team consistency, and rollout support for acquisitions.</p>
        <div class="enterprise-pricing">
          <span class="price">From $2,500</span>
          <span class="period">/week base</span>
        </div>
        <ul class="enterprise-includes">
          <li><span class="check">&#10003;</span> Pilot 1-2 locations first</li>
          <li><span class="check">&#10003;</span> Unified reporting by location</li>
          <li><span class="check">&#10003;</span> Scale at your pace</li>
          <li><span class="check">&#10003;</span> 30-day pilot available</li>
        </ul>
        <a href="/contact/" class="enterprise-cta">Talk to Enterprise Team</a>
      </div>
    </section>

    <!-- Pricing Tiers -->
    <section class="tiers-section">
      <div class="tiers-header">
        <h2>All Plans</h2>
        <p>From single practices to enterprise groups</p>
      </div>
      <Pricing tiers={pricingTiers} title="" eyebrow="" />
    </section>

    <!-- Feature Comparison Table -->
    <section class="comparison-section">
      <div class="section-header">
        <h2>Compare Plans</h2>
        <p>See what's included in each tier</p>
      </div>

      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th class="feature-col">Feature</th>
              <th>Starter</th>
              <th class="popular">Scale</th>
              <th>Enterprise</th>
            </tr>
          </thead>
          <tbody>
            {allFeatures.map(feature => (
              <tr>
                <td class="feature-name">{feature.name}</td>
                <td>
                  {typeof feature.starter === 'boolean' ? (
                    feature.starter ? (
                      <span class="check">&#10003;</span>
                    ) : (
                      <span class="x">-</span>
                    )
                  ) : (
                    <span class="value">{feature.starter}</span>
                  )}
                </td>
                <td class="popular">
                  {typeof feature.scale === 'boolean' ? (
                    feature.scale ? (
                      <span class="check">&#10003;</span>
                    ) : (
                      <span class="x">-</span>
                    )
                  ) : (
                    <span class="value">{feature.scale}</span>
                  )}
                </td>
                <td>
                  {typeof feature.enterprise === 'boolean' ? (
                    feature.enterprise ? (
                      <span class="check">&#10003;</span>
                    ) : (
                      <span class="x">-</span>
                    )
                  ) : (
                    <span class="value">{feature.enterprise}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Cost Comparison -->
    <section class="comparison-section">
      <div class="section-header">
        <h2>Cheaper Than Hiring. More Effective Than Voicemail.</h2>
        <p>See how we compare to the real alternatives</p>
      </div>
      <div class="cost-comparison">
        <div class="cost-card">
          <h3>Full-Time Receptionist</h3>
          <div class="cost-value">$45,000+<span>/year</span></div>
          <ul class="cost-details">
            <li>Salary, benefits, training</li>
            <li>Sick days = no coverage</li>
            <li>Only 40 hours/week</li>
            <li>You manage, you replace</li>
          </ul>
        </div>
        <div class="cost-card highlight">
          <div class="best-value">Best Value</div>
          <h3>My Business Care Team</h3>
          <div class="cost-value">From $10,500<span>/month</span></div>
          <ul class="cost-details">
            <li>Full managed team, always covered</li>
            <li>Business hours to 24/7 options</li>
            <li>Books directly into your EHR</li>
            <li>We manage everything</li>
          </ul>
          <p class="savings">Replaces 2-3 FTEs across locations</p>
        </div>
        <div class="cost-card">
          <h3>Cheap Answering Service</h3>
          <div class="cost-value">$300<span>/month</span></div>
          <ul class="cost-details">
            <li>Message-taking only</li>
            <li>No EHR booking</li>
            <li>Patients wait for callbacks</li>
            <li>Lost appointments</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ROI Calculator Teaser -->
    <section class="roi-section">
      <Card variant="pricing" class="roi-card">
        <div class="roi-content">
          <h2>Calculate Your ROI</h2>
          <p>The average practice loses $95,000-$150,000 per year to missed calls. Patient lifetime values range from $1,500 (veterinary) to $8,500+ (ENT surgical)-capturing just a few extra appointments pays for the service.</p>
          <div class="roi-example">
            <div class="roi-stat">
              <span class="stat-value">5</span>
              <span class="stat-label">Missed new patients/week</span>
            </div>
            <div class="roi-operator">&times;</div>
            <div class="roi-stat">
              <span class="stat-value">$2,400</span>
              <span class="stat-label">Optometry example*</span>
            </div>
            <div class="roi-operator">=</div>
            <div class="roi-stat highlight">
              <span class="stat-value">$624K</span>
              <span class="stat-label">Lost revenue/year</span>
            </div>
          </div>
          <p class="roi-note">*Patient lifetime values vary: Veterinary ~$1,500 | Dental ~$3,000+ | MedSpa ~$2,500+ | ENT ~$8,500+</p>
        </div>
      </Card>
    </section>

    <!-- Satisfaction Guarantee -->
    <section class="guarantee-section">
      <div class="guarantee-card">
        <div class="guarantee-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
        </div>
        <h2>Our Satisfaction Guarantee</h2>
        <p class="guarantee-text">
          We're confident you'll see results. If you don't see improvement in your call answer rate and appointment bookings within the first 90 days, we'll work with you until you do-at no additional cost.
        </p>
        <div class="guarantee-points">
          <div class="guarantee-point">
            <span class="point-check">✓</span>
            <span>90-day performance commitment</span>
          </div>
          <div class="guarantee-point">
            <span class="point-check">✓</span>
            <span>Month-to-month after initial period</span>
          </div>
          <div class="guarantee-point">
            <span class="point-check">✓</span>
            <span>30-day pilot available for enterprise</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing FAQs -->
    <section class="faq-section">
      <FAQ
        items={getFAQsByCategory('pricing')}
        title="Pricing Questions"
        eyebrow="Common Questions"
      />
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <CTA
        title="Ready to Get Started?"
        description="Book a discovery call to get a custom quote for your practice."
        buttonText="Book Your Call"
      />
    </section>
  </div>
</PageLayout>

<style>
  .pricing-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .enterprise-callout {
    margin-bottom: 60px;
  }

  .enterprise-box {
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.08) 0%, rgba(0, 96, 100, 0.02) 100%);
    border: 2px solid var(--oceanic-teal);
    border-radius: 24px;
    padding: 48px;
    text-align: center;
    position: relative;
  }

  .enterprise-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--oceanic-teal);
    color: white;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 20px;
    border-radius: 999px;
  }

  .enterprise-box h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .enterprise-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 24px;
  }

  .enterprise-pricing {
    margin-bottom: 24px;
  }

  .enterprise-pricing .price {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
  }

  .enterprise-pricing .period {
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .enterprise-includes {
    list-style: none;
    padding: 0;
    margin: 0 auto 28px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 32px;
    max-width: 500px;
  }

  .enterprise-includes li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--navy-900);
    font-weight: 500;
  }

  .enterprise-includes .check {
    color: var(--oceanic-teal);
    font-weight: 700;
  }

  .enterprise-cta {
    display: inline-block;
    padding: 16px 32px;
    background: var(--oceanic-teal);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .enterprise-cta:hover {
    background: var(--navy-900);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 96, 100, 0.3);
  }

  .tiers-section {
    margin-bottom: 60px;
  }

  .tiers-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .tiers-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .tiers-header p {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .comparison-section {
    margin-bottom: 60px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .section-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .comparison-table-wrapper {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 16px 20px;
    text-align: center;
    border-bottom: 1px solid var(--glass-border);
  }

  .comparison-table th {
    background: var(--spatial-glass);
    font-weight: 600;
    font-size: 1rem;
    color: var(--navy-900);
  }

  .comparison-table th.feature-col {
    text-align: left;
    width: 40%;
  }

  .comparison-table th.popular {
    background: rgba(0, 96, 100, 0.1);
    color: var(--oceanic-teal);
  }

  .comparison-table td.popular {
    background: rgba(0, 96, 100, 0.03);
  }

  .feature-name {
    text-align: left;
    font-weight: 500;
    color: var(--navy-900);
  }

  .check {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .x {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .value {
    font-weight: 500;
    color: var(--navy-900);
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .roi-section {
    margin-bottom: 60px;
  }

  :global(.roi-card) {
    padding: 48px;
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
  }

  .roi-content {
    text-align: center;
  }

  .roi-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .roi-content > p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .roi-example {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .roi-stat {
    text-align: center;
  }

  .roi-stat .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy-900);
  }

  .roi-stat .stat-label {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .roi-stat.highlight .stat-value {
    color: var(--revenue-gold);
  }

  .roi-operator {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .roi-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--glass-border);
  }

  /* Guarantee Section */
  .guarantee-section {
    margin-bottom: 60px;
  }

  .guarantee-card {
    text-align: center;
    padding: 48px;
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.08) 0%, rgba(0, 96, 100, 0.02) 100%);
    border: 2px solid var(--oceanic-teal);
    border-radius: 24px;
  }

  .guarantee-icon {
    width: 80px;
    height: 80px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: var(--oceanic-teal);
    box-shadow: 0 4px 20px rgba(0, 96, 100, 0.15);
  }

  .guarantee-card h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .guarantee-text {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .guarantee-points {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .guarantee-point {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--navy-900);
  }

  .point-check {
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  /* Cost Comparison */
  .cost-comparison {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .cost-card {
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 28px;
    text-align: center;
    position: relative;
  }

  .cost-card.highlight {
    border: 2px solid var(--oceanic-teal);
    box-shadow: 0 8px 32px rgba(0, 96, 100, 0.15);
  }

  .best-value {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--oceanic-teal);
    color: white;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 16px;
    border-radius: 999px;
  }

  .cost-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .cost-value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 20px;
  }

  .cost-value span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .cost-card.highlight .cost-value {
    color: var(--oceanic-teal);
  }

  .cost-details {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .cost-details li {
    padding: 8px 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--glass-border);
  }

  .cost-details li:last-child {
    border-bottom: none;
  }

  .savings {
    margin-top: 16px;
    padding: 10px;
    background: rgba(0, 96, 100, 0.08);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--oceanic-teal);
  }

  .faq-section {
    margin-bottom: 60px;
  }

  .cta-section {
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .roi-example {
      flex-direction: column;
      gap: 16px;
    }

    .roi-operator {
      transform: rotate(90deg);
    }

    .cost-comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
