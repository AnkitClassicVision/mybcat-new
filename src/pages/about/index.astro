---
/**
 * About Page
 * Company story, team, and values - consolidated from story.astro
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/sections/CTA.astro';
import { company } from '@data/company';
---

<PageLayout
  title="About Us | Built by a Practice Owner, for Practice Owners | My Business Care Team"
  description="Learn how Ankit Patel built My Business Care Team from his experience running Classic Vision Care. From Dell and Cleveland Clinic to revolutionizing healthcare operations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About' }
  ]}
>
  <div class="about-page">
    <!-- Hero Section -->
    <section class="story-hero">
      <div class="container">
        <div class="story-hero-grid">
          <div class="story-hero-content">
            <div class="eyebrow">Our Story</div>
            <h1>Built by a Practice Owner, for Practice Owners</h1>
            <p class="hero-lead">
              I didn't set out to build a healthcare operations company. I set out to fix my own practice's phone problem. What I discovered was a system that works for any practice facing the same challenges.
            </p>
            <Button href="/contact/">Let's Talk About Your Practice</Button>
          </div>
          <div class="story-hero-image">
            <img src="/images/ankit_headshot_full.webp" alt="Ankit Patel - Founder of My Business Care Team" width="400" height="500" />
            <div class="image-caption">
              <strong>{company.ownership.founder}</strong>
              <span>{company.ownership.founderTitle}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">The Journey</div>
          <h2>From Operations to Ownership to Operations Again</h2>
        </div>

        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Dell & Cleveland Clinic</span>
              <h3>Mastering Lean Six Sigma</h3>
              <p>Cut my teeth on process optimization at two world-class organizations. Learned that every inefficiency has a root cause, and every root cause has a solution.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Classic Vision Care</span>
              <h3>Building the Practice</h3>
              <p>My wife Dr. Mital Patel and I opened Classic Vision Care in Atlanta. Quickly discovered that clinical excellence means nothing if your phone goes unanswered.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">The Breaking Point</span>
              <h3>Facing the Staffing Crisis</h3>
              <p>Hiring was hard. Training was harder. Keeping good people? Nearly impossible. We were growing, but the operational chaos was growing faster.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">The Solution</span>
              <h3>Building the Team</h3>
              <p>Applied Lean Six Sigma to build a remote operations team that could handle intake, scheduling, and admin. Not generic VAs-healthcare-trained professionals who understood our workflows.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Today</span>
              <h3>My Business Care Team</h3>
              <p>Now we bring that same operational infrastructure to practices across the country. {company.stats.trustedPractices} healthcare professionals trust us to run their patient intake. The system that saved our practice is now saving theirs.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="values-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">What We Believe</div>
          <h2>Our Operating Principles</h2>
        </div>

        <div class="values-grid">
          <Card variant="testimonial" class="value-card">
            <h3>Operators, Not Vendors</h3>
            <p>We don't sell software and walk away. We run your operations alongside you. When you win, we win.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Systems Beat Heroics</h3>
            <p>Great people burnout. Great systems scale. We build the latter so your people can thrive.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Healthcare First</h3>
            <p>We only serve healthcare. That focus means we understand your EMR, your insurance, your patients.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Ownership Mentality</h3>
            <p>We treat your practice like our own-because we've been in your shoes. Every decision passes the "would I do this for Classic Vision?" test.</p>
          </Card>
        </div>
      </div>
    </section>

    <!-- Resources Links -->
    <section class="resources-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">Learn More</div>
          <h2>Resources from Our Team</h2>
        </div>

        <div class="resources-grid">
          <a href="/resources/podcast/" class="resource-link">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>Optometry CEO Podcast</h3>
              <p>Insights on growing your practice</p>
            </div>
            <span class="resource-arrow">&rarr;</span>
          </a>

          <a href="/resources/book/" class="resource-link">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>The Eye Care Entrepreneur</h3>
              <p>Ankit's book on practice management</p>
            </div>
            <span class="resource-arrow">&rarr;</span>
          </a>

          <a href="/blog/" class="resource-link">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>Blog</h3>
              <p>Articles on practice optimization</p>
            </div>
            <span class="resource-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-wrapper">
      <CTA
        title="Ready to Talk?"
        description="Let's discuss how the system that worked for Classic Vision Care can work for your practice."
        buttonText="Book a Discovery Call"
      />
    </section>
  </div>
</PageLayout>

<style>
  .about-page {
    padding-bottom: 60px;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  /* Hero Section */
  .story-hero {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 80px 0;
  }

  .story-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
  }

  .story-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .story-hero-image {
    text-align: center;
  }

  .story-hero-image img {
    width: 100%;
    max-width: 400px;
    height: auto;
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    margin-bottom: 16px;
  }

  .image-caption {
    text-align: center;
  }

  .image-caption strong {
    display: block;
    font-size: 1.1rem;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .image-caption span {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Timeline Section */
  .timeline-section {
    padding: 80px 0;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 60px;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--navy-900);
  }

  .timeline {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    padding-left: 40px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--glass-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 48px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -36px;
    top: 4px;
    width: 16px;
    height: 16px;
    background: var(--oceanic-teal);
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 0 0 3px var(--oceanic-teal);
  }

  .timeline-year {
    display: inline-block;
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .timeline-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .timeline-content p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Values Section */
  .values-section {
    padding: 80px 0;
    background: var(--spatial-glass);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  :global(.value-card) {
    padding: 32px;
  }

  :global(.value-card) h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  :global(.value-card) p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Resources Section */
  .resources-section {
    padding: 80px 0;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .resource-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 24px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .resource-link:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .resource-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--oceanic-teal);
  }

  .resource-details h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .resource-details p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .resource-arrow {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 1.25rem;
  }

  /* CTA */
  .cta-wrapper {
    padding: 0 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .story-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .story-hero-image {
      order: -1;
    }

    .story-hero-image img {
      max-width: 280px;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
