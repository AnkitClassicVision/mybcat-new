---
/**
 * About Page
 * Company story, team, and values - consolidated from story.astro
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/sections/CTA.astro';
import { company } from '@data/company';
---

<PageLayout
  title="About Us | Built by a Practice Owner, for Practice Owners | My Business Care Team"
  description="Learn how Ankit Patel built My Business Care Team from his experience running Classic Vision Care. From Dell and Cleveland Clinic to revolutionizing healthcare operations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About' }
  ]}
>
  <div class="about-page">
    <!-- Hero Section -->
    <section class="story-hero">
      <div class="container">
        <div class="story-hero-grid">
          <div class="story-hero-content">
            <div class="eyebrow">Our Story</div>
            <h1>Built by a Practice Owner, for Practice Owners</h1>
            <p class="hero-lead">
              I didn't set out to build a healthcare operations company. I was just trying to keep my own practice from drowning in missed calls and staffing chaos. What started as a survival strategy became a system that's now helping {company.stats.trustedPractices} practices capture every patient opportunity.
            </p>
            <div class="hero-credentials">
              <span class="credential">Lean Six Sigma Certified</span>
              <span class="credential">Case Western MPOD</span>
              <span class="credential">EO Atlanta Member</span>
            </div>
            <Button href="/contact/">Let's Talk About Your Practice</Button>
          </div>
          <div class="story-hero-image">
            <img src="/images/ankit_headshot_full.webp" alt="Ankit Patel - Founder of My Business Care Team" width="400" height="500" />
            <div class="image-caption">
              <strong>{company.ownership.founder}</strong>
              <span>{company.ownership.founderTitle}</span>
            </div>
            <div class="social-links">
              <a href="https://www.linkedin.com/in/ankitpatelcvc/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">The Journey</div>
          <h2>From Operations to Ownership to Operations Again</h2>
        </div>

        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Dell & Cleveland Clinic</span>
              <h3>Learning to Optimize at Scale</h3>
              <p>I spent years at Dell and Cleveland Clinic learning how world-class organizations optimize operations. Earned my Lean Six Sigma certification and discovered a truth that would later save my practice: every inefficiency has a root cause, and every root cause has a solution you can systematize.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Case Western Reserve</span>
              <h3>Studying Organizational Development</h3>
              <p>Completed my Master of Positive Organizational Development (MPOD) at Case Western Reserve. Learned how to build teams that don't just function—they thrive. This foundation shapes how we train and develop every team member today.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Classic Vision Care</span>
              <h3>Opening Our Practice in Atlanta</h3>
              <p>My wife Dr. Mital Patel and I opened Classic Vision Care—a full-service optometry group in Atlanta. We had the clinical excellence. What we didn't have? Enough people to answer the phones while helping patients in-office. Calls went to voicemail. Patients called competitors.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">The Breaking Point</span>
              <h3>Drowning in Staffing Chaos</h3>
              <p>Hiring was brutal. Training took months. Then they'd leave for a dollar more an hour. We were growing locations, but the operational chaos was growing faster. I knew there had to be a better way—so I started looking globally for a solution.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">The Discovery</span>
              <h3>Finding World-Class Talent</h3>
              <p>I discovered educated, English-fluent professionals in the Philippines who saw healthcare administration as a career, not a temp job. Combined with my Lean Six Sigma background, I built a remote operations team that could handle intake, scheduling, insurance verification, and billing—professionals who understood healthcare workflows inside and out.</p>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-year">Today</span>
              <h3>My Business Care Team</h3>
              <p>What saved Classic Vision Care is now saving practices across the country. {company.stats.trustedPractices} healthcare practices trust us to run their patient intake. Classic Vision Care remains our operational laboratory—every system, workflow, and script is tested with real patients before it ever reaches a client. Zero risk for you. Proven results.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="values-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">What We Believe</div>
          <h2>Our Operating Principles</h2>
        </div>

        <div class="values-grid">
          <Card variant="testimonial" class="value-card">
            <h3>Operators, Not Vendors</h3>
            <p>We don't sell software and walk away. We run your operations alongside you. Your goals become our KPIs. When you grow, we grow.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Data-Driven Everything</h3>
            <p>We measure what matters: call answer rates, conversion rates, no-show rates, AR days. You get dashboards, not guesswork. Every decision is backed by numbers.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Healthcare-Only Focus</h3>
            <p>We don't do retail. We don't do restaurants. We only serve healthcare practices. That specialization means we understand your EHR, your insurance workflows, and your patients.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Ownership Mentality</h3>
            <p>We treat your practice like our own—because we've been in your shoes. Every decision passes the "would I do this for Classic Vision Care?" test.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Teams, Not Temps</h3>
            <p>We don't fill positions. We build integrated teams that become an extension of your practice. Your patients never know the difference.</p>
          </Card>
          <Card variant="testimonial" class="value-card">
            <h3>Tested Before Deployed</h3>
            <p>Every workflow, script, and system runs through Classic Vision Care first. Real patients. Real stakes. By the time it reaches you, it's already proven.</p>
          </Card>
        </div>
      </div>
    </section>

    <!-- Resources Links -->
    <section class="resources-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">Learn More</div>
          <h2>Resources from Our Team</h2>
        </div>

        <div class="resources-grid">
          <a href="/resources/podcast/" class="resource-link">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>Optometrists Building Empires</h3>
              <p>Podcast on scaling your practice</p>
            </div>
            <span class="resource-arrow">&rarr;</span>
          </a>

          <a href="/resources/book/" class="resource-link">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>The Eye Care Entrepreneur</h3>
              <p>Ankit's book on practice management</p>
            </div>
            <span class="resource-arrow">&rarr;</span>
          </a>

          <a href="/blog/" class="resource-link">
            <div class="resource-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>
            <div class="resource-details">
              <h3>Blog</h3>
              <p>Articles on practice optimization</p>
            </div>
            <span class="resource-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-wrapper">
      <CTA
        title="Ready to Talk?"
        description="Let's discuss how the system that worked for Classic Vision Care can work for your practice."
        buttonText="Book a Discovery Call"
      />
    </section>
  </div>
</PageLayout>

<style>
  .about-page {
    padding-bottom: 60px;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  /* Hero Section */
  .story-hero {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 80px 0;
  }

  .story-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
  }

  .story-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .hero-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .hero-credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .credential {
    display: inline-block;
    background: var(--glass-teal);
    color: var(--oceanic-teal);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }

  .story-hero-image {
    text-align: center;
  }

  .story-hero-image img {
    width: 100%;
    max-width: 400px;
    height: auto;
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    margin-bottom: 16px;
  }

  .image-caption {
    text-align: center;
  }

  .image-caption strong {
    display: block;
    font-size: 1.1rem;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .image-caption span {
    font-size: 14px;
    color: var(--text-muted);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--glass-navy);
    color: var(--navy-800);
    transition: all 0.2s;
  }

  .social-links a:hover {
    background: var(--oceanic-teal);
    color: white;
  }

  /* Timeline Section */
  .timeline-section {
    padding: 80px 0;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 60px;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--navy-900);
  }

  .timeline {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    padding-left: 40px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--glass-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 48px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -36px;
    top: 4px;
    width: 16px;
    height: 16px;
    background: var(--oceanic-teal);
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 0 0 3px var(--oceanic-teal);
  }

  .timeline-year {
    display: inline-block;
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .timeline-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .timeline-content p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Values Section */
  .values-section {
    padding: 80px 0;
    background: var(--spatial-glass);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  :global(.value-card) {
    padding: 32px;
  }

  :global(.value-card) h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  :global(.value-card) p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Resources Section */
  .resources-section {
    padding: 80px 0;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .resource-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 24px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .resource-link:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .resource-icon {
    width: 64px;
    height: 64px;
    background: var(--glass-teal);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--oceanic-teal);
  }

  .resource-details h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .resource-details p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .resource-arrow {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 1.25rem;
  }

  /* CTA */
  .cta-wrapper {
    padding: 0 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .story-hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .story-hero-image {
      order: -1;
    }

    .story-hero-image img {
      max-width: 280px;
    }

    .hero-credentials {
      justify-content: center;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
