---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---

<Base
  title="Optometrists Building Empires Podcast | MyBCAT"
  description="Weekly conversations with practice owners who are scaling, selling, and succeeding. Hosted by Ankit Patel."
>
  <main class="podcast-page">
    <!-- Hero Section -->
    <section class="podcast-hero">
      <div class="container">
        <div class="podcast-hero-grid">
          <div class="podcast-hero-content">
            <div class="eyebrow">Podcast</div>
            <h1>Optometrists Building Empires</h1>
            <p class="podcast-tagline">Weekly conversations with practice owners who are scaling, selling, and succeeding.</p>
            <p class="hero-lead">
              Real stories from multi-location optometry ownership. The messy, complicated, rewarding reality of scaling a healthcare practice from one location to many.
            </p>
            <div class="podcast-stats">
              <div class="stat">
                <span class="stat-value">50+</span>
                <span class="stat-label">Episodes</span>
              </div>
              <div class="stat">
                <span class="stat-value">Weekly</span>
                <span class="stat-label">New Episodes</span>
              </div>
              <div class="stat">
                <span class="stat-value">5.0</span>
                <span class="stat-label">Rating</span>
              </div>
            </div>
            <div class="podcast-platforms">
              <a href="https://podcasts.apple.com" target="_blank" class="platform-link">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
                Apple Podcasts
              </a>
              <a href="https://spotify.com" target="_blank" class="platform-link">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 14.36c-.19.31-.56.41-.88.22-2.43-1.49-5.49-1.82-9.1-.99-.35.08-.69-.14-.77-.48-.08-.35.14-.69.48-.77 3.95-.91 7.34-.52 10.07 1.14.31.19.41.56.2.88zm1.22-2.7c-.24.39-.75.51-1.14.27-2.78-1.71-7.02-2.21-10.31-1.21-.43.13-.88-.11-1.01-.54-.13-.43.11-.88.54-1.01 3.75-1.14 8.42-.59 11.62 1.35.4.24.52.75.3 1.14zm.1-2.8c-3.33-1.98-8.84-2.16-12.02-1.2-.51.16-1.05-.13-1.21-.64-.16-.51.13-1.05.64-1.21 3.64-1.11 9.69-.89 13.51 1.38.47.28.62.89.34 1.35-.28.47-.89.62-1.26.32z"/></svg>
                Spotify
              </a>
              <a href="https://buildingempires.live" target="_blank" class="platform-link primary">
                Listen Now →
              </a>
            </div>
          </div>
          <div class="podcast-artwork">
            <div class="artwork-wrapper">
              <div class="artwork-placeholder">
                <span>🎙️</span>
                <p>Optometrists<br/>Building<br/>Empires</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Topics Section -->
    <section class="topics-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">What We Cover</div>
          <h2>Topics That Matter to Practice Owners</h2>
        </div>

        <div class="topics-grid">
          <div class="topic-card">
            <div class="topic-icon">📈</div>
            <h3>Scaling Operations</h3>
            <p>Systems and processes for growing from one location to many.</p>
          </div>
          <div class="topic-card">
            <div class="topic-icon">👥</div>
            <h3>Team Building</h3>
            <p>Hiring, training, and retaining top talent across locations.</p>
          </div>
          <div class="topic-card">
            <div class="topic-icon">💰</div>
            <h3>Revenue Growth</h3>
            <p>Strategies to increase revenue without increasing headaches.</p>
          </div>
          <div class="topic-card">
            <div class="topic-icon">🚪</div>
            <h3>Exit Strategies</h3>
            <p>Planning and executing a successful practice sale.</p>
          </div>
          <div class="topic-card">
            <div class="topic-icon">⚙️</div>
            <h3>Operational Systems</h3>
            <p>Building the infrastructure that runs without you.</p>
          </div>
          <div class="topic-card">
            <div class="topic-icon">🎯</div>
            <h3>Leadership</h3>
            <p>Growing as a leader while growing your practice.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Episodes Section -->
    <section class="episodes-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">Featured Episodes</div>
          <h2>Recent Conversations</h2>
        </div>

        <div class="episodes-list">
          <a href="https://buildingempires.live" target="_blank" class="episode-card">
            <div class="episode-number">EP 52</div>
            <div class="episode-content">
              <h3>From $500K to $4M: Scaling Without Losing Your Culture</h3>
              <p>How one practice owner grew revenue 8x while keeping the team culture that made them successful.</p>
            </div>
            <div class="episode-duration">45 min</div>
          </a>
          <a href="https://buildingempires.live" target="_blank" class="episode-card">
            <div class="episode-number">EP 51</div>
            <div class="episode-content">
              <h3>Patient Care as Business Strategy</h3>
              <p>Why the best business decision is often the best patient care decision.</p>
            </div>
            <div class="episode-duration">38 min</div>
          </a>
          <a href="https://buildingempires.live" target="_blank" class="episode-card">
            <div class="episode-number">EP 50</div>
            <div class="episode-content">
              <h3>Seizing Unexpected Career Opportunities</h3>
              <p>A conversation about taking risks and building something bigger than yourself.</p>
            </div>
            <div class="episode-duration">42 min</div>
          </a>
        </div>

        <div class="episodes-cta">
          <Button href="https://buildingempires.live" target="_blank">View All Episodes</Button>
        </div>
      </div>
    </section>

    <!-- Host Section -->
    <section class="host-section">
      <div class="container">
        <div class="host-grid">
          <div class="host-image">
            <div class="host-avatar">AP</div>
          </div>
          <div class="host-content">
            <div class="eyebrow">Your Host</div>
            <h2>Ankit Patel</h2>
            <p>
              Ankit brings Lean Six Sigma expertise from Dell and Cleveland Clinic, combined with hands-on experience scaling Classic Vision Care in Atlanta. As founder of My Business Care Team, he's helped dozens of practices transform their operations.
            </p>
            <p>
              Each week, he sits down with practice owners who are in the trenches—building, scaling, and sometimes selling their practices.
            </p>
            <div class="host-links">
              <a href="/about/story">Read Full Story →</a>
              <a href="/about/book">Get the Book →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="podcast-cta">
      <div class="container">
        <div class="cta-content">
          <h2>Never Miss an Episode</h2>
          <p>Subscribe on your favorite platform for weekly insights from practice owners who are building empires.</p>
          <div class="cta-buttons">
            <Button href="https://podcasts.apple.com" target="_blank" variant="secondary">Apple Podcasts</Button>
            <Button href="https://spotify.com" target="_blank" variant="secondary">Spotify</Button>
            <Button href="https://buildingempires.live" target="_blank">Listen Now</Button>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .podcast-page {
    padding-top: 80px;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-600);
    margin-bottom: 12px;
  }

  /* Hero Section */
  .podcast-hero {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
  }

  .podcast-hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .podcast-hero-content h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .podcast-tagline {
    font-size: 1.35rem;
    color: var(--oceanic-teal);
    font-weight: 600;
    margin-bottom: 16px;
  }

  .hero-lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }

  .podcast-stats {
    display: flex;
    gap: 40px;
    margin-bottom: 32px;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy-900);
  }

  .stat-label {
    font-size: 14px;
    color: var(--text-muted);
  }

  .podcast-platforms {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .platform-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: var(--navy-900);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .platform-link:hover {
    background: var(--glass-navy);
  }

  .platform-link.primary {
    background: var(--oceanic-teal);
    color: white;
    border-color: var(--oceanic-teal);
  }

  .platform-link.primary:hover {
    background: var(--teal-600);
  }

  .artwork-wrapper {
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--oceanic-teal) 100%);
    border-radius: 24px;
    padding: 40px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-xl);
  }

  .artwork-placeholder {
    text-align: center;
    color: white;
  }

  .artwork-placeholder span {
    font-size: 4rem;
    display: block;
    margin-bottom: 16px;
  }

  .artwork-placeholder p {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.2;
  }

  /* Topics Section */
  .topics-section {
    padding: 80px 0;
    background: white;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--navy-900);
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .topic-card {
    padding: 32px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-align: center;
    transition: all 0.3s var(--ease-smooth);
  }

  .topic-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .topic-icon {
    font-size: 2.5rem;
    margin-bottom: 16px;
  }

  .topic-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .topic-card p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Episodes Section */
  .episodes-section {
    padding: 80px 0;
    background: var(--cream-200);
  }

  .episodes-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }

  .episode-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 24px;
    background: white;
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.3s var(--ease-smooth);
  }

  .episode-card:hover {
    transform: translateX(8px);
    box-shadow: var(--shadow-lg);
  }

  .episode-number {
    font-size: 14px;
    font-weight: 700;
    color: var(--oceanic-teal);
    background: var(--glass-teal);
    padding: 8px 16px;
    border-radius: 999px;
  }

  .episode-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .episode-content p {
    color: var(--text-secondary);
    font-size: 15px;
  }

  .episode-duration {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .episodes-cta {
    text-align: center;
  }

  /* Host Section */
  .host-section {
    padding: 80px 0;
    background: white;
  }

  .host-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 60px;
    align-items: center;
  }

  .host-avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--glass-copper) 0%, var(--copper-500) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: white;
    font-weight: 700;
  }

  .host-content h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .host-content p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .host-links {
    display: flex;
    gap: 24px;
    margin-top: 24px;
  }

  .host-links a {
    color: var(--oceanic-teal);
    font-weight: 600;
    text-decoration: none;
  }

  .host-links a:hover {
    text-decoration: underline;
  }

  /* CTA Section */
  .podcast-cta {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--oceanic-teal) 100%);
    text-align: center;
  }

  .cta-content h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: white;
    margin-bottom: 16px;
  }

  .cta-content p {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 32px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .podcast-hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .podcast-stats {
      justify-content: center;
    }

    .podcast-platforms {
      justify-content: center;
    }

    .artwork-wrapper {
      max-width: 300px;
      margin: 0 auto;
    }

    .topics-grid {
      grid-template-columns: 1fr;
    }

    .episode-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .episode-number {
      justify-self: center;
    }

    .episode-duration {
      justify-self: center;
    }

    .host-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .host-avatar {
      margin: 0 auto;
    }

    .host-links {
      justify-content: center;
    }
  }
</style>
