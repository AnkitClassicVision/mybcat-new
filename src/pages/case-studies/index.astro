---
/**
 * Case Studies Hub Page
 * Showcases client success stories
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/sections/CTA.astro';
import { caseStudies } from '@data/case-studies';

const pageTitle = 'Case Studies: Healthcare Practice Results';
const pageDescription = 'Named client stories and composite benchmarks from healthcare groups using mybcat to improve patient access, answer rate, and revenue.';
const namedCaseStudies = caseStudies.filter(study => study.proofType === 'named-client');
const compositeCaseStudies = caseStudies.filter(study => study.proofType === 'composite-benchmark');
---

<PageLayout
  title={`${pageTitle} | MyBCAT`}
  description={pageDescription}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Case Studies' }
  ]}
>
  <div class="case-studies-hub">
    <!-- Hero -->
    <section class="hub-hero">
      <span class="eyebrow">Success Stories</span>
      <h1>Real Results from Real Practices</h1>
      <p class="hero-description">
        Review both named client stories and composite multi-location benchmarks to see how
        healthcare groups use mybcat to improve answer rate, staffing leverage, and patient acquisition.
      </p>
      <p class="hero-link">
        <a href="/blog/category/case-study/">Read case study articles on the blog →</a>
      </p>
    </section>

    <!-- Featured Stats -->
    <section class="featured-stats">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-value">100%</span>
          <span class="stat-label">Call Answer Rate</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">35%+</span>
          <span class="stat-label">Avg Recall Improvement</span>
        </div>
        <div class="stat-item">
          <span class="stat-value">$150K+</span>
          <span class="stat-label">Avg Annual Revenue Recovered</span>
        </div>
      </div>
      <p class="stats-disclaimer">Aggregated results across mybcat clients. Individual outcomes vary based on practice size, patient volume, and market conditions.</p>
    </section>

    <!-- Named Client Stories -->
    {namedCaseStudies.length > 0 && (
      <section class="case-studies-section">
        <div class="section-copy">
          <span class="section-label">Named Client Stories</span>
          <h2>Direct proof from healthcare operators using mybcat</h2>
          <p>These examples include named clients and attributed results from the stated rollout periods.</p>
        </div>
        <div class="case-studies-grid">
          {namedCaseStudies.map(study => (
            <a href={`/case-studies/${study.slug}/`} class="case-study-card">
              <div class="card-header">
                <span class="industry-badge">{study.industry}</span>
                <span class="proof-pill">Named Client Story</span>
                <span class="location">{study.location}</span>
              </div>
              <h2>{study.title}</h2>
              <p class="client-info">
                <strong>{study.client}</strong> — {study.practiceSize}
              </p>
              <p class="card-summary">{study.seoDescription || study.results}</p>
              <div class="metrics-preview">
                {study.metrics.slice(0, 2).map(metric => (
                  <div class="metric">
                    <span class="metric-value">{metric.value}</span>
                    <span class="metric-label">{metric.label}</span>
                  </div>
                ))}
              </div>
              <div class="card-cta">
                <span>Review rollout and results</span>
                <span class="arrow">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Composite Benchmarks -->
    {compositeCaseStudies.length > 0 && (
      <section class="case-studies-section case-studies-section-composite">
        <div class="section-copy">
          <span class="section-label">Composite Benchmarks</span>
          <h2>Representative examples for multi-location operators</h2>
          <p>These benchmark examples synthesize anonymized operating patterns across similar healthcare groups.</p>
        </div>
        <div class="case-studies-grid">
          {compositeCaseStudies.map(study => (
            <a href={`/case-studies/${study.slug}/`} class="case-study-card">
              <div class="card-header">
                <span class="industry-badge">{study.industry}</span>
                <span class="proof-pill proof-pill-composite">Composite Benchmark</span>
                <span class="location">{study.location}</span>
              </div>
              <h2>{study.title}</h2>
              <p class="client-info">
                <strong>{study.client}</strong> — {study.practiceSize}
              </p>
              <p class="card-summary">{study.seoDescription || study.results}</p>
              <div class="metrics-preview">
                {study.metrics.slice(0, 2).map(metric => (
                  <div class="metric">
                    <span class="metric-value">{metric.value}</span>
                    <span class="metric-label">{metric.label}</span>
                  </div>
                ))}
              </div>
              <div class="card-cta">
                <span>Review benchmark example</span>
                <span class="arrow">→</span>
              </div>
            </a>
          ))}
        </div>
        <p class="section-disclaimer">Composite benchmarks are anonymized examples intended to show what is operationally achievable for similar groups. They should not be interpreted as guarantees.</p>
      </section>
    )}

    <!-- Testimonial Highlight -->
    <section class="testimonial-section">
      <Card variant="testimonial">
        <div class="testimonial-content">
          <blockquote>
            "{caseStudies[0].testimonial.quote}"
          </blockquote>
          <cite>
            <strong>{caseStudies[0].testimonial.author}</strong>
            <span>{caseStudies[0].testimonial.title}</span>
          </cite>
        </div>
      </Card>
    </section>

    <!-- Industries Served -->
    <section class="industries-section">
      <h2>Industries We Serve</h2>
      <p>mybcat specializes in healthcare practices across multiple verticals.</p>
      <div class="industries-grid">
        <a href="/industries/optometry/" class="industry-link">Optometry</a>
        <a href="/industries/dental/" class="industry-link">Dental</a>
        <a href="/industries/veterinary/" class="industry-link">Veterinary</a>
        <a href="/industries/medspa/" class="industry-link">MedSpa</a>
        <a href="/industries/dermatology/" class="industry-link">Dermatology</a>
        <a href="/industries/urgent-care/" class="industry-link">Urgent Care</a>
        <a href="/industries/ent/" class="industry-link">ENT</a>
      </div>
    </section>

    <!-- Trust Signals -->
    <section class="trust-signals">
      <div class="trust-strip">
        <div class="trust-item">
          <span class="trust-icon">&#x1f512;</span>
          <span>HIPAA Compliant</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">&#x1f4cb;</span>
          <span>BAA Provided</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">&#x1f6e1;</span>
          <span>SOC 2 Practices</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">&#x1f91d;</span>
          <span>Dedicated Account Manager</span>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <CTA
        title="Ready to Write Your Success Story?"
        description="Join practices that have transformed their patient acquisition with mybcat."
        buttonText="Schedule a Consultation"
      />
    </section>
  </div>
</PageLayout>

<style>
  .case-studies-hub {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Hero */
  .hub-hero {
    text-align: center;
    padding: 40px 0 48px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 16px;
  }

  .hub-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  .hero-link {
    margin-top: 14px;
  }

  .hero-link a {
    color: var(--oceanic-teal);
    font-weight: 600;
    text-decoration: none;
  }

  .hero-link a:hover {
    text-decoration: underline;
  }

  .section-copy {
    margin-bottom: 24px;
  }

  .section-label {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--copper-500);
  }

  .section-copy h2 {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 10px;
  }

  .section-copy p,
  .section-disclaimer {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Featured Stats */
  .featured-stats {
    margin-bottom: 60px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 32px;
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.05) 0%, transparent 100%);
    border-radius: 20px;
    border: 1px solid var(--glass-border);
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .stats-disclaimer {
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 12px;
    font-style: italic;
    line-height: 1.5;
  }

  /* Case Studies Grid */
  .case-studies-section {
    margin-bottom: 60px;
  }

  .case-studies-section-composite {
    margin-bottom: 72px;
  }

  .case-studies-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .case-study-card {
    display: block;
    padding: 32px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .case-study-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
  }

  .industry-badge {
    padding: 6px 12px;
    background: var(--glass-teal);
    color: var(--oceanic-teal);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .location {
    font-size: 13px;
    color: var(--text-muted);
  }

  .proof-pill {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.12);
    color: #0369a1;
    font-size: 11px;
    font-weight: 700;
  }

  .proof-pill-composite {
    background: rgba(217, 119, 6, 0.12);
    color: #b45309;
  }

  .case-study-card h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .client-info {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .card-summary {
    margin-bottom: 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .metrics-preview {
    display: flex;
    gap: 32px;
    margin-bottom: 20px;
  }

  .metric {
    display: flex;
    flex-direction: column;
  }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
  }

  .metric-label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .card-cta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 14px;
  }

  .arrow {
    transition: transform 0.2s;
  }

  .case-study-card:hover .arrow {
    transform: translateX(4px);
  }

  /* Testimonial */
  .testimonial-section {
    margin-bottom: 60px;
  }

  .testimonial-content {
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }

  .testimonial-content blockquote {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--navy-900);
    line-height: 1.7;
    margin: 0 0 24px;
  }

  .testimonial-content cite {
    font-style: normal;
  }

  .testimonial-content cite strong {
    display: block;
    font-size: 1rem;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .testimonial-content cite span {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Industries */
  .industries-section {
    text-align: center;
    margin-bottom: 60px;
    padding: 40px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
  }

  .industries-section h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .industries-section > p {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .industries-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .industry-link {
    padding: 10px 20px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--navy-900);
    font-weight: 500;
    font-size: 14px;
    transition: all 0.2s;
  }

  .industry-link:hover {
    border-color: var(--oceanic-teal);
    color: var(--oceanic-teal);
  }

  /* Trust Signals */
  .trust-signals {
    margin-bottom: 60px;
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    padding: 20px 24px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
  }

  .trust-strip .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--navy-900);
  }

  .trust-icon {
    font-size: 16px;
  }

  /* CTA */
  .cta-section {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .stat-value {
      font-size: 2rem;
    }

    .metrics-preview {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
