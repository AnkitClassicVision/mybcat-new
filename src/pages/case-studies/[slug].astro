---
/**
 * Dynamic Case Study Page
 * Individual case study with full details
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/sections/CTA.astro';
import { caseStudies, type CaseStudy } from '@data/case-studies';
import { getSolutionBySlug, type Solution } from '@data/solutions';
import { generateArticleSchema, serializeSchema } from '@/utils/schema';
import { company } from '@data/company';
import { execSync } from 'node:child_process';

export function getStaticPaths() {
  return caseStudies.map(study => ({
    params: { slug: study.slug },
    props: { study }
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// Get other case studies for navigation
const otherStudies = caseStudies.filter(s => s.slug !== study.slug);
const isComposite = study.proofType === 'composite-benchmark';
const proofLabel = isComposite ? 'Composite Benchmark' : 'Named Client Story';
const heroSummary = study.seoDescription || study.results;

// Get related solutions for this case study
// getSolutionBySlug returns Solution or undefined, so undefined is the only value
// the old filter(Boolean) could drop. The predicate keeps that exact result and
// tells the compiler the survivors are defined.
const relatedSolutions = study.relatedSolutions
  .map(slug => getSolutionBySlug(slug))
  .filter((solution): solution is Solution => solution !== undefined);

function normalizeSpaces(text: string): string {
  return text.trim().replace(/\s+/g, ' ');
}

function clampWords(text: string, maxLen: number): string {
  if (text.length <= maxLen) return text;
  const words = text.split(/\s+/);
  let out = '';
  for (const word of words) {
    const next = out ? `${out} ${word}` : word;
    if (next.length > maxLen) break;
    out = next;
  }
  return out || text.slice(0, maxLen);
}

function buildMetaDescription(): string {
  let out = normalizeSpaces(`${study.client} case study: ${study.challenge}`);

  const suffixes = [
    ' See what we implemented and the results.',
    ` Built for ${study.industry.toLowerCase()} groups and multi-location operations.`,
  ];

  for (const suffix of suffixes) {
    if (out.length >= 120) break;
    const candidate = `${out}${suffix}`;
    if (candidate.length <= 160) out = candidate;
  }

  if (out.length > 160) {
    out = clampWords(out, 160);
  }

  out = out.replace(/[\s.,;:!?]+$/, '');
  if (out && !/[.!?]$/.test(out) && out.length < 160) out = `${out}.`;

  return out;
}

const metaDescription = study.seoDescription || buildMetaDescription();
const pageTitle = `${study.seoTitle || `${study.client} Case Study`} | MyBCAT`;
const metricsDisclaimer = isComposite
  ? 'This example is a composite benchmark built from anonymized operating patterns. Results vary based on location mix, staffing, systems, and patient demand.'
  : `Results reported by ${study.client} during the stated implementation period. Individual results vary based on practice size, patient volume, and market conditions.`;

function getGitLastModDate(filePath: string): string | null {
  try {
    const result = execSync(`git log -1 --format=%cI -- "${filePath}"`, {
      encoding: 'utf8',
      stdio: ['pipe', 'pipe', 'pipe'],
    }).trim();
    if (!result) return null;
    return result.split('T')[0];
  } catch {
    return null;
  }
}

const caseStudiesLastMod = getGitLastModDate('src/data/case-studies.ts') ?? '2025-01-01';

// Generate schema
const articleSchema = generateArticleSchema({
  headline: study.title,
  description: metaDescription,
  image: study.featuredImage || '/images/og-home.jpg',
  author: 'mybcat Team',
  datePublished: caseStudiesLastMod,
  dateModified: caseStudiesLastMod,
  url: `${company.site.url}/case-studies/${study.slug}/`
});
---

<PageLayout
  title={pageTitle}
  description={metaDescription}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Case Studies', url: '/case-studies/' },
    { name: study.client }
  ]}
>
  <script type="application/ld+json" set:html={serializeSchema(articleSchema)} slot="head" />

  <div class="case-study-page">
    <!-- Hero -->
    <section class="study-hero">
      <div class="hero-meta">
        <span class="industry-badge">{study.industry}</span>
        <span class:list={['proof-badge', { composite: isComposite }]}>{proofLabel}</span>
        <span class="divider">•</span>
        <span class="location">{study.location}</span>
        <span class="divider">•</span>
        <span class="size">{study.practiceSize}</span>
      </div>
      <h1>{study.title}</h1>
      <p class="client-name">{study.client}</p>
      <p class="hero-summary">{heroSummary}</p>
    </section>

    <!-- Proof Context -->
    <section class="proof-context">
      <div class="proof-card">
        {study.proofNote && <p class="proof-note">{study.proofNote}</p>}
        {study.bestFit && study.bestFit.length > 0 && (
          <>
            <h2>Best Fit</h2>
            <div class="fit-list">
              {study.bestFit.map(item => (
                <span class="fit-chip">{item}</span>
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    <!-- Key Metrics -->
    <section class="metrics-section">
      <div class="metrics-grid">
        {study.metrics.map(metric => (
          <div class="metric-card">
            <span class="metric-value">{metric.value}</span>
            <span class="metric-label">{metric.label}</span>
            {metric.description && (
              <span class="metric-description">{metric.description}</span>
            )}
          </div>
        ))}
      </div>
      <p class="metrics-disclaimer">{metricsDisclaimer}</p>
    </section>

    <!-- Snapshot -->
    {study.snapshot && study.snapshot.length > 0 && (
      <section class="content-section">
        <h2>At a Glance</h2>
        <div class="snapshot-grid">
          {study.snapshot.map(item => (
            <div class="snapshot-card">
              <span class="snapshot-label">{item.label}</span>
              <span class="snapshot-value">{item.value}</span>
              {item.description && <span class="snapshot-description">{item.description}</span>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Challenge -->
    <section class="content-section">
      <h2>The Challenge</h2>
      <p>{study.challenge}</p>
    </section>

    <!-- Solution -->
    <section class="content-section">
      <h2>The Solution</h2>
      <p>{study.solution}</p>
    </section>

    <!-- Implementation -->
    <section class="content-section">
      <h2>What We Implemented</h2>
      <ul class="implementation-list">
        {study.implementation.map(item => (
          <li>
            <span class="check">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Systems & Workflows -->
    {study.systemsUsed && study.systemsUsed.length > 0 && (
      <section class="content-section">
        <h2>Systems & Workflows Involved</h2>
        <ul class="implementation-list systems-list">
          {study.systemsUsed.map(item => (
            <li>
              <span class="check">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Results -->
    <section class="content-section">
      <h2>The Results</h2>
      <p>{study.results}</p>
      <div class="timeline-badge">
        <span class="timeline-icon">⏱</span>
        <span>{study.timeline}</span>
      </div>
    </section>

    <!-- Testimonial -->
    <section class="testimonial-section">
      <Card variant="pricing">
        <div class="testimonial-content">
          <blockquote>"{study.testimonial.quote}"</blockquote>
          <cite>
            <strong>{study.testimonial.author}</strong>
            <span>{study.testimonial.title}</span>
          </cite>
        </div>
      </Card>
    </section>

    <!-- Related Industry -->
    <section class="related-section">
      <Card variant="feature">
        <div class="related-content">
          <h3>More About {study.industry}</h3>
          <p>See how mybcat serves {study.industry.toLowerCase()} practices.</p>
          <Button href={`/industries/${study.industrySlug}/`}>
            View {study.industry} Solutions
          </Button>
        </div>
      </Card>
    </section>

    <!-- Related Solutions -->
    {relatedSolutions.length > 0 && (
      <section class="related-solutions">
        <h3>Related Solutions</h3>
        <p class="related-solutions-intro">The services that drove these results:</p>
        <div class="solutions-grid">
          {relatedSolutions.map(solution => (
            <a href={`/solutions/${solution.slug}/`} class="solution-card">
              <h4>{solution.name}</h4>
              <p>{solution.tagline}</p>
              <span class="solution-link">Learn more</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Other Case Studies -->
    {otherStudies.length > 0 && (
      <section class="other-studies">
        <h3>More Success Stories</h3>
        <div class="other-grid">
          {otherStudies.map(other => (
            <a href={`/case-studies/${other.slug}/`} class="other-card">
              <span class="other-industry">{other.industry}</span>
              <h4>{other.client}</h4>
              <p>{other.metrics[0].value} {other.metrics[0].label}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Trust Signals -->
    <section class="trust-signals">
      <div class="trust-strip">
        <div class="trust-item">
          <span class="trust-icon">&#x1f512;</span>
          <span>HIPAA Compliant</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">&#x1f4cb;</span>
          <span>BAA Provided</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">&#x1f6e1;</span>
          <span>SOC 2 Practices</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">&#x1f91d;</span>
          <span>Dedicated Account Manager</span>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <CTA
        title="Ready to See Results Like These?"
        description="Join the practices that have transformed their patient acquisition with mybcat."
        buttonText="Schedule a Consultation"
      />
    </section>
  </div>
</PageLayout>

<style>
  .case-study-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Hero */
  .study-hero {
    text-align: center;
    padding: 40px 0 48px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .industry-badge {
    padding: 6px 14px;
    background: var(--glass-teal);
    color: var(--oceanic-teal);
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .divider {
    color: var(--text-muted);
  }

  .location,
  .size {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .study-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .client-name {
    font-size: 1.1rem;
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  .hero-summary {
    margin: 16px auto 0;
    max-width: 680px;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .proof-badge {
    padding: 6px 14px;
    background: rgba(14, 165, 233, 0.12);
    color: #0369a1;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
  }

  .proof-badge.composite {
    background: rgba(217, 119, 6, 0.12);
    color: #b45309;
  }

  .proof-context {
    margin-bottom: 32px;
  }

  .proof-card {
    padding: 24px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
  }

  .proof-card h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin: 18px 0 10px;
  }

  .proof-note {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .fit-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .fit-chip {
    display: inline-flex;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(0, 96, 100, 0.08);
    color: var(--navy-900);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
  }

  /* Metrics */
  .metrics-section {
    margin-bottom: 48px;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .metric-card {
    text-align: center;
    padding: 24px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
  }

  .metric-value {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--oceanic-teal);
    margin-bottom: 4px;
  }

  .metric-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .metric-description {
    font-size: 12px;
    color: var(--text-muted);
  }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .snapshot-card {
    padding: 20px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
  }

  .snapshot-label {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .snapshot-value {
    display: block;
    margin-bottom: 6px;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--navy-900);
  }

  .snapshot-description {
    display: block;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Content Sections */
  .content-section {
    margin-bottom: 40px;
  }

  .content-section h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--glass-border);
  }

  .content-section p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .implementation-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .implementation-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px 16px;
    background: var(--spatial-glass);
    border-radius: 10px;
    margin-bottom: 10px;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .check {
    color: var(--oceanic-teal);
    font-weight: 700;
    flex-shrink: 0;
  }

  .systems-list li {
    align-items: center;
  }

  .timeline-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 10px 18px;
    background: var(--glass-copper);
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--copper-700);
  }

  /* Testimonial */
  .testimonial-section {
    margin-bottom: 48px;
  }

  .testimonial-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .testimonial-content blockquote {
    font-size: 1.3rem;
    font-style: italic;
    color: var(--navy-900);
    line-height: 1.7;
    margin: 0 0 24px;
  }

  .testimonial-content cite {
    font-style: normal;
  }

  .testimonial-content cite strong {
    display: block;
    font-size: 1.1rem;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .testimonial-content cite span {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Related */
  .related-section {
    margin-bottom: 48px;
  }

  .related-content {
    text-align: center;
  }

  .related-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .related-content p {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  /* Other Studies */
  .other-studies {
    margin-bottom: 48px;
  }

  .other-studies h3 {
    text-align: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 20px;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }

  .other-card {
    display: block;
    padding: 20px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .other-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-2px);
  }

  .other-industry {
    display: inline-block;
    padding: 4px 10px;
    background: var(--glass-teal);
    color: var(--oceanic-teal);
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .other-card h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .other-card p {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* Metrics Disclaimer */
  .metrics-disclaimer {
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
    margin-top: 12px;
    font-style: italic;
    line-height: 1.5;
  }

  /* Trust Signals */
  .trust-signals {
    margin-bottom: 48px;
  }

  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    padding: 20px 24px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
  }

  .trust-strip .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--navy-900);
  }

  .trust-icon {
    font-size: 16px;
  }

  /* CTA */
  .cta-section {
    margin-bottom: 0;
  }

  /* Related Solutions */
  .related-solutions {
    margin-bottom: 48px;
  }

  .related-solutions h3 {
    text-align: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .related-solutions-intro {
    text-align: center;
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .solution-card {
    display: block;
    padding: 20px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .solution-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-2px);
  }

  .solution-card h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 6px;
  }

  .solution-card p {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .solution-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--oceanic-teal);
  }
</style>
