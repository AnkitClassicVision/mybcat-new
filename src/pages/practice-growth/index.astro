---
/**
 * Practice Growth draft offer page.
 * Draft only: noindex, not in sitemap, no checkout, no homepage CTA changes.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/Button.astro';

const DISCOVERY_URL = 'https://mybcat.com/book/discovery';
const ONBOARD_URL = '/practice-growth/onboard/';

const packages = [
  {
    name: 'Social',
    summary: 'Stay visible on social and Google Business Profile.',
    starting: '$260',
    period: '/mo',
    note: 'Starting monthly. Not a locked quote.',
    featured: false,
    includes: [
      '3 social posts per week',
      '1 Google Business Profile post per week',
      'Drafts first. Nothing publishes without approval.'
    ]
  },
  {
    name: 'Convert',
    summary: 'Social plus a practice website, weekly blog, and local SEO.',
    starting: '$599',
    period: '/mo',
    note: 'Starting monthly. Not a locked quote.',
    featured: true,
    includes: [
      'Everything in Social',
      'Astro site hosted on Vercel',
      '1 blog article per week',
      'Local SEO for the practice market'
    ]
  },
  {
    name: 'Grow',
    summary: 'Website, social, and paid ads management.',
    starting: '$999',
    period: '/mo',
    note: 'Starting monthly, plus ad spend. Not a locked quote.',
    featured: false,
    includes: [
      'Everything in Convert',
      'Paid ads management',
      'Ad spend is billed separately and set with the practice'
    ]
  }
];

const operatingLoop = [
  {
    title: 'Practice brief',
    text: 'We collect approved facts about the practice, market, and what is already live. Unverified claims stay out of the work.'
  },
  {
    title: 'Growth packet',
    text: 'Website, content, social, and local work stay in review. A person approves each live write before publish, deploy, or spend.'
  },
  {
    title: 'Weekly cadence',
    text: 'The portable system repeats. Posts, articles, and local work follow the same gate, so the practice does not run a one-off campaign and stop.'
  }
];
---

<LandingLayout
  title="Practice Growth for Optometry | MyBCAT"
  description="Draft Practice Growth offer for independent optometry. Social, website, local SEO, and optional paid ads. Starting monthly prices. Book a discovery call."
  noindex={true}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Practice Growth' }
  ]}
>
  <div class="pg-page">
    <p class="draft-banner" role="status">
      Draft offer. Starting prices only. Setup is TBD. There is no checkout on this page.
    </p>

    <section class="hero" aria-labelledby="pg-hero-title">
      <p class="eyebrow">Practice growth ops</p>
      <h1 id="pg-hero-title">Website, social, and optional ads for independent optometry</h1>
      <p class="lede">
        We run a portable practice growth system. The work is website, social, local search, and optional ads. It is not a virtual assistant shop.
      </p>
      <div class="hero-actions">
        <Button href={DISCOVERY_URL} variant="primary">Book a discovery call</Button>
        <a class="secondary-cta" href={ONBOARD_URL}>Start practice onboard</a>
      </div>
      <p class="hero-note">Book discovery is the primary next step. Onboard is a practice brief only. It is not checkout. Pricing below is a starting monthly range, not a signed package.</p>
    </section>

    <section class="system" aria-labelledby="pg-system-title">
      <div class="section-head">
        <p class="eyebrow">How the work runs</p>
        <h2 id="pg-system-title">One portable system, not a pile of freelancers</h2>
        <p>
          The same operating loop covers research, the site, content, social, local search, and paid ads. Live writes wait for human approval.
        </p>
      </div>
      <ol class="loop">
        {operatingLoop.map((step, index) => (
          <li>
            <span class="step-num">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="packages" id="packages" aria-labelledby="pg-packages-title">
      <div class="section-head">
        <p class="eyebrow">Draft packages</p>
        <h2 id="pg-packages-title">Social, Convert, and Grow</h2>
        <p>
          Starting monthly prices. Setup is TBD. Final scope is set on the discovery call. This is not a promise and not a checkout.
        </p>
      </div>

      <div class="package-grid">
        {packages.map((pkg) => (
          <article class:list={['package-card', { featured: pkg.featured }]}>
            {pkg.featured && <p class="featured-label">Most practices start here</p>}
            <h3>{pkg.name}</h3>
            <p class="package-summary">{pkg.summary}</p>
            <p class="starting-label">Starting</p>
            <p class="price">
              <span class="price-amount">{pkg.starting}</span>
              <span class="price-period">{pkg.period}</span>
            </p>
            <p class="price-note">{pkg.note}</p>
            <p class="setup-note">Setup TBD</p>
            <ul>
              {pkg.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <Button href={DISCOVERY_URL} variant={pkg.featured ? 'primary' : 'secondary'} size="sm">
              Book a discovery call
            </Button>
          </article>
        ))}
      </div>
    </section>

    <section class="included" aria-labelledby="pg-included-title">
      <div class="section-head">
        <p class="eyebrow">What sits in the system</p>
        <h2 id="pg-included-title">Built for optometry practice growth, not generic marketing hours</h2>
      </div>
      <div class="include-grid">
        <article>
          <h3>Practice website</h3>
          <p>Astro site on Vercel. Fast pages, clear services, and a booking path the practice already uses.</p>
        </article>
        <article>
          <h3>Social and Google Business Profile</h3>
          <p>Three social posts each week and one Google Business Profile post each week. Drafts stay in review until someone approves publish.</p>
        </article>
        <article>
          <h3>Local SEO and blog</h3>
          <p>Convert and Grow add weekly articles and local SEO so the site and maps listing match how patients search.</p>
        </article>
        <article>
          <h3>Optional paid ads</h3>
          <p>Grow adds ads management. Ad spend is separate. The system does not spend until the practice approves a capped plan.</p>
        </article>
      </div>
    </section>

    <section class="fit" aria-labelledby="pg-fit-title">
      <div class="section-head">
        <p class="eyebrow">Fit</p>
        <h2 id="pg-fit-title">For owner-led optometry practices</h2>
        <p>
          This offer is for independent optometry practices that want a repeatable growth system. It is not after-hours phone coverage and not a staffing marketplace.
        </p>
      </div>
    </section>

    <section class="close" aria-labelledby="pg-close-title">
      <h2 id="pg-close-title">Review the draft offer on a discovery call</h2>
      <p>Starting prices are listed so the conversation has a floor. Setup is TBD. Nothing bills from this page.</p>
      <div class="close-actions">
        <Button href={DISCOVERY_URL} variant="primary">Book a discovery call</Button>
        <a class="secondary-cta" href={ONBOARD_URL}>Start practice onboard</a>
      </div>
    </section>
  </div>
</LandingLayout>

<style>
  .pg-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px 96px;
    color: var(--navy-900);
  }

  .draft-banner {
    margin: 8px 0 32px;
    padding: 12px 16px;
    background: rgba(0, 96, 100, 0.08);
    border: 1px solid rgba(0, 96, 100, 0.18);
    border-radius: 12px;
    color: var(--oceanic-teal);
    font-size: 0.95rem;
    font-weight: 600;
    text-align: center;
  }

  .hero,
  .system,
  .packages,
  .included,
  .fit,
  .close {
    padding: 32px 0 56px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--oceanic-teal);
    margin-bottom: 12px;
  }

  .hero {
    text-align: center;
    padding-top: 16px;
  }

  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    font-weight: 800;
    max-width: 18ch;
    margin: 0 auto 16px;
  }

  .lede,
  .section-head p,
  .hero-note,
  .fit p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .lede {
    font-size: 1.2rem;
    max-width: 680px;
    margin: 0 auto 28px;
  }

  .hero-actions,
  .close-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .close-actions {
    margin-bottom: 0;
  }

  .secondary-cta {
    color: var(--oceanic-teal);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .secondary-cta:hover,
  .secondary-cta:focus-visible {
    border-bottom-color: var(--oceanic-teal);
  }

  .hero-note {
    font-size: 0.95rem;
    max-width: 560px;
    margin: 0 auto;
  }

  .section-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }

  .section-head h2,
  .close h2 {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .loop {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 0;
    margin: 0;
  }

  .loop li,
  .include-grid article,
  .package-card {
    background: var(--spatial-surface);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .loop li {
    padding: 28px;
  }

  .step-num {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--glass-copper);
    color: var(--oceanic-teal);
    font-weight: 700;
    margin-bottom: 16px;
  }

  .loop h3,
  .include-grid h3,
  .package-card h3 {
    color: var(--navy-900);
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .loop p,
  .include-grid p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .package-grid,
  .include-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .include-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .include-grid article {
    padding: 28px;
  }

  .package-card {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .package-card.featured {
    border-color: var(--oceanic-teal);
    box-shadow: 0 0 0 2px var(--oceanic-teal);
  }

  .featured-label {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--oceanic-teal);
    color: #fff;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .package-summary,
  .price-note,
  .setup-note {
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .starting-label {
    margin: 20px 0 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oceanic-teal);
  }

  .price {
    margin: 0;
    color: var(--navy-900);
  }

  .price-amount {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .price-period {
    font-size: 1rem;
    font-weight: 500;
    color: var(--charcoal-500);
  }

  .price-note,
  .setup-note {
    font-size: 0.9rem;
    margin-top: 6px;
  }

  .setup-note {
    font-weight: 600;
    color: var(--navy-800);
    margin-bottom: 16px;
  }

  .package-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    flex: 1;
  }

  .package-card li {
    padding: 10px 0;
    border-bottom: 1px solid var(--glass-border);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .package-card li::before {
    content: "✓ ";
    color: var(--oceanic-teal);
    font-weight: 700;
  }

  .close {
    text-align: center;
    background: var(--glass-navy);
    border-radius: 24px;
    padding: 48px 24px;
    margin-top: 16px;
  }

  .close p {
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .loop,
    .package-grid,
    .include-grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: none;
    }
  }
</style>
