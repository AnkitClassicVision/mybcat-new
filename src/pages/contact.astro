---
/**
 * Contact Page
 * HubSpot contact form
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import { company } from '@data/company';
---

<PageLayout
  title="Contact Us | Schedule a Discovery Call | My Business Care Team"
  description="Ready to fill your appointment book? Schedule a discovery call with My Business Care Team to learn how we can help your practice capture every patient call."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contact' }
  ]}
  heroEyebrow="Get Started"
  heroTitle="Your Staff is Stretched Thin. Let's Fix That."
  heroSubtitle="Schedule a discovery call to learn how we become your front desk's best friend—capturing every call and filling your schedule while your team focuses on patients."
>
  <div class="contact-page">
    <!-- Practice Type Quick-Qualify -->
    <section class="practice-type-section">
      <h2>Tell Us About Your Practice</h2>
      <p class="practice-type-subtitle">This helps us prepare for your call with the right solutions.</p>
      <div class="practice-type-options">
        <button class="practice-type-option active" data-type="single" data-locations="1">
          <span class="option-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </span>
          <span class="option-label">Single Location</span>
          <span class="option-desc">One practice</span>
        </button>
        <button class="practice-type-option" data-type="small-group" data-locations="2-4">
          <span class="option-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="8" height="14" rx="1"></rect><rect x="14" y="7" width="8" height="14" rx="1"></rect><path d="M6 3h12"></path></svg>
          </span>
          <span class="option-label">2-4 Locations</span>
          <span class="option-desc">Growing group</span>
        </button>
        <button class="practice-type-option" data-type="enterprise" data-locations="5+">
          <span class="option-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="6" height="18" rx="1"></rect><rect x="9" y="3" width="6" height="18" rx="1"></rect><rect x="17" y="3" width="6" height="18" rx="1"></rect></svg>
          </span>
          <span class="option-label">5+ Locations</span>
          <span class="option-desc">Enterprise / DSO</span>
        </button>
      </div>
      <div class="enterprise-note" id="enterpriseNote" style="display: none;">
        <div class="enterprise-note-content">
          <span class="note-badge">Enterprise</span>
          <p>Great! Our Enterprise team specializes in multi-location centralization. Book below for a custom consultation, or <a href="/enterprise/">learn about our 30-day pilot program</a>.</p>
        </div>
      </div>
    </section>

    <div class="contact-grid">
      <!-- Contact Form -->
      <div class="form-section">
        <Card variant="pricing" class="form-card">
          <h2>Get Started Today</h2>
          <p class="form-description">
            Tell us about your practice and we'll reach out within 24 hours to schedule your discovery call.
          </p>
          <div class="hubspot-form-wrapper">
            <div class="hs-form-html" data-region="na1" data-form-id="539ee6f8-c838-4ea7-bad7-d2a9ea18db8d" data-portal-id="23344341"></div>
          </div>
        </Card>
      </div>

      <!-- Contact Info Sidebar -->
      <div class="contact-sidebar">
        <Card variant="testimonial" class="info-card">
          <h3>What to Expect</h3>
          <ul class="expect-list">
            <li>
              <span class="check">&#10003;</span>
              <span>Learn your specific challenges</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>Custom solution walkthrough</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>Pricing based on your needs</span>
            </li>
            <li>
              <span class="check">&#10003;</span>
              <span>No pressure, no obligation</span>
            </li>
          </ul>
        </Card>

        <Card variant="testimonial" class="info-card trust-card">
          <h3>Your Practice is Protected</h3>
          <div class="trust-badges">
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>HIPAA Compliant</span>
            </div>
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              <span>BAA Provided</span>
            </div>
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>US-Based Team</span>
            </div>
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>70+ Practices Trust Us</span>
            </div>
          </div>
        </Card>

        <Card variant="testimonial" class="info-card">
          <h3>Quick Questions?</h3>
          <div class="contact-method">
            <div class="method-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="method-details">
              <span class="method-label">Email</span>
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </div>
          </div>
        </Card>

        <Card variant="testimonial" class="info-card">
          <h3>Our Location</h3>
          <div class="contact-method">
            <div class="method-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="method-details">
              <span class="method-label">Headquarters</span>
              <span>{company.address.city}, {company.address.state}</span>
            </div>
          </div>
        </Card>

        <Card variant="testimonial" class="info-card not-ready-card">
          <h3>Not Ready to Talk Yet?</h3>
          <p class="not-ready-text">That's okay. Get our free guide on how much missed calls are really costing your practice.</p>
          <a href="/resources/roi-calculator/" class="alt-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
            Calculate My Lost Revenue
          </a>
          <div class="alt-options">
            <a href="/compare/" class="alt-link">Compare Solutions</a>
            <a href="/how-it-works/" class="alt-link">See How It Works</a>
          </div>
        </Card>
      </div>
    </div>

    <!-- FAQ Quick Links -->
    <section class="faq-quick">
      <h2>Common Questions</h2>
      <div class="faq-links">
        <a href="/pricing/" class="faq-link">
          <span class="faq-question">How much does it cost?</span>
          <span class="faq-arrow">&rarr;</span>
        </a>
        <a href="/hipaa-compliance/" class="faq-link">
          <span class="faq-question">Is MyBCAT HIPAA compliant?</span>
          <span class="faq-arrow">&rarr;</span>
        </a>
        <a href="/about/" class="faq-link">
          <span class="faq-question">Who is behind MyBCAT?</span>
          <span class="faq-arrow">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .contact-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Practice Type Section */
  .practice-type-section {
    text-align: center;
    margin-bottom: 48px;
  }

  .practice-type-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .practice-type-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .practice-type-options {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .practice-type-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 32px;
    background: var(--spatial-glass);
    border: 2px solid var(--glass-border);
    border-radius: 16px;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 140px;
  }

  .practice-type-option:hover {
    border-color: var(--oceanic-teal);
    background: rgba(0, 96, 100, 0.03);
  }

  .practice-type-option.active {
    border-color: var(--oceanic-teal);
    background: rgba(0, 96, 100, 0.08);
  }

  .option-icon {
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .practice-type-option.active .option-icon {
    color: var(--oceanic-teal);
  }

  .option-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .option-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .enterprise-note {
    margin-top: 20px;
  }

  .enterprise-note-content {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    background: rgba(0, 96, 100, 0.08);
    border: 1px solid var(--oceanic-teal);
    border-radius: 12px;
  }

  .note-badge {
    background: var(--oceanic-teal);
    color: white;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .enterprise-note-content p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .enterprise-note-content a {
    color: var(--oceanic-teal);
    font-weight: 600;
    text-decoration: none;
  }

  .enterprise-note-content a:hover {
    text-decoration: underline;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 32px;
    margin-bottom: 60px;
  }

  .form-section {
    min-height: 500px;
  }

  :global(.form-card) {
    height: 100%;
    padding: 40px;
  }

  :global(.form-card) h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
    text-align: center;
  }

  .form-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hubspot-form-wrapper {
    margin-top: 24px;
  }

  /* HubSpot Form Styling */
  :global(.hs-form-html) {
    width: 100%;
  }

  :global(.hs-form-html form) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :global(.hs-form-html .hs-form-field) {
    margin-bottom: 0;
  }

  :global(.hs-form-html label) {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 6px;
  }

  :global(.hs-form-html input[type="text"]),
  :global(.hs-form-html input[type="email"]),
  :global(.hs-form-html input[type="tel"]),
  :global(.hs-form-html input[type="number"]),
  :global(.hs-form-html select),
  :global(.hs-form-html textarea) {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    font-size: 15px;
    color: var(--navy-900);
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  :global(.hs-form-html input:focus),
  :global(.hs-form-html select:focus),
  :global(.hs-form-html textarea:focus) {
    outline: none;
    border-color: var(--oceanic-teal);
    box-shadow: 0 0 0 3px rgba(0, 96, 100, 0.1);
  }

  :global(.hs-form-html textarea) {
    min-height: 100px;
    resize: vertical;
  }

  :global(.hs-form-html .hs-submit) {
    margin-top: 8px;
  }

  :global(.hs-form-html input[type="submit"]),
  :global(.hs-form-html .hs-button) {
    width: 100%;
    padding: 14px 24px;
    background: var(--oceanic-teal);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  :global(.hs-form-html input[type="submit"]:hover),
  :global(.hs-form-html .hs-button:hover) {
    background: var(--navy-900);
    transform: translateY(-1px);
  }

  :global(.hs-form-html .hs-error-msgs) {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
  }

  :global(.hs-form-html .hs-error-msgs li) {
    color: #dc3545;
    font-size: 13px;
  }

  :global(.hs-form-html .hs-richtext) {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  :global(.hs-form-html .legal-consent-container) {
    font-size: 13px;
    color: var(--text-muted);
  }

  :global(.hs-form-html .submitted-message) {
    text-align: center;
    padding: 40px 20px;
    color: var(--oceanic-teal);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.info-card) {
    padding: 24px;
  }

  :global(.info-card) h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .expect-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .expect-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .check {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 14px;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .method-icon {
    width: 40px;
    height: 40px;
    background: var(--glass-teal);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--oceanic-teal);
  }

  .method-details {
    display: flex;
    flex-direction: column;
  }

  .method-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .method-details a,
  .method-details span:not(.method-label) {
    font-size: 15px;
    color: var(--navy-900);
    font-weight: 500;
  }

  .method-details a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .method-details a:hover {
    color: var(--oceanic-teal);
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--navy-900);
    font-weight: 500;
  }

  .trust-badge svg {
    color: var(--oceanic-teal);
    flex-shrink: 0;
  }

  /* Not Ready Card */
  .not-ready-card {
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.05) 0%, rgba(0, 96, 100, 0.02) 100%);
    border: 1px dashed var(--oceanic-teal);
  }

  .not-ready-text {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .alt-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    background: var(--oceanic-teal);
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s;
    margin-bottom: 12px;
  }

  .alt-cta:hover {
    background: var(--navy-900);
  }

  .alt-options {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .alt-link {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .alt-link:hover {
    color: var(--oceanic-teal);
  }

  .faq-quick {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 40px;
  }

  .faq-quick h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 24px;
    text-align: center;
  }

  .faq-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .faq-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .faq-link:hover {
    border-color: var(--oceanic-teal);
    transform: translateX(4px);
  }

  .faq-question {
    font-size: 15px;
    font-weight: 500;
    color: var(--navy-900);
  }

  .faq-arrow {
    color: var(--oceanic-teal);
    font-weight: 600;
    transition: transform 0.2s;
  }

  .faq-link:hover .faq-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .faq-links {
      grid-template-columns: 1fr;
    }

    .practice-type-options {
      flex-direction: column;
      align-items: stretch;
    }

    .practice-type-option {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      padding: 16px 20px;
    }

    .option-icon {
      flex-shrink: 0;
    }
  }
</style>

<!-- HubSpot Form Script -->
<script src="https://js.hsforms.net/forms/embed/developer/23344341.js" defer></script>

<script>
  // Practice type selector
  const options = document.querySelectorAll('.practice-type-option');
  const enterpriseNote = document.getElementById('enterpriseNote');

  options.forEach(option => {
    option.addEventListener('click', () => {
      // Remove active from all
      options.forEach(o => o.classList.remove('active'));
      // Add active to clicked
      option.classList.add('active');

      // Show/hide enterprise note
      const type = option.getAttribute('data-type');
      if (type === 'enterprise' && enterpriseNote) {
        enterpriseNote.style.display = 'block';
      } else if (enterpriseNote) {
        enterpriseNote.style.display = 'none';
      }
    });
  });
</script>
