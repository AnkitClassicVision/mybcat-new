<!-- HubSpot Form + Post-Submit Booking Flow -->
<script>
(function () {
  var MEETINGS_URL = 'https://hubspot.mybcat.com/meetings/ankit98/mybcat-discovery-call?embed=true';
  var MEETINGS_FALLBACK_URL = 'https://meetings.hubspot.com/ankit98/mybcat-discovery-call?embed=true';

  function buildMeetingsUrl(base, values) {
    var params = new URLSearchParams();
    if (values.firstName) params.set('firstName', values.firstName);
    if (values.lastName) params.set('lastName', values.lastName);
    if (values.email) params.set('email', values.email);
    var qs = params.toString();
    if (!qs) return base;
    return base + (base.indexOf('?') !== -1 ? '&' : '?') + qs;
  }

  function showPostSubmitState(values) {
    var formContent = document.getElementById('form-content');
    var postSubmit = document.getElementById('post-submit-state');
    var iframe = document.getElementById('meetings-iframe');
    var fallback = document.getElementById('meetings-fallback');
    var fallbackLink = document.getElementById('meetings-fallback-link');
    if (!formContent || !postSubmit) return;

    iframe.src = buildMeetingsUrl(MEETINGS_URL, values);
    fallbackLink.href = buildMeetingsUrl(MEETINGS_FALLBACK_URL, values);

    iframe.addEventListener('error', function () {
      iframe.hidden = true;
      fallback.hidden = false;
    });

    // Hide form skeleton if still showing
    var skeleton = document.getElementById('form-skeleton');
    if (skeleton) skeleton.classList.add('hidden');

    formContent.classList.add('fading');
    setTimeout(function () {
      formContent.style.display = 'none';
      postSubmit.removeAttribute('aria-hidden');
      postSubmit.style.display = 'block';
      postSubmit.getBoundingClientRect(); // force reflow for transition
      postSubmit.classList.add('visible');
    }, 150);
  }

  // --- Path 1: Returning from HubSpot redirect to /contact/?booked=true ---
  // HubSpot form must be configured to redirect to: https://mybcat.com/contact/?booked=true
  var urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('booked') === 'true') {
    history.replaceState({}, '', window.location.pathname); // clean URL
    showPostSubmitState({
      firstName: sessionStorage.getItem('hs_fn') || '',
      lastName:  sessionStorage.getItem('hs_ln') || '',
      email:     sessionStorage.getItem('hs_em') || ''
    });
    return; // skip form init — user already submitted
  }

  // --- Path 2: Normal page load — initialize form, listen for submission ---

  // Store field values to sessionStorage on submit so they survive the redirect
  window.addEventListener('message', function (event) {
    if (!event.data || typeof event.data !== 'object') return;
    if (event.data.type !== 'hsFormCallback') return;
    var eventName = event.data.eventName;
    var data = event.data.data;

    if (eventName === 'onFormSubmit' || eventName === 'onFormSubmitted') {
      if (Array.isArray(data)) {
        data.forEach(function (field) {
          if (field.name === 'email')     sessionStorage.setItem('hs_em', field.value || '');
          if (field.name === 'firstname') sessionStorage.setItem('hs_fn', field.value || '');
          if (field.name === 'lastname')  sessionStorage.setItem('hs_ln', field.value || '');
        });
      } else if (data && data.submissionValues) {
        sessionStorage.setItem('hs_em', data.submissionValues.email     || '');
        sessionStorage.setItem('hs_fn', data.submissionValues.firstname || '');
        sessionStorage.setItem('hs_ln', data.submissionValues.lastname  || '');
      }
    }
  });

  // Skeleton fallback: hide after 5s regardless
  setTimeout(function () {
    var skeleton = document.getElementById('form-skeleton');
    if (skeleton) skeleton.classList.add('hidden');
  }, 5000);

  // Initialize form — poll for hbspt since v2.js loads async after this script
  function initForm() {
    hbspt.forms.create({
      region: 'na1',
      portalId: '23344341',
      formId: 'a365996f-87cf-4a60-8782-9dabb9f9dd97',
      target: '#hubspot-form-target',
      onFormReady: function () {
        var skeleton = document.getElementById('form-skeleton');
        if (skeleton) skeleton.classList.add('hidden');
      }
    });
  }

  var attempts = 0;
  var poll = setInterval(function () {
    attempts++;
    if (window.hbspt && window.hbspt.forms) {
      clearInterval(poll);
      initForm();
    } else if (attempts > 50) { // 5s timeout
      clearInterval(poll);
    }
  }, 100);
})();
</script>
<script src="https://js.hsforms.net/forms/embed/v2.js" async></script>
