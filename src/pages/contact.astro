---
/**
 * Contact Page
 * HubSpot contact form with Organization schema for local search visibility
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import { company } from '@data/company';
import { generateOrganizationSchema, serializeSchema } from '@utils/schema';
// Organization schema added to contact page per schema-rules.json exception
// PostalAddress allowed on /contact/ to improve local search visibility
// while maintaining enterprise B2B positioning (not LocalBusiness)
---

<PageLayout
  title="Contact Enterprise Team | Schedule a Discovery Call | MyBCAT"
  description="Schedule a discovery call with MyBCAT. Learn how we help multi-location healthcare groups centralize patient access and intake operations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contact' }
  ]}
  heroEyebrow="Enterprise Inquiries"
  heroTitle="Scaling Multi-Location Operations? Let's Talk."
  heroSubtitle="Tell us about your group and we'll show you how centralized patient access works across 3, 10, or 50+ locations-with unified reporting and one team that knows your protocols."
>
  <!-- Preconnect to HubSpot for faster form loading -->
  <link rel="preconnect" href="https://js.hsforms.net" slot="head" />
  <link rel="preconnect" href="https://forms.hsforms.com" slot="head" />
  <link rel="preconnect" href="https://js.hscta.net" slot="head" />
  <link rel="dns-prefetch" href="https://js.hsforms.net" slot="head" />
  <link rel="dns-prefetch" href="https://forms.hsforms.com" slot="head" />
  <link rel="dns-prefetch" href="https://hubspot.mybcat.com" slot="head" />
  <link rel="dns-prefetch" href="https://meetings.hubspot.com" slot="head" />
  <!-- Organization schema with PostalAddress for local search visibility -->
  <script type="application/ld+json" set:html={serializeSchema(generateOrganizationSchema())} slot="head" />
  <div class="contact-page">
    <div class="contact-grid">
      <!-- Contact Form -->
      <div class="form-section">
        <!-- Enterprise Qualifier -->
        <div class="enterprise-qualifier">
          <div class="qualifier-label">We Work With</div>
          <div class="qualifier-tags">
            <span class="qualifier-tag">DSOs</span>
            <span class="qualifier-tag">Optometry Groups</span>
            <span class="qualifier-tag">Veterinary Chains</span>
            <span class="qualifier-tag">Multi-Location Practices</span>
            <span class="qualifier-tag highlight">3+ Locations</span>
          </div>
        </div>

        <Card variant="pricing" class="form-card">
          <!-- Form content (fades out after submit) -->
          <div id="form-content">
            <h2>Get Started Today</h2>
            <p class="form-description">
              Tell us about your group and we'll reach out within 24 hours to discuss your centralized patient access strategy.
            </p>
            <div class="hubspot-form-wrapper">
              <!-- Loading skeleton shown while form loads -->
              <div class="form-skeleton" id="form-skeleton">
                <div class="skeleton-row">
                  <div class="skeleton-field"></div>
                  <div class="skeleton-field"></div>
                </div>
                <div class="skeleton-field full"></div>
                <div class="skeleton-field full"></div>
                <div class="skeleton-field full short"></div>
                <div class="skeleton-button"></div>
              </div>
              <div id="hubspot-form-target"></div>
            </div>
          </div>

          <!-- Post-submit state (hidden until form is submitted) -->
          <div id="post-submit-state" aria-hidden="true">
            <div class="post-submit-message">
              <div class="post-submit-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <h2>Thank You — Final Steps — Book Your Time</h2>
              <p>Two things are happening now: <strong>(1)</strong> Check your inbox (and spam folder) for a confirmation email with your meeting details and our follow-up. <strong>(2)</strong> You can grab a time on our calendar right now — it's ready below.</p>
            </div>
            <div class="meetings-wrapper">
              <iframe
                id="meetings-iframe"
                title="Schedule a Discovery Call with MyBCAT"
                frameborder="0"
                allowfullscreen
              ></iframe>
              <div id="meetings-fallback" hidden>
                <p>Can't see the calendar? <a id="meetings-fallback-link" href="https://meetings.hubspot.com/ankit98/mybcat-discovery-call" target="_blank" rel="noopener noreferrer">Book your discovery call directly →</a></p>
              </div>
            </div>
          </div>
        </Card>
      </div>

      <!-- Contact Info Sidebar -->
      <div class="contact-sidebar">
        <Card variant="testimonial" class="info-card">
          <h3>What Happens Next</h3>
          <ul class="expect-list">
            <li>
              <span class="step-number">1</span>
              <span>We review your group's current call flow and pain points</span>
            </li>
            <li>
              <span class="step-number">2</span>
              <span>You receive a custom rollout plan for 1-2 pilot locations</span>
            </li>
            <li>
              <span class="step-number">3</span>
              <span>30-day pilot with full reporting before commitment</span>
            </li>
            <li>
              <span class="step-number">4</span>
              <span>Scale to remaining locations at your pace</span>
            </li>
          </ul>
        </Card>

        <Card variant="testimonial" class="info-card trust-card">
          <h3>Your Practice is Protected</h3>
          <div class="trust-badges">
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>HIPAA Compliant</span>
            </div>
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              <span>BAA Provided</span>
            </div>
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>US-Managed Team</span>
            </div>
            <div class="trust-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>70+ Locations Trust Us</span>
            </div>
          </div>
        </Card>

        <Card variant="testimonial" class="info-card">
          <h3>Our Location</h3>
          <div class="contact-method">
            <div class="method-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="method-details">
              <span class="method-label">Headquarters</span>
              <span>{company.address.city}, {company.address.state}</span>
            </div>
          </div>
        </Card>

        <Card variant="testimonial" class="info-card enterprise-questions-card">
          <h3>Be Ready to Discuss</h3>
          <p class="prep-text">Our discovery calls work best when you can share:</p>
          <ul class="prep-list">
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              <span>Number of locations & monthly call volume</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              <span>Current EHR/PM systems (we integrate with 50+)</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              <span>Primary pain point (staffing, answer rate, consistency)</span>
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              <span>Timeline for decision (pilot or full rollout)</span>
            </li>
          </ul>
        </Card>

        <Card variant="testimonial" class="info-card not-ready-card">
          <h3>Not Ready to Talk Yet?</h3>
          <p class="not-ready-text">That's okay. Get our free guide on how much missed calls are really costing your practice.</p>
          <a href="/resources/roi-calculator/" class="alt-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
            Calculate My Lost Revenue
          </a>
          <div class="alt-options">
            <a href="/compare/" class="alt-link">Compare Solutions</a>
            <a href="/how-it-works/" class="alt-link">See How It Works</a>
          </div>
        </Card>
      </div>
    </div>

    <!-- FAQ Quick Links -->
    <section class="faq-quick">
      <h2>Common Questions</h2>
      <div class="faq-links">
        <a href="/pricing/" class="faq-link">
          <span class="faq-question">How much does it cost?</span>
          <span class="faq-arrow">&rarr;</span>
        </a>
        <a href="/hipaa-compliance/" class="faq-link">
          <span class="faq-question">Is MyBCAT HIPAA compliant?</span>
          <span class="faq-arrow">&rarr;</span>
        </a>
        <a href="/about/" class="faq-link">
          <span class="faq-question">Who is behind MyBCAT?</span>
          <span class="faq-arrow">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .contact-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 32px;
    margin-bottom: 60px;
  }

  .form-section {
    min-height: 500px;
  }

  /* Enterprise Qualifier */
  .enterprise-qualifier {
    background: linear-gradient(135deg, var(--navy-900) 0%, #1a3a3d 100%);
    border-radius: 16px 16px 0 0;
    padding: 20px 24px;
    margin-bottom: 0;
  }

  .qualifier-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 12px;
  }

  .qualifier-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .qualifier-tag {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .qualifier-tag.highlight {
    background: var(--oceanic-teal);
    border-color: var(--oceanic-teal);
    color: white;
  }

  .enterprise-qualifier + :global(.form-card) {
    border-radius: 0 0 16px 16px;
  }

  :global(.form-card) {
    height: 100%;
    padding: 40px;
  }

  :global(.form-card) h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
    text-align: center;
  }

  .form-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hubspot-form-wrapper {
    margin-top: 24px;
    position: relative;
    min-height: 350px;
  }

  /* Loading Skeleton */
  .form-skeleton {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-skeleton.hidden {
    display: none;
  }

  .skeleton-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .skeleton-field {
    height: 48px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: 8px;
  }

  .skeleton-field.full {
    width: 100%;
  }

  .skeleton-field.short {
    width: 60%;
  }

  .skeleton-button {
    height: 50px;
    background: linear-gradient(90deg, var(--glass-teal) 25%, rgba(0, 96, 100, 0.15) 50%, var(--glass-teal) 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: 8px;
    margin-top: 8px;
  }

  @keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* HubSpot Form Styling */
  :global(.hs-form-html) {
    width: 100%;
  }

  :global(.hs-form-html form) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :global(.hs-form-html .hs-form-field) {
    margin-bottom: 0;
  }

  :global(.hs-form-html label) {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 6px;
  }

  :global(.hs-form-html input[type="text"]),
  :global(.hs-form-html input[type="email"]),
  :global(.hs-form-html input[type="tel"]),
  :global(.hs-form-html input[type="number"]),
  :global(.hs-form-html select),
  :global(.hs-form-html textarea) {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    font-size: 15px;
    color: var(--navy-900);
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  :global(.hs-form-html input:focus),
  :global(.hs-form-html select:focus),
  :global(.hs-form-html textarea:focus) {
    outline: none;
    border-color: var(--oceanic-teal);
    box-shadow: 0 0 0 3px rgba(0, 96, 100, 0.1);
  }

  :global(.hs-form-html textarea) {
    min-height: 100px;
    resize: vertical;
  }

  :global(.hs-form-html .hs-submit) {
    margin-top: 8px;
  }

  :global(.hs-form-html input[type="submit"]),
  :global(.hs-form-html .hs-button) {
    width: 100%;
    padding: 14px 24px;
    background: var(--oceanic-teal);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  :global(.hs-form-html input[type="submit"]:hover),
  :global(.hs-form-html .hs-button:hover) {
    background: var(--navy-900);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(211, 175, 94, 0.5);
  }

  :global(.hs-form-html .hs-error-msgs) {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
  }

  :global(.hs-form-html .hs-error-msgs li) {
    color: #dc3545;
    font-size: 13px;
  }

  :global(.hs-form-html .hs-richtext) {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  :global(.hs-form-html .legal-consent-container) {
    font-size: 13px;
    color: var(--text-muted);
  }

  :global(.hs-form-html .submitted-message) {
    text-align: center;
    padding: 40px 20px;
    color: var(--oceanic-teal);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :global(.info-card) {
    padding: 24px;
  }

  :global(.info-card) h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .expect-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .expect-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-size: 15px;
    color: var(--text-secondary);
  }

  .check {
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 14px;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--oceanic-teal);
    color: white;
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .method-icon {
    width: 40px;
    height: 40px;
    background: var(--glass-teal);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--oceanic-teal);
  }

  .method-details {
    display: flex;
    flex-direction: column;
  }

  .method-label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .method-details a,
  .method-details span:not(.method-label) {
    font-size: 15px;
    color: var(--navy-900);
    font-weight: 500;
  }

  .method-details a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .method-details a:hover {
    color: var(--oceanic-teal);
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--navy-900);
    font-weight: 500;
  }

  .trust-badge svg {
    color: var(--oceanic-teal);
    flex-shrink: 0;
  }

  /* Enterprise Questions Card */
  .enterprise-questions-card {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    border: 1px solid var(--copper-500);
  }

  .prep-text {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .prep-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .prep-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--text-secondary);
    padding: 8px 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .prep-list li:last-child {
    border-bottom: none;
  }

  .prep-list svg {
    color: var(--copper-500);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Not Ready Card */
  .not-ready-card {
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.05) 0%, rgba(0, 96, 100, 0.02) 100%);
    border: 1px dashed var(--oceanic-teal);
  }

  .not-ready-text {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .alt-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    background: var(--oceanic-teal);
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s;
    margin-bottom: 12px;
  }

  .alt-cta:hover {
    background: var(--navy-900);
  }

  .alt-options {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .alt-link {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .alt-link:hover {
    color: var(--oceanic-teal);
  }

  .faq-quick {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 40px;
  }

  .faq-quick h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 24px;
    text-align: center;
  }

  .faq-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .faq-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .faq-link:hover {
    border-color: var(--oceanic-teal);
    transform: translateX(4px);
  }

  .faq-question {
    font-size: 15px;
    font-weight: 500;
    color: var(--navy-900);
  }

  .faq-arrow {
    color: var(--oceanic-teal);
    font-weight: 600;
    transition: transform 0.2s;
  }

  .faq-link:hover .faq-arrow {
    transform: translateX(4px);
  }

  /* Form content fade-out transition */
  #form-content {
    transition: opacity 150ms ease-out;
  }

  #form-content.fading {
    opacity: 0;
  }

  /* Post-submit state */
  #post-submit-state {
    display: none;
    opacity: 0;
    transition: opacity 150ms ease-in;
  }

  #post-submit-state.visible {
    opacity: 1;
  }

  /* Post-submit thank-you message */
  .post-submit-message {
    text-align: center;
    padding: 24px 0 32px;
  }

  .post-submit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
