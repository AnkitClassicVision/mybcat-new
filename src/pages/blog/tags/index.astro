---
/**
 * Blog Tag Directory
 * URL: /blog/tags/
 *
 * Purpose:
 * - Provide a crawlable hub for tag pages (Option B: tags are indexable).
 * - Help users discover older content by topic.
 */
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { company } from '@data/company';
import { isPostVisible } from '@utils/blog';

const posts = (await getCollection('blog'))
  .filter(post => isPostVisible(post.data));

const tagCounts = new Map<string, number>();
for (const post of posts) {
  const tags = post.data.tags;
  if (!tags || !Array.isArray(tags)) continue;

  for (const rawTag of tags) {
    if (typeof rawTag !== 'string') continue;
    const slug = rawTag.toLowerCase().trim().replace(/\s+/g, '-');
    if (!slug) continue;
    tagCounts.set(slug, (tagCounts.get(slug) || 0) + 1);
  }
}

const acronymMap: Record<string, string> = {
  ai: 'AI',
  baa: 'BAA',
  bpo: 'BPO',
  cls: 'CLS',
  dso: 'DSO',
  ehr: 'EHR',
  ent: 'ENT',
  gdpr: 'GDPR',
  hipaa: 'HIPAA',
  kpi: 'KPI',
  kpis: 'KPIs',
  pe: 'PE',
  roi: 'ROI',
  sla: 'SLA',
  sms: 'SMS',
  vsp: 'VSP',
};

function toDisplayTag(slug: string): string {
  const normalized = slug.toLowerCase();
  if (normalized === 'm-and-a') return 'M&A';

  return normalized
    .split('-')
    .map((word) => acronymMap[word] || (word.charAt(0).toUpperCase() + word.slice(1)))
    .join(' ');
}

const tags = Array.from(tagCounts.entries())
  .map(([slug, count]) => ({ slug, count, name: toDisplayTag(slug) }))
  .sort((a, b) => (b.count - a.count) || a.name.localeCompare(b.name));

const metaTitle = `Blog Tags & Topics Directory | ${company.shortName}`;
const metaDescription = `Browse ${tags.length} blog topics from ${company.shortName}. Find articles by tag and explore playbooks for intake, scheduling, recall, and growth.`;
---

<Base
  title={metaTitle}
  description={metaDescription}
>
  <main id="main-content" class="tags-page">
    <header class="tags-header">
      <div class="header-content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a>
          <span class="separator">/</span>
          <span class="current">Tags</span>
        </nav>
        <h1>Browse by Tag</h1>
        <p class="subtitle">
          Explore {tags.length} topics across patient intake, operations, and growth. Each tag page stays indexable and links to its articles.
        </p>
      </div>
    </header>

    <div class="tags-container">
      <div class="tags-grid" role="list" aria-label="Blog tags">
        {tags.map(({ slug, name, count }) => (
          <a role="listitem" class="tag-card" href={`/blog/tag/${slug}/`}>
            <span class="tag-name">{name}</span>
            <span class="tag-count">{count} {count === 1 ? 'article' : 'articles'}</span>
          </a>
        ))}
      </div>

      <div class="cta-row">
        <a href="/blog/" class="cta-link">View all articles</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .tags-page {
    padding-top: 80px;
  }

  .tags-header {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 60px 24px;
    text-align: center;
  }

  .header-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: var(--text-secondary);
    font-size: 14px;
    margin-bottom: 18px;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .separator {
    opacity: 0.7;
  }

  .tags-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 14px;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .tags-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .tags-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .tag-card {
    display: grid;
    gap: 8px;
    padding: 16px 16px 14px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .tag-card:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 96, 100, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .tag-name {
    font-weight: 700;
    color: var(--navy-900);
  }

  .tag-count {
    color: var(--text-secondary);
    font-size: 14px;
  }

  .cta-row {
    display: flex;
    justify-content: center;
    margin-top: 26px;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--oceanic-teal);
    color: white;
    text-decoration: none;
    font-weight: 600;
  }

  .cta-link:hover {
    filter: brightness(1.05);
  }

  @media (max-width: 1024px) {
    .tags-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .tags-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .tags-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

