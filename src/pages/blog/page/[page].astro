---
/**
 * Blog Pagination Page
 * URL: /blog/page/{n}/ (starts at 2; page 1 is /blog/)
 */
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPostVisible } from '@utils/blog';
import { getResponsiveSrcset } from '@utils/responsive-image';
import Pagination from '@/components/blog/Pagination.astro';

const PAGE_SIZE = 18;

export async function getStaticPaths() {
  // Note: Astro compiles getStaticPaths separately from the page component.
  // Keep build-time constants scoped here to avoid undefined references.
  const BUILD_PAGE_SIZE = 18;

  const posts = await getCollection('blog', ({ data }) => isPostVisible(data));
  const totalPages = Math.ceil(posts.length / BUILD_PAGE_SIZE);

  const paths = [];
  for (let pageNum = 2; pageNum <= totalPages; pageNum++) {
    paths.push({ params: { page: String(pageNum) } });
  }

  return paths;
}

const pageNum = Number(Astro.params.page);

// Get all visible blog posts, sorted by date (must match /blog/).
const allPosts = (await getCollection('blog'))
  .filter(post => isPostVisible(post.data))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

// Safety: if someone hits an out-of-range page, keep it from crashing the build.
// (This route only generates valid pages via getStaticPaths.)
if (!Number.isFinite(pageNum) || pageNum < 2 || pageNum > totalPages) {
  throw new Error(`Invalid blog page: ${Astro.params.page}`);
}

const start = (pageNum - 1) * PAGE_SIZE;
const posts: CollectionEntry<'blog'>[] = allPosts.slice(start, start + PAGE_SIZE);

// Get unique categories (same as /blog/ for consistent navigation).
const categories = [...new Set(allPosts.map(post => post.data.category))];

const prevUrl = pageNum === 2 ? '/blog/' : `/blog/page/${pageNum - 1}/`;
const nextUrl = pageNum < totalPages ? `/blog/page/${pageNum + 1}/` : null;
const canonical = `https://mybcat.com/blog/page/${pageNum}/`;

const metaDescription = `Expert insights on patient intake, practice growth, and healthcare operations. Page ${pageNum} of ${totalPages}: browse older playbooks to fill schedules and scale.`;
---

<Base
  title={`Healthcare Practice Growth Blog - Page ${pageNum} | MyBCAT`}
  description={metaDescription}
  canonical={canonical}
>
  <Fragment slot="head">
    <link rel="prev" href={prevUrl} />
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <main id="main-content" class="blog-page">
    <header class="blog-header">
      <div class="header-content">
        <h1>Patient Intake & Healthcare Practice Growth Blog</h1>
        <p>Page {pageNum} of {totalPages}. Browse older articles on patient intake, practice growth, and healthcare operations.</p>
      </div>
    </header>

    <div class="blog-container">
      <!-- Category Filter -->
      <nav class="category-filter" aria-label="Blog categories">
        <a href="/blog/" class="category-link">All Posts</a>
        {categories.map(category => {
          const slug = category.toLowerCase().replace(/\s+/g, '-');
          return (
            <a href={`/blog/category/${slug}/`} class="category-link">{category}</a>
          );
        })}
      </nav>

      <!-- Blog Grid -->
      <div class="blog-grid">
        {posts.map((post, index) => {
          const categorySlug = post.data.category.toLowerCase().replace(/\s+/g, '-');
          return (
            <article class="blog-card">
              <a href={`/blog/${post.slug}/`} class="card-image-link">
                {post.data.featuredImage && (
                  <div class="card-image">
                    {(() => {
                      const srcset = getResponsiveSrcset(post.data.featuredImage);
                      return (
                        <img
                          src={post.data.featuredImage}
                          srcset={srcset ?? undefined}
                          sizes={srcset ? "(max-width: 600px) 100vw, 400px" : undefined}
                          alt={post.data.title}
                          width="400"
                          height="250"
                          loading={index < 3 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      );
                    })()}
                  </div>
                )}
              </a>
              <div class="card-content">
                <div class="card-meta">
                  <a href={`/blog/category/${categorySlug}/`} class="card-category">{post.data.category}</a>
                  <span class="card-date">{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                </div>
                <a href={`/blog/${post.slug}/`} class="card-link">
                  <h2 class="card-title">{post.data.title}</h2>
                  <p class="card-description">{post.data.description}</p>
                </a>
                <div class="card-author">
                  <span>By {post.data.author}</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <Pagination currentPage={pageNum} totalPages={totalPages} basePath="/blog/" pagePathPrefix="page/" />
    </div>
  </main>
</Base>

<style>
  .blog-page {
    padding-top: 80px;
  }

  .blog-header {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 60px 24px;
    text-align: center;
  }

  .header-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .blog-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .blog-header p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .blog-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 40px 24px;
  }

  .category-filter {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 40px;
  }

  .category-link {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .category-link:hover {
    background: var(--navy-900);
    color: white;
    border-color: var(--navy-900);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .blog-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s var(--ease-smooth);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(212, 145, 94, 0.2);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card-image-link {
    display: block;
    text-decoration: none;
  }

  .card-image {
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .blog-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-content {
    padding: 24px;
  }

  .card-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: 13px;
  }

  .card-category {
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s;
  }

  .card-category:hover {
    background: var(--copper-700);
    color: white;
  }

  .card-date {
    color: var(--text-muted);
    display: flex;
    align-items: center;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .card-description {
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-author {
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
