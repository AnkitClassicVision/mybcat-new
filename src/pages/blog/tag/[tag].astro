---
/**
 * Dynamic Tag Page
 * Generates static pages for each blog tag at /blog/tag/{tag-slug}/
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { company } from '@data/company';

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection('blog', ({ data }) => {
    if (data.status !== 'published') return false;
    return data.publishDate <= now;
  });

  // Collect all unique tags from all posts
  const tagSet = new Set<string>();
  for (const post of posts) {
    if (post.data.tags && Array.isArray(post.data.tags)) {
      for (const tag of post.data.tags) {
        // Store the lowercase slugified version
        tagSet.add(tag.toLowerCase().replace(/\s+/g, '-'));
      }
    }
  }

  // Generate a path for each unique tag
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;

// Get all published posts with this tag (exclude future-dated posts)
const now = new Date();
const allPosts = await getCollection('blog', ({ data }) => {
  if (data.status !== 'published') return false;
  return data.publishDate <= now;
});

// Filter posts that have this tag (case-insensitive match)
const tagPosts = allPosts.filter(post => {
  if (!post.data.tags || !Array.isArray(post.data.tags)) return false;
  return post.data.tags.some(t => t.toLowerCase().replace(/\s+/g, '-') === tag);
});

// Sort by publish date descending
tagPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

// Convert slug back to display name (capitalize words)
const displayTag = tag.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
---

<Base
  title={`${displayTag} Articles | ${company.shortName} Blog`}
  description={`Explore expert articles about ${displayTag} for healthcare practices. Strategies, tips, and case studies to improve operations and grow your practice.`}
>
  <main id="main-content" class="tag-page">
    <header class="tag-header">
      <div class="header-content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a>
          <span class="separator">/</span>
          <span class="current">Tag: {displayTag}</span>
        </nav>
        <h1>Articles tagged "{displayTag}"</h1>
        <p class="post-count">{tagPosts.length} {tagPosts.length === 1 ? 'article' : 'articles'}</p>
      </div>
    </header>

    <div class="blog-container">
      {tagPosts.length > 0 ? (
        <div class="blog-grid">
          {tagPosts.map((post, index) => {
            const categorySlug = post.data.category.toLowerCase().replace(/\s+/g, '-');
            return (
              <article class="blog-card">
                <a href={`/blog/${post.slug}/`} class="card-image-link">
                  {post.data.featuredImage && (
                    <div class="card-image">
                      <picture>
                        <source
                          srcset={post.data.featuredImage.replace(/\.(png|jpg|jpeg)$/i, '.webp')}
                          type="image/webp"
                        />
                        <img
                          src={post.data.featuredImage}
                          alt={post.data.title}
                          width="400"
                          height="250"
                          loading={index < 3 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </picture>
                    </div>
                  )}
                </a>
                <div class="card-content">
                  <div class="card-meta">
                    <a href={`/blog/category/${categorySlug}/`} class="card-category">{post.data.category}</a>
                    <span class="card-date">{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                  </div>
                  <a href={`/blog/${post.slug}/`} class="card-link">
                    <h2 class="card-title">{post.data.title}</h2>
                    <p class="card-description">{post.data.description}</p>
                  </a>
                  <div class="card-author">
                    <span>By {post.data.author}</span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="no-posts">
          <p>No articles found with this tag.</p>
          <a href="/blog/" class="back-link">Browse all articles</a>
        </div>
      )}

      <div class="cta-section">
        <a href="/blog/" class="back-to-blog">View All Articles</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .tag-page {
    padding-top: 80px;
  }

  .tag-header {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 60px 24px;
    text-align: center;
  }

  .header-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 14px;
  }

  .breadcrumb a {
    color: var(--oceanic-teal);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--navy-900);
  }

  .breadcrumb .separator {
    color: var(--text-muted);
  }

  .breadcrumb .current {
    color: var(--text-secondary);
  }

  .tag-header h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .post-count {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .blog-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 40px 24px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .blog-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s var(--ease-smooth);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(212, 145, 94, 0.2);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card-image-link {
    display: block;
    text-decoration: none;
  }

  .card-image {
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .blog-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-content {
    padding: 24px;
  }

  .card-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: 13px;
  }

  .card-category {
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s;
  }

  .card-category:hover {
    background: var(--copper-700);
    color: white;
  }

  .card-date {
    color: var(--text-muted);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .card-description {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-author {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .no-posts {
    text-align: center;
    padding: 60px 24px;
    background: var(--glass-navy);
    border-radius: 16px;
  }

  .no-posts p {
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .back-link {
    color: var(--oceanic-teal);
    text-decoration: underline;
    font-weight: 500;
  }

  .cta-section {
    text-align: center;
    padding-top: 48px;
  }

  .back-to-blog {
    display: inline-block;
    padding: 14px 32px;
    background: var(--navy-900);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s;
  }

  .back-to-blog:hover {
    background: var(--oceanic-teal);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
