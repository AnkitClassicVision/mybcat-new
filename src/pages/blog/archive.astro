---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

// Helper: Check if a post should be visible
const isPostVisible = (post: any) => {
  if (post.data.status === 'published') return true;
  if (post.data.status === 'scheduled' && post.data.scheduledDate) {
    return new Date(post.data.scheduledDate) <= new Date();
  }
  return false;
};

// Get all visible blog posts, sorted by date
const posts = (await getCollection('blog'))
  .filter(isPostVisible)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base
  title="All Blog Posts | MyBCAT"
  description="Browse all healthcare practice insights and articles from MyBCAT."
>
  <main id="main-content" class="archive-page">
    <header class="archive-header">
      <a href="/blog/" class="back-link">&larr; Back to Blog</a>
      <h1>All Blog Posts</h1>
      <p>{posts.length} articles on healthcare practice growth</p>
    </header>

    <div class="archive-container">
      <div class="archive-list">
        {posts.map((post) => {
          const categorySlug = post.data.category.toLowerCase().replace(/\s+/g, '-');
          return (
            <article class="archive-item">
              <div class="archive-link-wrapper">
                <div class="archive-meta">
                  <a href={`/blog/category/${categorySlug}/`} class="archive-category">{post.data.category}</a>
                  <span class="archive-date">{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                </div>
                <a href={`/blog/${post.slug}/`} class="archive-link">
                  <h2 class="archive-title">{post.data.title}</h2>
                  <p class="archive-description">{post.data.description}</p>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </main>
</Base>

<style>
  .archive-page {
    padding-top: 80px;
  }

  .archive-header {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 40px 24px 60px;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 24px;
    color: var(--oceanic-teal);
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .archive-header h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .archive-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .archive-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .archive-item {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    transition: all 0.2s;
  }

  .archive-item:hover {
    border-color: rgba(212, 145, 94, 0.3);
    box-shadow: var(--shadow-md);
  }

  .archive-link-wrapper {
    padding: 20px 24px;
  }

  .archive-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .archive-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .archive-category {
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 3px 10px;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .archive-category:hover {
    background: var(--copper-700);
    color: white;
  }

  .archive-date {
    color: var(--text-muted);
  }

  .archive-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--navy-900);
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .archive-description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
