---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { getCollection } from 'astro:content';

// Get all published blog posts, sorted by date
const posts = (await getCollection('blog'))
  .filter(post => post.data.status === 'published')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Get unique categories
const categories = [...new Set(posts.map(post => post.data.category))];
---

<Base
  title="Healthcare Practice Growth Blog | MyBCAT"
  description="Expert insights on patient intake, practice growth, and healthcare operations. Learn how to fill your appointment book and scale your multi-location practice."
>
  <main class="blog-page">
    <header class="blog-header">
      <div class="header-content">
        <h1>Healthcare Practice Insights</h1>
        <p>Expert strategies for patient intake, practice growth, and healthcare operations.</p>
      </div>
    </header>

    <div class="blog-container">
      <!-- Category Filter -->
      <nav class="category-filter" aria-label="Blog categories">
        <a href="/blog" class="category-link active">All Posts</a>
        {categories.map(category => (
          <a href={`/blog?category=${encodeURIComponent(category)}`} class="category-link">{category}</a>
        ))}
      </nav>

      <!-- Blog Grid -->
      <div class="blog-grid">
        {posts.map((post, index) => (
          <article class={`blog-card ${index === 0 ? 'featured' : ''}`}>
            <a href={`/blog/${post.slug}`} class="card-link">
              {post.data.featuredImage && (
                <div class="card-image">
                  <img
                    src={post.data.featuredImage}
                    alt={post.data.title}
                    loading={index < 3 ? 'eager' : 'lazy'}
                  />
                </div>
              )}
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-category">{post.data.category}</span>
                  <span class="card-date">{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                </div>
                <h2 class="card-title">{post.data.title}</h2>
                <p class="card-description">{post.data.description}</p>
                <div class="card-author">
                  <span>By {post.data.author}</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="no-posts">
          <p>No posts yet. Check back soon!</p>
        </div>
      )}
    </div>

    <!-- CTA Section -->
    <section class="blog-cta">
      <div class="cta-content">
        <h2>Want personalized insights for your practice?</h2>
        <p>Book a discovery call to discuss your specific challenges and opportunities.</p>
        <a href="/#final-cta" class="cta-button">Book a Discovery Call</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .blog-page {
    padding-top: 80px;
  }

  .blog-header {
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
    padding: 60px 24px;
    text-align: center;
  }

  .header-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .blog-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .blog-header p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .blog-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 40px 24px;
  }

  /* Category Filter */
  .category-filter {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--glass-border);
  }

  .category-link {
    padding: 8px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-secondary);
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    transition: all 0.2s;
  }

  .category-link:hover {
    background: var(--glass-navy);
    color: var(--navy-900);
  }

  .category-link.active {
    background: var(--oceanic-teal);
    color: white;
    border-color: var(--oceanic-teal);
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* Featured post takes full width */
  .blog-card.featured {
    grid-column: span 3;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
  }

  .blog-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s var(--ease-smooth);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(212, 145, 94, 0.2);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .blog-card.featured .card-link {
    display: grid;
    grid-template-columns: inherit;
    gap: inherit;
  }

  .card-image {
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .blog-card.featured .card-image {
    aspect-ratio: auto;
    height: 100%;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .blog-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-content {
    padding: 24px;
  }

  .blog-card.featured .card-content {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: 13px;
  }

  .card-category {
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .card-date {
    color: var(--text-muted);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .blog-card.featured .card-title {
    font-size: 1.75rem;
    margin-bottom: 12px;
  }

  .card-description {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card.featured .card-description {
    -webkit-line-clamp: 4;
  }

  .card-author {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .no-posts {
    text-align: center;
    padding: 60px 24px;
    color: var(--text-muted);
  }

  /* CTA Section */
  .blog-cta {
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--oceanic-teal) 100%);
    padding: 60px 24px;
    margin-top: 40px;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .blog-cta h2 {
    color: white;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .blog-cta p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.1rem;
    margin-bottom: 24px;
  }

  .cta-button {
    display: inline-block;
    background: white;
    color: var(--oceanic-teal);
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: all 0.3s;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .blog-card.featured {
      grid-column: span 2;
      grid-template-columns: 1fr;
    }

    .blog-card.featured .card-link {
      display: block;
    }

    .blog-card.featured .card-image {
      aspect-ratio: 16/9;
    }
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-card.featured {
      grid-column: span 1;
    }

    .blog-card.featured .card-content {
      padding: 24px;
    }

    .blog-card.featured .card-title {
      font-size: 1.4rem;
    }
  }
</style>
