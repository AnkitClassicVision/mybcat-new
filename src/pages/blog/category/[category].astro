---
/**
 * Blog Category Page
 * Dynamic page for filtering blog posts by category
 */

import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

// Use centralized visibility logic from utils
import { isPostVisible } from '@utils/blog';

// Get all visible posts
const allPosts = await getCollection('blog', ({ data }) => isPostVisible(data));

// Category metadata for SEO and display
const categoryMeta: Record<string, { title: string; description: string; }> = {
  'Technology': {
    title: 'Technology & AI in Healthcare',
    description: 'Explore how technology, AI, and automation are transforming healthcare practice operations, from EHR integrations to intelligent call handling.'
  },
  'Virtual Staffing': {
    title: 'Virtual Staffing Solutions',
    description: 'Learn about virtual receptionist services, remote staffing, and how outsourced teams can support your healthcare practice operations.'
  },
  'Patient Experience': {
    title: 'Patient Experience & Care',
    description: 'Best practices for improving patient satisfaction, communication, and the overall patient journey at your healthcare practice.'
  },
  'Operations': {
    title: 'Practice Operations',
    description: 'Operational insights for running an efficient healthcare practice, from scheduling optimization to workflow improvements.'
  },
  'Growth': {
    title: 'Practice Growth & Revenue',
    description: 'Strategies for growing your healthcare practice, increasing patient acquisition, and maximizing revenue opportunities across every location.'
  },
  'Practice Growth': {
    title: 'Practice Growth Strategies',
    description: 'Proven strategies for scaling your healthcare practice, from patient acquisition to revenue optimization. Built for multi-location healthcare groups.'
  },
  'Industry': {
    title: 'Industry News & Trends',
    description: 'Stay updated on healthcare industry trends, regulations, and developments affecting medical and specialty practices across the U.S.'
  },
  'Practice Management': {
    title: 'Practice Management',
    description: 'Comprehensive guides on starting, managing, and growing a successful healthcare practice including equipment, staffing, location, and finances.'
  },
  'Analytics': {
    title: 'Analytics & Data Insights',
    description: 'Data-driven insights, KPI tracking, and analytics strategies for optimizing healthcare practice performance and patient access operations.'
  },
  'Case Study': {
    title: 'Healthcare Practice Case Studies',
    description: 'Real-world success stories and detailed case studies from healthcare practices using MyBCAT solutions to improve patient intake and grow revenue.'
  },
  'Optometry': {
    title: 'Optometry Practice Insights',
    description: 'Specialized content for optometry practices covering patient care, operations, and growth strategies to help fill schedules and reduce missed calls.'
  },
  'Dental': {
    title: 'Dental Practice Insights',
    description: 'Specialized content for dental practices covering patient experience, operations, and practice growth to capture more calls and appointments.'
  },
  'Enterprise': {
    title: 'Enterprise & Multi-Location Operations',
    description: 'Strategies for scaling healthcare operations across multiple locations, DSO management, PE-backed practice groups, and enterprise-level intake optimization.'
  }
};

export function getStaticPaths() {
  // We need to generate paths at build time
  // Note: 'industry' category removed - no posts exist, redirect handles old links
  return [
    { params: { category: 'technology' } },
    { params: { category: 'virtual-staffing' } },
    { params: { category: 'patient-experience' } },
    { params: { category: 'operations' } },
    { params: { category: 'growth' } },
    { params: { category: 'practice-growth' } },
    { params: { category: 'practice-management' } },
    { params: { category: 'analytics' } },
    { params: { category: 'case-study' } },
    { params: { category: 'optometry' } },
    { params: { category: 'dental' } },
    { params: { category: 'enterprise' } },
  ];
}

const { category } = Astro.params;

// Convert slug to display name
function slugToCategory(slug: string): string {
  const mapping: Record<string, string> = {
    'technology': 'Technology',
    'virtual-staffing': 'Virtual Staffing',
    'patient-experience': 'Patient Experience',
    'operations': 'Operations',
    'growth': 'Growth',
    'practice-growth': 'Practice Growth',
    'industry': 'Industry',
    'practice-management': 'Practice Management',
    'analytics': 'Analytics',
    'case-study': 'Case Study',
    'optometry': 'Optometry',
    'dental': 'Dental',
    'enterprise': 'Enterprise',
  };
  return mapping[slug] || slug;
}

const displayCategory = slugToCategory(category || '');

// Filter posts by category
const categoryPosts = allPosts
  .filter(post => post.data.category === displayCategory)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const meta = categoryMeta[displayCategory] || {
  title: displayCategory,
  description: `Browse all ${displayCategory} articles from the mybcat blog.`
};

// Get all categories with counts for sidebar
const categoryCounts = allPosts.reduce((acc, post) => {
  const cat = post.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<Base
  title={`${meta.title} | MyBCAT Blog`}
  description={meta.description}
>
  <main id="main-content" class="category-page">
    <header class="category-header">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Blog</a>
        <span>/</span>
        <span>{displayCategory}</span>
      </nav>
      <h1>{meta.title}</h1>
      <p class="category-description">{meta.description}</p>
      <div class="post-count">
        {categoryPosts.length} {categoryPosts.length === 1 ? 'article' : 'articles'}
      </div>
    </header>

    <div class="category-layout">
      <aside class="category-sidebar">
        <h2>Categories</h2>
        <ul class="category-list">
          {Object.entries(categoryCounts)
            .sort(([,a], [,b]) => b - a)
            .map(([cat, count]) => {
              const slug = cat.toLowerCase().replace(/\s+/g, '-');
              const isActive = cat === displayCategory;
              return (
                <li>
                  <a href={`/blog/category/${slug}/`} class:list={['category-link', { active: isActive }]}>
                    <span class="cat-name">{cat}</span>
                    <span class="cat-count">{count}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <a href="/blog/" class="all-posts-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          All Posts
        </a>
      </aside>

      <div class="posts-grid">
        {categoryPosts.length > 0 ? (
          categoryPosts.map((post) => (
            <article class="post-card">
              {post.data.featuredImage && (
                <a href={`/blog/${post.slug}/`} class="post-image">
                  <picture>
                    <source
                      srcset={post.data.featuredImage.replace(/\.(png|jpg|jpeg)$/i, '.webp')}
                      type="image/webp"
                    />
                    <img
                      src={post.data.featuredImage}
                      alt={post.data.title}
                      width="400"
                      height="250"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </a>
              )}
              <div class="post-content">
                <div class="post-meta">
                  <span class="post-date">
                    {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </span>
                </div>
                <h2 class="post-title">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                <p class="post-excerpt">{post.data.description}</p>
                <div class="post-tags">
                  {post.data.tags?.slice(0, 3).map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))
        ) : (
          <div class="no-posts">
            <p>No articles in this category yet.</p>
            <a href="/blog/" class="back-link">Browse all articles</a>
          </div>
        )}
      </div>
    </div>
  </main>
</Base>

<style>
  .category-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 24px 60px;
  }

  .category-header {
    text-align: center;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--glass-border);
  }

  .breadcrumb {
    display: flex;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .breadcrumb a {
    color: var(--oceanic-teal);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .category-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .category-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 16px;
    line-height: 1.6;
  }

  .post-count {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .category-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
  }

  .category-sidebar {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .category-sidebar h2 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }

  .category-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 15px;
    transition: all 0.2s;
  }

  .category-link:hover {
    background: var(--glass-navy);
    color: var(--navy-900);
  }

  .category-link.active {
    background: var(--glass-teal);
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  .cat-count {
    font-size: 13px;
    background: var(--glass-navy);
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--text-muted);
  }

  .category-link.active .cat-count {
    background: rgba(0, 96, 100, 0.2);
    color: var(--oceanic-teal);
  }

  .all-posts-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--oceanic-teal);
    text-decoration: none;
    padding: 12px 14px;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    transition: all 0.2s;
  }

  .all-posts-link:hover {
    background: var(--glass-teal);
    border-color: var(--oceanic-teal);
  }

  .posts-grid {
    display: grid;
    gap: 32px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s;
  }

  .post-card:hover {
    box-shadow: 0 8px 32px rgba(0, 96, 100, 0.1);
    border-color: rgba(0, 96, 100, 0.2);
  }

  .post-image {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--glass-navy);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .post-card:hover .post-image img {
    transform: scale(1.05);
  }

  .post-content {
    padding: 24px 24px 24px 0;
    display: flex;
    flex-direction: column;
  }

  .post-meta {
    margin-bottom: 12px;
  }

  .post-date {
    font-size: 13px;
    color: var(--text-muted);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 12px;
  }

  .post-title a {
    color: var(--navy-900);
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--oceanic-teal);
  }

  .post-excerpt {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 12px;
    padding: 4px 10px;
    background: var(--glass-navy);
    border-radius: 999px;
    color: var(--navy-800);
  }

  .no-posts {
    text-align: center;
    padding: 60px 24px;
    background: var(--glass-navy);
    border-radius: 16px;
  }

  .no-posts p {
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .back-link {
    color: var(--oceanic-teal);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .category-layout {
      grid-template-columns: 1fr;
    }

    .category-sidebar {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--glass-border);
    }

    .category-sidebar h2 {
      width: 100%;
      margin-bottom: 8px;
    }

    .category-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0;
    }

    .category-link {
      padding: 6px 12px;
      font-size: 14px;
    }

    .all-posts-link {
      margin-top: 0;
    }

    .post-card {
      grid-template-columns: 1fr;
    }

    .post-content {
      padding: 20px;
    }
  }
</style>
