---
import Blog from '@/layouts/Blog.astro';
import { getCollection } from 'astro:content';
import { isPostVisible } from '@utils/blog';

export async function getStaticPaths() {
  // Generate pages for posts that are currently visible.
  // Keeps list pages and detail pages in sync (prevents broken internal links).
  const posts = await getCollection('blog', ({ data }) => isPostVisible(data));
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Blog post={post}>
  <Content />
</Blog>
