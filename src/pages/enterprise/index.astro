---
/**
 * Enterprise Hub Page
 * Multi-location patient operations landing page
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/sections/CTA.astro';
import FAQ from '@/components/sections/FAQ.astro';
import { enterpriseHub, enterpriseVerticals } from '@data/enterprise';
import { company } from '@data/company';
import { getFAQsByCategory } from '@data/faq';

// Icons for capabilities
const icons: Record<string, string> = {
  'phone': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  'link': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>',
  'settings': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>',
  'chart': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>',
  'refresh': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>',
  'growth': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>',
  'tooth': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2c-2 0-3.5.5-4.5 1.5S6 5.5 6 7c0 2 1 3.5 1 5.5S6 15 6 17c0 3 1.5 5 3.5 5 1.5 0 2-1 2.5-2.5s1-2.5 2.5-2.5 2 1 2.5 2.5 1 2.5 2.5 2.5c2 0 3.5-2 3.5-5 0-2-1-3.5-1-5.5s1-3.5 1-5.5c0-1.5-.5-3-1.5-4S14 2 12 2z"></path></svg>',
  'eye': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>',
  'paw': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="17" rx="5" ry="4"></ellipse><circle cx="6" cy="10" r="2"></circle><circle cx="18" cy="10" r="2"></circle><circle cx="9" cy="6" r="2"></circle><circle cx="15" cy="6" r="2"></circle></svg>',
  'clock': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>'
};

// Vertical icons mapping
const verticalIcons: Record<string, string> = {
  'tooth': icons.tooth,
  'eye': icons.eye,
  'paw': icons.paw,
  'clock': icons.clock
};

// Get enterprise FAQs (using general for now, can create enterprise category)
const enterpriseFaqs = getFAQsByCategory('general').slice(0, 4);
---

<PageLayout
  title={`${enterpriseHub.title} | MyBCAT`}
  description={enterpriseHub.metaDescription}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Enterprise' }
  ]}
>
  <div class="enterprise-page">
    <!-- Hero Section -->
    <section class="enterprise-hero">
      <div class="hero-content">
        <div class="hero-eyebrow">For Healthcare Groups</div>
        <h1>{enterpriseHub.headline}</h1>
        <p class="hero-tagline">{enterpriseHub.tagline}</p>
        <div class="hero-ctas">
          <Button href="/contact/" variant="primary">Talk to Enterprise Team</Button>
          <Button href="#how-it-works" variant="secondary">See How It Works</Button>
        </div>
        <div class="hero-trust">
          {enterpriseHub.trust.map(item => (
            <div class="trust-item">
              <span class="trust-value">{item.value}</span>
              <span class="trust-label">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Problem Section -->
    <section class="problem-section">
      <div class="section-header">
        <div class="eyebrow">The Challenge</div>
        <h2>{enterpriseHub.problem.headline}</h2>
        <p class="section-subtitle">{enterpriseHub.problem.description}</p>
      </div>

      <div class="problem-stats">
        {enterpriseHub.problem.stats.map(stat => (
          <div class="stat-card">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
      <p class="stats-disclaimer">Industry statistics based on healthcare staffing and practice management research. Individual practice metrics vary.</p>

      <div class="pain-points">
        {enterpriseHub.problem.painPoints.map(point => (
          <div class="pain-point">
            <h3>{point.title}</h3>
            <p>{point.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Solution Section -->
    <section class="solution-section" id="how-it-works">
      <div class="section-header">
        <div class="eyebrow">The Solution</div>
        <h2>{enterpriseHub.solution.headline}</h2>
        <p class="section-subtitle">{enterpriseHub.solution.description}</p>
      </div>

      <div class="capabilities-grid">
        {enterpriseHub.solution.capabilities.map(capability => (
          <div class="capability-card">
            <div class="capability-icon">
              <Fragment set:html={icons[capability.icon] || icons.phone} />
            </div>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Enterprise Buyer Blocks Section -->
    <section class="buyer-blocks-section">
      <div class="section-header">
        <div class="eyebrow">For Your Team</div>
        <h2>Built for Enterprise Evaluation</h2>
        <p class="section-subtitle">Information your operations, finance, and compliance teams need to make a decision.</p>
      </div>

      <div class="buyer-blocks-grid">
        <!-- Operations Block -->
        <div class="buyer-block ops">
          <div class="block-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </div>
          <div class="block-header">
            <span class="block-label">For Operations Leaders</span>
            <h3>SLAs & Quality Assurance</h3>
          </div>
          <ul class="block-list">
            <li>
              <strong>Answer Rate SLA:</strong> 95%+ calls answered within 3 rings
            </li>
            <li>
              <strong>Phased Rollout Plan:</strong> Pilot 1-2 locations, then scale at your pace
            </li>
            <li>
              <strong>Escalation Protocol:</strong> Tiered escalation with direct manager access
            </li>
            <li>
              <strong>QA Calibration:</strong> Weekly call reviews, monthly calibration sessions
            </li>
            <li>
              <strong>Real-Time Dashboards:</strong> Answer rates, booking rates, wait times by location
            </li>
          </ul>
          <div class="block-cta">
            <a href="/contact/" class="block-link">Request SLA Documentation →</a>
          </div>
        </div>

        <!-- Finance Block -->
        <div class="buyer-block finance">
          <div class="block-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <div class="block-header">
            <span class="block-label">For Finance Leaders</span>
            <h3>Cost & ROI Analysis</h3>
          </div>
          <ul class="block-list">
            <li>
              <strong>Cost Per Booked Appointment:</strong> Transparent unit economics for budgeting
            </li>
            <li>
              <strong>Staffing Cost Avoidance:</strong> Replaces 2-3 FTEs per 5 locations
            </li>
            <li>
              <strong>EBITDA Impact:</strong> Variable cost model improves margins on growth
            </li>
            <li>
              <strong>No Capital Outlay:</strong> No hiring, training, or infrastructure costs
            </li>
            <li>
              <strong>Predictable Pricing:</strong> Weekly base + volume, no surprise charges
            </li>
          </ul>
          <div class="block-cta">
            <a href="/compare/build-vs-buy/" class="block-link">View Build vs Buy Analysis →</a>
          </div>
        </div>

        <!-- IT/Compliance Block -->
        <div class="buyer-block compliance">
          <div class="block-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div class="block-header">
            <span class="block-label">For IT & Compliance</span>
            <h3>Security & Data Governance</h3>
          </div>
          <ul class="block-list">
            <li>
              <strong>Access Controls:</strong> Role-based access, MFA required, session timeouts
            </li>
            <li>
              <strong>Audit Trails:</strong> Complete logging of all PHI access and changes
            </li>
            <li>
              <strong>BAA Provided:</strong> Signed Business Associate Agreement before go-live
            </li>
            <li>
              <strong>PHI Location:</strong> Data stays in your EHR; we access, not store
            </li>
            <li>
              <strong>Encryption:</strong> TLS 1.3 in transit, AES-256 at rest where applicable
            </li>
          </ul>
          <div class="block-cta">
            <a href="/hipaa-compliance/" class="block-link">View Security Documentation →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Verticals Section -->
    <section class="verticals-section">
      <div class="section-header">
        <div class="eyebrow">Who We Serve</div>
        <h2>Enterprise Solutions by Industry</h2>
        <p class="section-subtitle">Specialized patient operations for every healthcare vertical.</p>
      </div>

      <div class="verticals-grid">
        {enterpriseVerticals.map(vertical => (
          <a href={`/enterprise/${vertical.slug}/`} class="vertical-card">
            <div class="vertical-icon">
              <Fragment set:html={verticalIcons[vertical.icon] || icons.phone} />
            </div>
            <h3>{vertical.name}</h3>
            <p>{vertical.tagline}</p>
            <div class="vertical-integrations">
              {vertical.integrations.slice(0, 3).map(int => (
                <span class="integration-tag">{int}</span>
              ))}
            </div>
            <span class="vertical-link">Learn more →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Process Section -->
    <section class="process-section">
      <div class="section-header">
        <div class="eyebrow">How It Works</div>
        <h2>From Discovery to Go-Live</h2>
        <p class="section-subtitle">A phased approach that minimizes disruption and maximizes results.</p>
      </div>

      <div class="process-steps">
        {enterpriseHub.process.map(step => (
          <div class="process-step">
            <div class="step-number">{step.step}</div>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="process-cta">
        <Button href="/enterprise/implementation/" variant="secondary">View Full Implementation Timeline</Button>
      </div>
    </section>

    <!-- 30-Day Pilot Program -->
    <section class="pilot-section">
      <div class="pilot-card">
        <div class="pilot-badge">Low-Risk Start</div>
        <h2>30-Day Pilot Program</h2>
        <p class="pilot-tagline">Test us with 1-2 locations before committing your entire organization.</p>

        <div class="pilot-features">
          <div class="pilot-feature">
            <div class="pilot-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <div class="pilot-feature-content">
              <h3 class="pilot-feature-title">No Long-Term Commitment</h3>
              <p>30 days to prove ROI. Cancel anytime if we don't deliver.</p>
            </div>
          </div>
          <div class="pilot-feature">
            <div class="pilot-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="pilot-feature-content">
              <h3 class="pilot-feature-title">Live in 5-7 Days</h3>
              <p>Pilot locations go live fast. See results within the first week.</p>
            </div>
          </div>
          <div class="pilot-feature">
            <div class="pilot-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            </div>
            <div class="pilot-feature-content">
              <h3 class="pilot-feature-title">Full Metrics Dashboard</h3>
              <p>Track answer rates, booking rates, and patient satisfaction from day one.</p>
            </div>
          </div>
          <div class="pilot-feature">
            <div class="pilot-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="pilot-feature-content">
              <h3 class="pilot-feature-title">Dedicated Success Manager</h3>
              <p>Single point of contact for your pilot. Weekly check-ins and optimization.</p>
            </div>
          </div>
        </div>

        <div class="pilot-cta">
          <Button href="/contact/" variant="primary">Start Your 30-Day Pilot</Button>
          <span class="pilot-note">No setup fees for pilot locations</span>
        </div>
      </div>
    </section>

    <!-- Infrastructure Section -->
    <section class="infrastructure-section">
      <div class="section-header">
        <div class="eyebrow">Enterprise-Grade</div>
        <h2>Built to Scale With You</h2>
        <p class="section-subtitle">The infrastructure to handle 5 locations or 500.</p>
      </div>

      <div class="infra-grid">
        <div class="infra-item">
          <div class="infra-value">50+</div>
          <div class="infra-label">Trained Coordinators</div>
          <div class="infra-desc">US-based leadership + HIPAA-trained global delivery team</div>
        </div>
        <div class="infra-item">
          <div class="infra-value">3</div>
          <div class="infra-label">Time Zones Covered</div>
          <div class="infra-desc">East, Central, and Pacific coverage for true 24/7 support</div>
        </div>
        <div class="infra-item">
          <div class="infra-value">99.9%</div>
          <div class="infra-label">Uptime SLA</div>
          <div class="infra-desc">Enterprise-grade reliability with redundant systems</div>
        </div>
        <div class="infra-item">
          <div class="infra-value">&lt;3</div>
          <div class="infra-label">Rings to Answer</div>
          <div class="infra-desc">No patient waits. No voicemail. Every call answered live.</div>
        </div>
      </div>

      <div class="compliance-badges">
        <div class="compliance-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>HIPAA Compliant</span>
        </div>
        <div class="compliance-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          <span>BAA Provided</span>
        </div>
        <div class="compliance-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>Encrypted Communications</span>
        </div>
        <div class="compliance-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>
          <span>Audit Trails</span>
        </div>
      </div>
    </section>

    <!-- Case Study Teaser -->
    <section class="case-study-section">
      <Card variant="testimonial" class="case-study-card">
        <div class="case-study-content">
          <div class="case-study-badge">Case Study</div>
          <h3>How a 5-Location Optometry Group Centralized Patient Operations</h3>
          <p>"We were struggling to maintain consistent phone coverage across all our locations. My Business Care Team gave us one team that handles everything. Our call answer rate went from 67% to 100%, and we are booking 40% more appointments."</p>
          <div class="case-study-author">
            <img src="/videos/dittman-headshot-optimized.webp" alt="Dr. Michael Dittman" width="48" height="48" loading="lazy" />
            <div>
              <strong>Dr. Michael Dittman</strong>
              <span>Dittman Eye Care (5 Locations)</span>
            </div>
          </div>
          <Button href="/case-studies/" variant="secondary">Read Full Case Study</Button>
        </div>
      </Card>
    </section>

    <!-- Comparison CTA -->
    <section class="comparison-section">
      <div class="comparison-content">
        <div class="eyebrow">Resources</div>
        <h2>Build vs. Buy: Multi-Location Call Center Analysis</h2>
        <p>Should you build an in-house centralized call center or partner with us? Get a detailed cost analysis and decision framework.</p>
        <Button href="/compare/build-vs-buy/" variant="secondary">Read the Analysis</Button>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <FAQ
        items={enterpriseFaqs}
        title="Enterprise FAQ"
        eyebrow="Common Questions"
      />
    </section>

    <!-- Final CTA -->
    <CTA
      title="Ready to Centralize Your Patient Operations?"
      subtitle="Book a discovery call to see how My Business Care Team can support your multi-location growth."
      buttonText="Talk to Enterprise Team"
      buttonHref="/contact/"
    />
  </div>
</PageLayout>

<style>
  .enterprise-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Hero Section */
  .enterprise-hero {
    padding: 80px 0 60px;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--oceanic-teal);
    margin-bottom: 16px;
  }

  .enterprise-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--navy-900);
