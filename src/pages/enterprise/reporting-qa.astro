---
/**
 * Enterprise Reporting & QA Page
 * Dashboards and quality assurance landing page
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/sections/CTA.astro';
import { enterpriseCapabilityPages, getEnterpriseVerticalBySlug } from '@data/enterprise';

const page = enterpriseCapabilityPages.find(p => p.slug === 'reporting-qa')!;

const icons: Record<string, string> = {
  'chart': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>',
  'users': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>',
  'map': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>',
  'shield': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>'
};

const dashboardMetrics = [
  { name: 'Call Volume', description: 'Inbound calls by location, hour, and day' },
  { name: 'Answer Rate', description: 'Percentage of calls answered within 3 rings' },
  { name: 'Average Handle Time', description: 'Time spent per call by type' },
  { name: 'Booking Rate', description: 'Calls that result in scheduled appointments' },
  { name: 'First-Call Resolution', description: 'Issues resolved without callback' },
  { name: 'Patient Satisfaction', description: 'Post-call survey scores' },
  { name: 'Recall Success', description: 'Outbound recall campaign results' },
  { name: 'Queue Time', description: 'How long patients wait before answer' }
];
---

<PageLayout
  title="Healthcare Call Center Reporting & QA | Dashboards | MyBCAT"
  description={page.metaDescription}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Enterprise', url: '/enterprise/' },
    { name: 'Reporting & QA' }
  ]}
>
  <div class="capability-page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-eyebrow">Enterprise Capability</div>
      <h1>{page.headline}</h1>
      <p class="hero-tagline">{page.tagline}</p>
      <p class="hero-problem">{page.problemStatement}</p>
      <div class="hero-ctas">
        <Button href="/contact/" variant="primary">Book a Discovery Call</Button>
        <Button href="/enterprise/" variant="secondary">See All Enterprise Solutions</Button>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats-section">
      <div class="stats-grid">
        {page.stats.map(stat => (
          <div class="stat-item">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pain Points -->
    <section class="pain-section">
      <div class="section-header">
        <div class="eyebrow">The Problem</div>
        <h2>Why You're Flying Blind</h2>
      </div>
      <div class="pain-list">
        {page.painPoints.map(point => (
          <div class="pain-item">
            <span class="pain-x">✕</span>
            <span>{point}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Dashboard Preview -->
    <section class="dashboard-preview">
      <div class="section-header">
        <div class="eyebrow">Dashboard Preview</div>
        <h2>What Your Dashboard Looks Like</h2>
        <p class="section-subtitle">Real-time visibility across all your locations in one view.</p>
      </div>
      <div class="dashboard-mockup">
        <div class="mockup-header">
          <div class="mockup-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            Enterprise Performance Dashboard
          </div>
          <div class="mockup-date">Last 30 Days</div>
        </div>
        <div class="mockup-grid">
          <!-- KPI Cards -->
          <div class="mockup-kpi green">
            <div class="kpi-label">Answer Rate</div>
            <div class="kpi-value">98.4%</div>
            <div class="kpi-trend up">↑ 3.2% vs last month</div>
          </div>
          <div class="mockup-kpi blue">
            <div class="kpi-label">Avg Handle Time</div>
            <div class="kpi-value">3:42</div>
            <div class="kpi-trend down">↓ 18 sec improvement</div>
          </div>
          <div class="mockup-kpi teal">
            <div class="kpi-label">Booking Rate</div>
            <div class="kpi-value">67%</div>
            <div class="kpi-trend up">↑ 5% vs benchmark</div>
          </div>
          <div class="mockup-kpi gold">
            <div class="kpi-label">Patient Satisfaction</div>
            <div class="kpi-value">4.8/5</div>
            <div class="kpi-trend stable">→ Stable</div>
          </div>
          <!-- Chart Mockup -->
          <div class="mockup-chart">
            <div class="chart-header">
              <span>Call Volume by Location</span>
              <span class="chart-legend">
                <span class="legend-dot answered"></span> Answered
                <span class="legend-dot missed"></span> Missed
              </span>
            </div>
            <div class="chart-bars">
              <div class="bar-group">
                <div class="bar-label">Location A</div>
                <div class="bar-container">
                  <div class="bar answered" style="width: 95%"></div>
                  <div class="bar missed" style="width: 5%"></div>
                </div>
                <div class="bar-value">1,234</div>
              </div>
              <div class="bar-group">
                <div class="bar-label">Location B</div>
                <div class="bar-container">
                  <div class="bar answered" style="width: 92%"></div>
                  <div class="bar missed" style="width: 8%"></div>
                </div>
                <div class="bar-value">987</div>
              </div>
              <div class="bar-group">
                <div class="bar-label">Location C</div>
                <div class="bar-container">
                  <div class="bar answered" style="width: 98%"></div>
                  <div class="bar missed" style="width: 2%"></div>
                </div>
                <div class="bar-value">1,102</div>
              </div>
              <div class="bar-group">
                <div class="bar-label">Location D</div>
                <div class="bar-container">
                  <div class="bar answered" style="width: 97%"></div>
                  <div class="bar missed" style="width: 3%"></div>
                </div>
                <div class="bar-value">856</div>
              </div>
            </div>
          </div>
          <!-- Table Mockup -->
          <div class="mockup-table">
            <div class="table-header">
              <span>Agent Scorecards</span>
              <span class="view-all">View All →</span>
            </div>
            <div class="table-row header-row">
              <span>Agent</span>
              <span>Calls</span>
              <span>Answer Rate</span>
              <span>Score</span>
            </div>
            <div class="table-row">
              <span>Maria T.</span>
              <span>312</span>
              <span>99%</span>
              <span class="score high">4.9</span>
            </div>
            <div class="table-row">
              <span>James L.</span>
              <span>287</span>
              <span>98%</span>
              <span class="score high">4.8</span>
            </div>
            <div class="table-row">
              <span>Sarah K.</span>
              <span>298</span>
              <span>97%</span>
              <span class="score medium">4.6</span>
            </div>
          </div>
        </div>
        <div class="mockup-footer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Data refreshes every 5 minutes | Custom reports available on request
        </div>
      </div>
    </section>

    <!-- Features/Solutions -->
    <section class="features-section">
      <div class="section-header">
        <div class="eyebrow">The Solution</div>
        <h2>Complete Visibility Into Phone Operations</h2>
      </div>
      <div class="features-grid">
        {page.features.map(feature => (
          <div class="feature-card">
            <div class="feature-icon">
              <Fragment set:html={icons[feature.icon] || icons.chart} />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Dashboard Metrics -->
    <section class="metrics-section">
      <div class="section-header">
        <div class="eyebrow">What You'll See</div>
        <h2>Dashboard Metrics</h2>
        <p class="section-subtitle">Real-time visibility into every aspect of your phone operations.</p>
      </div>
      <div class="metrics-grid">
        {dashboardMetrics.map(metric => (
          <div class="metric-card">
            <h3>{metric.name}</h3>
            <p>{metric.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- QA Process -->
    <section class="qa-section">
      <div class="qa-card">
        <div class="qa-header">
          <div class="eyebrow">Quality Assurance</div>
          <h2>How We Maintain Call Quality</h2>
        </div>
        <div class="qa-grid">
          <div class="qa-item">
            <div class="qa-number">1</div>
            <h3>Call Recording</h3>
            <p>100% of calls recorded for review and training purposes.</p>
          </div>
          <div class="qa-item">
            <div class="qa-number">2</div>
            <h3>Weekly Audits</h3>
            <p>Random sample of calls reviewed against quality scorecard.</p>
          </div>
          <div class="qa-item">
            <div class="qa-number">3</div>
            <h3>Agent Coaching</h3>
            <p>Individual feedback sessions based on QA findings.</p>
          </div>
          <div class="qa-item">
            <div class="qa-number">4</div>
            <h3>Continuous Improvement</h3>
            <p>Protocol updates based on trends and feedback.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Verticals -->
    <section class="related-section">
      <div class="section-header">
        <div class="eyebrow">Industry Solutions</div>
        <h2>Reporting for Your Industry</h2>
      </div>
      <div class="related-grid">
        {page.relatedVerticals.map(slug => {
          const vertical = getEnterpriseVerticalBySlug(slug);
          return vertical && (
            <a href={`/enterprise/${slug}/`} class="related-card">
              <h3>{vertical.name}</h3>
              <p>{vertical.tagline}</p>
              <span class="related-link">Learn more →</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <CTA
      title="Ready to See Your Phone Operations Clearly?"
      subtitle="Book a discovery call to see a live dashboard demo."
      buttonText="Book a Discovery Call"
      buttonHref="/contact/"
    />
  </div>
</PageLayout>

<style>
  .capability-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 60px 0 40px;
  }

  .hero-eyebrow {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--oceanic-teal);
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--oceanic-teal);
    font-weight: 600;
    margin-bottom: 20px;
  }

  .hero-problem {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Stats */
  .stats-section {
    padding: 40px 0;
  }

  .stats-grid {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Pain Points */
  .pain-section {
    padding: 60px 0;
  }

  .pain-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
  }

  .pain-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(220, 53, 69, 0.08);
    border: 1px solid rgba(220, 53, 69, 0.2);
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 0.95rem;
    color: var(--navy-900);
  }

  .pain-x {
    color: #dc3545;
    font-weight: 700;
  }

  /* Dashboard Preview */
  .dashboard-preview {
    padding: 60px 0;
  }

  .dashboard-mockup {
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .mockup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: var(--navy-900);
    color: white;
  }

  .mockup-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 600;
  }

  .mockup-title svg {
    opacity: 0.8;
  }

  .mockup-date {
    font-size: 13px;
    background: rgba(255, 255, 255, 0.15);
    padding: 6px 12px;
    border-radius: 6px;
  }

  .mockup-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 24px;
    background: #f8fafc;
  }

  .mockup-kpi {
    background: white;
    border-radius: 12px;
    padding: 20px;
    border-left: 4px solid;
  }

  .mockup-kpi.green { border-color: #10b981; }
  .mockup-kpi.blue { border-color: #3b82f6; }
  .mockup-kpi.teal { border-color: var(--oceanic-teal); }
  .mockup-kpi.gold { border-color: var(--copper-500); }

  .kpi-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .kpi-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 4px;
  }

  .kpi-trend {
    font-size: 12px;
    font-weight: 500;
  }

  .kpi-trend.up { color: #10b981; }
  .kpi-trend.down { color: #10b981; }
  .kpi-trend.stable { color: var(--text-muted); }

  .mockup-chart {
    grid-column: 1 / 3;
    background: white;
    border-radius: 12px;
    padding: 20px;
  }

  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-900);
  }

  .chart-legend {
    display: flex;
    gap: 16px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .legend-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 4px;
    vertical-align: middle;
  }

  .legend-dot.answered { background: var(--oceanic-teal); }
  .legend-dot.missed { background: #ef4444; }

  .chart-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bar-group {
    display: grid;
    grid-template-columns: 80px 1fr 50px;
    align-items: center;
    gap: 12px;
  }

  .bar-label {
    font-size: 13px;
    color: var(--navy-900);
    font-weight: 500;
  }

  .bar-container {
    display: flex;
    height: 20px;
    background: #f1f5f9;
    border-radius: 4px;
    overflow: hidden;
  }

  .bar {
    height: 100%;
  }

  .bar.answered { background: var(--oceanic-teal); }
  .bar.missed { background: #ef4444; }

  .bar-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--navy-900);
    text-align: right;
  }

  .mockup-table {
    grid-column: 3 / 5;
    background: white;
    border-radius: 12px;
    padding: 20px;
  }

  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy-900);
  }

  .view-all {
    font-size: 12px;
    color: var(--oceanic-teal);
    font-weight: 500;
  }

  .table-row {
    display: grid;
    grid-template-columns: 1fr 60px 80px 50px;
    padding: 10px 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 13px;
    color: var(--navy-900);
  }

  .table-row.header-row {
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .score {
    font-weight: 700;
    text-align: center;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .score.high {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .score.medium {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
  }

  .mockup-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    font-size: 12px;
    color: var(--text-muted);
  }

  .mockup-footer svg {
    color: var(--oceanic-teal);
  }

  @media (max-width: 900px) {
    .mockup-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .mockup-chart,
    .mockup-table {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .mockup-grid {
      grid-template-columns: 1fr;
    }

    .mockup-chart,
    .mockup-table {
      grid-column: span 1;
    }
  }

  /* Features */
  .features-section {
    padding: 60px 40px;
    background: var(--glass-navy);
    border-radius: 24px;
    margin-bottom: 60px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .feature-card {
    background: white;
    border-radius: 20px;
    padding: 32px;
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    background: var(--glass-teal);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--oceanic-teal);
  }

  .feature-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Metrics Section */
  .metrics-section {
    padding: 60px 0;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .metric-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 20px;
  }

  .metric-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 6px;
  }

  .metric-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* QA Section */
  .qa-section {
    padding: 60px 0;
  }

  .qa-card {
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.08) 0%, rgba(0, 96, 100, 0.02) 100%);
    border: 2px solid var(--oceanic-teal);
    border-radius: 24px;
    padding: 48px;
  }

  .qa-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .qa-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  .qa-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .qa-item {
    text-align: center;
  }

  .qa-number {
    width: 40px;
    height: 40px;
    background: var(--oceanic-teal);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 auto 12px;
  }

  .qa-item h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .qa-item p {
    font-size: 0.9rem;
    color: var(--text-secondary);
