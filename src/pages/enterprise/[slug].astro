---
/**
 * Enterprise Vertical Page
 * Dynamic page for DSO, Optometry Groups, Veterinary Groups, etc.
 */
import type { GetStaticPaths } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/sections/CTA.astro';
import { enterpriseVerticals, getEnterpriseVerticalBySlug } from '@data/enterprise';

export const getStaticPaths: GetStaticPaths = async () => {
  return enterpriseVerticals.map(vertical => ({
    params: { slug: vertical.slug },
    props: { vertical }
  }));
};

const { vertical } = Astro.props;

// Icons
const icons: Record<string, string> = {
  'phone': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  'link': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>',
  'shield': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>',
  'users': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>',
  'refresh': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>',
  'calendar': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>',
  'clock': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>',
  'clipboard': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>',
  'growth': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>',
  'map': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>'
};
---

<PageLayout
  title={`${vertical.headline} | ${vertical.name} | My Business Care Team`}
  description={vertical.metaDescription}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Enterprise', url: '/enterprise/' },
    { name: vertical.shortName }
  ]}
>
  <div class="vertical-page">
    <!-- Hero Section -->
    <section class="vertical-hero">
      <div class="hero-content">
        <div class="hero-eyebrow">Enterprise Solutions</div>
        <h1>{vertical.headline}</h1>
        <p class="hero-tagline">{vertical.tagline}</p>
        <p class="hero-description">{vertical.description}</p>
        <div class="hero-ctas">
          <Button href="/contact/" variant="primary">{vertical.cta.primary}</Button>
          <Button href="/case-studies/" variant="secondary">{vertical.cta.secondary}</Button>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
      <div class="stats-grid">
        {vertical.stats.map(stat => (
          <div class="stat-item">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pain Points Section -->
    <section class="pain-section">
      <div class="section-header">
        <div class="eyebrow">The Challenge</div>
        <h2>Problems We Solve for {vertical.name}</h2>
      </div>

      <div class="pain-grid">
        {vertical.painPoints.map(point => (
          <div class="pain-card">
            <h3>{point.title}</h3>
            <p>{point.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Solutions Section -->
    <section class="solutions-section">
      <div class="section-header">
        <div class="eyebrow">Our Solutions</div>
        <h2>How We Help {vertical.name}</h2>
      </div>

      <div class="solutions-grid">
        {vertical.solutions.map(solution => (
          <div class="solution-card">
            <div class="solution-icon">
              <Fragment set:html={icons[solution.icon] || icons.phone} />
            </div>
            <h3>{solution.title}</h3>
            <p>{solution.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Integrations Section -->
    <section class="integrations-section">
      <div class="section-header">
        <div class="eyebrow">Integrations</div>
        <h2>We Work With Your Systems</h2>
        <p class="section-subtitle">Direct integration with the practice management systems you already use.</p>
      </div>

      <div class="integrations-list">
        {vertical.integrations.map(integration => (
          <div class="integration-item">
            <span class="integration-check">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </span>
            <span class="integration-name">{integration}</span>
          </div>
        ))}
        <div class="integration-item more">
          <span class="integration-name">+ 50 more systems</span>
        </div>
      </div>
    </section>

    <!-- Related Industry Link -->
    {vertical.parentIndustrySlug && (
      <section class="related-section">
        <Card variant="testimonial" class="related-card">
          <div class="related-content">
            <h3>Looking for single-location solutions?</h3>
            <p>We also support individual {vertical.shortName.toLowerCase()} practices with the same quality service.</p>
            <Button href={`/industries/${vertical.parentIndustrySlug}/`} variant="secondary">
              View {vertical.shortName} Industry Page
            </Button>
          </div>
        </Card>
      </section>
    )}

    <!-- Final CTA -->
    <CTA
      title={`Ready to Centralize Your ${vertical.shortName} Operations?`}
      subtitle={`Book a discovery call to see how My Business Care Team can support your ${vertical.name.toLowerCase()}.`}
      buttonText={vertical.cta.primary}
      buttonHref="/contact/"
    />
  </div>
</PageLayout>

<style>
  .vertical-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Hero */
  .vertical-hero {
    padding: 60px 0 40px;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--oceanic-teal);
    margin-bottom: 16px;
  }

  .vertical-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--oceanic-teal);
    font-weight: 600;
    margin-bottom: 16px;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Stats */
  .stats-section {
    padding: 40px 0;
  }

  .stats-grid {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    max-width: 150px;
  }

  /* Pain Points */
  .pain-section {
    padding: 60px 0;
  }

  .pain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .pain-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-left: 4px solid var(--copper-500);
    border-radius: 16px;
    padding: 28px;
  }

  .pain-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .pain-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Solutions */
  .solutions-section {
    padding: 60px 0;
    background: var(--glass-navy);
    border-radius: 24px;
    margin-bottom: 60px;
    padding-left: 40px;
    padding-right: 40px;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .solution-card {
    background: white;
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .solution-icon {
    width: 56px;
    height: 56px;
    background: var(--glass-teal);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--oceanic-teal);
  }

  .solution-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .solution-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Integrations */
  .integrations-section {
    padding: 60px 0;
  }

  .integrations-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    max-width: 700px;
    margin: 0 auto;
  }

  .integration-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    padding: 12px 20px;
    border-radius: 999px;
  }

  .integration-check {
    color: var(--oceanic-teal);
    display: flex;
  }

  .integration-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--navy-900);
  }

  .integration-item.more {
    background: var(--glass-teal);
    border-color: var(--oceanic-teal);
  }

  .integration-item.more .integration-name {
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  /* Related Section */
  .related-section {
    padding: 40px 0;
  }

  :global(.related-card) {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .related-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .related-content p {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pain-grid,
    .solutions-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      gap: 32px;
    }

    .solutions-section {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
