---
/**
 * Enterprise Patient Access Center Page
 * Centralized patient access services landing page
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
import CTA from '@/components/sections/CTA.astro';
import { enterpriseCapabilityPages, enterpriseRolloutTimeline, getEnterpriseVerticalBySlug } from '@data/enterprise';

const page = enterpriseCapabilityPages.find(p => p.slug === 'patient-access-center')!;

const icons: Record<string, string> = {
  'phone': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  'link': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>',
  'users': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>',
  'map': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>',
  'chart': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>',
  'calendar': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>',
  'clock': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>',
  'shield': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>',
  'refresh': '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>'
};
---

<PageLayout
  title="Centralized Patient Access Center | MyBCAT"
  description={page.metaDescription}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Enterprise', url: '/enterprise/' },
    { name: 'Patient Access Center' }
  ]}
>
  <div class="capability-page">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-eyebrow">Enterprise Capability</div>
      <h1>{page.headline}</h1>
      <p class="hero-tagline">{page.tagline}</p>
      <p class="hero-problem">{page.problemStatement}</p>
      <div class="hero-ctas">
        <Button href="/contact/" variant="primary">Book a Discovery Call</Button>
        <Button href="/enterprise/" variant="secondary">See All Enterprise Solutions</Button>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats-section">
      <div class="stats-grid">
        {page.stats.map(stat => (
          <div class="stat-item">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pain Points -->
    <section class="pain-section">
      <div class="section-header">
        <div class="eyebrow">The Problem</div>
        <h2>Why Multi-Location Phone Operations Break Down</h2>
      </div>
      <div class="pain-list">
        {page.painPoints.map(point => (
          <div class="pain-item">
            <span class="pain-x">✕</span>
            <span>{point}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Features/Solutions -->
    <section class="features-section">
      <div class="section-header">
        <div class="eyebrow">The Solution</div>
        <h2>How Centralized Patient Access Works</h2>
      </div>
      <div class="features-grid">
        {page.features.map(feature => (
          <div class="feature-card">
            <div class="feature-icon">
              <Fragment set:html={icons[feature.icon] || icons.phone} />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Rollout Timeline -->
    <section class="timeline-section">
      <div class="section-header">
        <div class="eyebrow">Implementation</div>
        <h2>How We Roll Out Across Your Locations</h2>
        <p class="section-subtitle">We don't flip a switch. We pilot, perfect, then scale.</p>
      </div>
      <div class="timeline-grid">
        {enterpriseRolloutTimeline.phases.map(phase => (
          <div class="timeline-card">
            <div class="timeline-duration">{phase.duration}</div>
            <h3>{phase.phase}</h3>
            <p class="timeline-desc">{phase.description}</p>
            <ul class="timeline-activities">
              {phase.activities.map(activity => (
                <li>{activity}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Success Metrics -->
    <section class="success-section">
      <div class="section-header">
        <div class="eyebrow">What Success Looks Like</div>
        <h2>30 / 60 / 90 Day Milestones</h2>
      </div>
      <div class="success-grid">
        <div class="success-card">
          <div class="success-day">Day 30</div>
          <ul>
            {enterpriseRolloutTimeline.successMetrics.day30.map(item => (
              <li><span class="check">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div class="success-card">
          <div class="success-day">Day 60</div>
          <ul>
            {enterpriseRolloutTimeline.successMetrics.day60.map(item => (
              <li><span class="check">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div class="success-card highlight">
          <div class="success-day">Day 90</div>
          <ul>
            {enterpriseRolloutTimeline.successMetrics.day90.map(item => (
              <li><span class="check">✓</span> {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Related Verticals -->
    <section class="related-section">
      <div class="section-header">
        <div class="eyebrow">Industry Solutions</div>
        <h2>Patient Access for Your Industry</h2>
      </div>
      <div class="related-grid">
        {page.relatedVerticals.map(slug => {
          const vertical = getEnterpriseVerticalBySlug(slug);
          return vertical && (
            <a href={`/enterprise/${slug}/`} class="related-card">
              <h3>{vertical.name}</h3>
              <p>{vertical.tagline}</p>
              <span class="related-link">Learn more →</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <CTA
      title="Ready to Centralize Patient Access?"
      subtitle="Book a discovery call to see how we can support all your locations."
      buttonText="Book a Discovery Call"
      buttonHref="/contact/"
    />
  </div>
</PageLayout>

<style>
  .capability-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-header h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: 60px 0 40px;
  }

  .hero-eyebrow {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--oceanic-teal);
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--oceanic-teal);
    font-weight: 600;
    margin-bottom: 20px;
  }

  .hero-problem {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Stats */
  .stats-section {
    padding: 40px 0;
  }

  .stats-grid {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--oceanic-teal);
  }

  .stat-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Pain Points */
  .pain-section {
    padding: 60px 0;
  }

  .pain-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
  }

  .pain-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(220, 53, 69, 0.08);
    border: 1px solid rgba(220, 53, 69, 0.2);
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 0.95rem;
    color: var(--navy-900);
  }

  .pain-x {
    color: #dc3545;
    font-weight: 700;
  }

  /* Features */
  .features-section {
    padding: 60px 40px;
    background: var(--glass-navy);
    border-radius: 24px;
    margin-bottom: 60px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .feature-card {
    background: white;
    border-radius: 20px;
    padding: 32px;
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    background: var(--glass-teal);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--oceanic-teal);
  }

  .feature-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Timeline */
  .timeline-section {
    padding: 60px 0;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .timeline-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 24px;
    position: relative;
  }

  .timeline-duration {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--oceanic-teal);
    margin-bottom: 8px;
  }

  .timeline-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .timeline-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .timeline-activities {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-activities li {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 4px 0;
    padding-left: 16px;
    position: relative;
  }

  .timeline-activities li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--oceanic-teal);
  }

  /* Success Metrics */
  .success-section {
    padding: 60px 0;
  }

  .success-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .success-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 28px;
  }

  .success-card.highlight {
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.08) 0%, rgba(0, 96, 100, 0.02) 100%);
    border: 2px solid var(--oceanic-teal);
  }

  .success-day {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--oceanic-teal);
    margin-bottom: 16px;
  }

  .success-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .success-card li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--navy-900);
    padding: 8px 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .success-card li:last-child {
    border-bottom: none;
  }

  .check {
    color: var(--oceanic-teal);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Related */
  .related-section {
    padding: 60px 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .related-card {
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 24px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .related-card:hover {
    border-color: var(--oceanic-teal);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 96, 100, 0.1);
  }

  .related-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .related-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .related-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--oceanic-teal);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .timeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features-grid,
    .success-grid,
    .timeline-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .features-section {
      padding: 40px 24px;
    }
  }
</style>
