---
/**
 * Book Page
 * Optometry Redefined book information and Amazon link
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
---

<PageLayout
  title="Optometry Redefined: Master Global Resourcing | MyBCAT"
  description="The definitive playbook for practice owners seeking to scale without sacrificing margins, sanity, or patient experience. By Ankit Patel."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Resources', url: '/resources/' },
    { name: 'Book' }
  ]}
>
  <div class="book-page">
    <!-- Hero Section -->
    <section class="book-hero">
      <div class="container">
        <div class="book-hero-grid">
          <div class="book-cover">
            <div class="new-release-badge">New Release</div>
            <div class="book-cover-wrapper">
              <img src="/images/book-cover.jpg" alt="Optometry Redefined Book Cover" width="768" height="1376" loading="eager" decoding="async" />
            </div>
          </div>
          <div class="book-hero-content">
            <div class="eyebrow">The Book</div>
            <h1>Optometry Redefined</h1>
            <p class="book-subtitle">Master Global Resourcing for Peak Performance</p>
            <p class="book-author">By Ankit Patel</p>
            <p class="hero-lead">
              The definitive playbook for practice owners seeking to scale without sacrificing margins, sanity, or patient experience. Drawing from operational systems at Classic Vision Care and multi-location practices nationwide.
            </p>
            <div class="book-stats">
              <div class="stat-item">
                <span class="stat-value">200+</span>
                <span class="stat-label">Pages</span>
              </div>
              <div class="stat-item">
                <span class="stat-value">12</span>
                <span class="stat-label">Chapters</span>
              </div>
              <div class="stat-item">
                <span class="stat-value">Kindle</span>
                <span class="stat-label">Format</span>
              </div>
            </div>
            <div class="book-ctas">
              <a href="https://www.amazon.com/Optometry-Redefined-Master-Resourcing-Performance-ebook/dp/B0FKK13S4Z/" target="_blank" rel="noopener noreferrer" class="amazon-btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                  <path d="M15.93 17.09c-.18.16-.43.17-.63.06-.89-.74-1.05-1.08-1.54-1.79-1.47 1.5-2.51 1.95-4.42 1.95-2.25 0-4.01-1.39-4.01-4.17 0-2.18 1.17-3.64 2.86-4.38 1.46-.64 3.49-.76 5.04-.93v-.35c0-.64.05-1.41-.33-1.96-.32-.49-.95-.7-1.5-.7-1.02 0-1.93.53-2.15 1.61-.05.24-.24.48-.5.49l-2.77-.3c-.22-.05-.47-.22-.4-.56.6-3.15 3.45-4.1 6-4.1 1.3 0 3 .35 4.03 1.33C17.11 4.55 17 6.18 17 7.95v4.17c0 1.25.52 1.8 1.01 2.48.17.25.21.54 0 .71-.54.46-1.5 1.32-2.03 1.8l-.05-.02zm-2.45-5.53v-.58c-1.93 0-3.97.41-3.97 2.67 0 1.16.6 1.94 1.63 1.94 1.14 0 2.08-.7 2.4-1.84.08-.29.03-.58-.06-.83v-1.36z"/>
                  <path d="M20.16 19.54C18 21.14 14.82 22 12.1 22c-3.81 0-7.25-1.41-9.85-3.76-.2-.18-.02-.43.22-.29 2.81 1.63 6.28 2.61 9.87 2.61 2.42 0 5.07-.5 7.51-1.54.37-.16.68.24.31.52z"/>
                  <path d="M21.07 18.5c-.28-.36-1.85-.17-2.57-.09-.21.03-.25-.16-.05-.29 1.26-.89 3.32-.63 3.56-.33.25.3-.07 2.35-1.24 3.32-.18.15-.35.07-.27-.13.26-.65.85-2.12.57-2.48z"/>
                </svg>
                Get on Amazon
              </a>
              <Button href="/contact/" variant="secondary">Get My Schedule Filled</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What You'll Learn Section -->
    <section class="learn-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow">Inside the Book</div>
          <h2>What You'll Learn</h2>
        </div>

        <div class="modules-grid">
          <div class="module-card">
            <div class="module-number">01</div>
            <h3>The Global Talent Advantage</h3>
            <p>Explores why the Philippines has become instrumental for scaling practices and building cohesive remote teams.</p>
          </div>
          <div class="module-card">
            <div class="module-number">02</div>
            <h3>The Leaky Bucket Problem</h3>
            <p>Identifies revenue losses from missed calls, abandoned leads, and scheduling inefficiencies costing thousands monthly.</p>
          </div>
          <div class="module-card">
            <div class="module-number">03</div>
            <h3>Lean Six Sigma for Healthcare</h3>
            <p>Applies optimization principles to eliminate waste and create predictable operational outcomes.</p>
          </div>
          <div class="module-card">
            <div class="module-number">04</div>
            <h3>The EBITDA Multiplier</h3>
            <p>Demonstrates how operational efficiency directly impacts practice valuation and exit potential.</p>
          </div>
          <div class="module-card">
            <div class="module-number">05</div>
            <h3>Hybrid Staffing Models</h3>
            <p>Designs balanced onshore-offshore teams maintaining patient satisfaction and profit margins.</p>
          </div>
          <div class="module-card">
            <div class="module-number">06</div>
            <h3>Scaling Without Chaos</h3>
            <p>Provides frameworks for multi-location expansion without proportional management complexity.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote Section -->
    <section class="quote-section">
      <div class="container">
        <blockquote>
          <p>"I didn't write this book to impress anyone. I wrote it because I wish it existed when I was struggling to scale."</p>
          <cite>- Ankit Patel</cite>
        </blockquote>
      </div>
    </section>

    <!-- Author Section -->
    <section class="author-section">
      <div class="container">
        <div class="author-grid">
          <div class="author-image">
            <img src="/images/ankit_headshot_full.webp" alt="Ankit Patel" width="280" height="280" loading="lazy" decoding="async" />
          </div>
          <div class="author-content">
            <div class="eyebrow">About the Author</div>
            <h2>Ankit Patel</h2>
            <p>
              Ankit combines corporate rigor with entrepreneurial experience. His background includes roles at Dell and Cleveland Clinic, plus founding Classic Vision Care and My Business Care Team.
            </p>
            <p>
              He hosts the <strong>Optometrists Building Empires</strong> podcast, where he shares weekly insights with practice owners nationwide.
            </p>
            <div class="author-links">
              <a href="/about/">Read Full Story &rarr;</a>
              <a href="/resources/podcast/">Listen to Podcast &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="book-cta">
      <div class="container">
        <div class="cta-content">
          <h2>Ready to Redefine Your Practice?</h2>
          <p>Get the book and start transforming your operations today.</p>
          <a href="https://www.amazon.com/Optometry-Redefined-Master-Resourcing-Performance-ebook/dp/B0FKK13S4Z/" target="_blank" rel="noopener noreferrer" class="amazon-btn amazon-btn-light">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M15.93 17.09c-.18.16-.43.17-.63.06-.89-.74-1.05-1.08-1.54-1.79-1.47 1.5-2.51 1.95-4.42 1.95-2.25 0-4.01-1.39-4.01-4.17 0-2.18 1.17-3.64 2.86-4.38 1.46-.64 3.49-.76 5.04-.93v-.35c0-.64.05-1.41-.33-1.96-.32-.49-.95-.7-1.5-.7-1.02 0-1.93.53-2.15 1.61-.05.24-.24.48-.5.49l-2.77-.3c-.22-.05-.47-.22-.4-.56.6-3.15 3.45-4.1 6-4.1 1.3 0 3 .35 4.03 1.33C17.11 4.55 17 6.18 17 7.95v4.17c0 1.25.52 1.8 1.01 2.48.17.25.21.54 0 .71-.54.46-1.5 1.32-2.03 1.8l-.05-.02zm-2.45-5.53v-.58c-1.93 0-3.97.41-3.97 2.67 0 1.16.6 1.94 1.63 1.94 1.14 0 2.08-.7 2.4-1.84.08-.29.03-.58-.06-.83v-1.36z"/>
              <path d="M20.16 19.54C18 21.14 14.82 22 12.1 22c-3.81 0-7.25-1.41-9.85-3.76-.2-.18-.02-.43.22-.29 2.81 1.63 6.28 2.61 9.87 2.61 2.42 0 5.07-.5 7.51-1.54.37-.16.68.24.31.52z"/>
              <path d="M21.07 18.5c-.28-.36-1.85-.17-2.57-.09-.21.03-.25-.16-.05-.29 1.26-.89 3.32-.63 3.56-.33.25.3-.07 2.35-1.24 3.32-.18.15-.35.07-.27-.13.26-.65.85-2.12.57-2.48z"/>
            </svg>
            Get Your Copy
          </a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .book-page {
    overflow: hidden;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  /* Hero Section */
  .book-hero {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--cream-200) 0%, rgba(255, 253, 245, 0.8) 100%);
  }

  .book-hero-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
    align-items: center;
  }

  .book-cover {
    position: relative;
  }

  .new-release-badge {
    position: absolute;
    top: -10px;
    left: -10px;
    background: var(--oceanic-teal);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(45, 144, 128, 0.3);
  }

  .book-cover-wrapper {
    background: white;
    padding: 16px;
    border-radius: 12px;
    box-shadow: var(--shadow-xl);
    transform: rotate(-2deg);
    transition: transform 0.3s ease;
  }

  .book-cover-wrapper:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .book-cover-wrapper img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
  }

  .book-hero-content h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 8px;
    line-height: 1.1;
  }

  .book-subtitle {
    font-size: 1.4rem;
    color: var(--oceanic-teal);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .book-author {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .book-stats {
    display: flex;
    gap: 40px;
    margin-bottom: 32px;
    padding: 20px 0;
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--navy-900);
  }

  .stat-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .book-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .amazon-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: #FF9900;
    color: #111;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(255, 153, 0, 0.3);
  }

  .amazon-btn:hover {
    background: #e88a00;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 153, 0, 0.4);
  }

  /* Learn Section */
  .learn-section {
    padding: 80px 0;
    background: white;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--navy-900);
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .module-card {
    padding: 32px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    transition: all 0.3s;
  }

  .module-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(212, 145, 94, 0.3);
  }

  .module-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--copper-500);
    margin-bottom: 16px;
    line-height: 1;
  }

  .module-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  .module-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Quote Section */
  .quote-section {
    padding: 80px 0;
    background: var(--navy-900);
  }

  .quote-section blockquote {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .quote-section blockquote p {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-style: italic;
    color: white;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .quote-section blockquote cite {
    font-size: 1.1rem;
    color: var(--copper-400);
    font-style: normal;
    font-weight: 600;
  }

  /* Author Section */
  .author-section {
    padding: 80px 0;
    background: var(--cream-200);
  }

  .author-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 60px;
    align-items: center;
  }

  .author-image img {
    width: 280px;
    height: 280px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
  }

  .author-content h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--navy-900);
    margin-bottom: 16px;
  }

  .author-content p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .author-content p strong {
    color: var(--navy-900);
  }

  .author-links {
    display: flex;
    gap: 24px;
    margin-top: 24px;
  }

  .author-links a {
    color: var(--oceanic-teal);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .author-links a:hover {
    color: var(--copper-500);
    text-decoration: underline;
  }

  /* CTA Section */
  .book-cta {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--oceanic-teal) 100%);
    text-align: center;
  }

  .cta-content h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: white;
    margin-bottom: 16px;
  }

  .cta-content p {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 32px;
  }

  .amazon-btn-light {
    background: white;
    color: #111;
  }

  .amazon-btn-light:hover {
    background: #f5f5f5;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .modules-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .book-hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .book-cover {
      max-width: 300px;
      margin: 0 auto;
    }

    .new-release-badge {
      left: 50%;
      transform: translateX(-50%);
    }

    .book-stats {
      justify-content: center;
    }

    .book-ctas {
      justify-content: center;
    }

    .modules-grid {
      grid-template-columns: 1fr;
    }

    .author-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .author-image img {
      margin: 0 auto;
      width: 200px;
      height: 200px;
    }

    .author-links {
      justify-content: center;
    }
  }
</style>
