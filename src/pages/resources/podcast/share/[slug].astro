---
/**
 * Hidden podcast guest share page.
 * Preview-only: noindex, nofollow, excluded from sitemap and nav.
 */
import { getGuestShareEpisodes, type GuestShareEpisode } from '@data/podcast-guest-shares';

export function getStaticPaths() {
  return getGuestShareEpisodes().map((episode) => ({
    params: { slug: episode.slug },
    props: { episode }
  }));
}

interface Props {
  episode: GuestShareEpisode;
}

const { episode } = Astro.props;
const logoSrc = '/images/logo.webp';
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{episode.pageTitle}</title>
<meta name="robots" content="noindex, nofollow">
<meta name="googlebot" content="noindex, nofollow">
<meta name="description" content={episode.pageDescription}>
<link rel="icon" href={logoSrc}>
<style is:global>
  @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:fallback;src:url('/fonts/inter-latin-400-normal.woff2') format('woff2')}
  @font-face{font-family:'Inter';font-style:normal;font-weight:700;font-display:fallback;src:url('/fonts/inter-latin-700-normal.woff2') format('woff2')}
  :root { --navy:#1A242C; --muted:#6C7A88; --line:#E9EDF0; --bg:#F4F6F8; --white:#FFFFFF; --accent:#227691; --font:Inter, 'Helvetica Neue', Arial, sans-serif; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin:0; background:var(--bg); font-family:var(--font); color:var(--navy); }
  .wrap { max-width:600px; margin:0 auto; padding:32px 16px 64px; }
  .sheet { background:var(--white); padding:40px; }
  header { text-align:center; }
  header img.logo { display:block; margin:0 auto 28px; width:40px; height:40px; border:0; }
  .eyebrow, .section-label { margin:0 0 8px; font-size:11px; font-weight:600; letter-spacing:1.6px; text-transform:uppercase; color:var(--muted); }
  h1 { margin:0 0 10px; font-size:30px; font-weight:700; line-height:1.2; letter-spacing:-0.3px; color:var(--navy); }
  .subhead { margin:0; font-size:15px; line-height:1.5; color:var(--muted); }
  .hero { display:block; width:100%; height:auto; border:0; border-radius:12px; margin:28px 0; }
  p { margin:0 0 14px; font-size:15px; line-height:1.65; }
  .note { margin:8px 0 0; font-size:13px; line-height:1.5; color:var(--muted); }
  hr { border:0; border-top:1px solid var(--line); margin:28px 0; }
  section { margin:0 0 8px; padding-top:8px; }
  .post { background:var(--bg); border:1px solid var(--line); border-radius:10px; padding:20px 22px; font-size:16px; line-height:1.6; color:var(--navy); white-space:pre-wrap; word-break:break-word; user-select:all; margin:0 0 12px; }
  .btn-row { display:flex; gap:16px; margin:0 0 28px; }
  .copy-btn, .post-btn { flex:1; display:block; width:100%; background:var(--accent); color:var(--white); border:0; border-radius:999px; padding:14px 18px; font-family:var(--font); font-size:16px; font-weight:700; line-height:1.2; text-align:center; text-decoration:none; cursor:pointer; }
  .copy-btn.copied { background:#1b5e4a; }
  .pills { margin:16px 0 0; }
  .pills a { display:inline-block; background:var(--accent); color:var(--white); text-decoration:none; font-weight:700; font-size:14px; padding:10px 18px; border-radius:999px; margin:0 8px 8px 0; white-space:nowrap; }
  .assets { margin:0; padding:0; list-style:none; }
  .assets li { margin:0 0 10px; }
  .assets a { font-size:14px; line-height:1.5; font-weight:500; color:var(--accent); text-decoration:none; }
  footer { text-align:center; padding-top:8px; }
  footer img { display:block; margin:0 auto 12px; width:24px; height:24px; }
  footer, footer a { font-size:12px; line-height:1.6; color:var(--muted); text-decoration:none; }
  @media (max-width:640px) {
    .sheet { padding:28px 20px 32px; }
    h1 { font-size:26px; }
    .btn-row { flex-direction:column; gap:10px; }
  }
</style>
</head>
<body>
  <div class="wrap">
    <div class="sheet">
      <header>
        <img class="logo" src={logoSrc} width="40" height="40" alt="MyBCAT">
        <p class="eyebrow">{episode.eyebrow}</p>
        <h1>{episode.titleLine1}{episode.titleLine2 && <br />}{episode.titleLine2}</h1>
        <p class="subhead">{episode.subhead}</p>
      </header>
      <img class="hero" src={episode.heroImage.src} width={episode.heroImage.width} alt={episode.heroImage.alt}>
      <p>{episode.greeting}</p>
      {episode.intro.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <hr>
      <p class="section-label">Listen and watch</p>
      <div class="pills">
        {episode.listenLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
      <p class="note">{episode.listenNote}</p>
      <hr>
      <p class="section-label">Your posts</p>
      <p>{episode.postsIntro}</p>

      {episode.platforms.map((platform) => (
        <section id={platform.id}>
          <p class="section-label">{platform.label}</p>
          <div class="post" id={`post-${platform.id}`}>{platform.copy}</div>
          <div class="btn-row">
            <button type="button" class="copy-btn" data-copy={`post-${platform.id}`}>Copy</button>
            <a class="post-btn" href={platform.actionHref}>{platform.actionLabel}</a>
          </div>
        </section>
      ))}

      <hr>
      <p class="section-label">Visuals and clips</p>
      <p>{episode.assetsIntro}</p>
      <ul class="assets">
        {episode.assets.map((asset) => (
          <li><a href={asset.href}>{asset.label}</a></li>
        ))}
      </ul>
      <p class="note">{episode.assetsNote}</p>
      <hr>
      <p>{episode.thanks}</p>
      <hr>
      <footer>
        <img src={logoSrc} width="24" height="24" alt="MyBCAT">
        {episode.footerLinks.map((link, index) => (
          <>
            {index > 0 && <>&nbsp;·&nbsp;</>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </footer>
    </div>
  </div>
  <script is:inline>
    (function () {
      function fallbackCopy(el) {
        const range = document.createRange();
        range.selectNodeContents(el);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        try { return document.execCommand("copy"); } catch { return false; }
      }
      function markCopied(btn) {
        const original = btn.getAttribute("data-label") || "Copy";
        btn.textContent = "Copied!";
        btn.classList.add("copied");
        window.setTimeout(function () {
          btn.textContent = original;
          btn.classList.remove("copied");
        }, 2000);
      }
      document.querySelectorAll(".copy-btn").forEach(function (btn) {
        btn.setAttribute("data-label", btn.textContent);
        btn.addEventListener("click", function () {
          const el = document.getElementById(btn.getAttribute("data-copy"));
          if (!el) return;
          const text = el.textContent;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () { markCopied(btn); }).catch(function () {
              if (fallbackCopy(el)) markCopied(btn);
            });
          } else if (fallbackCopy(el)) {
            markCopied(btn);
          }
        });
      });
    })();
  </script>
</body>
</html>
