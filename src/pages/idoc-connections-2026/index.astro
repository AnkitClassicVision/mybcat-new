---
/**
 * IDOC Connections 2026 Landing Page (QR/handout default)
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import IdocConnections2026Landing from '@/components/landing/IdocConnections2026Landing.astro';
---

<BaseLayout
  title="IDOC Connections 2026 | AI in Optometry + Enterprise Patient Access | MyBCAT"
  description="Proud sponsor of IDOC Connections 2026. Get the AI in Optometry deck + a missed-call opportunity snapshot for multi-location optometry groups."
  canonical="https://mybcat.com/idoc-connections-2026/"
  noindex={true}
  navMode="hidden"
  disableTracking={false}
>
  <!-- Preconnect to HubSpot for faster form loading -->
  <link rel="preconnect" href="https://js.hsforms.net" slot="head" />
  <link rel="preconnect" href="https://forms.hsforms.com" slot="head" />
  <link rel="dns-prefetch" href="https://js.hsforms.net" slot="head" />
  <link rel="dns-prefetch" href="https://forms.hsforms.com" slot="head" />

  <IdocConnections2026Landing variant="qr" />
</BaseLayout>

<style>
  :global(.site-footer) {
    display: none;
  }
</style>
