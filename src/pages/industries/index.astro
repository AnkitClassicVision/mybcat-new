---
/**
 * Industries Hub Page
 * Lists all industries we serve
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import CTA from '@/components/sections/CTA.astro';
import { industries } from '@data/industries';

// Icon SVGs for industries
const icons: Record<string, string> = {
  'eye': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>',
  'tooth': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2c-2 0-3.5.5-4.5 1.5S6 5.5 6 7c0 2 1 3.5 1 5.5S6 15 6 17c0 3 1.5 5 3.5 5 1.5 0 2-1 2.5-2.5s1-2.5 2.5-2.5 2 1 2.5 2.5 1 2.5 2.5 2.5c2 0 3.5-2 3.5-5 0-2-1-3.5-1-5.5s1-3.5 1-5.5c0-1.5-.5-3-1.5-4S14 2 12 2z"></path></svg>',
  'paw': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="17" rx="5" ry="4"></ellipse><circle cx="6" cy="10" r="2"></circle><circle cx="18" cy="10" r="2"></circle><circle cx="9" cy="6" r="2"></circle><circle cx="15" cy="6" r="2"></circle></svg>',
  'sparkles': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"></path><path d="M5 19l.5 1.5L7 21l-1.5.5L5 23l-.5-1.5L3 21l1.5-.5L5 19z"></path><path d="M19 13l.5 1.5L21 15l-1.5.5L19 17l-.5-1.5L17 15l1.5-.5L19 13z"></path></svg>',
  'shield': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>'
};
---

<PageLayout
  title="Healthcare Industries We Serve | MyBCAT"
  description="Patient intake for optometry, dental, veterinary, medspa, and dermatology. Industry-specific solutions."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Industries' }
  ]}
  heroEyebrow="Industries We Serve"
  heroTitle="Healthcare-Specific Patient Intake"
  heroSubtitle="We only serve healthcare. That focus means we understand your EMR, your insurance, and your patients."
>
  <div class="industries-page">
    <div class="industries-grid">
      {industries.map(industry => (
        <a href={`/industries/${industry.slug}/`} class="industry-card">
          <div class="industry-icon">
            <Fragment set:html={icons[industry.icon] || icons.shield} />
          </div>
          <div class="industry-content">
            <h2>{industry.name}</h2>
            <p class="industry-headline">{industry.headline}</p>
            <p class="industry-description">{industry.description}</p>
            <div class="industry-stats">
              {industry.stats.slice(0, 2).map(stat => (
                <div class="stat">
                  <span class="stat-value">{stat.value}</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
            <span class="learn-more">
              Learn more
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Why Industry Specialization -->
    <section class="specialization-section">
      <div class="section-header">
        <h2>Why Industry Specialization Matters</h2>
        <p>Generic call centers don't understand healthcare. We do.</p>
      </div>

      <div class="specialization-grid">
        <Card variant="feature" class="spec-card">
          <h3>Insurance Expertise</h3>
          <p>VSP vs EyeMed. Delta Dental vs Cigna. We know the carriers, the eligibility rules, and the common patient questions for your specialty.</p>
        </Card>
        <Card variant="feature" class="spec-card">
          <h3>EMR Integration</h3>
          <p>We train on your specific system-whether that's Eyefinity, Dentrix, Cornerstone, or any other platform. Direct scheduling, not callbacks.</p>
        </Card>
        <Card variant="feature" class="spec-card">
          <h3>Workflow Knowledge</h3>
          <p>From patient intake to recall campaigns, we understand the unique workflows and terminology of your specialty.</p>
        </Card>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <CTA
        title="Don't See Your Industry?"
        description="We're always expanding our specializations. Let's talk about your practice's specific needs."
        buttonText="Contact Us"
      />
    </section>
  </div>
</PageLayout>

<style>
  .industries-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .industries-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 60px;
  }

  .industry-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    padding: 40px;
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s;
  }

  .industry-card:hover {
    border-color: var(--oceanic-teal);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }

  .industry-icon {
    width: 80px;
    height: 80px;
    background: var(--glass-teal);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--oceanic-teal);
    flex-shrink: 0;
  }

  .industry-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .industry-headline {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--oceanic-teal);
    margin-bottom: 8px;
  }

  .industry-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .industry-stats {
    display: flex;
    gap: 32px;
    margin-bottom: 16px;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  .stat-label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--oceanic-teal);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .learn-more svg {
    transition: transform 0.2s;
  }

  .industry-card:hover .learn-more svg {
    transform: translateX(4px);
  }

  .specialization-section {
    margin-bottom: 60px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .section-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 8px;
  }

  .section-header p {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .specialization-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  :global(.spec-card) {
    padding: 32px;
    text-align: center;
  }

  :global(.spec-card) h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-bottom: 12px;
  }

  :global(.spec-card) p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cta-section {
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .industry-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .industry-icon {
      margin: 0 auto;
    }

    .industry-stats {
      justify-content: center;
    }

    .specialization-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
