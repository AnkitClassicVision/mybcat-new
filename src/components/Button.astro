---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'secondary-light' | 'text';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button'
} = Astro.props;

const Tag = href ? 'a' : 'button';
const baseClass = `magnetic-button ${variant} ${size} ${className}`.trim();
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class={baseClass}
  data-magnetic
>
  <slot />
</Tag>

<style>
  .magnetic-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 40px;
    background: var(--oceanic-teal);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid var(--oceanic-teal);
    border-radius: 8px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s ease;
    transform-style: preserve-3d;
    text-decoration: none;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 8px rgba(0, 96, 100, 0.25);
  }

  .magnetic-button:hover {
    background: var(--navy-800);
    border-color: var(--navy-800);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
  }

  .magnetic-button:focus-visible {
    outline: 2px solid var(--oceanic-teal);
    outline-offset: 2px;
  }

  /* Size variants */
  .magnetic-button.sm {
    padding: 12px 24px;
    font-size: 14px;
  }

  .magnetic-button.lg {
    padding: 22px 56px;
    font-size: 18px;
  }

  /* Secondary variant - outlined style */
  .magnetic-button.secondary {
    background: transparent;
    color: var(--navy-800);
    border: 2px solid var(--navy-800);
    box-shadow: none;
  }

  .magnetic-button.secondary:hover {
    background: var(--navy-800);
    color: #ffffff;
    box-shadow: none;
  }

  /* Secondary Light variant - for dark backgrounds */
  .magnetic-button.secondary-light {
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
    box-shadow: none;
  }

  .magnetic-button.secondary-light:hover {
    background: #ffffff;
    color: var(--navy-900);
    box-shadow: none;
  }

  /* Text variant */
  .magnetic-button.text {
    background: transparent;
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: normal;
    padding: 10px 20px;
    box-shadow: none;
  }

  .magnetic-button.text:hover {
    color: var(--text-primary);
    background: var(--glass-navy);
    box-shadow: none;
  }
</style>
