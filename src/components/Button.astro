---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button'
} = Astro.props;

const Tag = href ? 'a' : 'button';
const baseClass = `magnetic-button ${variant} ${size} ${className}`.trim();
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class={baseClass}
  data-magnetic
>
  <slot />
</Tag>

<style>
  .magnetic-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 48px;
    background: var(--oceanic-teal);
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    overflow: hidden;
    transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
    transform-style: preserve-3d;
    text-decoration: none;
    letter-spacing: 2px;
    text-transform: uppercase;
    box-shadow: 0 0 10px var(--oceanic-teal),
          0 0 30px rgba(0, 96, 100, 0.5),
          0 0 60px rgba(0, 96, 100, 0.3);
  }

  .magnetic-button:hover {
    background: var(--navy-800);
    color: #ffffff;
    box-shadow: 0 0 10px var(--navy-800),
          0 0 30px rgba(211, 175, 94, 0.6),
          0 0 60px rgba(211, 175, 94, 0.3);
  }

  /* Size variants */
  .magnetic-button.sm {
    padding: 12px 24px;
    font-size: 14px;
  }

  .magnetic-button.lg {
    padding: 22px 56px;
    font-size: 18px;
  }

  /* Secondary variant */
  .magnetic-button.secondary {
    color: var(--navy-800);
  }

  .magnetic-button.secondary:hover {
    background: var(--navy-800);
    color: #ffffff;
    box-shadow: 0 0 5px var(--navy-800),
          0 0 25px var(--navy-800),
          0 0 50px var(--navy-800);
  }

  /* Text variant */
  .magnetic-button.text {
    background: transparent;
    color: var(--text-secondary);
    text-transform: none;
    letter-spacing: normal;
    padding: 10px 20px;
    box-shadow: none;
  }

  .magnetic-button.text:hover {
    color: var(--text-primary);
    background: var(--glass-navy);
    box-shadow: none;
  }
</style>
