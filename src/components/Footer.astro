<style>
  .site-footer {
    background-color: var(--navy-900);
    color: var(--cream-200);
    padding: 60px 24px 40px;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 32px;
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    max-width: 120px;
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  .footer-column .footer-heading {
    display: block;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
    color: var(--cream-200);
  }

  .footer-column a {
    display: block;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 14px;
    padding: 6px 0;
    transition: color 0.2s;
  }

  .footer-column a:hover {
    color: var(--copper-500);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-social {
    display: flex;
    gap: 16px;
  }

  .footer-social a {
    color: var(--cream-200);
    transition: color 0.3s;
  }

  .footer-social a:hover {
    color: var(--copper-500);
  }

  /* Touch-friendly footer tap targets (mobile/tablet + audit tools) */
  @media (max-width: 1024px), (pointer: coarse) {
    .footer-column a {
      min-height: 44px;
      display: flex;
      align-items: center;
      padding: 10px 0;
    }

    /* Ensure 8px spacing between stacked footer links */
    .footer-column a + a {
      margin-top: 8px;
    }

    .footer-social a {
      width: 44px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
    }
  }

  .footer-copyright {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-bottom {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
