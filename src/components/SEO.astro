---
import { serializeScriptSafeJson } from '@utils/script-safe-json';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/images/og-home.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'MyBCAT',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://mybcat.com';
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Construct canonical URL: use provided prop or default to siteUrl + current pathname
// This ensures we always point to the non-www version and strip query params by default
const path = Astro.url.pathname;
const defaultCanonical = `${siteUrl}${path}`;
const fullCanonical = canonical 
  ? (canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`)
  : defaultCanonical;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical -->
<link rel="canonical" href={fullCanonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content="MyBCAT - My Business Care Team" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Article specific -->
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}

<!-- Schema.org JSON-LD -->
{type === 'website' ? (
  <script type="application/ld+json" set:html={serializeScriptSafeJson({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "My Business Care Team",
    "alternateName": "MyBCAT",
    "url": siteUrl,
    "logo": `${siteUrl}/images/logo.webp`,
    "description": "Medical operations partner helping healthcare practices capture every call and fill every appointment slot.",
    "sameAs": [
      "https://www.facebook.com/mybcat",
      "https://www.linkedin.com/company/my-business-care-team/"
    ]
  })} />
) : (
  <script type="application/ld+json" set:html={serializeScriptSafeJson({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": fullImageUrl,
    "datePublished": publishedTime?.toISOString(),
    "dateModified": modifiedTime?.toISOString() || publishedTime?.toISOString(),
    "author": {
      "@type": "Person",
      "name": author
    },
    "publisher": {
      "@type": "Organization",
      "name": "My Business Care Team",
      "logo": `${siteUrl}/images/logo.webp`
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": fullCanonical
    }
  })} />
)}
