<script>
  window.MYBCAT_FORM_TOKEN =
    import.meta.env.PUBLIC_CUTOVER_FORMS_TOKEN || import.meta.env.PUBLIC_FORM_INTAKE_TOKEN || '';

  const kitForm = document.getElementById('idoc-kit-form') as HTMLFormElement | null;
  const kitThanks = document.getElementById('idoc-kit-thanks');
  const kitError = document.getElementById('idoc-kit-error');
  kitForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(kitForm);
    const firstName = String(data.get('firstname') || '').trim();
    const lastName = String(data.get('lastname') || '').trim();
    const email = String(data.get('email') || '').trim();
    const phone = String(data.get('mobilephone') || '').trim();
    const phoneDigits = phone.replace(/\D/g, '');
    if (!firstName || !lastName || !email || phoneDigits.length < 10) {
      if (kitError) {
        kitError.hidden = false;
        kitError.textContent = 'First name, last name, work email, and a mobile number are required.';
      }
      return;
    }
    if (kitError) kitError.hidden = true;
    kitForm.hidden = true;
    if (kitThanks) kitThanks.hidden = false;
    const token = window.MYBCAT_FORM_TOKEN || '';
    if (!token) return;
    const fields = [
      { name: 'firstname', value: firstName },
      { name: 'lastname', value: lastName },
      { name: 'email', value: email },
      { name: 'mobilephone', value: phone },
      { name: 'requested_meeting', value: 'IDOC kit' },
    ];
    fetch('https://estate-form-bridge.mybcat-estate.workers.dev', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Forms-Token': token },
      body: JSON.stringify({
        fields,
        context: { pageUri: window.location.href, pageName: document.title, source: 'idoc-connections' },
      }),
    }).catch(() => {
      if (kitError) {
        kitError.hidden = false;
        kitError.textContent = 'We could not send your details. Please email help@mybcat.com.';
      }
    });
  });

  // Hide sticky CTA when the form is in view (mobile only)
  const sticky = document.querySelector('[data-idoc-sticky]');
  const target = document.querySelector('#get-the-kit');

  if (sticky && target && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      if (entry.isIntersecting) sticky.setAttribute('data-hidden', '');
      else sticky.removeAttribute('data-hidden');
    }, { rootMargin: '0px 0px -35% 0px' });

    observer.observe(target);
  }
</script>
