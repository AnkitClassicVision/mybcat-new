---
/**
 * IDOC Connections 2026 Landing (reusable)
 * Variants:
 * - qr: default for QR/handouts
 * - booth: kiosk-friendly for booth signups
 * - followup: post-talk follow-up
 */
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import { company } from '@data/company';
import { getTestimonialsByIndustry, getFeaturedTestimonial } from '@data/testimonials';

export type IdocLandingVariant = 'qr' | 'booth' | 'followup';

interface Props {
  variant?: IdocLandingVariant;
}

const { variant = 'qr' } = Astro.props;

const optometryTestimonials = getTestimonialsByIndustry('optometry');
const featuredTestimonial = optometryTestimonials[0] ?? getFeaturedTestimonial();

const copyByVariant = {
  qr: {
    heroEyebrow: 'IDOC Connections 2026',
    heroTitle: 'Avoid choosing between answering the phone and',
    heroAccent: 'greeting a patient.',
    heroSubtitle:
      'Find out how much money you’re losing on missed calls now—by location and call type. Get the deck + a missed-call opportunity snapshot, and see how {company.shortName} delivers a done-for-you patient access program (tech + training, AI overflow calls, backup coverage, and appointment conversion tracking)—not a VA you have to hire and train.',
    bullets: [
      { strong: 'Know what you’re losing', text: 'missed-call snapshot by location + call type.' },
      { strong: 'Done-for-you delivery', text: 'we handle the tech + training + QA.' },
      { strong: 'AI overflow + backup coverage', text: 'so peak hours don’t become missed revenue.' },
      { strong: 'Track appointment conversions', text: 'missed call → booked appointment, by location.' }
    ],
    formKicker: 'IDOC Attendee Resources',
    formTitle: 'Get the Deck + Missed-Call Snapshot',
    formSubtitle:
      'We’ll email the slide deck, a missed-call opportunity snapshot (by location + call type), and a 30-day pilot blueprint—right after you submit.',
    stickyLabel: 'Get the Deck + Missed-Call Snapshot',
    stickyHint: 'Jump to the signup form'
  },
  booth: {
    heroEyebrow: 'Booth Signup',
    heroTitle: 'Get the Deck + Missed-Call Snapshot.',
    heroAccent: '',
    heroSubtitle: 'Fast booth signup—enter your email and we’ll send the deck + missed-call opportunity snapshot right after you submit.',
    bullets: [
      { strong: 'Missed-call opportunity snapshot', text: 'by location and call type.' },
      { strong: 'AI in Optometry slide deck', text: 'from today’s session.' },
      { strong: '30-day pilot blueprint', text: 'prove ROI at 1–2 locations before rollout.' }
    ],
    formKicker: 'IDOC Booth Signup',
    formTitle: 'Send me the Deck + Missed-Call Snapshot',
    formSubtitle: 'Fast booth signup—delivered by email right after you submit.',
    stickyLabel: '',
    stickyHint: ''
  },
  followup: {
    heroEyebrow: 'Session Follow-Up',
    heroTitle: 'Thanks for joining AI in Optometry—',
    heroAccent: 'here’s your AI + Access toolkit.',
    heroSubtitle:
      'The fastest AI wins show up in patient access: fewer missed calls, more appointments booked, and cleaner workflows across locations. Get the slides plus a missed-call opportunity snapshot and 30-day pilot blueprint in one email.',
    bullets: [
      { strong: 'Missed-call opportunity snapshot', text: 'quantify missed appointments by location and call type.' },
      { strong: 'Slide deck + templates', text: 'practical AI workflows you can apply this week.' },
      { strong: '30-day pilot blueprint', text: 'prove ROI before a rollout.' }
    ],
    formKicker: 'AI in Optometry Resources',
    formTitle: 'Get the Deck + Missed-Call Snapshot',
    formSubtitle: 'We’ll email the slides, missed-call snapshot, and a 30-day pilot blueprint—right after you submit.',
    stickyLabel: 'Get the Deck + Missed-Call Snapshot',
    stickyHint: 'Jump to the signup form'
  }
} as const;

const v = copyByVariant[variant];

const showLongPage = variant !== 'booth';
const showSticky = variant !== 'booth';
const showSpeaker = variant === 'followup';
const showOfferPreview = variant !== 'booth';
const showInlineTestimonial = variant !== 'booth';
---

<main id="main-content" class="idoc-landing" data-variant={variant}>
  <section class="hero" aria-label="IDOC Connections 2026">
    <div class="hero-photo" aria-hidden="true"></div>
    <div class="hero-shell">
      <div class="hero-brand" aria-label="MyBCAT">
        <img src="/images/logo-optimized.webp" alt="MyBCAT" width="44" height="41" loading="eager" decoding="async" />
        <div class="hero-brand-copy">
          <div class="hero-brand-name">{company.shortName}</div>
          <div class="hero-brand-tag">{company.name}</div>
        </div>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="event-badges">
            <div class="badge conference">
              <span class="badge-dot" aria-hidden="true"></span>
              <span>{v.heroEyebrow}</span>
            </div>
            <div class="badge sponsor">
              <span>Proud Sponsor</span>
            </div>
          </div>

          {showSpeaker && (
            <div class="speaker">
              <img
                src="/images/ankit_headshot_full.webp"
                alt="Ankit Patel"
                width="800"
                height="1066"
                loading="eager"
                decoding="async"
                class="speaker-photo"
              />
              <div class="speaker-meta">
                <div class="speaker-name">{company.ownership.founder}</div>
                <div class="speaker-title">{company.ownership.founderTitle} · {company.shortName}</div>
              </div>
            </div>
          )}

          <h1 class="hero-title">
            {v.heroTitle}{v.heroAccent && <span class="accent">{v.heroAccent}</span>}
          </h1>
          <p class="hero-subtitle">{v.heroSubtitle}</p>

          <ul class="hero-bullets">
            {v.bullets.map((b) => (
              <li>
                <span class="check" aria-hidden="true">✓</span>
                <span><strong>{b.strong}</strong> {b.text}</span>
              </li>
            ))}
          </ul>

          {variant !== 'booth' && (
            <div class="hero-ctas">
              <Button href="#get-the-kit" variant="primary" class="cta-primary">{v.stickyLabel}</Button>
            </div>
          )}

          {showOfferPreview && (
            <div class="offer-preview" aria-label="Missed-call opportunity snapshot preview">
              <div class="offer-preview-top">
                <div class="offer-preview-kicker">What you’ll get</div>
                <div class="offer-preview-title">Missed-call opportunity snapshot</div>
              </div>
              <div class="offer-preview-grid">
                <div class="preview-item">
                  <div class="preview-label">By location</div>
                  <div class="preview-value">View performance across 3+ sites</div>
                </div>
                <div class="preview-item">
                  <div class="preview-label">By call type</div>
                  <div class="preview-value">New patients, recalls, medical, optical</div>
                </div>
                <div class="preview-item">
                  <div class="preview-label">Opportunity</div>
                  <div class="preview-value">Missed calls → missed appointments</div>
                </div>
              </div>
              <div class="offer-preview-note">Example layout. Delivered by email after signup.</div>
            </div>
          )}

          <div class="micro-trust" aria-label="Trust indicators">
            <div class="micro-item">
              <div class="micro-value">{company.stats.callAnswerRate}</div>
              <div class="micro-label">Answer Rate</div>
            </div>
            <div class="micro-item">
              <div class="micro-value">&lt;3</div>
              <div class="micro-label">Rings to Answer</div>
            </div>
            <div class="micro-item">
              <div class="micro-value">{company.stats.trustedPractices}</div>
              <div class="micro-label">Practices Served</div>
            </div>
          </div>
        </div>

        <div class="hero-form" id="get-the-kit">
          <Card variant="pricing" class="form-card">
            <div class="form-top">
              <div class="form-kicker">{v.formKicker}</div>
              <h2 class="form-title">{v.formTitle}</h2>
              <p class="form-subtitle">{v.formSubtitle}</p>
            </div>

            <div class="form-embed">
              <noscript><p class="form-noscript">This form needs JavaScript. Please turn it on, or email us at <a href="mailto:hello@mybcat.com">hello@mybcat.com</a>.</p></noscript>
              <form id="idoc-kit-form" method="post" action="javascript:void(0)" novalidate>
                <div class="kit-row">
                  <label>
                    First name <span class="required-mark" aria-hidden="true">*</span>
                    <input type="text" name="firstname" required autocomplete="given-name" />
                  </label>
                  <label>
                    Last name <span class="required-mark" aria-hidden="true">*</span>
                    <input type="text" name="lastname" required autocomplete="family-name" />
                  </label>
                </div>
                <label>
                  Work email <span class="required-mark" aria-hidden="true">*</span>
                  <input type="email" name="email" required autocomplete="email" />
                </label>
                <label>
                  Mobile number <span class="required-mark" aria-hidden="true">*</span>
                  <input type="tel" name="mobilephone" required autocomplete="tel" />
                </label>
                <p class="kit-error" id="idoc-kit-error" hidden></p>
                <button type="submit" class="kit-submit">Get the deck + snapshot</button>
              </form>
              <p class="kit-thanks" id="idoc-kit-thanks" hidden>
                Thanks. The kit is on its way. Want a live walkthrough?
                <a href="https://mybcat.com/book/discovery">Book a Discovery call</a>.
              </p>
            </div>

            <div class="form-fineprint">
              <p>
                You’ll get the full kit by email right after you submit.
              </p>
              <p class="fineprint">
                By submitting, you agree to receive conference follow-ups from {company.shortName}. Unsubscribe any time.
              </p>
            </div>
          </Card>

          {showInlineTestimonial && featuredTestimonial && (
            <div class="form-proof" aria-label="Optometry testimonial">
              <div class="form-proof-kicker">Trusted in optometry</div>
              <p class="form-proof-quote">“{featuredTestimonial.quote}”</p>
              <div class="form-proof-author">
                <span class="form-proof-name">{featuredTestimonial.author}</span>
                <span class="form-proof-sep" aria-hidden="true">·</span>
                <span class="form-proof-title">
                  {featuredTestimonial.title}{featuredTestimonial.company ? ` · ${featuredTestimonial.company}` : ''}
                </span>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {showLongPage && (
    <>
      <section class="section squeeze" aria-label="The enterprise optometry squeeze">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow">The Reality</div>
            <h2>Enterprise optometry is getting squeezed—on labor and on access.</h2>
            <p>
              If your group is growing, the phone problem grows faster. Every new location multiplies schedules, scripts, and exceptions.
              Meanwhile wage inflation makes “just hire one more” a losing strategy.
            </p>
          </div>

          <div class="squeeze-grid">
            <Card class="squeeze-card" tilt={true}>
              <div class="squeeze-icon" aria-hidden="true">↗</div>
              <h3>Staff Costs Keep Rising</h3>
              <p>Front desk coverage scales linearly. Patient demand doesn’t. You need a model that scales with volume—without constant rehiring.</p>
            </Card>
            <Card class="squeeze-card" tilt={true}>
              <div class="squeeze-icon" aria-hidden="true">☎</div>
              <h3>Phones vs. Patients</h3>
              <p>Teams shouldn’t have to choose between answering the phone and greeting a patient. That tradeoff is a revenue leak and an experience problem.</p>
            </Card>
            <Card class="squeeze-card" tilt={true}>
              <div class="squeeze-icon" aria-hidden="true">⌁</div>
              <h3>Scaling Adds Complexity</h3>
              <p>Different doctors, different templates, different insurance workflows. Standardize the access layer and growth becomes predictable.</p>
            </Card>
          </div>
        </div>
      </section>

      <section class="section kit" aria-label="What you get">
        <div class="container">
          <div class="section-head compact">
            <div class="eyebrow">IDOC Kit</div>
            <h2>What you’ll receive after you sign up</h2>
          </div>

          <div class="kit-grid">
            <div class="kit-item">
              <div class="kit-mark" aria-hidden="true">01</div>
              <h3>AI in Optometry deck</h3>
              <p>Slides from the IDOC Connections session, plus the 3 places AI actually works in day-to-day ops.</p>
            </div>
            <div class="kit-item">
              <div class="kit-mark" aria-hidden="true">02</div>
              <h3>Missed-call opportunity snapshot</h3>
              <p>Estimate missed opportunities from missed calls—broken down by location and call type.</p>
            </div>
            <div class="kit-item">
              <div class="kit-mark" aria-hidden="true">03</div>
              <h3>30-day pilot blueprint</h3>
              <p>A rollout plan that starts with 1–2 locations, proves ROI, then scales across the group.</p>
            </div>
            <div class="kit-item">
              <div class="kit-mark" aria-hidden="true">04</div>
              <h3>Optometry workflow templates</h3>
              <p>Insurance verification, medical vs routine routing, recall outreach, and no-show recovery.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section how" aria-label="How MyBCAT helps optometry groups">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow">How We Help</div>
            <h2>One access layer across every location—patients never notice the difference.</h2>
            <p>
              {company.shortName} combines a trained patient access team with enterprise operating rigor—so growth doesn’t mean more chaos.
              We don’t “take messages.” We do the work.
            </p>
          </div>

          <div class="how-grid">
            <Card class="how-card" tilt={true}>
              <div class="how-title-row">
                <div class="how-icon" aria-hidden="true">◎</div>
                <h3>Centralized Patient Access</h3>
              </div>
              <ul class="how-list">
                <li>Answer overflow and peak-hour calls fast (no voicemail black hole).</li>
                <li>Schedule directly into your EHR/PM (Eyefinity, RevolutionEHR, Crystal PM, Compulink, and more).</li>
                <li>Route medical vs routine correctly and follow your provider preferences.</li>
                <li>Handle vision insurance verification (VSP, EyeMed, Spectera) with consistent workflows.</li>
              </ul>
            </Card>

            <Card class="how-card" tilt={true}>
              <div class="how-title-row">
                <div class="how-icon" aria-hidden="true">▣</div>
                <h3>Proactive Growth Ops</h3>
              </div>
              <ul class="how-list">
                <li>Recall campaigns to keep annual exams from slipping.</li>
                <li>No-show and cancellation recovery to protect chair utilization.</li>
                <li>Outbound follow-up for unscheduled treatment plans and referrals.</li>
                <li>Enterprise reporting by location so you can see what’s working.</li>
              </ul>
              <figure class="how-proof">
                <img
                  src="/images/landing/idoc-connections-2026/kpi-dashboard.webp"
                  alt="Example of multi-location intake KPI dashboard"
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>Example: reporting by location, call type, and conversion.</figcaption>
              </figure>
            </Card>
          </div>

          <div class="how-ctas">
            <Button href="#get-the-kit" variant="primary">Get the Deck + Missed-Call Snapshot</Button>
          </div>
        </div>
      </section>

      <section class="section buyer" aria-label="Enterprise evaluation">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow">Enterprise Ready</div>
            <h2>Built for enterprise evaluation—Ops, Finance, and Compliance.</h2>
            <p>When your group grows, your vendor requirements grow too. We’re prepared for how enterprise teams buy.</p>
          </div>

          <div class="buyer-grid">
            <div class="buyer-block ops">
              <div class="buyer-top">
                <div class="buyer-label">Operations</div>
                <h3>SLAs + QA you can enforce</h3>
              </div>
              <ul class="buyer-list">
                <li>Answer-rate focus during peak hours (rushes, lunch, end of day).</li>
                <li>Location-specific scripts and escalation protocols.</li>
                <li>Weekly call reviews and quality calibration.</li>
                <li>Visibility across locations—no more blind spots.</li>
              </ul>
            </div>

            <div class="buyer-block finance">
              <div class="buyer-top">
                <div class="buyer-label">Finance</div>
                <h3>Unit economics that scale</h3>
              </div>
              <ul class="buyer-list">
                <li>Shift from fixed staffing cost to a scalable operating model.</li>
                <li>Capture revenue you’re already generating (but not booking).</li>
                <li>Protect chair utilization with recall + no-show recovery.</li>
                <li>Prove value in a pilot before rolling out.</li>
              </ul>
            </div>

            <div class="buyer-block compliance">
              <div class="buyer-top">
                <div class="buyer-label">IT & Compliance</div>
                <h3>Security + HIPAA alignment</h3>
              </div>
              <ul class="buyer-list">
                <li>HIPAA-trained workflows and secure access patterns.</li>
                <li>BAA before go-live.</li>
                <li>Role-based access for team members and auditing support.</li>
                <li>PHI handling and retention follow your BAA and your systems of record.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section proof" aria-label="Social proof">
        <div class="container">
          <div class="proof-grid">
            <div class="proof-copy">
              <div class="eyebrow">Trusted in Optometry</div>
              <h2>When the phones are handled, the office gets quieter—and the schedule gets fuller.</h2>
              <p>Want the deck + missed-call snapshot? Drop your email and we’ll send the full kit.</p>
              <div class="proof-ctas">
                <Button href="#get-the-kit" variant="primary">Get the Deck + Missed-Call Snapshot</Button>
              </div>
            </div>

            {featuredTestimonial && (
              <Card variant="testimonial" class="proof-quote">
                <p class="quote">“{featuredTestimonial.quote}”</p>
                <div class="author">
                  {featuredTestimonial.avatar ? (
                    <img
                      class="author-avatar"
                      src={featuredTestimonial.avatar}
                      alt={`${featuredTestimonial.author} headshot`}
                      width="56"
                      height="56"
                      loading="lazy"
                    />
                  ) : (
                    <div class="author-initials" aria-hidden="true">{featuredTestimonial.initials}</div>
                  )}
                  <div class="author-meta">
                    <div class="author-name">{featuredTestimonial.author}</div>
                    <div class="author-title">
                      {featuredTestimonial.title}{featuredTestimonial.company ? ` · ${featuredTestimonial.company}` : ''}
                    </div>
                  </div>
                </div>
              </Card>
            )}
          </div>
        </div>
      </section>

      <section class="final-cta" aria-label="Final call to action">
        <div class="container">
          <div class="final-shell">
            <div class="final-copy">
              <div class="final-kicker">IDOC Connections 2026</div>
              <h2>Want the deck + missed-call snapshot?</h2>
              <p>Get the slides, snapshot, and 30-day pilot blueprint—then decide if centralized patient access is your next growth lever.</p>
            </div>
            <div class="final-actions">
              <Button href="#get-the-kit" variant="primary">Get the Deck + Missed-Call Snapshot</Button>
            </div>
          </div>
        </div>
      </section>
    </>
  )}

  {showSticky && (
    <a class="sticky-cta" href="#get-the-kit" data-idoc-sticky>
      <span class="sticky-title">{v.stickyLabel}</span>
      <span class="sticky-subtitle">{v.stickyHint}</span>
    </a>
  )}
</main>

<style>
  .idoc-landing {
    overflow: clip;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 110px 24px 70px;
    background:
      radial-gradient(1200px 700px at 20% 20%, rgba(0, 96, 100, 0.25), transparent 55%),
      radial-gradient(900px 520px at 80% 30%, rgba(77, 208, 225, 0.18), transparent 60%),
      radial-gradient(900px 600px at 60% 90%, rgba(26, 36, 44, 0.28), transparent 60%),
      linear-gradient(135deg, rgba(26, 36, 44, 0.96) 0%, rgba(39, 52, 60, 0.94) 55%, rgba(26, 36, 44, 0.97) 100%);
    color: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    background-image: url('/images/landing/idoc-connections-2026/hero-bg.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.14;
    filter: saturate(0.9) contrast(1.08);
    mix-blend-mode: luminosity;
    pointer-events: none;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(transparent 0 94%, rgba(255, 255, 255, 0.06) 94% 100%),
      linear-gradient(90deg, transparent 0 94%, rgba(255, 255, 255, 0.05) 94% 100%);
    background-size: 72px 72px;
    opacity: 0.28;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at 12% 40%, rgba(211, 175, 94, 0.16), transparent 55%);
    pointer-events: none;
    filter: blur(14px);
    opacity: 0.9;
  }

  .hero-shell {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    margin-bottom: 18px;
  }

  .hero-brand img {
    width: 34px;
    height: 32px;
  }

  .hero-brand-copy {
    display: grid;
    gap: 2px;
  }

  .hero-brand-name {
    font-weight: 900;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .hero-brand-tag {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.15;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: start;
  }

  .event-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .badge.conference {
    border-color: rgba(77, 208, 225, 0.22);
    background: rgba(77, 208, 225, 0.08);
  }

  .badge-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--electric-aqua);
    box-shadow: 0 0 0 4px rgba(77, 208, 225, 0.16);
  }

  .speaker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    margin: 8px 0 16px;
  }

  .speaker-photo {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .speaker-name {
    font-weight: 800;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.1;
  }

  .speaker-title {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 2px;
  }

  .hero-title {
    color: #ffffff;
    font-size: clamp(2.2rem, 4.6vw, 3.55rem);
    line-height: 1.05;
