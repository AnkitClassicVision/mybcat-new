---
/**
 * Header component with navigation
 * Enhanced version of Nav.astro using data layer
 */
import { mainNavigation, ctaButton } from '@data/navigation';
import { company } from '@data/company';
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!-- Mobile Menu Toggle Button -->
<button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
</button>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay" aria-hidden="true"></div>

<!-- Mobile Menu Panel -->
<nav class="mobile-menu" role="navigation" aria-label="Mobile navigation">
  <div class="mobile-nav-brand">
    <Logo size="sm" showText={true} />
  </div>
  {mainNavigation.map(item => (
    <>
      <a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a>
      {item.children?.map(child => (
        <a href={child.href} class="mobile-submenu-item">{child.label}</a>
      ))}
    </>
  ))}
  <a href={ctaButton.href} class="mobile-cta">{ctaButton.mobileLabel}</a>
</nav>

<!-- Floating Navigation Dock -->
<nav class="nav-dock" role="navigation" aria-label="Main navigation">
  <div class="nav-brand">
    <Logo size="sm" showText={true} />
  </div>

  {mainNavigation.map(item => (
    item.children ? (
      <div class="nav-dropdown">
        <a href={item.href} class:list={['nav-item nav-dropdown-trigger', { active: isActive(item.href) }]}>
          {item.label}
        </a>
        <div class="nav-dropdown-menu">
          {item.children.map(child => (
            <a href={child.href}>
              <span class="dropdown-label">{child.label}</span>
              {child.description && <span class="dropdown-desc">{child.description}</span>}
            </a>
          ))}
        </div>
      </div>
    ) : (
      <a href={item.href} class:list={['nav-item', { active: isActive(item.href) }]}>{item.label}</a>
    )
  ))}

  <a href={ctaButton.href} class="nav-item nav-cta-glow">{ctaButton.label}</a>
</nav>

<style>
  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: none;
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1001;
    width: 44px;
    height: 44px;
    background: var(--spatial-glass);
    backdrop-filter: blur(var(--blur-lg));
    -webkit-backdrop-filter: blur(var(--blur-lg));
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    padding: 10px;
  }

  .hamburger-line {
    width: 20px;
    height: 2px;
    background: var(--navy-900);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 22, 40, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-menu-overlay.active {
    opacity: 1;
  }

  /* Mobile Menu Panel */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: -300px;
    width: 280px;
    height: 100vh;
    background: var(--spatial-glass);
    backdrop-filter: blur(var(--blur-lg));
    -webkit-backdrop-filter: blur(var(--blur-lg));
    border-left: 1px solid var(--glass-border);
    z-index: 1000;
    flex-direction: column;
    padding: 80px 20px 20px;
    transition: right 0.3s ease;
    overflow-y: auto;
  }

  .mobile-menu.active {
    right: 0;
  }

  .mobile-menu a {
    padding: 14px 16px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .mobile-menu a:hover,
  .mobile-menu a.active {
    background: var(--glass-navy);
    color: var(--text-primary);
  }

  .mobile-submenu-item {
    padding-left: 32px !important;
    font-size: 14px !important;
    color: var(--text-muted) !important;
  }

  .mobile-nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: 8px;
  }

  .mobile-cta {
    margin-top: auto;
    background: var(--oceanic-teal) !important;
    color: white !important;
    text-align: center;
  }

  /* Floating Navigation Dock */
  .nav-dock {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    background: transparent;
    backdrop-filter: blur(var(--blur-lg));
    -webkit-backdrop-filter: blur(var(--blur-lg));
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 24px;
    padding: 6px 16px;
    display: flex;
    flex-wrap: nowrap;
    gap: 2px;
    box-shadow: none;
    white-space: nowrap;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 16px;
    transition: all 0.3s var(--ease-smooth);
  }

  .nav-brand:hover {
    background: var(--glass-navy);
  }

  .nav-item {
    padding: 10px 18px;
    border-radius: 16px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.3s var(--ease-smooth);
    position: relative;
  }

  .nav-item:hover {
    background: var(--glass-navy);
    color: var(--text-primary);
  }

  .nav-item.active {
    background: var(--glass-navy);
    color: var(--copper-500);
  }

  /* Nav Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-dropdown-trigger::after {
    content: '';
    display: inline-block;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid currentColor;
    transition: transform 0.2s ease;
  }

  .nav-dropdown:hover .nav-dropdown-trigger::after {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--spatial-glass);
    backdrop-filter: blur(var(--blur-lg));
    -webkit-backdrop-filter: blur(var(--blur-lg));
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 8px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    margin-top: 8px;
  }

  .nav-dropdown:hover .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  .nav-dropdown-menu a {
    display: block;
    padding: 10px 16px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  .nav-dropdown-menu a:hover {
    background: var(--glass-navy);
    color: var(--text-primary);
  }

  .dropdown-label {
    display: block;
    font-weight: 600;
    color: var(--navy-900);
  }

  .dropdown-desc {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* Nav CTA with Snake Border Animation */
  .nav-cta-glow {
    background: transparent !important;
    color: var(--oceanic-teal) !important;
    font-weight: 600 !important;
    border-radius: 4px !important;
    position: relative;
    overflow: hidden;
  }

  .nav-cta-glow::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--oceanic-teal));
    animation: snake-nav-anim1 1.5s linear infinite;
  }

  .nav-cta-glow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(270deg, transparent, var(--oceanic-teal));
    animation: snake-nav-anim3 1.5s linear infinite;
    animation-delay: 0.75s;
  }

  .nav-cta-glow:hover {
    background: var(--oceanic-teal) !important;
    color: #ffffff !important;
    box-shadow: 0 0 5px var(--oceanic-teal),
          0 0 25px var(--oceanic-teal);
  }

  @keyframes snake-nav-anim1 {
    0% { left: -100%; }
    50%, 100% { left: 100%; }
  }

  @keyframes snake-nav-anim3 {
    0% { left: 100%; }
    50%, 100% { left: -100%; }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav-dock {
      display: none;
    }

    .mobile-menu-toggle,
    .mobile-menu,
    .mobile-menu-overlay {
      display: flex;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const menuToggle = document.querySelector('.mobile-menu-toggle');
  const mobileMenu = document.querySelector('.mobile-menu');
  const menuOverlay = document.querySelector('.mobile-menu-overlay');

  function toggleMenu() {
    menuToggle?.classList.toggle('active');
    mobileMenu?.classList.toggle('active');
    menuOverlay?.classList.toggle('active');
    document.body.style.overflow = mobileMenu?.classList.contains('active') ? 'hidden' : '';
  }

  menuToggle?.addEventListener('click', toggleMenu);
  menuOverlay?.addEventListener('click', toggleMenu);

  // Close menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu.classList.contains('active')) {
        toggleMenu();
      }
    });
  });
</script>
