---
/**
 * RelatedPosts Component
 * Display related blog posts at the bottom of articles
 */

import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  currentCategory?: string;
  currentTags?: string[];
  relatedSlugs?: string[];
  maxPosts?: number;
}

const { currentSlug, currentCategory, currentTags = [], relatedSlugs = [], maxPosts = 3 } = Astro.props;

// Get all published posts
const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');

// Filter out current post
const otherPosts = allPosts.filter(post => post.slug !== currentSlug);

// Function to calculate relevance score
function getRelevanceScore(post: CollectionEntry<'blog'>): number {
  let score = 0;

  // Explicitly related posts get highest priority
  if (relatedSlugs.includes(post.slug)) {
    score += 100;
  }

  // Same category
  if (currentCategory && post.data.category === currentCategory) {
    score += 10;
  }

  // Matching tags
  const postTags = post.data.tags || [];
  for (const tag of currentTags) {
    if (postTags.includes(tag)) {
      score += 5;
    }
  }

  // Recency bonus (newer posts)
  const daysOld = (Date.now() - new Date(post.data.publishDate).getTime()) / (1000 * 60 * 60 * 24);
  if (daysOld < 30) score += 3;
  else if (daysOld < 90) score += 2;
  else if (daysOld < 180) score += 1;

  return score;
}

// Sort by relevance and take top posts
const relatedPosts = otherPosts
  .map(post => ({ post, score: getRelevanceScore(post) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, maxPosts)
  .map(({ post }) => post);
---

{relatedPosts.length > 0 && (
  <section class="related-posts">
    <h2 class="related-heading">
      <svg class="related-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
      </svg>
      Related Articles
    </h2>
    <div class="related-grid">
      {relatedPosts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="related-card">
          {post.data.featuredImage && (
            <div class="related-image">
              <img
                src={post.data.featuredImage}
                alt={post.data.title}
                loading="lazy"
                width="320"
                height="180"
              />
            </div>
          )}
          <div class="related-content">
            <span class="related-category">{post.data.category}</span>
            <h3 class="related-title">{post.data.title}</h3>
            <p class="related-excerpt">{post.data.description.slice(0, 100)}...</p>
            <div class="related-meta">
              <span class="related-date">
                {new Date(post.data.publishDate).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts {
    margin: 3rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border, rgba(0, 96, 100, 0.1));
  }

  .related-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy-900, #0a1628);
    margin-bottom: 1.5rem;
  }

  .related-icon {
    color: var(--oceanic-teal, #006064);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--glass-border, rgba(0, 96, 100, 0.1));
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 96, 100, 0.12);
    border-color: var(--oceanic-teal, #006064);
  }

  .related-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--glass-navy, rgba(10, 22, 40, 0.05));
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .related-card:hover .related-image img {
    transform: scale(1.05);
  }

  .related-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .related-category {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-600, #b87333);
    background: var(--glass-copper, rgba(184, 115, 51, 0.1));
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
    align-self: flex-start;
  }

  .related-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--navy-900, #0a1628);
    line-height: 1.4;
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-excerpt {
    font-size: 0.875rem;
    color: var(--text-muted, #718096);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .related-meta {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--glass-border, rgba(0, 96, 100, 0.08));
  }

  .related-date {
    font-size: 0.75rem;
    color: var(--text-muted, #718096);
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
