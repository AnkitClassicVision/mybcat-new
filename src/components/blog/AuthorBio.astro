---
/**
 * AuthorBio Component
 * Display author information at the bottom of blog posts
 */

export interface Props {
  name: string;
  role?: string;
  bio?: string;
  image?: string;
  linkedin?: string;
  twitter?: string;
}

const { name, role, bio, image, linkedin, twitter } = Astro.props;

// Default bios for known authors
const defaultBios: Record<string, { role: string; bio: string; image?: string; linkedin?: string; authorPage?: string }> = {
  'Ankit Patel': {
    role: 'Founder & Author',
    bio: 'Ankit Patel is the Founder and CEO of My Business Care Team. Before starting MyBCAT, he built his expertise at Dell and Cleveland Clinic, earning Lean Six Sigma credentials along the way. He co-founded Classic Vision Care in Atlanta with his wife, Dr. Mital Patel—where he first experienced the staffing and operational challenges that inspired MyBCAT. He writes about healthcare operations, practice growth, and the systems that help multi-location groups scale.',
    image: '/images/ankit_headshot_full.webp',
    linkedin: 'https://www.linkedin.com/in/ankitpatelcvc/',
    authorPage: '/author/ankit-patel/'
  },
  'Dr. Mital Patel': {
    role: 'Clinical Advisor, OD',
    bio: 'Dr. Mital Patel is the co-founder and optometrist at Classic Vision Care in Atlanta, GA. With extensive clinical experience in comprehensive eye exams, contact lens fittings, and ocular disease management, she provides the clinical lens that shapes MyBCAT\'s patient recall and communication best practices. Her firsthand work with patients grounds every operational recommendation in real clinical outcomes.',
    image: '/images/dr-mital-patel-headshot.webp',
    authorPage: '/author/dr-mital-patel/'
  },
  'MyBCAT Team': {
    role: 'Healthcare Operations Experts',
    bio: 'The MyBCAT team brings together expertise in healthcare operations, patient communication, and practice management to help practices thrive.'
  }
};

const authorDefaults = defaultBios[name] || { role: 'Contributor', bio: '' };
const displayRole = role || authorDefaults.role;
const displayBio = bio || authorDefaults.bio;
const displayImage = image || authorDefaults.image;
const displayLinkedin = linkedin || authorDefaults.linkedin;
const authorPage = authorDefaults.authorPage;

// Generate initials for avatar fallback
const initials = name.split(' ').map(n => n[0]).join('');
---

<div class="author-bio">
  <div class="author-avatar-container">
    {displayImage ? (
      <img src={displayImage} alt={`Photo of ${name}`} class="author-avatar-img" width="80" height="80" loading="lazy" />
    ) : (
      <div class="author-avatar-fallback">{initials}</div>
    )}
  </div>
  <div class="author-details">
    <div class="author-header">
      <span class="written-by">Written by</span>
      {authorPage ? (
        <a href={authorPage} class="author-name-link">
          <h3 class="author-name">{name}</h3>
        </a>
      ) : (
        <h3 class="author-name">{name}</h3>
      )}
      {displayRole && <span class="author-role">{displayRole}</span>}
    </div>
    {displayBio && <p class="author-description">{displayBio}</p>}
    {(displayLinkedin || twitter) && (
      <div class="author-social">
        {displayLinkedin && (
          <a href={displayLinkedin} target="_blank" rel="noopener noreferrer" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="sr-only">{name} on LinkedIn</span>
          </a>
        )}
        {twitter && (
          <a href={twitter} target="_blank" rel="noopener noreferrer" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="sr-only">{name} on X (Twitter)</span>
          </a>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .author-bio {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
    margin: 3rem 0;
    background: linear-gradient(135deg, rgba(0, 96, 100, 0.04) 0%, rgba(184, 115, 51, 0.04) 100%);
    border: 1px solid var(--glass-border, rgba(0, 96, 100, 0.1));
    border-radius: 20px;
  }

  .author-avatar-container {
    flex-shrink: 0;
  }

  .author-avatar-img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--oceanic-teal, #006064);
  }

  .author-avatar-fallback {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--oceanic-teal, #006064) 0%, var(--copper-500, #b87333) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
  }

  .author-details {
    flex: 1;
  }

  .author-header {
    margin-bottom: 0.75rem;
  }

  .written-by {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted, #718096);
    margin-bottom: 0.25rem;
  }

  .author-name-link {
    display: inline-block;
    padding: 10px 0;
    text-decoration: none;
  }

  .author-name-link:hover .author-name {
    color: var(--oceanic-teal, #006064);
  }

  .author-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900, #0a1628);
    margin: 0 0 0.25rem;
    transition: color 0.2s;
  }

  .author-role {
    font-size: 0.9rem;
    color: var(--oceanic-teal, #006064);
    font-weight: 500;
  }

  .author-description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary, #4a5568);
    margin: 0;
  }

  .author-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--glass-navy, rgba(10, 22, 40, 0.05));
    color: var(--navy-800, #1a365d);
    transition: all 0.2s;
  }

  .social-link:hover {
    background: var(--oceanic-teal, #006064);
    color: white;
  }

  @media (max-width: 640px) {
    .author-bio {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.5rem;
    }

    .author-social {
      justify-content: center;
    }
  }
</style>
