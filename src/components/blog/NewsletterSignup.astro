---
/**
 * NewsletterSignup - Inline email capture for blog posts
 * Submits directly to HubSpot Forms API (no embed script needed)
 */

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
}

const {
  title = "Get Practice Growth Insights",
  description = "Join 500+ optometry professionals getting weekly strategies on AI, automation, and practice growth.",
  buttonText = "Subscribe"
} = Astro.props;

const portalId = '23344341';
const formGuid = '7df21f92-ee45-492c-9ccb-ca85fae77361';
---

<aside class="newsletter-signup" role="complementary" aria-label="Newsletter signup">
  <div class="newsletter-inner">
    <div class="newsletter-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
    </div>
    <div class="newsletter-text">
      <h3 class="newsletter-title">{title}</h3>
      <p class="newsletter-description">{description}</p>
    </div>
    <form class="newsletter-form" data-portal-id={portalId} data-form-guid={formGuid}>
      <div class="newsletter-fields">
        <input
          type="text"
          name="firstname"
          placeholder="First name"
          class="newsletter-input newsletter-input-name"
          autocomplete="given-name"
        />
        <input
          type="email"
          name="email"
          placeholder="Work email"
          class="newsletter-input newsletter-input-email"
          required
          autocomplete="email"
        />
        <button type="submit" class="newsletter-button">
          <span class="btn-text">{buttonText}</span>
          <svg class="btn-spinner" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
          </svg>
        </button>
      </div>
      <p class="newsletter-error" aria-live="polite"></p>
    </form>
    <p class="newsletter-success" aria-live="polite">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
      You're in! Check your inbox for the latest from Optometrists Building Empires.
    </p>
  </div>
</aside>

<style>
  .newsletter-signup {
    margin-top: 48px;
    padding: 36px;
    background: linear-gradient(135deg, #f0fdfa 0%, #e0f7fa 50%, #e8f5e9 100%);
    border: 1px solid rgba(0, 96, 100, 0.15);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }

  .newsletter-signup::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(0, 96, 100, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
  }

  .newsletter-icon {
    width: 52px;
    height: 52px;
    background: rgba(0, 96, 100, 0.1);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--oceanic-teal, #006064);
    margin-bottom: 16px;
  }

  .newsletter-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--navy-900, #1A242C);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .newsletter-description {
    font-size: 0.95rem;
    color: var(--text-secondary, #4a5568);
    margin: 0 0 20px 0;
    line-height: 1.5;
  }

  .newsletter-fields {
    display: flex;
    gap: 8px;
  }

  .newsletter-input {
    padding: 12px 16px;
    border: 1.5px solid rgba(0, 96, 100, 0.2);
    border-radius: 10px;
    font-size: 15px;
    font-family: inherit;
    background: white;
    transition: border-color 0.2s, box-shadow 0.2s;
    color: var(--navy-900, #1A242C);
  }

  .newsletter-input::placeholder {
    color: #94a3b8;
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--oceanic-teal, #006064);
    box-shadow: 0 0 0 3px rgba(0, 96, 100, 0.1);
  }

  .newsletter-input-name {
    flex: 0 1 160px;
    min-width: 0;
  }

  .newsletter-input-email {
    flex: 1;
    min-width: 0;
  }

  .newsletter-button {
    flex-shrink: 0;
    padding: 12px 24px;
    background: var(--oceanic-teal, #006064);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .newsletter-button:hover {
    background: var(--navy-900, #1A242C);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 96, 100, 0.3);
  }

  .newsletter-button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .btn-spinner {
    display: none;
    animation: spin 1s linear infinite;
  }

  .newsletter-button.loading .btn-text {
    display: none;
  }

  .newsletter-button.loading .btn-spinner {
    display: block;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .newsletter-error {
    margin: 8px 0 0;
    font-size: 13px;
    color: #dc2626;
    min-height: 0;
  }

  .newsletter-error:empty {
    display: none;
  }

  .newsletter-success {
    display: none;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 14px 18px;
    background: rgba(0, 96, 100, 0.08);
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--oceanic-teal, #006064);
  }

  .newsletter-success svg {
    flex-shrink: 0;
    color: #16a34a;
  }

  .newsletter-signup.submitted .newsletter-form {
    display: none;
  }

  .newsletter-signup.submitted .newsletter-success {
    display: flex;
  }

  @media (max-width: 640px) {
    .newsletter-signup {
      padding: 28px 20px;
    }

    .newsletter-fields {
      flex-direction: column;
    }

    .newsletter-input-name {
      flex: 1;
    }

    .newsletter-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('.newsletter-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const portalId = form.dataset.portalId;
      const formGuid = form.dataset.formGuid;
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
      const nameInput = form.querySelector<HTMLInputElement>('input[name="firstname"]');
      const errorEl = form.querySelector<HTMLParagraphElement>('.newsletter-error');
      const button = form.querySelector<HTMLButtonElement>('.newsletter-button');
      const wrapper = form.closest<HTMLElement>('.newsletter-signup');

      if (!emailInput || !errorEl || !button || !wrapper) return;

      const email = emailInput.value.trim();
      const firstname = nameInput?.value.trim() || '';

      if (!email) {
        errorEl.textContent = 'Please enter your email address.';
        return;
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        errorEl.textContent = 'Please enter a valid email address.';
        return;
      }

      errorEl.textContent = '';
      button.classList.add('loading');
      button.disabled = true;

      const hutk = document.cookie
        .split('; ')
        .find((row) => row.startsWith('hubspotutk='))
        ?.split('=')[1];

      const submissionData: Record<string, unknown> = {
        fields: [
          { name: 'email', value: email },
          ...(firstname ? [{ name: 'firstname', value: firstname }] : []),
        ],
        context: {
          pageUri: window.location.href,
          pageName: document.title,
          ...(hutk ? { hutk } : {}),
        },
      };

      try {
        const response = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formGuid}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(submissionData),
          }
        );

        if (!response.ok) {
          const text = await response.text();
          console.error('Newsletter signup failed:', text);
          errorEl.textContent = 'Something went wrong. Please try again.';
          button.classList.remove('loading');
          button.disabled = false;
          return;
        }

        wrapper.classList.add('submitted');
      } catch (err) {
        console.error('Newsletter signup error:', err);
        errorEl.textContent = 'Network error. Please try again.';
        button.classList.remove('loading');
        button.disabled = false;
      }
    });
  });
</script>
