---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  pagePathPrefix?: string;
}

const { currentPage, totalPages, basePath, pagePathPrefix = 'page/' } = Astro.props;

// Build URLs (page 1 uses the base path).
const pageUrl = (pageNum: number) => (pageNum === 1 ? basePath : `${basePath}${pagePathPrefix}${pageNum}/`);

const prevUrl = currentPage > 1 ? pageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? pageUrl(currentPage + 1) : null;

type PageItem = { type: 'page'; num: number; url: string; current: boolean } | { type: 'ellipsis' };
const pageItems: PageItem[] = [];

for (let i = 1; i <= totalPages; i++) {
  const showPage = i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1;

  if (showPage) {
    pageItems.push({
      type: 'page',
      num: i,
      url: pageUrl(i),
      current: i === currentPage,
    });
  } else if (pageItems.length > 0 && pageItems[pageItems.length - 1].type !== 'ellipsis') {
    pageItems.push({ type: 'ellipsis' });
  }
}

// Astro's HTML attribute types do not describe `key`, but this list has rendered
// the attribute since it was written. Passing it as a typed object keeps the
// rendered markup byte for byte the same without widening the element types.
interface EllipsisAttributes {
  key: string;
}

const ellipsisAttributes = (idx: number): EllipsisAttributes => ({ key: `ellipsis-${idx}` });
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Blog pagination">
    <div class="pagination-links">
      {prevUrl ? (
        <a href={prevUrl} class="pagination-link prev" rel="prev">
          <span class="pagination-arrow">&larr;</span>
          <span>Newer</span>
        </a>
      ) : (
        <span class="pagination-link prev disabled" aria-disabled="true">
          <span class="pagination-arrow">&larr;</span>
          <span>Newer</span>
        </span>
      )}

      <div class="pagination-numbers">
        {pageItems.map((item, idx) =>
          item.type === 'ellipsis' ? (
            <span class="pagination-ellipsis" {...ellipsisAttributes(idx)}>...</span>
          ) : item.current ? (
            <span class="pagination-number current" aria-current="page">{item.num}</span>
          ) : (
            <a href={item.url} class="pagination-number">{item.num}</a>
          ),
        )}
      </div>

      {nextUrl ? (
        <a href={nextUrl} class="pagination-link next" rel="next">
          <span>Older</span>
          <span class="pagination-arrow">&rarr;</span>
        </a>
      ) : (
        <span class="pagination-link next disabled" aria-disabled="true">
          <span>Older</span>
          <span class="pagination-arrow">&rarr;</span>
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .pagination {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--glass-border);
  }

  .pagination-links {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .pagination-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--spatial-glass);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--navy-900);
    font-weight: 500;
    font-size: 14px;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .pagination-link:hover:not(.disabled) {
    background: var(--navy-900);
    color: white;
    border-color: var(--navy-900);
  }

  .pagination-link.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination-arrow {
    font-size: 16px;
  }

  .pagination-numbers {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .pagination-number {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--navy-900);
    font-weight: 500;
    font-size: 14px;
    transition: all 0.2s;
  }

  .pagination-number:hover:not(.current) {
    background: var(--glass-navy);
  }

  .pagination-number.current {
    background: var(--oceanic-teal);
    color: white;
  }

  .pagination-ellipsis {
    padding: 0 8px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .pagination-links {
      flex-wrap: wrap;
      justify-content: center;
    }

    .pagination-numbers {
      order: -1;
      width: 100%;
      justify-content: center;
      margin-bottom: 16px;
    }

    .pagination-link {
      flex: 1;
      justify-content: center;
    }
  }
</style>
