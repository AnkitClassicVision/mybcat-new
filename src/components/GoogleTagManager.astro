---
/**
 * Google Tag Manager Component
 * Deferred analytics loading. The container loads only after explicit
 * analytics consent or a meaningful user interaction.
 *
 * GTM Container: GTM-MFK3VKPN
 */

const GTM_ID = 'GTM-MFK3VKPN';
---

<!-- Google Tag Manager - deferred until consent or meaningful interaction -->
<script is:inline define:vars={{ GTM_ID }}>
  function loadGTM() {
    if (window.__gtmLoaded) return;
    window.__gtmLoaded = true;

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
    document.head.appendChild(script);
  }

  window.addEventListener('mybcat:analytics-consent', loadGTM, { once: true });
  ['pointerdown', 'keydown', 'touchstart'].forEach(function(eventName) {
    document.addEventListener(eventName, loadGTM, { once: true, passive: true });
  });
</script>
