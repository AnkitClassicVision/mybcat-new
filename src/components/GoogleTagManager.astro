---
/**
 * Google Tag Manager Component
 * Deferred loading for better FCP - loads after page is idle
 *
 * GTM Container: GTM-MFK3VKPN
 */

const GTM_ID = 'GTM-MFK3VKPN';
---

<!-- Google Tag Manager - deferred for performance -->
<script is:inline define:vars={{ GTM_ID }}>
  // Defer GTM until after page is interactive
  function loadGTM() {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
    var script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
    document.head.appendChild(script);
  }

  // Use requestIdleCallback if available, otherwise setTimeout
  // Increased timeouts for mobile TBT optimization
  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadGTM, { timeout: 4500 });
  } else {
    setTimeout(loadGTM, 5000);
  }
</script>
