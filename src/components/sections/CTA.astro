---
/**
 * CTA Section component
 * Call-to-action section with gradient background
 */
import { ctaButton } from '@data/navigation';
import Button from '@/components/Button.astro';

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  buttonFunnel?: 'service' | 'acquisition';
  buttonCtaId?: string;
  buttonContentCluster?: string;
  variant?: 'default' | 'simple';
}

const props = Astro.props as Props;

const {
  id,
  title = 'Ready to Fill Every Appointment Slot?',
  buttonText = 'Book Your Discovery Call',
  buttonHref = ctaButton.href,
  buttonFunnel,
  buttonCtaId,
  buttonContentCluster,
  variant = 'default'
} = props;

const subtitle =
  props.subtitle ??
  props.description ??
  "Book a discovery call to see how My Business Care Team can capture the revenue you're leaving on the table.";
---

<section id={id} class={`cta-section ${variant}`}>
  <div class="cta-content">
    <h2>{title}</h2>
    <p>{subtitle}</p>
    <Button
      href={buttonHref}
      variant="secondary-light"
      seoCta={Boolean(buttonCtaId)}
      funnel={buttonFunnel}
      ctaId={buttonCtaId}
      contentCluster={buttonContentCluster}
    >{buttonText}</Button>
  </div>
</section>

<style>
  .cta-section {
    grid-column: span 6;
    background: linear-gradient(135deg, var(--navy-900) 0%, var(--oceanic-teal) 100%);
    border-radius: 24px;
    padding: 60px 40px;
    text-align: center;
  }

  .cta-section.simple {
    padding: 40px;
  }

  .cta-content h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: 16px;
  }

  .cta-content p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 32px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-section.simple .cta-content p {
    margin-bottom: 24px;
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 40px 24px;
    }
  }
</style>
