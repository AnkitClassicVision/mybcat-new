---
/**
 * Testimonials Section component
 * Displays customer testimonials
 */
import type { Testimonial } from '@data/testimonials';
import Card from '@/components/Card.astro';

interface Props {
  items: Testimonial[];
  title?: string;
  eyebrow?: string;
}

const {
  items,
  title = 'Trusted by 70+ Healthcare Professionals',
  eyebrow = 'Results That Matter'
} = Astro.props;
---

<section class="testimonials-section">
  <div class="section-intro">
    <div class="section-intro-eyebrow">{eyebrow}</div>
    <h2 class="section-intro-title">{title}</h2>
  </div>

  <div class="testimonials-grid">
    {items.map(testimonial => (
      <Card variant="testimonial">
        <blockquote class="quote">"{testimonial.quote}"</blockquote>
        <div class="author">
          <div class="author-avatar">{testimonial.initials}</div>
          <div>
            <cite class="author-name">{testimonial.author}</cite>
            <span class="author-title">
              {testimonial.title}
              {testimonial.company && `, ${testimonial.company}`}
            </span>
          </div>
        </div>
      </Card>
    ))}
  </div>
</section>

<style>
  .testimonials-section {
    grid-column: span 6;
  }

  .section-intro {
    text-align: center;
    padding: 60px 24px 20px;
  }

  .section-intro-eyebrow {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--copper-500);
    margin-bottom: 12px;
  }

  .section-intro-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--navy-900);
    max-width: 700px;
    margin: 0 auto;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    padding: 20px 24px;
  }

  .quote {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    font-style: italic;
    margin: 0 0 16px;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--glass-copper) 0%, var(--copper-500) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: white;
    font-weight: 600;
    flex-shrink: 0;
  }

  .author-name {
    font-weight: 600;
    color: var(--navy-900);
    font-style: normal;
    display: block;
  }

  .author-title {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
