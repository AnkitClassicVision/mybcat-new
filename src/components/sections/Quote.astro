---
/**
 * Quote Section component
 * Displays a highlighted testimonial quote
 */

interface Props {
  quote: string;
  author: string;
  title?: string;
}

const { quote, author, title } = Astro.props;
---

<section class="quote-section">
  <blockquote>"{quote}"</blockquote>
  <cite>
    - {author}
    {title && <span class="author-title">, {title}</span>}
  </cite>
</section>

<style>
  .quote-section {
    grid-column: span 6;
    background: var(--glass-copper);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    text-align: center;
    padding: 40px 32px;
  }

  blockquote {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-style: italic;
    color: var(--navy-900);
    margin: 0 0 16px 0;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  cite {
    font-size: 15px;
    color: var(--text-secondary);
    font-style: normal;
    font-weight: 500;
  }

  .author-title {
    font-weight: 400;
  }
</style>
