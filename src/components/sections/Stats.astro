---
/**
 * Stats Section component
 * Displays key statistics in a highlighted card
 */

interface Stat {
  value: string;
  label: string;
}

interface Props {
  headline: string;
  headlineColor?: 'gold' | 'teal' | 'copper';
  description?: string;
  stats?: Stat[];
  variant?: 'single' | 'multi';
}

const {
  headline,
  headlineColor = 'gold',
  description,
  stats = [],
  variant = 'single'
} = Astro.props;

const colorMap = {
  gold: 'var(--revenue-gold)',
  teal: 'var(--oceanic-teal)',
  copper: 'var(--copper-500)'
};

const bgMap = {
  gold: 'rgba(211, 175, 94, 0.1)',
  teal: 'rgba(0, 96, 100, 0.08)',
  copper: 'rgba(184, 115, 51, 0.1)'
};

const borderMap = {
  gold: 'rgba(211, 175, 94, 0.25)',
  teal: 'rgba(0, 96, 100, 0.2)',
  copper: 'rgba(184, 115, 51, 0.25)'
};
---

<section
  class={`stat-section ${variant}`}
  style={`--stat-color: ${colorMap[headlineColor]}; --stat-bg: ${bgMap[headlineColor]}; --stat-border: ${borderMap[headlineColor]};`}
>
  {variant === 'single' ? (
    <div class="stat-card-single">
      <div class="stat-number">{headline}</div>
      {description && <div class="stat-label">{description}</div>}
    </div>
  ) : (
    <div class="stat-grid">
      {stats.map(stat => (
        <div class="stat-item">
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .stat-section {
    grid-column: span 6;
  }

  .stat-card-single {
    background: var(--stat-bg);
    border: 1px solid var(--stat-border);
    border-radius: 24px;
    text-align: center;
    padding: 40px;
  }

  .stat-number {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--stat-color);
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--stat-color);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    padding: 40px;
    background: var(--stat-bg);
    border: 1px solid var(--stat-border);
    border-radius: 24px;
  }

  .stat-item {
    text-align: center;
    padding: 20px;
  }

  .stat-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--stat-color);
    margin-bottom: 8px;
  }

  .stat-item .stat-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .stat-grid {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }
</style>
