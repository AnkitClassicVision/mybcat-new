---
/**
 * Logo Marquee Section component
 * Displays scrolling client/authority logos
 */
import { clientLogos } from '@data/testimonials';

// The data module exports the logo array, not a named type. Derive the
// element type from it so the props and the map callback stay typed.
type ClientLogo = (typeof clientLogos)[number];

interface Props {
  title?: string;
  logos?: ClientLogo[];
  speed?: 'slow' | 'normal' | 'fast';
}

const {
  title = 'Trusted by Leading Healthcare Practices',
  logos = clientLogos,
  speed = 'normal'
} = Astro.props;

const speedMap = {
  slow: '60s',
  normal: '40s',
  fast: '25s'
};
---

<section class="logo-marquee-section" style={`--animation-speed: ${speedMap[speed]}`}>
  <div class="marquee-label">{title}</div>
  <div class="marquee-track" id="logoMarqueeTrack">
    {/* Only load logos once - JS will clone for infinite scroll */}
    {logos.map((logo: ClientLogo) => (
      <img
        src={logo.src}
        alt={logo.alt}
        class="marquee-logo"
        width="180"
        height="60"
        loading="lazy"
        decoding="async"
      />
    ))}
  </div>
</section>

<script>
  // Clone logos for infinite scroll effect (avoids loading 30 images)
  const track = document.getElementById('logoMarqueeTrack');
  if (track) {
    const logos = track.innerHTML;
    track.innerHTML = logos + logos + logos;
  }
</script>

<style>
  .logo-marquee-section {
    grid-column: span 6;
    background: var(--spatial-glass);
    border-radius: 24px;
    border: 1px solid var(--glass-border);
    padding: 40px;
    overflow: hidden;
    position: relative;
    box-shadow: var(--shadow);
  }

  .marquee-label {
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 32px;
  }

  .marquee-track {
    display: flex;
    gap: 80px;
    align-items: center;
    animation: scrollLogos var(--animation-speed, 40s) linear infinite;
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  @keyframes scrollLogos {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-33.333%, 0, 0); }
  }

  .marquee-logo {
    height: 60px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  .marquee-logo:hover {
    opacity: 1;
  }

  /* Pause on hover */
  .logo-marquee-section:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .marquee-track {
      gap: 40px;
    }

    .marquee-logo {
      height: 40px;
      max-width: 120px;
    }
  }
</style>
