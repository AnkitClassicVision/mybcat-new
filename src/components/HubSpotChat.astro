---
interface Props {
  portalId?: string;
  delay?: number;
}

const {
  portalId = '47905082',
  delay = 15000 // 15 seconds delay for better performance
} = Astro.props;
---

<div id="hubspot-chat-container" data-portal-id={portalId} data-delay={delay}></div>

<script>
  // Delay loading HubSpot chat for performance
  const container = document.getElementById('hubspot-chat-container');
  const portalId = container?.getAttribute('data-portal-id');
  const delay = parseInt(container?.getAttribute('data-delay') || '8000', 10);

  let chatLoaded = false;

  const loadHubSpotChat = () => {
    if (chatLoaded || !portalId) return;
    chatLoaded = true;

    const script = document.createElement('script');
    script.id = 'hs-script-loader';
    script.src = `//js.hs-scripts.com/${portalId}.js`;
    script.async = true;
    script.defer = true;
    document.body.appendChild(script);
  };

  // Load after delay
  const timeoutId = setTimeout(loadHubSpotChat, delay);

  // Or load on user interaction (whichever comes first)
  const interactionEvents = ['mousedown', 'mousemove', 'keydown', 'scroll', 'touchstart'];

  const handleInteraction = () => {
    clearTimeout(timeoutId);
    loadHubSpotChat();
    interactionEvents.forEach((event) => {
      document.removeEventListener(event, handleInteraction, { passive: true } as EventListenerOptions);
    });
  };

  interactionEvents.forEach((event) => {
    document.addEventListener(event, handleInteraction, { passive: true });
  });
</script>
