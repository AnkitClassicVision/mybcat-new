---
/**
 * BaseLayout - Core HTML structure
 * All other layouts extend from this
 */
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import GoogleTagManager from '@/components/GoogleTagManager.astro';
import GoogleTagManagerNoScript from '@/components/GoogleTagManagerNoScript.astro';
import PostHog from '@/components/PostHog.astro';
import AttributionCapture from '@/components/AttributionCapture.astro';
import { company } from '@data/company';
import { generateOrganizationSchema, generateWebSiteSchema, serializeSchema } from '@utils/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  noindex?: boolean;
  disableTracking?: boolean;
  navMode?: 'full' | 'minimal' | 'hidden';
  lcpImage?: string; // Preload hint for Largest Contentful Paint image
}

const {
  title,
  description,
  ogImage = '/images/og-home.jpg',
  ogType = 'website',
  canonical,
  publishDate,
  modifiedDate,
  author = company.ownership.founder,
  noindex = false,
  disableTracking = false,
  navMode = 'full',
  lcpImage
} = Astro.props;

const siteUrl = company.site.url;
// Ensure trailing slash for canonical URLs
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/') && !pathname.includes('.')) {
  pathname += '/';
}
const canonicalUrl = canonical || new URL(pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Check if this is the homepage for Organization schema
const isHomepage = pathname === '/';
const shouldPreloadLogo = navMode !== 'hidden';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {/* Disable Vercel Insights injection on privacy-sensitive pages */}
  {disableTracking && (
    <script is:inline>
      (function () {
        try {
          const original = HTMLHeadElement.prototype.appendChild;
          HTMLHeadElement.prototype.appendChild = function (node) {
            try {
              if (
                node &&
                node.tagName === 'SCRIPT' &&
                typeof node.src === 'string' &&
                node.src.indexOf('/_vercel/insights/script.js') !== -1
              ) {
                return node;
              }
            } catch (_e) { /* empty */ }
            return original.call(this, node);
          };
        } catch (_e) { /* empty */ }
      })();
    </script>
  )}

  {/* Critical CSS - inlined for faster FCP */}
  <style is:inline>
    @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:fallback;src:url('/fonts/inter-latin-400-normal.woff2') format('woff2')}
    @font-face{font-family:'Inter';font-style:normal;font-weight:700;font-display:fallback;src:url('/fonts/inter-latin-700-normal.woff2') format('woff2')}
    @font-face{font-family:'Inter';font-style:normal;font-weight:800;font-display:fallback;src:url('/fonts/inter-latin-800-normal.woff2') format('woff2')}
    :root{--deep-slate:#27343C;--oceanic-teal:#006064;--navy-900:#1A242C;--navy-800:#27343C;--copper-500:#4DD0E1;--spatial-bg:#F4F6F8;--spatial-glass:rgba(255,255,255,0.82);--glass-border:rgba(39,52,60,0.12);--text-primary:#27343C;--text-secondary:#475462;--cream-200:#D8DFE4}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{-webkit-text-size-adjust:100%;font-family:'Inter',system-ui,-apple-system,sans-serif}
    body{background:var(--spatial-bg);color:var(--text-primary);line-height:1.6;min-height:100vh}
    .nav-dock{position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:1000;background:rgba(255,255,255,0.98);border:1px solid var(--glass-border);border-radius:24px;padding:6px 16px;display:flex;gap:2px;box-shadow:0 4px 20px rgba(0,0,0,0.08)}
    .nav-brand{display:flex;align-items:center;gap:10px;padding:6px 14px;text-decoration:none}
    .nav-brand img{height:28px;width:auto}
    .spatial-hero{min-height:85vh;background:linear-gradient(135deg,var(--cream-200) 0%,rgba(255,253,245,0.8) 100%);border-radius:24px;display:flex;align-items:center}
    .spatial-hero-inner{display:grid;grid-template-columns:1.1fr 0.9fr;gap:40px;width:100%;padding:60px 48px;align-items:center}
    .hero-title{font-size:clamp(2rem,4vw,3rem);font-weight:800;color:var(--navy-900);line-height:1.1}
    .hero-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:16px}
    .mobile-menu-toggle,.mobile-menu,.mobile-menu-overlay{display:none}
    @media(max-width:1024px){.nav-dock{display:none}.mobile-menu-toggle{display:flex;position:fixed;top:20px;right:20px;z-index:1001;width:44px;height:44px;background:var(--spatial-glass);border:1px solid var(--glass-border);border-radius:12px;flex-direction:column;justify-content:center;align-items:center;gap:5px}.spatial-hero-inner{grid-template-columns:1fr;padding:40px 24px}}
  </style>

  {/* Preload LCP image for faster paint */}
  {lcpImage && (
    <link rel="preload" href={lcpImage} as="image" type="image/webp" fetchpriority="high" />
  )}

  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Robots -->
  {noindex ? (
    <meta name="robots" content="noindex, nofollow">
    <meta name="googlebot" content="noindex, nofollow">
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  )}

  <link rel="canonical" href={canonicalUrl}>

  <!-- RSS feed autodiscovery for agents and feed readers -->
  <link rel="alternate" type="application/rss+xml" title="MyBCAT Blog" href="/rss.xml">

  <!-- Hreflang - US English site with x-default fallback for international SEO -->
  <link rel="alternate" hreflang="en-US" href={canonicalUrl}>
  <link rel="alternate" hreflang="x-default" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content={company.name}>
  <meta property="og:locale" content={company.site.locale}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalUrl}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>

  {publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()}>
  )}
  {modifiedDate && (
    <meta property="article:modified_time" content={modifiedDate.toISOString()}>
  )}
  {author && ogType === 'article' && (
    <meta property="article:author" content={author}>
  )}

  <!-- Self-hosted fonts - preload critical weights (400 body, 700 headings, 800 hero) -->
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  {shouldPreloadLogo && (
    <link rel="preload" href="/images/logo-optimized.webp" as="image" type="image/webp">
  )}

  <!-- DNS prefetch for third-party resources -->
  {!disableTracking && (
    <>
      <link rel="dns-prefetch" href="https://www.googletagmanager.com">
      <link rel="dns-prefetch" href="https://va.vercel-scripts.com">
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    </>
  )}

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <!-- Organization + WebSite Schema (homepage only) - Enterprise B2B positioning -->
  {isHomepage && (
    <>
      <script type="application/ld+json" set:html={serializeSchema(generateOrganizationSchema())} />
      <script type="application/ld+json" set:html={serializeSchema(generateWebSiteSchema())} />
    </>
  )}

  <!-- PostHog client-side analytics -->
  {!disableTracking && <PostHog />}

  <!-- First-party lead source capture (first touch and last touch) -->
  {!disableTracking && <AttributionCapture />}

  <slot name="head" />

</head>
<body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
  {!disableTracking && <GoogleTagManagerNoScript />}
  {navMode !== 'hidden' && <Nav currentPath={Astro.url.pathname} />}

  <slot />

  <Footer />

  <slot name="footer-scripts" />

  {/* First-party attribution stores only normalized campaign categories and paths. */}
  <script is:inline src="/js/seo-attribution.js" defer></script>
  <script is:inline src="/js/intake-form.js" defer></script>

  {/* Block Vector.co pixel - misconfigured in GTM, causes console errors */}
  <script is:inline>
    (function () {
      try {
        const origAppend = HTMLHeadElement.prototype.appendChild;
        HTMLHeadElement.prototype.appendChild = function (node) {
          try {
            if (
              node &&
              node.tagName === 'SCRIPT' &&
              typeof node.src === 'string' &&
              node.src.indexOf('vector.co') !== -1
            ) {
              return node;
            }
          } catch (_e) { /* empty */ }
          return origAppend.call(this, node);
        };
      } catch (_e) { /* empty */ }
    })();
  </script>

  {/* GTM moved to end of body for better FCP */}
  {!disableTracking && <GoogleTagManager />}
</body>
</html>
