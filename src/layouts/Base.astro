---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import GoogleTagManager from '@/components/GoogleTagManager.astro';
import GoogleTagManagerNoScript from '@/components/GoogleTagManagerNoScript.astro';
import { company } from '@data/company';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/images/og-home.jpg',
  ogType = 'website',
  canonical,
  publishDate,
  modifiedDate,
  author = company.ownership.founder,
  noindex = false,
} = Astro.props;

const siteUrl = company.site.url;
// Ensure trailing slash for canonical URLs
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/') && !pathname.includes('.')) {
  pathname += '/';
}
const canonicalUrl = canonical || new URL(pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {/* Critical CSS - inlined for faster FCP (fonts defined in global.css) */}
  <style is:inline>
    :root{--deep-slate:#27343C;--oceanic-teal:#006064;--navy-900:#1A242C;--navy-800:#27343C;--copper-500:#4DD0E1;--spatial-bg:#F4F6F8;--spatial-glass:rgba(255,255,255,0.82);--glass-border:rgba(39,52,60,0.12);--text-primary:#27343C;--text-secondary:#475462;--cream-200:#D8DFE4}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{-webkit-text-size-adjust:100%;font-family:'Inter',system-ui,-apple-system,sans-serif}
    body{background:var(--spatial-bg);color:var(--text-primary);line-height:1.6;min-height:100vh}
    .nav-dock{position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:1000;background:rgba(255,255,255,0.98);border:1px solid var(--glass-border);border-radius:24px;padding:6px 16px;display:flex;gap:2px;box-shadow:0 4px 20px rgba(0,0,0,0.08)}
    .nav-brand{display:flex;align-items:center;gap:10px;padding:6px 14px;text-decoration:none}
    .nav-brand img{height:28px;width:auto}
    .mobile-menu-toggle,.mobile-menu,.mobile-menu-overlay{display:none}
    @media(max-width:1024px){.nav-dock{display:none}.mobile-menu-toggle{display:flex;position:fixed;top:20px;right:20px;z-index:1001;width:44px;height:44px;background:var(--spatial-glass);border:1px solid var(--glass-border);border-radius:12px;flex-direction:column;justify-content:center;align-items:center;gap:5px}}
  </style>

  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Robots -->
  {noindex ? (
    <meta name="robots" content="noindex, nofollow">
    <meta name="googlebot" content="noindex, nofollow">
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  )}

  <link rel="canonical" href={canonicalUrl}>

  <!-- RSS feed autodiscovery for agents and feed readers -->
  <link rel="alternate" type="application/rss+xml" title="MyBCAT Blog" href="/rss.xml">

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:site_name" content="My Business Care Team">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalUrl}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>

  {publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()}>
  )}
  {modifiedDate && (
    <meta property="article:modified_time" content={modifiedDate.toISOString()}>
  )}
  {author && ogType === 'article' && (
    <meta property="article:author" content={author}>
  )}
  {author && (
    <meta name="author" content={author}>
  )}

  <!-- Self-hosted fonts - preload critical weights only (400 for body, 700 for headings) -->
  <!-- Other weights (600, 800) load on-demand via @font-face in global.css -->
  <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>

  <!-- LCP hint: logo is commonly the first painted image on key pages -->
  <link rel="preload" href="/images/logo-optimized.webp" as="image" type="image/webp">

  <!-- Some audit tools rely on CSS.escape; polyfill defensively for older runtimes -->
  <script is:inline>
    (function () {
      try {
        if (typeof window === 'undefined') return;
        if (typeof window.CSS === 'undefined') window.CSS = {};
        if (typeof window.CSS.escape === 'function') return;
        // Minimal CSS.escape polyfill (MDN-inspired) for safe selector escaping.
        window.CSS.escape = function (value) {
          const string = String(value);
          const length = string.length;
          let index = -1;
          let output = '';
          let codeUnit;
          const firstCodeUnit = string.charCodeAt(0);

          while (++index < length) {
            codeUnit = string.charCodeAt(index);
            // Note: there is no need to special-case astral symbols, surrogate pairs, or lone surrogates.
            if (codeUnit === 0x0000) {
              output += '\uFFFD';
              continue;
            }

            if (
              (codeUnit >= 0x0001 && codeUnit <= 0x001f) ||
              codeUnit === 0x007f ||
              (index === 0 && codeUnit >= 0x0030 && codeUnit <= 0x0039) ||
              (index === 1 && codeUnit >= 0x0030 && codeUnit <= 0x0039 && firstCodeUnit === 0x002d)
            ) {
              output += '\\\\' + codeUnit.toString(16) + ' ';
              continue;
            }

            if (
              index === 0 &&
              length === 1 &&
              codeUnit === 0x002d
            ) {
              output += '\\\\' + string.charAt(index);
              continue;
            }

            if (
              codeUnit >= 0x0080 ||
              codeUnit === 0x002d ||
              codeUnit === 0x005f ||
              (codeUnit >= 0x0030 && codeUnit <= 0x0039) ||
              (codeUnit >= 0x0041 && codeUnit <= 0x005a) ||
              (codeUnit >= 0x0061 && codeUnit <= 0x007a)
            ) {
              output += string.charAt(index);
              continue;
            }

            output += '\\\\' + string.charAt(index);
          }

          return output;
        };
      } catch (_e) { /* empty */ }
    })();
  </script>

  <!-- DNS prefetch for third-party resources -->
  <link rel="dns-prefetch" href="https://js.hsforms.net">
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://va.vercel-scripts.com">
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">

  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="skip-to-content">Skip to main content</a>
  <GoogleTagManagerNoScript />
  <Nav currentPath={Astro.url.pathname} />

  <slot />

  <Footer />

  <slot name="footer-scripts" />

  {/* Block Vector.co pixel - misconfigured in GTM, causes console errors */}
  <script is:inline>
    (function () {
      try {
        const origAppend = HTMLHeadElement.prototype.appendChild;
        HTMLHeadElement.prototype.appendChild = function (node) {
          try {
            if (
              node &&
              node.tagName === 'SCRIPT' &&
              typeof node.src === 'string' &&
              node.src.indexOf('vector.co') !== -1
            ) {
              return node;
            }
          } catch (_e) { /* empty */ }
          return origAppend.call(this, node);
        };
      } catch (_e) { /* empty */ }
    })();
  </script>

  {/* GTM moved to end of body for better FCP */}
  <GoogleTagManager />
</body>
</html>
