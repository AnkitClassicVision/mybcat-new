---
import Base from './Base.astro';
import AuthorBio from '@/components/blog/AuthorBio.astro';
import MedicalReviewBadge from '@/components/blog/MedicalReviewBadge.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import { isPostVisible } from '@utils/blog';
import { generateArticleSchema, generateBreadcrumbSchema, generateHowToSchema, generateFAQSchema, combineSchemas, serializeSchema } from '@/utils/schema';
import { company } from '@data/company';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, publishDate, modifiedDate, author, category, tags, featuredImage, relatedPosts, seoTitle, seoDescription, canonical, howToSchema, faqSchema } = post.data;

// Generate category slug for linking
const categorySlug = category.toLowerCase().replace(/\s+/g, '-');

// Posts that are not visible should not be indexed by search engines.
// Keep this consistent with list pages and getStaticPaths().
const shouldNoindex = !isPostVisible(post.data);

// SEO title: use seoTitle if provided, otherwise use full title
// This allows short, keyword-optimized titles for search results
// while keeping descriptive titles on the page
const pageTitle = seoTitle || title;

// Keep the rendered <title> within common SEO length guidance (30–60 chars).
// Prefer including the brand suffix, but avoid pushing otherwise-good titles over the limit.
const brandSuffix = ' | MyBCAT';
const titleWithBrand = `${pageTitle}${brandSuffix}`;
const metaTitle = titleWithBrand.length <= 60 ? titleWithBrand : pageTitle;
const metaDescription = seoDescription || description;

// Calculate reading time and word count (rough estimate: 200 words per minute)
const content = post.body || '';
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Author URL map for schema and linking
const authorUrlMap: Record<string, string> = {
  'Ankit Patel': '/author/ankit-patel/',
  'Dr. Mital Patel': '/author/dr-mital-patel/',
};

// Clinical categories that show "Reviewed by" badge for E-E-A-T
const clinicalCategories = ['Patient Recall', 'Patient Experience', 'Patient Communication', 'Clinical Operations'];
const isClinicalPost = clinicalCategories.includes(category);
const reviewer = isClinicalPost ? {
  name: 'Dr. Mital Patel',
  url: `${company.site.url}/author/dr-mital-patel/`,
  credential: 'Doctor of Optometry (OD)'
} : undefined;

// Generate Article schema for SEO
const articleUrl = `${company.site.url}/blog/${post.slug}/`;
const authorUrl = authorUrlMap[author];
const articleSchema = generateArticleSchema({
  headline: title,
  description: description,
  image: featuredImage || '/images/og-blog.jpg',
  author: author,
  authorUrl: authorUrl ? `${company.site.url}${authorUrl}` : undefined,
  datePublished: publishDate.toISOString(),
  dateModified: modifiedDate ? modifiedDate.toISOString() : undefined,
  url: articleUrl,
  wordCount: wordCount,
  section: category,
  keywords: tags,
  reviewedBy: reviewer ? { name: reviewer.name, url: reviewer.url, credential: reviewer.credential } : undefined,
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Blog', url: '/blog/' },
  { name: title }
], articleUrl);

const optionalSchemas: object[] = [];
if (howToSchema) {
  optionalSchemas.push(generateHowToSchema({ ...howToSchema, url: articleUrl }));
}
if (faqSchema && faqSchema.length > 0) {
  optionalSchemas.push(generateFAQSchema(faqSchema));
}

const schema = combineSchemas(articleSchema, breadcrumbSchema, ...optionalSchemas);

// Author data for header
const authorData: Record<string, { role: string; image: string }> = {
  'Ankit Patel': {
    role: 'Founder & Author',
    image: '/images/ankit_headshot_full.webp'
  },
  'Dr. Mital Patel': {
    role: 'Clinical Advisor, OD',
    image: '/images/dr-mital-patel-headshot.webp'
  }
};
const authorInfo = authorData[author] || { role: '', image: '' };
---

<Base
  title={metaTitle}
  description={metaDescription}
  ogType="article"
  ogImage={featuredImage}
  canonical={canonical}
  publishDate={publishDate}
  modifiedDate={modifiedDate}
  author={author}
  noindex={shouldNoindex}
>
  <script slot="head" type="application/ld+json" set:html={serializeSchema(schema)} />
  <main id="main-content">
	    <article class="blog-post" itemscope itemtype="https://schema.org/Article">
	    <header class="post-header">
	      <div class="post-meta" aria-label="Article metadata">
	        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
	          <a href={authorUrlMap[author] || '/about/'} rel="author" class="post-byline" itemprop="url">
	            <span class="post-byline-prefix" aria-hidden="true">By </span>
	            <span itemprop="name">{author}</span>
	          </a>
	        </span>
	        <a href={`/blog/category/${categorySlug}/`} class="post-category">{category}</a>
	        <time datetime={publishDate.toISOString()} class="post-date" itemprop="datePublished">{publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
	        <span class="post-reading-time">{readingTime} min read</span>
	      </div>
      <h1 class="post-title" itemprop="headline">{title}</h1>
      <p class="post-description" itemprop="description">{description}</p>
      <div class="post-author">
        {authorInfo.image ? (
          <img src={authorInfo.image} alt={author} class="author-avatar-img" width="48" height="48" loading="eager" />
        ) : (
          <div class="author-avatar">{author.split(' ').map(n => n[0]).join('')}</div>
        )}
        <div class="author-info">
          <a href={authorUrlMap[author] || '/about/'} rel="author" class="author-name">{author}</a>
          {authorInfo.role && <span class="author-role">{authorInfo.role}</span>}
        </div>
      </div>
      {isClinicalPost && reviewer && (
        <MedicalReviewBadge
          reviewerName={reviewer.name}
          credential="OD"
          reviewerUrl="/author/dr-mital-patel/"
        />
      )}
    </header>

    {featuredImage && (
      <div class="post-featured-image">
        <picture>
          <source
            srcset={featuredImage.replace(/\.(png|jpg|jpeg)$/i, '.webp')}
            type="image/webp"
          />
          <img
            src={featuredImage}
            alt={title}
            loading="eager"
            decoding="async"
            width="1200"
            height="630"
            fetchpriority="high"
            itemprop="image"
          />
        </picture>
      </div>
    )}

    <div class="post-content prose" id="blog-content" itemprop="articleBody">
      <slot />
    </div>

    {tags && tags.length > 0 && (
      <footer class="post-footer">
        <div class="post-tags">
          {tags.map((tag: string) => (
            <a href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag">{tag}</a>
          ))}
        </div>
      </footer>
    )}

    <!-- Author Bio -->
    <AuthorBio name={author} />

    <!-- Related Posts -->
    <RelatedPosts
      currentSlug={post.slug}
      currentCategory={category}
      currentTags={tags || []}
      relatedSlugs={relatedPosts || []}
      maxPosts={3}
    />

    <!-- Blog Post CTA -->
    <section class="post-cta">
      <div class="post-cta-content">
        <div class="post-cta-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            <path d="M14.05 2a9 9 0 0 1 8 7.94"></path>
            <path d="M14.05 6A5 5 0 0 1 18 10"></path>
          </svg>
        </div>
        <div class="post-cta-text">
          <h2>Ready to Capture More Revenue?</h2>
          <p>See how MyBCAT helps multi-location healthcare groups fill every appointment slot and reduce front desk dependency.</p>
        </div>
      </div>
      <div class="post-cta-buttons">
        <a href="/contact/" class="cta-button primary">Schedule a Consultation</a>
        <a href="/blog/" class="cta-button secondary">View More Articles</a>
      </div>
    </section>
  </article>
  </main>
</Base>

<script>
  // Wrap markdown-generated tables in a scrollable container for mobile
  const postTitle = document.querySelector('.post-title')?.textContent?.trim() || 'Table';
  const findNearestHeading = (table) => {
    let prev = table.previousElementSibling;
    while (prev) {
      if (/^H[1-6]$/.test(prev.tagName)) return prev;
      prev = prev.previousElementSibling;
    }
    return table.closest('.prose')?.querySelector('h2, h3, h4, h5, h6') || null;
  };

  document.querySelectorAll('.prose table').forEach((table, _index) => {
    if (table.parentElement?.classList.contains('table-wrapper')) return;
    const wrapper = document.createElement('div');
    wrapper.className = 'table-wrapper';
    table.parentNode?.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });

  // Add accessible labels to tables for screen readers and audit tools
  document.querySelectorAll('.prose table').forEach((table, index) => {
    if (!table.getAttribute('aria-label')) {
      const heading = findNearestHeading(table);
      const labelBase = heading?.textContent?.trim() || postTitle;
      table.setAttribute('aria-label', `${labelBase} table ${index + 1}`);
    }
  });
</script>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 100px 24px 60px;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .post-byline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: var(--glass-copper);
    color: var(--copper-700);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .post-byline:hover {
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-1px);
  }

  .post-category {
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 12px;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s;
  }

  .post-date,
  .post-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--glass-navy);
    color: var(--navy-800);
    line-height: 1.2;
  }

  /* Ensure small inline elements stay legible and tappable */
  .prose :global(sup),
  .prose :global(sub),
  .prose :global(small) {
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .post-category:hover {
    background: var(--copper-700);
    color: white;
  }

  /* Touch-friendly tap targets (phones/tablets) */
  @media (max-width: 1024px), (pointer: coarse) {
    .post-byline,
    .post-category,
    .tag {
      min-height: 44px;
      padding: 0 14px;
    }

    .post-category,
    .tag {
      display: inline-flex;
      align-items: center;
    }

    /* Make in-content links easier to tap on touch devices */
    .prose :global(a) {
      display: inline-block;
      padding: 6px 2px;
      /* Add vertical breathing room so adjacent wrapped links meet 8px spacing */
      margin: 4px 0;
    }

    /* Blog header author link is otherwise too small to tap */
    .author-name {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 2px;
    }
  }

  .post-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--glass-copper) 0%, var(--copper-500) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: white;
    font-weight: 600;
  }

  .author-avatar-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--oceanic-teal);
  }

  .author-name {
    font-weight: 600;
    color: var(--navy-900);
    display: block;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.2s;
  }

  .author-name:hover {
    color: var(--oceanic-teal);
  }

  .author-role {
    font-size: 0.85rem;
    color: var(--oceanic-teal);
    font-weight: 500;
  }

  .post-featured-image {
    margin-bottom: 40px;
    border-radius: 16px;
    overflow: hidden;
  }

  .post-featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Enhanced Prose styling for Markdown content */
  .prose {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  /* Lead Paragraph - The Hook */
  .prose > :global(p:first-of-type) {
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--navy-900);
    margin-bottom: 2rem;
    font-weight: 500;
  }

  /* Headings that Pop */
  .prose :global(h2) {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--navy-900);
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--glass-border);
    position: relative;
  }

  .prose :global(h2)::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 2px;
    background: var(--oceanic-teal);
  }

  .prose :global(h3) {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy-800);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-left: 1rem;
    border-left: 4px solid var(--electric-aqua);
  }

  .prose :global(h4) {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--navy-700);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  /* Body Text & Links */
  .prose :global(p) {
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .prose :global(a) {
    color: var(--oceanic-teal);
    text-decoration: none;
    border-bottom: 2px solid rgba(0, 96, 100, 0.2);
    transition: all 0.2s ease;
    font-weight: 500;
  }

  .prose :global(a:hover) {
    color: var(--navy-900);
    border-bottom-color: var(--electric-aqua);
    background: rgba(77, 208, 225, 0.1);
  }

  .prose :global(strong) {
    font-weight: 700;
    color: var(--navy-900);
  }

  /* Engaging Lists */
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
    position: relative;
    color: var(--text-secondary);
  }

  /* Task lists (GFM) render tiny disabled checkboxes by default */
  .prose :global(ul.contains-task-list) {
    padding-left: 0;
  }

  .prose :global(li.task-list-item) {
    list-style: none;
    padding-left: 0;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .prose :global(li.task-list-item input[type='checkbox']) {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    margin: 0;
  }

  .prose :global(ul li)::marker {
    color: var(--oceanic-teal);
    font-weight: bold;
  }

  .prose :global(ol li)::marker {
    color: var(--oceanic-teal);
    font-weight: 600;
  }

  /* Enhanced Blockquotes */
  .prose :global(blockquote) {
    border-left: 4px solid var(--oceanic-teal);
    background: linear-gradient(to right, rgba(0, 96, 100, 0.06), transparent);
    padding: 24px 32px;
    margin: 2.5rem 0;
    font-style: italic;
    color: var(--navy-800);
    border-radius: 0 12px 12px 0;
    font-size: 1.15rem;
  }

  .prose :global(blockquote p) {
    margin-bottom: 0;
  }

  /* Code Blocks */
  .prose :global(code) {
    background: var(--cream-100, #f5f5f5);
    color: var(--navy-900);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.9em;
    border: 1px solid var(--cream-200, #e5e5e5);
  }

  .prose :global(pre) {
    background: var(--navy-900);
    color: var(--cream-200);
    padding: 24px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 2rem 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    border: none;
    color: inherit;
    font-size: 0.95em;
  }

  /* Modern Tables – scrollable wrapper for mobile */
  .prose :global(.table-wrapper) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 2.5rem 0;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 0;
    box-shadow: none;
    border-radius: 12px;
    overflow: hidden;
    font-size: 1rem;
    min-width: 480px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid var(--glass-border);
  }

  .prose :global(th) {
    background: var(--navy-900);
    color: white;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    border-bottom: none;
  }

  .prose :global(tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(tbody tr:nth-child(even)) {
    background-color: rgba(0, 96, 100, 0.03);
  }

  .prose :global(tbody tr:hover td) {
    background-color: rgba(0, 96, 100, 0.06);
  }

  /* Images */
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 2.5rem 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--glass-border);
  }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--glass-border), transparent);
    margin: 3.5rem 0;
  }

  /* In-Content CTA Styles (for injected CTA) */
  .prose :global(.in-content-cta),
  .injected-cta .in-content-cta {
    margin: 3rem 0;
    padding: 2rem;
    background: linear-gradient(135deg, var(--navy-900) 0%, rgba(0, 96, 100, 0.9) 100%);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }

  .prose :global(.in-content-cta)::before,
  .injected-cta .in-content-cta::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(circle at top right, rgba(77, 208, 225, 0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .prose :global(.cta-inner),
  .injected-cta .cta-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .prose :global(.cta-icon),
  .injected-cta .cta-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    background: rgba(77, 208, 225, 0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--electric-aqua);
  }

  .prose :global(.cta-text),
  .injected-cta .cta-text {
    flex: 1;
    min-width: 0;
  }

  .prose :global(.cta-title),
  .injected-cta .cta-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
    border: none;
    padding: 0;
  }

  .prose :global(.cta-title)::after,
  .injected-cta .cta-title::after {
    display: none;
  }

  .prose :global(.cta-description),
  .injected-cta .cta-description {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    line-height: 1.5;
  }

  .prose :global(.cta-button-inline),
  .injected-cta .cta-button-inline {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background: var(--electric-aqua);
    color: var(--navy-900);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
    white-space: nowrap;
    border: none;
  }

  .prose :global(.cta-button-inline:hover),
  .injected-cta .cta-button-inline:hover {
    background: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(211, 175, 94, 0.5);
  }

  @media (max-width: 768px) {
    .prose :global(.cta-inner),
    .injected-cta .cta-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }

    .prose :global(.cta-icon),
    .injected-cta .cta-icon {
      width: 48px;
      height: 48px;
    }

    .prose :global(.cta-button-inline),
    .injected-cta .cta-button-inline {
      width: 100%;
    }
  }

  .post-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--glass-border);
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

