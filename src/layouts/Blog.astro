---
import Base from './Base.astro';
import AuthorBio from '@/components/blog/AuthorBio.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import { generateArticleSchema, generateBreadcrumbSchema, combineSchemas, serializeSchema } from '@/utils/schema';
import { company } from '@data/company';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, publishDate, author, category, tags, featuredImage, relatedPosts } = post.data;

// Generate Article schema for SEO
const articleUrl = `${company.site.url}/blog/${post.slug}/`;
const articleSchema = generateArticleSchema({
  headline: title,
  description: description,
  image: featuredImage || '/images/blog/default.png',
  author: author,
  authorUrl: author === 'Ankit Patel' ? `${company.site.url}/about/` : undefined,
  datePublished: publishDate.toISOString(),
  url: articleUrl,
  section: category,
  keywords: tags,
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Blog', url: `${company.site.url}/blog/` },
  { name: title }
]);

const schema = combineSchemas(articleSchema, breadcrumbSchema);

// Calculate reading time (rough estimate: 200 words per minute)
const content = post.body || '';
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

// Author data for header
const authorData: Record<string, { role: string; image: string }> = {
  'Ankit Patel': {
    role: 'Founder & Author',
    image: '/images/ankit_headshot_full.webp'
  }
};
const authorInfo = authorData[author] || { role: '', image: '' };
---

<Base
  title={`${title} | MyBCAT Blog`}
  description={description}
  ogType="article"
  ogImage={featuredImage}
  publishDate={publishDate}
  author={author}
>
  <script slot="head" type="application/ld+json" set:html={serializeSchema(schema)} />
  <article class="blog-post">
    <header class="post-header">
      <div class="post-meta">
        <span class="post-category">{category}</span>
        <span class="post-date">{publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span class="post-reading-time">{readingTime} min read</span>
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-author">
        {authorInfo.image ? (
          <img src={authorInfo.image} alt={author} class="author-avatar-img" width="48" height="48" loading="eager" />
        ) : (
          <div class="author-avatar">{author.split(' ').map(n => n[0]).join('')}</div>
        )}
        <div class="author-info">
          <a href="/about/" class="author-name">{author}</a>
          {authorInfo.role && <span class="author-role">{authorInfo.role}</span>}
        </div>
      </div>
    </header>

    {featuredImage && (
      <div class="post-featured-image">
        <img src={featuredImage} alt={title} loading="eager" />
      </div>
    )}

    <div class="post-content prose">
      <slot />
    </div>

    {tags && tags.length > 0 && (
      <footer class="post-footer">
        <div class="post-tags">
          {tags.map((tag: string) => (
            <a href={`/blog?tag=${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      </footer>
    )}

    <!-- Author Bio -->
    <AuthorBio name={author} />

    <!-- Related Posts -->
    <RelatedPosts
      currentSlug={post.slug}
      currentCategory={category}
      currentTags={tags || []}
      relatedSlugs={relatedPosts || []}
      maxPosts={3}
    />

    <!-- Blog Post CTA -->
    <section class="post-cta">
      <div class="post-cta-content">
        <div class="post-cta-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            <path d="M14.05 2a9 9 0 0 1 8 7.94"></path>
            <path d="M14.05 6A5 5 0 0 1 18 10"></path>
          </svg>
        </div>
        <div class="post-cta-text">
          <h2>Ready to Capture More Revenue?</h2>
          <p>See how MyBCAT helps multi-location healthcare groups fill every appointment slot and reduce front desk dependency.</p>
        </div>
      </div>
      <div class="post-cta-buttons">
        <a href="/contact/" class="cta-button primary">Schedule a Consultation</a>
        <a href="/blog/" class="cta-button secondary">View More Articles</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 100px 24px 60px;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .post-category {
    background: var(--glass-copper);
    color: var(--copper-700);
    padding: 4px 12px;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy-900);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--glass-copper) 0%, var(--copper-500) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: white;
    font-weight: 600;
  }

  .author-avatar-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--oceanic-teal);
  }

  .author-name {
    font-weight: 600;
    color: var(--navy-900);
    display: block;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.2s;
  }

  .author-name:hover {
    color: var(--oceanic-teal);
  }

  .author-role {
    font-size: 0.85rem;
    color: var(--oceanic-teal);
    font-weight: 500;
  }

  .post-featured-image {
    margin-bottom: 40px;
    border-radius: 16px;
    overflow: hidden;
  }

  .post-featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Prose styling for Markdown content */
  .prose {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .prose :global(h4) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy-900);
    margin-top: 28px;
    margin-bottom: 8px;
  }

  .prose :global(p) {
    margin-bottom: 20px;
    color: var(--text-secondary);
  }

  .prose :global(a) {
    color: var(--oceanic-teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--teal-600);
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--navy-900);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .prose :global(li) {
    margin-bottom: 8px;
    color: var(--text-secondary);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--oceanic-teal);
    padding-left: 20px;
    margin: 32px 0;
    font-style: italic;
    color: var(--navy-800);
  }

  .prose :global(code) {
    background: var(--glass-navy);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    background: var(--navy-900);
    color: var(--cream-200);
    padding: 20px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 12px 16px;
    border: 1px solid var(--glass-border);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--glass-navy);
    font-weight: 600;
    color: var(--navy-900);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 24px 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--glass-border);
    margin: 40px 0;
  }

  .post-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--glass-border);
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--glass-navy);
    color: var(--navy-800);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .tag:hover {
    background: var(--navy-800);
    color: white;
  }

  .post-cta {
    margin-top: 60px;
    padding: 48px;
    background: var(--navy-900);
    border-radius: 24px;
    position: relative;
    overflow: hidden;
  }

  .post-cta::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    background: linear-gradient(135deg, transparent 0%, rgba(0, 96, 100, 0.3) 100%);
    pointer-events: none;
  }

  .post-cta-content {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }

  .post-cta-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    background: rgba(77, 208, 225, 0.15);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--electric-aqua);
  }

  .post-cta-icon svg {
    width: 32px;
    height: 32px;
  }

  .post-cta-text {
    flex: 1;
  }

  .post-cta h2 {
    color: white;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .post-cta p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0;
    max-width: 500px;
  }

  .post-cta-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .cta-button.primary {
    background: var(--electric-aqua);
    color: var(--navy-900);
  }

  .cta-button.primary:hover {
    background: white;
    color: var(--navy-900);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(77, 208, 225, 0.3);
  }

  .cta-button.secondary {
    background: transparent;
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .cta-button.secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    color: white;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: 80px 16px 40px;
    }

    .post-cta {
      padding: 32px 24px;
    }

    .post-cta-content {
      flex-direction: column;
      gap: 20px;
    }

    .post-cta-icon {
      width: 56px;
      height: 56px;
    }

    .post-cta-icon svg {
      width: 28px;
      height: 28px;
    }

    .post-cta h2 {
      font-size: 1.5rem;
    }

    .post-cta p {
      font-size: 1rem;
    }

    .post-cta-buttons {
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
      text-align: center;
    }
  }
</style>
