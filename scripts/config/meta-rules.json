{
  "$schema": "./meta-rules.schema.json",
  "_sourceOfTruth": "05_technical_seo.md",
  "version": "1.0.0",
  "lastUpdated": "2026-03-06",
  "description": "Meta tag validation rules",

  "title": {
    "minLength": 50,
    "maxLength": 60,
    "required": true,
    "mustInclude": [],
    "mustNotInclude": ["undefined", "null", "untitled"],
    "source": "05_technical_seo.md §1.1, Rules 5.1-5.3"
  },

  "description": {
    "minLength": 140,
    "maxLength": 160,
    "required": true,
    "mustNotInclude": ["undefined", "null", "lorem ipsum"],
    "source": "05_technical_seo.md §1.2, Rules 5.4-5.5"
  },

  "canonical": {
    "required": true,
    "mustBeAbsolute": true,
    "mustIncludeTrailingSlash": true,
    "mustUseHttps": true,
    "domain": "mybcat.com",
    "source": "05_technical_seo.md §3, Rules 5.7-5.10"
  },

  "openGraph": {
    "required": ["og:title", "og:description", "og:url", "og:type"],
    "recommended": ["og:image"],
    "imageMinWidth": 1200,
    "imageMinHeight": 630,
    "source": "05_technical_seo.md §2, Rule 5.6"
  },

  "robots": {
    "defaultIndex": true,
    "defaultFollow": true,
    "noindexPatterns": ["/draft/", "/preview/", "/404"],
    "source": "05_technical_seo.md §4, Rule 5.11"
  },

  "byPageType": {
    "blog": {
      "requiredFields": ["author", "datePublished", "category"],
      "titleSuffix": " | MyBCAT"
    },
    "enterprise": {
      "requiredFields": [],
      "titleSuffix": " | MyBCAT Enterprise"
    },
    "solution": {
      "requiredFields": [],
      "titleSuffix": " | MyBCAT"
    }
  }
}
