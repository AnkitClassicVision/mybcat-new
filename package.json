{
  "name": "mybcat-new",
  "type": "module",
  "version": "1.0.0",
  "description": "MyBCAT website - Astro/Vercel static site",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/check-missing-webp.js && node scripts/validators/validate-images.js && node scripts/deactivate-broken-links.js && node scripts/validators/validate-cross-links.js",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "astro check",
    "audit:tracked": "node scripts/audit-blog-posts.js --csv=../blog_writer/blogs/published/published_posts.csv",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "publish-scheduled": "node scripts/publish-scheduled.js",
    "remediate-quality": "node scripts/remediate-quality.js",
    "images:optimize": "node scripts/optimize-images.js",
    "images:check": "node scripts/check-missing-webp.js",
    "images:check:fix": "node scripts/check-missing-webp.js --fix",
    "images:variants": "node scripts/generate-image-variants.js",
    "images:variants:dry": "node scripts/generate-image-variants.js --dry-run",
    "validate:terms": "node scripts/validators/validate-terms.js",
    "validate:meta": "node scripts/validators/validate-meta.js",
    "validate:h1": "node scripts/validators/validate-h1.js",
    "validate:links": "node scripts/validators/validate-links.js",
    "validate:schema": "node scripts/validators/validate-schema.js",
    "validate:enterprise-links": "node scripts/validators/validate-enterprise-links.js",
    "validate:content-quality": "node scripts/validators/validate-content-quality.js",
    "deactivate-links": "node scripts/deactivate-broken-links.js",
    "deactivate-links:dry": "node scripts/deactivate-broken-links.js --dry-run",
    "validate:cross-links": "node scripts/validators/validate-cross-links.js",
    "validate:deactivated-links": "node scripts/validators/validate-deactivated-links.js",
    "validate:pipeline-stages": "node scripts/validators/validate-pipeline-stages.js",
    "validate:citations": "node scripts/validators/validate-citations.js",
    "evaluate-post": "node scripts/evaluate-post.js",
    "validate:all": "node scripts/validators/validate-all.js",
    "validate:redirects": "node scripts/validate-redirects.mjs",
    "validate:sitemap": "node scripts/check-sitemap-urls.mjs --local-only",
    "validate:publish-dates": "node scripts/validators/validate-publish-dates.js",
    "validate:url-stability": "node scripts/validators/validate-url-stability.mjs",
    "validate:url-stability:save": "node scripts/validators/validate-url-stability.mjs --save",
    "audit:seo": "npm run validate:all -- --verbose"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/vercel": "^7.8.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^4.16.0",
    "posthog-js": "^1.427.0",
    "posthog-node": "^5.51.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "playwright": "^1.57.0",
    "sharp": "^0.35.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "sharp": "$sharp"
  }
}
